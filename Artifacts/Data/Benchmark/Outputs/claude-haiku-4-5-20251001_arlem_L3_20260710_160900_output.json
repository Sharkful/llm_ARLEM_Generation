      {
        "id": "action_03_vector_decomposition",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_device",
        "location": "launch_zone",
        "predicate": "component_decomposition_diagram",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "The second way to represent a vector is by its components: the projections of the vector onto the x-axis (horizontal) and y-axis (vertical). If a vector has magnitude V and makes an angle \u03b8 with the horizontal, then: Vx = V \u00d7 cos(\u03b8) and Vy = V \u00d7 sin(\u03b8). This decomposition is crucial for analyzing projectile motion. The horizontal component Vx remains constant (no horizontal force acts on the projectile), while Vy decreases due to gravity during ascent and increases downward during descent. Watch the diagram on the Vector Board to see how a single velocity vector is broken into its components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "component_decomposition_diagram",
              "poi": "component_display"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "component_x_label",
              "poi": "component_display",
              "text": "Horizontal: Vx = V\u00b7cos(\u03b8)"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "component_y_label",
              "poi": "component_display",
              "text": "Vertical: Vy = V\u00b7sin(\u03b8)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
