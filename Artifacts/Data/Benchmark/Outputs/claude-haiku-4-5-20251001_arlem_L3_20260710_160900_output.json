  "activity": {
    "id": "vectors_projectile_motion_lab",
    "name": "Vector Operations and Projectile Motion Exploration",
    "description": "A comprehensive AR physics lab where students first master vector representation, addition, and decomposition through interactive visualizations on the vector board, then apply these concepts to real projectile motion using an adjustable launcher. Students observe how launch angle and initial speed affect trajectory, range, and maximum height, discovering the independence principle of horizontal and vertical motion.",
    "language": "en",
    "workplace": "physics_vectors_projectile_lab",
    "start": "action_01_intro_vectors",
    "actions": [
      {
        "id": "action_01_intro_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_device",
        "location": "launch_zone",
        "predicate": "launcher_3d_model",
        "instruction": {
          "title": "Welcome to Vector Operations Lab",
          "description": "You are entering a physics lab dedicated to understanding vectors\u2014mathematical representations of quantities with both magnitude (size) and direction. Today you will learn how vectors are used to describe motion, starting with abstract vector operations and then applying them to projectile motion. First, let's understand what a vector is and how to represent it. A vector can be described two ways: (1) by its magnitude (the length) and direction (an angle), or (2) by its components along perpendicular axes (horizontal x and vertical y). Look at the launcher in front of you. When we fire a projectile at a certain angle, its initial velocity is a vector that we can decompose into horizontal and vertical parts."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "launcher_3d_model",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "launcher_3d_model"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
