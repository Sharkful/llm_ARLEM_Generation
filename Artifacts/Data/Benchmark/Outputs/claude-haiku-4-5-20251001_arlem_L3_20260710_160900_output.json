            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_vector_representation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_device",
        "location": "launch_zone",
        "predicate": "vector_magnitude_label",
        "instruction": {
          "title": "Representing Vectors: Magnitude and Direction",
          "description": "Any vector can be fully specified by two pieces of information: (1) its magnitude\u2014how big it is, measured as a length; and (2) its direction\u2014the angle it makes with a reference direction, typically the positive x-axis (horizontal to the right). For example, if a projectile is launched with a speed of 20 m/s at an angle of 45 degrees above the horizontal, we write this as: magnitude = 20 m/s, direction = 45\u00b0. This is the polar representation. Move to the Vector Board to see this concept visualized."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_magnitude_label",
              "poi": "vector_space",
              "text": "Vector: Magnitude & Direction"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
