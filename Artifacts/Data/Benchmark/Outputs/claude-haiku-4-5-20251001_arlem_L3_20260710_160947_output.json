          }
        ]
      },
      {
        "id": "molecular_geometry_vs_electron_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_student",
        "location": "student_workstation",
        "predicate": "tetrahedral_model_3d",
        "instruction": {
          "title": "Step 4: Electron-Domain vs. Molecular Geometry",
          "description": "It's critical to distinguish between two terms: (1) Electron-domain geometry describes the arrangement of ALL electron domains (both bonding and lone pairs). (2) Molecular geometry describes the arrangement of ONLY the atoms (bonding pairs). Methane (CH\u2084) is tetrahedral for both electron-domain and molecular geometry because all 4 domains are bonding pairs. Water (H\u2082O) has tetrahedral electron-domain geometry (4 domains: 2 bonding, 2 lone) but BENT molecular geometry (only 2 atoms plus the central oxygen). Ammonia (NH\u2083) has tetrahedral electron-domain geometry but trigonal pyramidal molecular geometry. Let's examine these molecules side by side."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_comparison_models",
              "type": "predicate",
              "augmentation": "tetrahedral_model_3d",
              "poi": "tetrahedral_position"
            },
            {
              "target": "geometry_comparison_models",
              "type": "predicate",
              "augmentation": "water_bent_geometry",
              "poi": "linear_position"
            },
            {
              "target": "geometry_comparison_models",
              "type": "predicate",
              "augmentation": "ammonia_pyramidal_geometry",
              "poi": "octahedral_position"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
