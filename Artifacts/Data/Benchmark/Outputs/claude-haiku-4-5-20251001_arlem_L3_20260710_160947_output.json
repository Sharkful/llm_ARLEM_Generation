            "viewport": "actions",
            "value": "ready",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "lone_pair_repulsion",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_student",
        "location": "student_workstation",
        "predicate": "lone_pair_explanation",
        "instruction": {
          "title": "Step 3: Lone Pairs and Their Effect on Molecular Geometry",
          "description": "Now here's the crucial insight: lone pairs occupy MORE angular space than bonding pairs. This is because a lone pair is repelled by only one nucleus (the central atom), while a bonding pair is attracted to TWO nuclei. This asymmetry makes lone pairs bulkier. As a result, lone pairs push bonding pairs closer together, reducing bond angles. In methane (CH\u2084) with 4 bonding pairs and no lone pairs (tetrahedral), the bond angle is 109.5\u00b0. In water (H\u2082O) with 2 bonding pairs and 2 lone pairs (also tetrahedral electron-domain geometry), the bond angle is only 104.5\u00b0\u2014compressed by the lone pairs. In ammonia (NH\u2083) with 3 bonding pairs and 1 lone pair (also tetrahedral), the bond angles are about 107\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "student_workstation",
              "type": "predicate",
              "augmentation": "lone_pair_explanation"
            },
            {
              "target": "geometry_comparison_models",
              "type": "predicate",
              "augmentation": "water_bent_geometry",
              "poi": "tetrahedral_position"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_comparison_models",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lone_pair_repulsion",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
