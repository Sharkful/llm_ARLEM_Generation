      {
        "id": "complex_molecules_analysis",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_student",
        "location": "reference_documentation_zone",
        "predicate": "trigonal_bipyramidal_model",
        "instruction": {
          "title": "Step 5: Exploring All Five Geometries with Real Molecules",
          "description": "Now let's apply VSEPR theory to molecules with higher steric numbers. Phosphorus pentafluoride (PF\u2085) has 5 bonding pairs around phosphorus and 0 lone pairs, giving a steric number of 5. This produces trigonal bipyramidal electron-domain geometry, with 3 atoms in a plane 120\u00b0 apart and 2 atoms above and below perpendicular to that plane (axial positions). The axial bonds are at 90\u00b0, while equatorial bonds are at 120\u00b0. When lone pairs are present in trigonal bipyramidal geometry, they preferentially occupy equatorial positions (where they experience less crowding). Sulfur hexafluoride (SF\u2086) has 6 bonding pairs and 0 lone pairs, giving octahedral geometry\u2014a three-dimensional 'square' with atoms at each corner. Xenon tetrafluoride (XeF\u2084) has 4 bonding pairs and 2 lone pairs around xenon. With a steric number of 6 (octahedral electron-domain geometry), the two lone pairs occupy opposite axial positions, leaving the 4 bonding pairs in the equatorial plane, producing square planar molecular geometry. These examples show how VSEPR predictions match experimental structures perfectly."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_comparison_models",
              "type": "predicate",
              "augmentation": "trigonal_bipyramidal_model",
              "poi": "linear_position"
            },
