          }
        ]
      },
      {
        "id": "step_03_dual_circulation_color_flow",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_unit",
        "location": "workstation_primary",
        "predicate": "blood_flow_narration",
        "instruction": {
          "title": "Dual-Circuit Color-Coded Blood Flow",
          "description": "The heart drives two interconnected circulatory loops: the pulmonary circuit and the systemic circuit. Here we display the flowing blood in color: blue represents deoxygenated blood on the right side of the heart, in the pulmonary arteries, and in the systemic veins; red represents oxygenated blood on the left side of the heart, in the pulmonary veins, and in the systemic arteries. The right side of the heart receives deoxygenated blood from the body and pumps it to the lungs. The left side receives oxygenated blood from the lungs and pumps it to the entire body. Watch as the pulmonary circuit is highlighted, then the systemic circuit, showing you these two distinct functional units working together continuously."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "blood_flow_narration"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "circulation_color_flow_animation"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "pulmonary_circuit_highlight"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "systemic_circuit_highlight"
            }
          ],
          "deactivate": [],
          "messages": [],
