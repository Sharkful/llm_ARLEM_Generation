  "activity": {
    "id": "heart_anatomy_exploration",
    "name": "Human Heart Anatomy and Circulation Lab",
    "description": "A comprehensive AR-guided exploration of the structural anatomy of the human heart and the dual-loop circulation. Students identify the four chambers, four valves, and major vessels; trace the path of blood through pulmonary and systemic circuits; examine the functional asymmetry of ventricular wall thickness; and learn how valves prevent backflow. The lab includes interactive tours, animated blood flow demonstrations, step-by-step cell tracing, comparative anatomy analysis, and formative quizzes to reinforce learning.",
    "language": "en",
    "workplace": "heart_anatomy_lab",
    "start": "step_01_heart_exterior_orientation",
    "actions": [
      {
        "id": "step_01_heart_exterior_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_unit",
        "location": "workstation_primary",
        "predicate": "intro_narration_audio",
        "instruction": {
          "title": "Heart Exterior Orientation",
          "description": "Welcome to the heart anatomy lab. You are now viewing the external surface of a human heart positioned anatomically with the apex pointing downward and slightly to the left. Notice the major vessels entering and exiting the heart: the superior and inferior vena cava bringing blood into the right side, the pulmonary trunk and arteries leaving the right side, the pulmonary veins returning to the left side, and the aorta leaving the left side. Remember that anatomical descriptions are from the patient's perspective, not the viewer's perspective\u2014so the heart's right side appears on your left. You can rotate both the intact and cutaway models to view them from any angle. Let's begin by identifying the chambers and valves of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_intact_model",
              "type": "predicate",
              "augmentation": "intro_narration_audio"
            },
            {
              "target": "heart_cutaway_model",
              "type": "primitive",
              "augmentation": "animation",
              "url": "https://assets.example.com/animations/heart_models_side_by_side.glb"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_structural_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_unit",
        "location": "workstation_primary",
        "predicate": "chamber_tour_narration",
        "instruction": {
          "title": "Structural Tour: Chambers, Valves, and Vessels",
          "description": "Now we will take a guided tour of the heart's internal structures using the cutaway view. Listen as each structure is named and watch as labels appear to highlight them. We'll start with the chambers: right atrium (receives deoxygenated blood from the body), right ventricle (pumps blood to the lungs), left atrium (receives oxygenated blood from the lungs), and left ventricle (pumps blood to the body). Then the valves: tricuspid (between right atrium and right ventricle), pulmonary or pulmonic (between right ventricle and pulmonary trunk), mitral or bicuspid (between left atrium and left ventricle), and aortic (between left ventricle and aorta). Finally, the major vessels: superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. As each interior structure is highlighted, the corresponding exterior landmark is also highlighted on the intact model so you can map the anatomy."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "chamber_tour_narration"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "highlight_effect_right_side",
              "poi": "right_atrium_chamber"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "right_atrium_label",
              "poi": "right_atrium_chamber",
              "text": "Right Atrium"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "right_ventricle_label",
              "poi": "right_ventricle_chamber",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "left_atrium_label",
              "poi": "left_atrium_chamber",
              "text": "Left Atrium"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "left_ventricle_label",
              "poi": "left_ventricle_chamber",
              "text": "Left Ventricle"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "tricuspid_valve_label",
              "poi": "tricuspid_valve",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "pulmonary_valve_label",
              "poi": "pulmonary_valve",
              "text": "Pulmonary Valve (SL)"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "mitral_valve_label",
              "poi": "mitral_valve",
              "text": "Mitral/Bicuspid Valve (AV)"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "aortic_valve_label",
              "poi": "aortic_valve",
              "text": "Aortic Valve (SL)"
            },
            {
              "target": "heart_intact_model",
              "type": "predicate",
              "augmentation": "superior_vena_cava_label",
              "poi": "superior_vena_cava_ext",
              "text": "Superior Vena Cava"
            },
            {
              "target": "heart_intact_model",
              "type": "predicate",
              "augmentation": "aorta_label",
              "poi": "aorta_ext",
              "text": "Aorta"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
