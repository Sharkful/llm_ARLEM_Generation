      {
        "id": "step_04_rbc_step_trace",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_unit",
        "location": "workstation_primary",
        "predicate": "rbc_trace_narration",
        "instruction": {
          "title": "Red Blood Cell Step-by-Step Path Trace",
          "description": "A single large red blood cell appears in the superior vena cava. Press 'Next' to advance the cell one step at a time through the complete circulatory path. With each step, the cell moves to the next chamber or vessel, a label names the structure it has just entered, and narration describes what is happening: the contracting atria and ventricles, the opening and closing of valves, and crucially, the color change of the cell from blue to red as it picks up oxygen in the lung capillaries. The complete path is: superior vena cava \u2192 right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary trunk \u2192 pulmonary arteries \u2192 lung capillaries (color change) \u2192 pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta \u2192 systemic circulation, then returning blue through systemic veins back to the superior vena cava. You can replay the trace as many times as needed to reinforce the sequence."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "rbc_trace_narration"
            },
            {
              "target": "heart_cutaway_model",
              "type": "predicate",
              "augmentation": "rbc_trace_animation"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
