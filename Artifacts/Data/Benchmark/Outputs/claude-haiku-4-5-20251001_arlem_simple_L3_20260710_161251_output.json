  "activity": {
    "id": "cardiac_anatomy_activity",
    "name": "Heart Anatomy and Circulation Lab",
    "description": "A comprehensive AR lab exploring the structural anatomy of the human heart, including the four chambers, four valves, and major vessels. Students trace the dual-loop circulation pathway (pulmonary and systemic) and understand how chamber wall thickness relates to circulatory function.",
    "workplace": "cardiac_anatomy_workplace",
    "start": "step_1_chambers",
    "actions": [
      {
        "id": "step_1_chambers",
        "instruction": {
          "title": "Identify the Four Heart Chambers",
          "description": "Begin by examining the 3D heart model. Locate and identify the four chambers: the right atrium (upper right), right ventricle (lower right), left atrium (upper left), and left ventricle (lower left). The atria are smaller, thinner-walled chambers that receive blood; the ventricles are larger, muscular chambers that pump blood out of the heart. Notice how the left ventricle appears thicker than the right ventricle\u2014we will explore why in a later step."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "chamber_label_ra",
              "poi": "right_atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "chamber_label_rv",
              "poi": "right_ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "chamber_label_la",
              "poi": "left_atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "chamber_label_lv",
              "poi": "left_ventricle"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_vessels"
          }
        ]
      },
      {
        "id": "step_2_vessels",
        "instruction": {
          "title": "Trace the Major Vessels",
          "description": "Now examine the second marker showing the major blood vessels entering and leaving the heart. Identify the six key vessels: the superior and inferior vena cava, the pulmonary arteries, the pulmonary veins, and the aorta. These vessels are the highways of the circulatory system. Click to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_vessels",
              "type": "predicate",
              "augmentation": "vessel_label_svc",
              "poi": "superior_vena_cava"
            },
            {
              "target": "heart_vessels",
              "type": "predicate",
              "augmentation": "vessel_label_ivc",
              "poi": "inferior_vena_cava"
            },
            {
              "target": "heart_vessels",
              "type": "predicate",
              "augmentation": "vessel_label_pa",
              "poi": "pulmonary_artery"
            },
            {
              "target": "heart_vessels",
              "type": "predicate",
              "augmentation": "vessel_label_pv",
              "poi": "pulmonary_vein"
            },
            {
              "target": "heart_vessels",
              "type": "predicate",
              "augmentation": "vessel_label_aorta",
              "poi": "aorta"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "predicate"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_valves"
          }
        ]
      },
      {
        "id": "step_3_valves",
        "instruction": {
          "title": "Understand the Four Heart Valves",
          "description": "Switch to the valve closeup model to examine the four heart valves in detail. The atrioventricular (AV) valves (tricuspid and mitral) allow blood to flow from atria to ventricles while preventing backflow. The semilunar valves (pulmonary and aortic) prevent blood from flowing backward into the ventricles when they relax. These one-way mechanisms are essential for efficient circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_valves",
              "type": "predicate",
              "augmentation": "valve_label_tricuspid",
              "poi": "tricuspid_valve"
            },
            {
              "target": "heart_valves",
              "type": "predicate",
              "augmentation": "valve_label_pulmonary",
              "poi": "pulmonary_valve"
            },
            {
              "target": "heart_valves",
              "type": "predicate",
              "augmentation": "valve_label_mitral",
              "poi": "mitral_valve"
            },
            {
              "target": "heart_valves",
              "type": "predicate",
              "augmentation": "valve_label_aortic",
              "poi": "aortic_valve"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_vessels",
              "type": "predicate"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_dual_circulation"
          }
        ]
      },
      {
        "id": "step_4_dual_circulation",
        "instruction": {
          "title": "Trace the Dual-Loop Circulation Pathway",
          "description": "Now trace the complete pathway of blood through the heart. Deoxygenated blood returns from the body and enters the right atrium via the vena cava. It flows through the tricuspid valve into the right ventricle, pumped through the pulmonary valve and arteries to the lungs (pulmonary circulation). Oxygenated blood returns via pulmonary veins to the left atrium, flows through the mitral valve into the left ventricle, and is pumped through the aortic valve and aorta to the systemic circulation. Watch the animation to see this pathway in action."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "blood_flow_animation"
            },
            {
              "target": "systemic_circulation_zone",
              "type": "predicate",
              "augmentation": "systemic_circuit_diagram",
              "poi": "default"
            },
            {
              "target": "pulmonary_circulation_zone",
              "type": "predicate",
              "augmentation": "pulmonary_circuit_diagram",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_valves",
              "type": "predicate"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_wall_thickness"
          }
        ]
      },
      {
        "id": "step_5_wall_thickness",
        "instruction": {
          "title": "Explain Ventricular Wall Thickness",
          "description": "Notice that the left ventricle has a substantially thicker myocardium than the right ventricle. The left ventricle must generate sufficient pressure to pump blood through the entire body (systemic circuit), while the right ventricle only pumps to the nearby lungs (pulmonary circuit). The thicker left ventricular wall reflects this greater workload. This is form following function in physiology. Review the comparative cross-section image to understand these differences."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "pulmonary_circulation_zone",
              "type": "predicate",
              "augmentation": "myocardium_thickness_comparison",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "blood_flow_narration"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "step_5_wall_thickness"
          }
        ]
      }
    ]
