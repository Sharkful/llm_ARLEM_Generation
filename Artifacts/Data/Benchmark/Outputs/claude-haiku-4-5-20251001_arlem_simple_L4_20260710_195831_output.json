  "activity": {
    "id": "vectors_projectile_lab_activity",
    "name": "Vectors and Projectile Motion Exploration",
    "description": "A comprehensive AR lab exploring vectors as mathematical representations of quantities with magnitude and direction, and their application to two-dimensional projectile motion. Students progress from abstract vector operations (addition, decomposition) to concrete physics applications, discovering the independence of horizontal and vertical motion and the 45-degree maximum range result.",
    "workplace": "physics_vectors_projectile",
    "start": "intro_vectors",
    "actions": [
      {
        "id": "intro_vectors",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Observe a vector as a mathematical object with both magnitude (size/length) and direction. The arrow has a clearly visible tail at the origin and a head extending into space. Notice the magnitude value displayed nearby and the colored coordinate axes (red for x, green for y, blue for z) that show direction relative to the workspace. You can grab the arrow's head and drag it around to change its direction and magnitude in real time. Rotate your viewpoint around the vector to see it from different angles and confirm that the vector itself does not change \u2014 only your viewing perspective changes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_display_board",
              "type": "predicate",
              "augmentation": "single_vector_interactive",
              "poi": "vector_origin"
            },
            {
              "target": "vector_display_board",
              "type": "predicate",
              "augmentation": "coordinate_axes",
              "poi": "vector_origin"
            },
            {
              "target": "vector_display_board",
              "type": "predicate",
              "augmentation": "magnitude_label",
              "poi": "magnitude_display"
            },
            {
              "target": "vector_display_board",
              "type": "predicate",
              "augmentation": "direction_label",
              "poi": "direction_display"
            },
            {
              "target": "vector_display_board",
              "type": "predicate",
              "augmentation": "intro_vectors_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "intro_vectors"
          }
        ]
      },
      {
        "id": "vector_addition",
        "instruction": {
          "title": "Vector Addition by Tip-to-Tail Method",
          "description": "Observe two vectors drawn in different colors (blue and green) positioned tip-to-tail in the workspace. The first vector (blue) starts at the origin; the second vector (green) starts at the head of the first. A resultant vector (drawn in red) connects the tail of the first vector to the head of the second, showing the sum of the two vectors. Grab and reorient either the blue or green vector; the resultant updates in real time as you move them. Notice that no matter how you arrange the two vectors, the resultant always points from the origin to the same final position \u2014 this demonstrates that vector addition is commutative: A + B = B + A."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "addition_demo_board",
              "type": "predicate",
              "augmentation": "vector_addition_blue",
              "poi": "addition_origin"
            },
            {
              "target": "addition_demo_board",
              "type": "predicate",
              "augmentation": "vector_addition_green",
              "poi": "addition_origin"
            },
            {
              "target": "addition_demo_board",
              "type": "predicate",
              "augmentation": "vector_resultant_red",
              "poi": "addition_origin"
            },
            {
              "target": "addition_demo_board",
              "type": "predicate",
              "augmentation": "vector_addition_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_addition"
          }
        ]
      },
      {
        "id": "vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition Along Axes",
          "description": "Observe vector decomposition as the reverse of addition. A single vector (shown in neutral color) is broken down into three component vectors aligned with the x, y, and z axes. Each component is color-coded to match its axis: red for x, green for y, blue for z. The three components are arranged tip-to-tail starting from the origin: the x component starts at the origin, the y component starts at the tip of x, and the z component starts at the tip of y, with their sum reaching the head of the original vector. Grab and resize any component by dragging along its axis; the original vector updates to remain the sum of the three components. This demonstrates that any vector can be reconstructed from its component parts, and in two dimensions, the components and original vector form a right triangle related by the Pythagorean theorem."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "decomposition_demo_board",
              "type": "predicate",
              "augmentation": "decomposition_original",
              "poi": "decomposition_origin"
            },
            {
              "target": "decomposition_demo_board",
              "type": "predicate",
              "augmentation": "component_x_axis",
              "poi": "decomposition_origin"
            },
            {
              "target": "decomposition_demo_board",
              "type": "predicate",
              "augmentation": "component_y_axis",
              "poi": "decomposition_origin"
            },
            {
              "target": "decomposition_demo_board",
              "type": "predicate",
              "augmentation": "component_z_axis",
              "poi": "decomposition_origin"
            },
            {
              "target": "decomposition_demo_board",
              "type": "predicate",
              "augmentation": "decomposition_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_decomposition"
          }
        ]
      },
      {
        "id": "projectile_setup",
        "instruction": {
          "title": "Transitioning to Projectile Motion",
          "description": "The abstract vector tools you just learned are now applied to a specific physical problem: projectile motion. A 2D vertical plane appears in the workspace with horizontal (x) and vertical (y) axes clearly labeled. A small projectile (ball) rests on the ground line at the left side of the plane, and an initial velocity vector is drawn from the ball pointing upward and to the right at a launch angle above the horizontal. The projectile experiences only gravity (which acts downward) and no horizontal force, so its motion remains entirely within this 2D vertical plane. The vector decomposition you learned earlier will explain why the horizontal and vertical components of motion behave so differently."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "2d_plane_animation",
              "poi": "default"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "projectile_ball",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "velocity_vector_arrow",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "projectile_setup_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "projectile_setup"
          }
        ]
      },
      {
        "id": "projectile_motion_demo",
        "instruction": {
          "title": "Projectile Motion: Independent Horizontal and Vertical Components",
          "description": "Watch the projectile launch from the ground with an initial velocity vector decomposed into horizontal (red, pointing right) and vertical (blue, pointing up) components. As the projectile flies, observe how these component arrows change: the horizontal component remains constant in length and direction throughout the flight because no horizontal force acts on the projectile. The vertical component shrinks during ascent, becomes zero at the peak of the trajectory (the moment of maximum height), and grows downward during descent as gravity pulls the projectile down. A faint trail traces the parabolic path. The key insight is that the horizontal motion (constant velocity) and vertical motion (constant acceleration under gravity) are independent \u2014 the parabolic trajectory is simply these two independent motions occurring simultaneously. You can switch viewing angles to see this motion from different perspectives."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "projectile_ball",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "horizontal_component_arrow",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "vertical_component_arrow",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "trajectory_path_animation",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "projectile_motion_narration"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "independence_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "projectile_motion_demo"
          }
        ]
      },
      {
        "id": "parametric_exploration",
        "instruction": {
          "title": "Discovering Maximum Range: Angle and Speed Effects",
          "description": "You now have interactive controls to set the launch angle (0 to 90 degrees above horizontal) and launch speed. Each time you adjust the parameters and press launch, the projectile launches and its trajectory is drawn. The range \u2014 the horizontal distance from launch to landing at the same elevation \u2014 is displayed on screen. A history panel records the angle, speed, and range of each attempt, allowing you to compare results. Explore different combinations: try angles from 20 to 70 degrees at various speeds. Look for patterns: does the range change symmetrically around a certain angle? For a fixed speed, what angle maximizes range? After you have made several launches, narration will confirm the maximum-range result: at any fixed speed, range is maximized when the launch angle is 45 degrees, and angles symmetric about 45 degrees produce equal range."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "projectile_ball",
              "poi": "launch_origin"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "parametric_control_interface"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "launch_history_panel"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "range_result_label"
            },
            {
              "target": "projectile_environment",
              "type": "predicate",
              "augmentation": "max_range_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "parametric_exploration"
          }
        ]
      },
      {
        "id": "sandbox_exploration",
        "instruction": {
          "title": "Sandbox: Free Exploration with All Parameters",
          "description": "The structured constraints are now removed, and you have full control over the projectile motion system. Adjust the launch angle (0\u201390 degrees), launch speed, initial height (from ground level up to 50 meters), and gravity strength (from 0 to 5 times Earth's gravity). Simply launch projectiles and observe the trajectories, with live component arrows shown on the projectile. Explore: What happens to range when gravity is halved? What does the trajectory look like under very strong gravity? If you launch from a 50-meter platform, does 45 degrees still maximize range, or does the optimal angle shift? Use this sandbox to consolidate your intuition by experimenting freely with the system."
        },
        "enter": {
