      "clips": [
        {
          "clipName": "clip0_intro",
          "audioClip": "vsepr_intro_fundamentals",
          "autoAdvance": false,
          "changeMeaning": "Introduces VSEPR theory principle and the concept of electron-pair repulsion as the driving force for molecular geometry.",
          "narration": "VSEPR theory, or Valence Shell Electron Pair Repulsion theory, predicts the three-dimensional shapes of molecules. The key principle is that electron pairs\u2014both bonding pairs and lone pairs\u2014repel each other. These electron pairs arrange themselves around a central atom in a way that minimizes repulsion, which determines the molecule's shape."
        },
        {
          "clipName": "clip1_steric_number",
          "audioClip": "vsepr_steric_number_definition",
          "autoAdvance": false,
          "changes": [
            {
              "target": "central_atom_sphere",
              "enabled": true
            },
            {
              "target": "steric_number_label",
              "enabled": true
            }
          ],
          "changeMeaning": "Displays the central atom and explains how to calculate steric number from Lewis structure for methane.",
          "narration": "To apply VSEPR theory, we first determine the steric number. The steric number is the total number of electron domains around the central atom. It equals the number of bonding pairs plus the number of lone pairs. For methane, carbon is the central atom bonded to four hydrogens. That's four bonding pairs and zero lone pairs, giving a steric number of four."
        }
      ]
