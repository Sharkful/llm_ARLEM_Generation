      {
        "id": "action_compare_giants",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_orrery",
        "instruction": {
          "title": "Step 5: Compare Mars, Jupiter, and Saturn",
          "description": "Finally, add Jupiter and Saturn to the orrery. Watch all three loops side by side. Notice that Jupiter and Saturn make SMALLER loops than Mars. Because they orbit farther out, Earth overtakes them from a greater distance, so the relative-motion effect \u2014 and the apparent loop \u2014 shrinks. Say 'Finish' to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_orrery",
              "type": "predicate",
              "augmentation": "pred_giants_compare",
              "poi": "poi_sun_center",
              "state": "three_planet_loops"
            },
            {
              "target": "thing_gas_giants",
              "type": "predicate",
              "augmentation": "pred_label_mars",
              "poi": "poi_giants_label",
              "text": "Jupiter & Saturn: smaller loops"
            }
          ],
          "deactivate": [],
