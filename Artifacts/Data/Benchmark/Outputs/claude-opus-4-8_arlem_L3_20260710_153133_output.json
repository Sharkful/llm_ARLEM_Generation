      },
      {
        "id": "action_predict",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_orrery",
        "instruction": {
          "title": "Step 4: Predict When Retrograde Happens",
          "description": "Retrograde occurs only near 'opposition' \u2014 when Earth passes directly between the Sun and the outer planet. Rotate the orrery until Earth, Mars, and the Sun line up, then detect the Mars marker to confirm your prediction. This alignment repeats about every 26 months for Mars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_orrery",
              "type": "predicate",
              "augmentation": "pred_prediction_widget",
              "poi": "poi_sun_center"
            },
            {
              "target": "place_orrery",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits",
              "poi": "poi_sun_center",
              "state": "alignment_mode"
            },
            {
