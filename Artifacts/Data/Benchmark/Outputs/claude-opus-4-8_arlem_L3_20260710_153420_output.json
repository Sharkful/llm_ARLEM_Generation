        "id": "action_leading_lagging",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "place_replication_station",
        "predicate": "pred_okazaki_anim",
        "instruction": {
          "title": "5. Leading vs. Lagging Strand",
          "description": "Because DNA polymerase only extends 5' to 3', the leading strand is synthesized continuously toward the fork while the lagging strand is made discontinuously as Okazaki fragments, later joined by DNA ligase. Observe both strands and relate the asymmetry to the antiparallel templates. Say 'next' to conclude."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_enzyme_kit",
              "type": "predicate",
              "augmentation": "pred_polymerase_anim",
              "poi": "poi_leading_strand"
            },
            {
              "target": "thing_enzyme_kit",
              "type": "predicate",
              "augmentation": "pred_okazaki_anim",
              "poi": "poi_lagging_strand"
            },
            {
