      {
        "id": "action_antiparallel",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "place_structure_station",
        "predicate": "pred_antiparallel_diagram",
        "instruction": {
          "title": "3. Antiparallel Directionality",
          "description": "The two strands run in opposite directions. Follow the highlighted backbone: one strand runs 5' to 3', its complement runs 3' to 5'. This antiparallel arrangement arises from the directionality of the sugar-phosphate backbone. Note the 5' and 3' end labels, then say 'next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_antiparallel_diagram",
              "viewport": "actions"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
