              "augmentation": "pred_label_5prime",
              "poi": "poi_five_prime_top",
              "text": "5' end"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "poi_three_prime_bottom",
              "text": "3' end"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_pointer",
