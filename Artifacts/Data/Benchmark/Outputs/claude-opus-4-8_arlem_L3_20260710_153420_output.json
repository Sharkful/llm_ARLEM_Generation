  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure & Semiconservative Replication",
    "description": "A hands-on AR training session for introductory molecular biology students. Learners first examine the three-dimensional structure of the DNA double helix, identify its sugar-phosphate backbones and nitrogenous bases, apply complementary base-pairing rules, and reason about antiparallel strand directionality. They then trace the enzymatic machinery of DNA replication at the replication fork, distinguish leading- from lagging-strand synthesis, and conclude by explaining why replication is semiconservative.",
    "language": "en",
    "workplace": "wp_dna_molbio",
    "start": "action_intro_helix",
    "actions": [
      {
        "id": "action_intro_helix",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "place_structure_station",
        "predicate": "pred_helix_overview",
        "instruction": {
          "title": "1. Meet the Double Helix",
          "description": "Approach the DNA Structure Station. A rotating double helix model appears before you. Notice the two sugar-phosphate backbones spiraling around a common axis, with the nitrogenous bases projecting inward. Say 'next' or tap Continue to identify the components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_helix_overview",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_audio_intro"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone_left",
              "text": "Sugar-phosphate backbone"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_base_pair",
              "poi": "poi_base_pair_center",
              "text": "Nitrogenous bases project inward"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone_left"
            },
            {
              "target": "thing_dna_helix",
              "augmentation": "pred_label_base_pair",
              "poi": "poi_base_pair_center"
            },
            {
              "target": "thing_dna_helix",
              "augmentation": "pred_audio_intro"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_helix_model",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_intro_helix",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_intro_helix",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_base_pairing",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "place_structure_station",
        "predicate": "pred_at_pairing_anim",
        "instruction": {
          "title": "2. Complementary Base Pairing",
          "description": "Use the Base Pairing Tray. Adenine pairs with Thymine via two hydrogen bonds; Guanine pairs with Cytosine via three. Given one strand 5'-A T G C-3', determine its complement. Watch the A-T and G-C pairing animations, then say 'next' to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_base_tray",
              "type": "predicate",
              "augmentation": "pred_at_pairing_anim",
              "poi": "poi_adenine_slot"
            },
            {
              "target": "thing_base_tray",
              "type": "predicate",
              "augmentation": "pred_gc_pairing_anim",
              "poi": "poi_guanine_slot"
            },
            {
              "target": "thing_base_tray",
              "type": "predicate",
              "augmentation": "pred_audio_basepairing"
            },
            {
              "target": "thing_base_tray",
              "type": "predicate",
              "augmentation": "pred_label_base_pair",
              "poi": "poi_thymine_slot",
              "text": "A=T: 2 H-bonds"
            },
            {
              "target": "thing_base_tray",
              "type": "predicate",
              "augmentation": "pred_label_base_pair",
              "poi": "poi_cytosine_slot",
              "text": "G\u2261C: 3 H-bonds"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
