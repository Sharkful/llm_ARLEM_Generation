  "activity": {
    "id": "act_heart_anatomy_lab",
    "name": "The Human Heart: Structure and Blood Flow",
    "description": "A hands-on AR lab for Human Anatomy and Physiology I. Learners orient to a 3D heart model, identify the four chambers, the four valves, and the major vessels, then trace the dual-loop circulation of blood and reason about why the left ventricle wall is thicker than the right. Advance each step by clicking or speaking the prompt.",
    "language": "en",
    "workplace": "wp_heart_anatomy",
    "start": "step_orientation",
    "actions": [
      {
        "id": "step_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection_bench",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Welcome to the cardiac anatomy lab. Look at the 3D heart model on the dissection bench. Note its orientation: the point (apex) tilts down and to the patient's left. The right side of the heart is nearest you. When you are oriented, say 'next' or tap Continue to begin identifying the chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_highlight_glow",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_narration_intro"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_chambers_diagram",
              "poi": "default",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection_bench",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Four labeled markers now appear on the model. The two upper receiving chambers are the RIGHT ATRIUM and LEFT ATRIUM. The two lower pumping chambers are the RIGHT VENTRICLE and LEFT VENTRICLE. The interventricular septum divides left from right. Trace each label, then continue to study the valves."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_narration_chambers"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_septum",
              "text": "Interventricular Septum"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
