        "triggers": [
          {
            "mode": "click",
            "id": "step_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection_bench",
        "instruction": {
          "title": "The Four Valves and Backflow Prevention",
          "description": "Four valves keep blood moving one way. The atrioventricular (AV) valves sit between atria and ventricles: the TRICUSPID valve (right side) and the MITRAL/bicuspid valve (left side). The semilunar valves guard the exits: the PULMONARY valve (right ventricle to pulmonary artery) and the AORTIC valve (left ventricle to aorta). Look at the valve tray to see how the cusps snap shut to prevent backflow. Continue to trace the path of blood."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_narration_valves"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mitral",
              "text": "Mitral Valve (AV)"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve (Semilunar)"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve (Semilunar)"
            },
            {
              "target": "thing_valve_tray",
              "type": "predicate",
              "augmentation": "pred_highlight_glow",
              "poi": "poi_av_valves"
            },
            {
              "target": "thing_valve_tray",
              "type": "predicate",
              "augmentation": "pred_valve_diagram",
              "poi": "poi_semilunar_valves"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
