          }
        ]
      },
      {
        "id": "step_bloodpath",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_circulation_wall",
        "instruction": {
          "title": "Trace the Path of Blood",
          "description": "Follow the animated flow. DEOXYGENATED (blue) blood returns via the superior and inferior vena cava into the RIGHT ATRIUM, through the TRICUSPID valve into the RIGHT VENTRICLE, out the PULMONARY valve and pulmonary arteries to the LUNGS. OXYGENATED (red) blood returns via the pulmonary veins to the LEFT ATRIUM, through the MITRAL valve into the LEFT VENTRICLE, and out the AORTIC valve and aorta to the body. The blue pulmonary circuit and red systemic circuit are shown on the flow board. Continue to compare the ventricle walls."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_narration_bloodpath"
            },
            {
