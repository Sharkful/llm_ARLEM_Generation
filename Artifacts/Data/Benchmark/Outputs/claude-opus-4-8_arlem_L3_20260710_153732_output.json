        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "launch_zone",
        "predicate": "anim_velocity_vectors",
        "instruction": {
          "title": "The Launch Velocity Vector",
          "description": "Move to the Projectile Launcher. Set the angle dial and speed you wish to test. The initial velocity vector is decomposed for you into a constant horizontal component Vx and a vertical component Vy that gravity will change. Detect the launcher marker to lock in your setup."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "launcher",
              "type": "predicate",
              "augmentation": "anim_velocity_vectors",
              "poi": "muzzle",
              "state": "idle"
            },
            {
              "target": "launcher",
              "type": "predicate",
              "augmentation": "label_xcomponent",
              "poi": "muzzle",
              "text": "Vx = V cos\u03b8 (stays constant)"
            },
            {
              "target": "launcher",
              "type": "predicate",
              "augmentation": "label_ycomponent",
              "poi": "angle_dial",
              "text": "Vy = V sin\u03b8 (gravity changes this)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
