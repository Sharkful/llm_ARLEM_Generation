        },
        "triggers": [
          {
            "mode": "detect",
            "id": "launcher",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "step_flight",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_flight",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "launch_zone",
        "predicate": "anim_projectile_arc",
        "instruction": {
          "title": "Independent Motions & the Parabola",
          "description": "Fire the projectile and watch its flight. Notice Vx never changes (no horizontal force), while Vy decreases going up, reaches zero at maximum height, then grows downward. The horizontal and vertical motions are independent; their combination produces the parabolic path. Tap Next to optimize your launch."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "launch_zone",
              "type": "predicate",
              "augmentation": "anim_projectile_arc",
              "poi": "field_start",
              "state": "play"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "anim_velocity_vectors",
              "state": "play"
            },
            {
              "target": "launch_zone",
              "type": "predicate",
              "augmentation": "label_vx_constant",
              "poi": "field_start",
              "text": "Vx constant throughout"
            },
            {
              "target": "launch_zone",
              "type": "predicate",
              "augmentation": "label_apex",
              "poi": "field_apex",
              "text": "Max height: Vy = 0"
