  "activity": {
    "id": "act_vectors_projectile",
    "name": "From Vectors to Projectile Motion",
    "description": "A hands-on AR training session that begins with abstract vector operations (tip-to-tail addition and component decomposition via right-triangle trigonometry) and applies them to two-dimensional projectile motion. Learners manipulate a launcher's angle and speed to discover the independence of horizontal and vertical motion and the launch angle that maximizes range.",
    "language": "en",
    "workplace": "wp_vectors_projectile",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "vector_zone",
        "predicate": "narration_intro",
        "instruction": {
          "title": "Welcome: Magnitude and Direction",
          "description": "A vector carries both a magnitude and a direction. Look at the Vector Board in front of you: the coordinate grid is where you will build and manipulate vectors. When you are ready, say 'start' or tap Begin to add your first vectors."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "narration_intro"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_resultant",
              "poi": "grid_center",
              "text": "A vector = magnitude + direction"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "narration_intro"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_add_vectors",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_add_vectors",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_add_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "vector_zone",
        "predicate": "anim_tip_to_tail",
        "instruction": {
          "title": "Adding Vectors Tip-to-Tail",
          "description": "Two vectors A and B are shown on the grid. Watch how vector B is moved so its tail meets the tip of vector A. The arrow drawn from the tail of A to the tip of B is the resultant, A + B. Tap Next when you can identify the resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "anim_tip_to_tail",
              "poi": "grid_center",
              "state": "play"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_resultant",
              "poi": "vector_b_tail",
              "text": "Resultant = A + B"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_decompose",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_decompose",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_decompose",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "vector_zone",
        "predicate": "anim_component_decompose",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "Any vector can be split into a horizontal (x) component and a vertical (y) component. Using right-triangle trigonometry, x = V\u00b7cos(\u03b8) and y = V\u00b7sin(\u03b8). Study the triangle: the vector is the hypotenuse, and its components form the two legs. Tap Next to apply this to a real projectile."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "anim_component_decompose",
              "poi": "grid_center",
              "state": "play"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "img_right_triangle",
              "poi": "display_wall"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_xcomponent",
              "poi": "vector_a_tail",
              "text": "x = V cos\u03b8 (horizontal)"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_ycomponent",
              "poi": "grid_center",
              "text": "y = V sin\u03b8 (vertical)"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "narration_components"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "narration_components"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
