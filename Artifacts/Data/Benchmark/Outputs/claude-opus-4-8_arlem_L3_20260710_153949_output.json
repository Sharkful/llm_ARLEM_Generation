  "activity": {
    "id": "act_vsepr_training",
    "name": "Predicting Molecular Shapes with VSEPR Theory",
    "description": "A hands-on AR training session in which General Chemistry I students start from a Lewis structure, count electron domains to find the steric number, predict the electron-domain geometry, apply lone-pair effects to obtain molecular geometry, reason about bond-angle deviations, and finally compare VSEPR predictions to real molecules (water, ammonia, methane, SF6).",
    "language": "en",
    "workplace": "wp_vsepr_lab",
    "start": "action_intro_lewis",
    "actions": [
      {
        "id": "action_intro_lewis",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_lewis_intro_audio",
        "instruction": {
          "title": "Start from the Lewis Structure",
          "description": "VSEPR theory predicts a molecule's 3-D shape from the arrangement of electron pairs around its central atom. Begin with the Lewis structure of water (H2O) shown on your reference card. Identify the central oxygen atom and note its bonding pairs and lone pairs. When ready, say or tap 'Begin' to count the electron domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_lewis_card",
              "type": "predicate",
              "augmentation": "pred_lewis_water_image",
              "poi": "poi_face"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_lewis_intro_audio"
            },
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_instruction_label",
              "poi": "poi_center",
              "text": "H2O: 2 bonding pairs + 2 lone pairs on central O"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_card",
              "type": "*"
            },
            {
              "target": "place_build_zone",
              "augmentation": "pred_instruction_label"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_count_domains",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_count_domains",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_steric_number_label",
        "instruction": {
          "title": "Count Domains: Find the Steric Number",
          "description": "The steric number equals the number of bonding pairs plus lone pairs around the central atom. Drag electron domains from the tray onto the central oxygen: place 2 bonding pairs and 2 lone pairs. Oxygen therefore has a steric number of 4. Detect the domain tray to confirm your count and reveal the steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "poi_top",
              "text": "Steric Number = 2 bonds + 2 lone pairs = 4"
            },
            {
              "target": "thing_domain_tray",
              "type": "predicate",
              "augmentation": "pred_instruction_label",
              "poi": "poi_bonding_slot",
              "text": "Add bonding & lone pairs to the central atom"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_domain_tray",
              "augmentation": "pred_instruction_label"
            },
            {
              "target": "thing_central_atom",
              "augmentation": "pred_steric_number_label"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_domain_tray",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_predict_edg",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_predict_edg",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_domain_repulsion_anim",
        "instruction": {
          "title": "Predict the Electron-Domain Geometry",
          "description": "Electron domains repel one another and spread out to minimize repulsion. Watch the four domains around oxygen settle into a tetrahedral arrangement (109.5 degrees) - the electron-domain geometry for steric number 4. Review how each steric number (2 through 6) maps to linear, trigonal planar, tetrahedral, trigonal bipyramidal, or octahedral. Tap 'Next' to add lone-pair effects."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_domain_repulsion_anim",
              "poi": "default",
              "state": "minimize_repulsion"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_tetrahedral_anim",
              "poi": "default"
            },
            {
              "target": "place_comparison_zone",
              "type": "predicate",
              "augmentation": "pred_five_geometries_video",
              "poi": "poi_shelf",
              "viewport": "reactions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "pred_domain_repulsion_anim"
            },
            {
              "target": "place_comparison_zone",
              "augmentation": "pred_five_geometries_video"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_molecular_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_molecular_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_molecular_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_lone_pair_anim",
        "instruction": {
          "title": "From Electron-Domain to Molecular Geometry",
          "description": "Molecular geometry describes only the atoms, not the invisible lone pairs. Hide the two lone pairs on oxygen: the remaining O-H bonds form a BENT shape rather than tetrahedral. Notice the lone pairs occupy more angular space, squeezing the H-O-H angle. Say 'Continue' to examine the resulting bond angle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_lone_pair_anim",
              "poi": "poi_orbit",
              "state": "lone_pairs_expand"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_water_molecule_anim",
              "poi": "default"
            },
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_instruction_label",
              "poi": "poi_center",
              "text": "4 domains, 2 lone pairs -> BENT molecular geometry"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "pred_lone_pair_anim"
            },
            {
              "target": "place_build_zone",
              "augmentation": "pred_instruction_label"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "action_bond_angle",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_bond_angle",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_bond_angle",
        "viewport": "reactions",
        "type": "reactions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_bond_angle_label",
        "instruction": {
          "title": "Explain the Bond-Angle Deviation",
          "description": "In an ideal tetrahedron the angle is 109.5 degrees, as in methane (CH4). But water's two lone pairs push harder than bonding pairs, compressing the H-O-H angle to 104.5 degrees. Compare the compressed water angle against the ideal methane angle displayed beside it. Tap 'Compare Molecules' to test your predictions against real structures."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_bond_angle_label",
              "poi": "poi_top",
              "text": "H-O-H = 104.5 deg (compressed from 109.5 deg)"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_water_molecule_anim",
              "poi": "default",
              "state": "show_angle"
            },
            {
              "target": "place_comparison_zone",
              "type": "predicate",
              "augmentation": "pred_methane_molecule_anim",
              "poi": "poi_shelf"
            }
          ],
          "deactivate": [],
