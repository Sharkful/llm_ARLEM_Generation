            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_link",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_nightsky",
        "instruction": {
          "title": "4. Linking the Two Viewpoints",
          "description": "See both models at once. A line of sight runs from Earth through Mars out to the background stars. During normal motion it sweeps eastward through the constellations. As Earth begins to overtake Mars, the line reverses and sweeps westward \u2014 and in the night-sky inset, Mars retraces its path. After Earth passes, the sweep resumes eastward. The loop is real apparent geometry, not a trick of the eye. Tap 'Next' to try it yourself."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_solar_system",
              "type": "predicate",
              "augmentation": "pred_orbits_run",
              "poi": "default"
            },
            {
              "target": "thing_solar_system",
              "type": "predicate",
              "augmentation": "pred_lineofsight",
              "poi": "poi_mars_orbit"
            },
            {
