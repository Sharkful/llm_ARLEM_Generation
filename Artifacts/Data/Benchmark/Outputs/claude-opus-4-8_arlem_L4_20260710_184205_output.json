  "activity": {
    "id": "act_retrograde_motion",
    "name": "Understanding Apparent Retrograde Motion",
    "description": "A seven-part AR investigation of apparent retrograde motion. Learners observe Mars's retrograde loop from Earth, examine the geocentric epicycle explanation, view the heliocentric resolution, link the two viewpoints via a line of sight, physically generate retrograde motion by walking Earth's orbit, compare loops of Mars/Jupiter/Saturn, and predict retrograde configurations. Supports objectives on describing, explaining, contrasting, predicting, and comparing retrograde motion.",
    "language": "en",
    "workplace": "wp_retrograde_motion",
    "start": "action_observe",
    "actions": [
      {
        "id": "action_observe",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_nightsky",
        "instruction": {
          "title": "1. Observe the Puzzle in the Night Sky",
          "description": "Look up at the starfield. The constellations of the ecliptic \u2014 Leo, Virgo, Libra, and Scorpio \u2014 surround you, with Mars glowing as a red point. Watch six months pass: Mars drifts eastward, then slows, loops westward for about two months, then resumes eastward motion. The trail marks its full path. Why would a planet move backward? Say or tap 'Next' to investigate."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_constellation_labels",
              "poi": "poi_zenith"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_trail",
              "poi": "default"
            },
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_label_east",
              "poi": "poi_ecliptic_east",
              "text": "East (normal drift)"
            },
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_label_west",
              "poi": "poi_ecliptic_west",
              "text": "West (retrograde loop)"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_mars",
              "augmentation": "*"
            },
            {
              "target": "place_nightsky",
              "augmentation": "*"
            },
            {
              "target": "person_learner",
              "augmentation": "pred_narration_intro"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_geocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_geocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_nightsky",
        "instruction": {
          "title": "2. The Geocentric Explanation: Epicycles",
          "description": "Earth sits at the center. Mars rides a small circle \u2014 the epicycle \u2014 that itself rides a larger circle, the deferent, around Earth. Watch the machinery run: when Mars is on the inner side of its epicycle, closest to Earth, its combined motion appears backward. This reproduces the loop, but only with carefully tuned circle sizes and speeds \u2014 and better data forced astronomers to stack ever more epicycles. Tap 'Next' to see a simpler answer."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_epicycle_rig",
              "type": "predicate",
              "augmentation": "pred_epicycle_run",
              "poi": "default"
            },
            {
              "target": "thing_epicycle_rig",
              "type": "predicate",
              "augmentation": "pred_label_epicycle",
              "poi": "poi_epicycle",
              "text": "Epicycle"
            },
            {
              "target": "thing_epicycle_rig",
              "type": "predicate",
              "augmentation": "pred_label_deferent",
              "poi": "poi_deferent",
              "text": "Deferent"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_narration_geocentric",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_epicycle_rig",
              "augmentation": "*"
            },
            {
              "target": "person_learner",
              "augmentation": "pred_narration_geocentric"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
