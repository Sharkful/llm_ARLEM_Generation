            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_heliocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_nightsky",
        "instruction": {
          "title": "3. The Heliocentric Resolution",
          "description": "Rise above the solar system. The Sun is at the center; Earth orbits at 1 AU (one year) and Mars at 1.52 AU (1.88 years). Watch them run at true relative speeds \u2014 Earth overtakes Mars roughly every 26 months. The retrograde event from Scene 1 is replayed here: Earth swings past Mars on its inner, faster orbit. No epicycles needed \u2014 just two smooth ellipses. Tap 'Next' to connect this to the night sky."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_solar_system",
              "type": "predicate",
              "augmentation": "pred_orbits_run",
              "poi": "default"
            },
            {
              "target": "thing_solar_system",
              "type": "predicate",
              "augmentation": "pred_label_east",
              "poi": "poi_sun",
              "text": "Sun"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_solar_system",
              "augmentation": "*"
            },
            {
              "target": "person_learner",
              "augmentation": "pred_narration_heliocentric"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
