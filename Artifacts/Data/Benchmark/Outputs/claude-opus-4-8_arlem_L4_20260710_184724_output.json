  "activity": {
    "id": "act_heart_circulation",
    "name": "The Human Heart & the Path of Blood",
    "description": "An eight-part hands-on AR tour of cardiac structure and dual-loop circulation. Learners orient to the heart, take a guided structural tour of chambers/valves/vessels, watch color-coded dual-circuit flow, trace a single red blood cell through the full circuit, compare ventricular wall thickness, examine valve open/closed states, and finish with identification and blood-flow quizzes plus a recap.",
    "language": "en",
    "workplace": "wp_heart_anatomy",
    "start": "step_orientation",
    "actions": [
      {
        "id": "step_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "dissection_bench",
        "predicate": "launched",
        "instruction": {
          "title": "1. Orient to the Heart",
          "description": "Two full-size heart models appear side by side on the bench. The LEFT model is intact, showing the exterior and major vessels; the RIGHT model is a cutaway with the anterior wall removed, exposing the chambers and valves. Rotate the models to view from any angle. Note that 'right' and 'left' are named from the patient's perspective \u2014 so the anatomical right side faces YOUR left. When ready, say or click 'next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "intact_heart",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/intact_heart.glb"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/cutaway_heart.glb"
            },
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "narration_intro"
            },
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "highlight_glow",
              "poi": "right_side"
            },
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "structure_label",
              "poi": "right_side",
              "text": "Patient's RIGHT side (your left)"
            },
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "structure_label",
              "poi": "left_side",
              "text": "Patient's LEFT side (your right)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "narration_intro"
            },
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "highlight_glow",
              "poi": "right_side"
            },
            {
              "target": "intact_heart",
