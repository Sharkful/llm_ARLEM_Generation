      {
        "id": "step_structural_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "dissection_bench",
        "predicate": "launched",
        "instruction": {
          "title": "2. Guided Structural Tour",
          "description": "Follow the narration through the cutaway heart. The four CHAMBERS light up in order: right atrium, right ventricle, left atrium, left ventricle. Then the four VALVES: tricuspid (RA\u2192RV), pulmonary (RV\u2192pulmonary trunk), mitral/bicuspid (LA\u2192LV), and aortic (LV\u2192aorta). Then the major VESSELS on the intact model: superior & inferior vena cava, pulmonary arteries, pulmonary veins, aorta. Note the mitral valve is also called the bicuspid valve \u2014 you'll see both terms. Click 'next' when done."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "narration_tour"
