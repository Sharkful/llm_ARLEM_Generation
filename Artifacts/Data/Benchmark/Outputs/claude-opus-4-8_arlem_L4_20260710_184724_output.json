      {
        "id": "step_dual_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_learner",
        "location": "dissection_bench",
        "predicate": "launched",
        "instruction": {
          "title": "3. Dual-Circuit Color-Coded Flow",
          "description": "The cutaway chambers and vessels fill with flowing color: BLUE = deoxygenated blood (right heart, pulmonary arteries, systemic veins); RED = oxygenated blood (left heart, pulmonary veins, systemic arteries). Watch the steady-state pattern. The PULMONARY circuit (right heart \u2192 lungs \u2192 left atrium) highlights briefly, then the SYSTEMIC circuit (left heart \u2192 body \u2192 right atrium). Right side pumps to the lungs; left side pumps to the body. Click 'next' to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "bloodflow_anim",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "narration_dualcircuit"
