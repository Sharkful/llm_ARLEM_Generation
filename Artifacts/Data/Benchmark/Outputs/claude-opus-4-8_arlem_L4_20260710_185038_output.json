      {
        "id": "step_projectile_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_projectile_plane",
        "instruction": {
          "title": "From Vectors to Projectiles",
          "description": "The 3D workspace gives way to a 2D vertical plane with labeled horizontal and vertical axes. Gravity acts only downward and no horizontal force acts, so the entire motion lives in the plane containing the initial velocity \u2014 a genuinely two-dimensional problem. A ball rests on the ground line at the left, with a velocity vector pointing up and to the right at the launch angle. Look the ball over, then say 'next' to decompose the launch velocity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_projectile_axes",
              "poi": "plane_center"
            },
            {
              "target": "thing_projectile_ball",
              "type": "predicate",
              "augmentation": "pred_velocity_vector",
              "poi": "top"
            },
            {
              "target": "thing_projectile_ball",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "top",
              "text": "Initial speed = 20 m/s at 53 deg"
            },
            {
