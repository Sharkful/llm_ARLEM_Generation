        ]
      },
      {
        "id": "step_molecular_geo",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "workbench",
        "instruction": {
          "title": "4. Electron-Domain vs. Molecular Geometry",
          "description": "Start with methane (CH4): four bonding domains, tetrahedral electron-domain geometry AND tetrahedral molecular geometry \u2014 they match when all domains bond. Now replace one H with a lone pair (ammonia, NH3): electron-domain geometry is still tetrahedral, but the molecular shape is now TRIGONAL PYRAMIDAL. Replace a second H (water, H2O) and the shape becomes BENT. The electron-domain geometry never changed \u2014 lone pairs just aren't 'seen' in the molecular shape. Tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "anim_ch4_to_nh3_h2o",
              "poi": "default",
              "state": "morph_ch4_nh3_h2o"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "label_edgeo",
              "poi": "top",
              "text": "Electron-domain: Tetrahedral"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "label_molgeo",
              "poi": "front",
              "text": "Molecular: CH4\u2192NH3\u2192H2O"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "narration_molecular_geo",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
