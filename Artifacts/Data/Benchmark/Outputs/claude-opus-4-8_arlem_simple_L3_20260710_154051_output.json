  "activity": {
    "id": "act_retrograde_motion",
    "name": "Why Mars Loops: Exploring Apparent Retrograde Motion",
    "description": "A two-perspective AR investigation of apparent retrograde motion. Students first observe Mars tracing a westward loop against the constellations from Earth's surface, then step outside the solar system to see how the loop arises naturally from Earth overtaking Mars in the heliocentric model. The lab contrasts geocentric epicycles with the heliocentric explanation and compares the retrograde loops of Mars, Jupiter, and Saturn.",
    "workplace": "wp_retrograde_motion",
    "start": "step_observe_night_sky",
    "actions": [
      {
        "id": "step_observe_night_sky",
        "instruction": {
          "title": "1. Watch Mars in the Night Sky",
          "description": "Point your device at the sky-dome marker. Over the animated weeks, watch Mars drift eastward against the background constellations, slow, reverse into a westward loop for about two months, then resume its eastward motion. Tap Next when you have traced the full loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_skydome",
              "type": "predicate",
              "augmentation": "pred_star_background_img",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_retrograde_loop_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_mars",
              "poi": "poi_label",
              "text": "Mars"
            },
            {
              "target": "place_skydome",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_skydome",
              "type": "predicate",
              "augmentation": "pred_narration_intro"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_observe_night_sky"
          }
        ]
      },
      {
        "id": "step_geocentric_epicycle",
        "instruction": {
          "title": "2. The Geocentric Puzzle",
          "description": "In the ancient geocentric model, everything orbits a stationary Earth. To reproduce Mars's loop, astronomers had to add an epicycle \u2014 a small circle riding on a larger one. Observe how many extra circles are needed. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_skydome",
              "type": "predicate",
              "augmentation": "pred_epicycle_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_mars",
              "poi": "poi_label",
              "text": "Mars on epicycle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_skydome",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_geocentric_epicycle"
          }
        ]
      },
      {
        "id": "step_heliocentric_orbits",
        "instruction": {
          "title": "3. Step Outside the Solar System",
          "description": "Scan the solar-system marker to view Earth and Mars from above. Both planets move in smooth circles around the Sun \u2014 no epicycles required. Watch Earth on its faster inner orbit catch up to and overtake the slower Mars. Tap Next when the orbits complete one cycle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_orbit_motion_anim",
              "poi": "poi_sun_center"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_label_earth",
              "poi": "poi_label",
              "text": "Earth (inner, faster)"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_mars",
              "poi": "poi_label",
              "text": "Mars (outer, slower)"
            },
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_solar_system",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_heliocentric_orbits"
          }
        ]
      },
      {
        "id": "step_overtake_sightline",
        "instruction": {
          "title": "4. The Overtaking Effect",
          "description": "As Earth passes Mars, the sight-line from Earth through Mars to the background stars swings backward \u2014 just like a slower car appearing to drift backward when you pass it. This backward swing is the westward loop you saw in Step 1. Study the projected sight-lines, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_orbit_motion_anim",
              "poi": "poi_sun_center"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_sightline_video",
              "poi": "poi_label"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_overtake_diagram",
              "poi": "poi_label"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_overtake_sightline"
          }
        ]
      },
      {
        "id": "step_compare_planets",
        "instruction": {
          "title": "5. Compare Mars, Jupiter, and Saturn",
          "description": "Point at the outer-planets anchor to compare retrograde loops. Notice that Jupiter and Saturn trace smaller, tighter loops than Mars because they are farther from the Sun, so Earth's relative-motion effect on them is weaker. Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_compare_loops_anim",
              "poi": "default"
            },
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_label_mars",
              "poi": "poi_jupiter",
              "text": "Jupiter: smaller loop"
            },
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_label_earth",
              "poi": "poi_saturn",
              "text": "Saturn: smallest loop"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_outer_planets",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_compare_planets"
          }
        ]
      }
    ]
  }
}