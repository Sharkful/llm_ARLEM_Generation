  "activity": {
    "id": "act_dna_replication",
    "name": "The Double Helix and Semiconservative Replication",
    "description": "A guided AR lab for introductory molecular biology students. Learners inspect a 3D double-helix model to identify structural components, apply complementary base-pairing rules, reason about antiparallel strand directionality, trace the enzymes of the replication fork, and conclude with the semiconservative model of DNA replication. Linear progression across six steps, advanced by clicking UI actions or detecting physical models.",
    "workplace": "wp_dna_lab",
    "start": "step_structure",
    "actions": [
      {
        "id": "step_structure",
        "instruction": {
          "title": "1. Anatomy of the Double Helix",
          "description": "Point your device at the DNA model to load it onto the lab bench. Observe the two sugar-phosphate backbones (highlighted in orange) spiraling around a common axis, with the nitrogenous bases projecting inward. Identify the backbone as the structural 'railing' of the helix. When you are ready, tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "anim_helix_spin",
              "poi": "default"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "anim_backbone_highlight",
              "poi": "default"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_left",
              "text": "Sugar-phosphate backbone"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "label_bases",
              "poi": "helix_top",
              "text": "Nitrogenous bases project inward"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_intro_structure",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "augmentation": "anim_backbone_highlight"
            },
            {
              "target": "thing_double_helix",
              "augmentation": "label_backbone"
            },
            {
              "target": "thing_double_helix",
              "augmentation": "label_bases"
            },
            {
              "target": "place_lab_bench",
              "augmentation": "audio_intro_structure"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_double_helix",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_structure"
          }
        ]
      },
      {
        "id": "step_basepairing",
        "instruction": {
          "title": "2. Complementary Base Pairing",
          "description": "Scan the base-pair model. Watch the hydrogen bonds form between pairs: adenine bonds with thymine via two hydrogen bonds, while guanine bonds with cytosine via three. Use the diagram to practice: given one strand's sequence, determine the complementary strand. Tap Continue when finished."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "anim_basepair_bonds",
              "poi": "default"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "label_hbonds",
              "poi": "at_pair",
              "text": "A = T (2 hydrogen bonds)"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "label_hbonds",
              "poi": "gc_pair",
              "text": "G \u2261 C (3 hydrogen bonds)"
            },
            {
              "target": "place_summary_screen",
              "type": "predicate",
              "augmentation": "img_base_pairing_rules",
              "poi": "screen_face"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_basepair_rules",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_base_pair",
              "augmentation": "*"
            },
            {
              "target": "place_summary_screen",
              "augmentation": "img_base_pairing_rules"
            },
            {
              "target": "place_lab_bench",
              "augmentation": "audio_basepair_rules"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_base_pair",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_basepairing"
          }
        ]
      },
      {
        "id": "step_antiparallel",
        "instruction": {
          "title": "3. Antiparallel Orientation",
          "description": "Return to the double-helix model. Directional arrows now trace each backbone: one strand runs 5' to 3', the complementary strand runs 3' to 5'. Note how the sugar-phosphate directionality forces the two strands to lie antiparallel. This arrangement will become critical during replication. Tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "anim_antiparallel_arrows",
              "poi": "default"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "label_directionality",
              "poi": "backbone_left",
              "text": "5' \u2192 3'"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "label_directionality",
              "poi": "backbone_right",
              "text": "3' \u2190 5'"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_antiparallel",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "augmentation": "*"
            },
            {
              "target": "place_lab_bench",
              "augmentation": "audio_antiparallel"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_antiparallel"
          }
        ]
      },
      {
        "id": "step_replication_fork",
        "instruction": {
          "title": "4. Enzymes at the Replication Fork",
          "description": "Scan the replication fork model. Watch helicase unwind the double helix at the fork; single-strand binding proteins stabilize the separated strands; DNA polymerase reads each template. Identify each enzyme by its labeled function. Tap Continue to see how the two new strands are built."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "anim_helicase_unwind",
              "poi": "fork_junction"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "label_enzyme",
              "poi": "fork_junction",
              "text": "Helicase unwinds; SSB proteins stabilize"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_replication_enzymes",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "anim_helicase_unwind"
            },
            {
              "target": "thing_replication_fork",
              "augmentation": "label_enzyme"
            },
            {
              "target": "place_lab_bench",
              "augmentation": "audio_replication_enzymes"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_replication_fork",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_replication_fork"
          }
        ]
      },
      {
        "id": "step_leading_lagging",
        "instruction": {
          "title": "5. Leading and Lagging Strands",
          "description": "Because DNA polymerase extends only in the 5'-to-3' direction, the antiparallel templates are copied differently. The leading strand is synthesized continuously toward the fork; the lagging strand is built discontinuously as Okazaki fragments, later joined by DNA ligase. Study the labeled strands and diagram, then tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "anim_polymerase_synthesis",
              "poi": "default"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "label_strand_type",
              "poi": "leading_strand",
              "text": "Leading strand: continuous synthesis"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "label_strand_type",
              "poi": "lagging_strand",
              "text": "Lagging strand: Okazaki fragments + ligase"
            },
            {
              "target": "place_summary_screen",
              "type": "predicate",
              "augmentation": "img_okazaki_fragments",
              "poi": "screen_face"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "*"
            },
            {
              "target": "place_summary_screen",
              "augmentation": "img_okazaki_fragments"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_leading_lagging"
          }
        ]
      },
      {
        "id": "step_semiconservative",
        "instruction": {
          "title": "6. Semiconservative Replication",
          "description": "Watch the parental helix separate into two daughter molecules \u2014 each retaining one original parental strand paired with one newly-synthesized strand. This is why replication is 'semiconservative'. Predict: after two rounds, how many molecules contain an original strand? Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "anim_semiconservative",
              "poi": "default"
            },
            {
              "target": "place_summary_screen",
              "type": "predicate",
              "augmentation": "label_summary",
              "poi": "screen_face",
              "text": "Each daughter = 1 parental + 1 new strand"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_semiconservative",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "augmentation": "*"
            },
            {
              "target": "place_summary_screen",
              "augmentation": "label_summary"
            },
            {
              "target": "place_lab_bench",
              "augmentation": "audio_semiconservative"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_semiconservative"
          }
        ]
      }
    ]
  }
}