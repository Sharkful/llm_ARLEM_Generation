  "activity": {
    "id": "act_heart_bloodflow",
    "name": "The Human Heart: Structure and Blood Flow",
    "description": "A five-part AR lab that guides students through the structural anatomy of the human heart and the dual-loop path of blood. Students identify the four chambers, four valves, and major vessels; trace deoxygenated and oxygenated blood through the pulmonary and systemic circuits; and examine why the left ventricle has a thicker myocardium than the right.",
    "workplace": "wp_heart_anatomy",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Point your device at the heart model marker to load the 3D human heart. Notice its orientation: the anatomical right side (the patient's right) appears on your left. When ready, tap Next to begin identifying the four chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_intro",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "highlight_structure",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "heart_model",
            "duration": 1500
          },
          {
            "mode": "click",
            "id": "step_intro"
          }
        ]
      },
      {
        "id": "step_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "The heart has four chambers: the right atrium and right ventricle on the right side, and the left atrium and left ventricle on the left. Atria receive blood; ventricles pump it out. Study the labels on the model and the reference tray, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber",
              "poi": "right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber",
              "poi": "right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber",
              "poi": "left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber",
              "poi": "left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "chambers_tray",
              "type": "predicate",
              "augmentation": "chambers_diagram_img",
              "poi": "label_slot"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_chambers",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "chambers_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_chambers"
          }
        ]
      },
      {
        "id": "step_valves",
        "instruction": {
          "title": "Identify the Four Valves and Major Vessels",
          "description": "Four valves keep blood moving one direction. The atrioventricular valves \u2014 tricuspid (right) and mitral/bicuspid (left) \u2014 sit between atria and ventricles. The semilunar valves \u2014 pulmonary and aortic \u2014 guard the exits to the great vessels. Watch the valves open and close, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve",
              "poi": "tricuspid_valve",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve",
              "poi": "pulmonary_valve",
              "text": "Pulmonary Valve (semilunar)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve",
              "poi": "mitral_valve",
              "text": "Mitral/Bicuspid Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve",
              "poi": "aortic_valve",
              "text": "Aortic Valve (semilunar)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel",
              "poi": "vena_cava",
              "text": "Superior & Inferior Vena Cava"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel",
              "poi": "pulmonary_artery",
              "text": "Pulmonary Arteries"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel",
              "poi": "pulmonary_vein",
              "text": "Pulmonary Veins"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel",
              "poi": "aorta",
              "text": "Aorta"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "valve_open_close",
              "poi": "tricuspid_valve"
            },
            {
              "target": "valves_tray",
              "type": "predicate",
              "augmentation": "valves_diagram_img",
              "poi": "label_slot"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_valves",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "valves_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_valves"
          }
        ]
      },
      {
        "id": "step_pulmonary_circuit",
        "instruction": {
          "title": "Trace the Pulmonary Circuit (Right Heart)",
          "description": "Follow the blue flow: deoxygenated blood returns from the body via the vena cava into the RIGHT ATRIUM, through the TRICUSPID valve into the RIGHT VENTRICLE, out the PULMONARY valve and pulmonary arteries to the LUNGS. Watch the animation in the pulmonary zone, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_deoxy",
              "poi": "right_atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_deoxy",
              "poi": "right_ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_deoxy",
              "poi": "pulmonary_artery"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "highlight_structure",
              "poi": "pulmonary_valve"
            },
            {
              "target": "pulmonary_circuit_zone",
              "type": "predicate",
              "augmentation": "pulmonary_circuit_video",
              "poi": "diagram_wall"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_bloodpath",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "pulmonary_circuit_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "anchor_pulmonary_zone",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_pulmonary_circuit"
          }
        ]
      },
      {
        "id": "step_systemic_circuit",
        "instruction": {
          "title": "Trace the Systemic Circuit & Compare Wall Thickness",
          "description": "Follow the red flow: oxygenated blood returns from the lungs via the pulmonary veins into the LEFT ATRIUM, through the MITRAL valve into the LEFT VENTRICLE, out the AORTIC valve and aorta to the whole body. Note the left ventricle's thick myocardium \u2014 it must generate far higher pressure than the right to perfuse the systemic circuit. Compare the walls, then tap Finish."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_oxy",
              "poi": "left_atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_oxy",
              "poi": "left_ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "bloodflow_oxy",
              "poi": "aorta"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "highlight_structure",
              "poi": "septum"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "myocardium_compare_img",
              "poi": "left_ventricle"
            },
            {
              "target": "systemic_circuit_zone",
              "type": "predicate",
              "augmentation": "systemic_circuit_video",
              "poi": "diagram_wall"
            },
            {
              "target": "heart_model",
