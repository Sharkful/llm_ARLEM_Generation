  "activity": {
    "id": "act_vectors_projectile",
    "name": "From Vectors to Projectile Motion",
    "description": "A guided AR lab in which students first master abstract vector operations (tip-to-tail addition and component decomposition via right-triangle trigonometry), then apply these tools to two-dimensional projectile motion. Students observe that horizontal and vertical motions are independent, examine how vertical velocity reaches zero at maximum height, and explore how launch angle and speed determine range and maximum height.",
    "workplace": "wp_vectors_projectile",
    "start": "step_intro_vectors",
    "actions": [
      {
        "id": "step_intro_vectors",
        "instruction": {
          "title": "1. Vectors: Magnitude & Direction",
          "description": "Point your device at the Vector Whiteboard. A vector is drawn as an arrow whose length represents its magnitude and whose orientation represents its direction. Study the labeled arrow, then tap Next when you can identify both its magnitude and direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "default",
              "text": "A vector has both MAGNITUDE (length) and DIRECTION (angle)"
            },
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_vector_board",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_intro_vectors"
          }
        ]
      },
      {
        "id": "step_tip_to_tail",
        "instruction": {
          "title": "2. Adding Vectors Tip-to-Tail",
          "description": "Watch the animation on the Vector Whiteboard as two vectors are joined tip-to-tail. The resultant vector runs from the tail of the first arrow to the tip of the second. Tap Next once you can identify the resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_tip_to_tail_anim",
              "poi": "default",
              "state": "play"
            },
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_resultant_label",
              "poi": "poi_resultant",
              "text": "RESULTANT = A + B"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_tip_to_tail"
          }
        ]
      },
      {
        "id": "step_components",
        "instruction": {
          "title": "3. Decomposing a Vector into Components",
          "description": "Aim at the Component Decomposition Grid. The animation resolves a single vector into a horizontal (x) component and a vertical (y) component. Note the right triangle formed: the vector is the hypotenuse. Tap Next to review the trigonometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_component_anim",
              "poi": "default",
              "state": "play"
            },
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "poi_angle",
              "text": "Vx = V cos(theta),  Vy = V sin(theta)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_grid",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_component_grid",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_components"
          }
        ]
      },
      {
        "id": "step_trig_reconstruct",
        "instruction": {
          "title": "4. Right-Triangle Trigonometry",
          "description": "Study the right-triangle diagram on the grid. Given the components Vx and Vy, the magnitude is sqrt(Vx^2 + Vy^2) and the direction is arctan(Vy/Vx). Confirm you can reconstruct the original vector from its components, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_trig_diagram",
              "poi": "default"
            },
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "poi_angle",
              "text": "|V| = sqrt(Vx^2 + Vy^2),  theta = atan(Vy/Vx)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_grid",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_trig_reconstruct"
          }
        ]
      },
      {
        "id": "step_projectile_launch",
        "instruction": {
          "title": "5. Projectile Motion: Independent Components",
          "description": "Move to the Launch Field and aim at the Projectile Launcher. Launch the projectile and watch its parabolic path. Its initial velocity is decomposed into a constant horizontal component and a gravity-driven vertical component. The accompanying video shows that horizontal and vertical motions are fully independent. Tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_projectile_anim",
              "poi": "poi_muzzle",
              "state": "launch"
            },
            {
              "target": "place_field",
              "type": "predicate",
              "augmentation": "pred_independence_video",
              "poi": "default"
            },
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_narration_projectile",
              "poi": "default"
            },
            {
              "target": "place_field",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "poi_landing",
              "text": "Vertical velocity = 0 at MAXIMUM HEIGHT"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launcher",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_field",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_launcher",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_projectile_launch"
          }
        ]
      },
      {
        "id": "step_angle_range",
        "instruction": {
          "title": "6. Launch Angle, Speed & Range",
          "description": "Observe the angle-sweep animation over the Launch Field, showing trajectories for launch angles from 15 to 75 degrees at fixed speed. Notice how range and maximum height change, and confirm that 45 degrees gives maximum range for a given speed. Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_field",
              "type": "predicate",
              "augmentation": "pred_angle_sweep_anim",
              "poi": "default",
              "state": "play"
            },
            {
              "target": "place_field",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "poi_landing",
              "text": "Maximum range at launch angle = 45 degrees"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_field",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_angle_range"
          }
        ]
      }
    ]
  }
}