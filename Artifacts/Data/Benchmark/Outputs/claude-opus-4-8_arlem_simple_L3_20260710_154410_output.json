  "activity": {
    "id": "act_vsepr_walkthrough",
    "name": "Predicting Molecular Shapes with VSEPR Theory",
    "description": "A linear, five-step AR lab for General Chemistry I. Students begin from a Lewis structure, count bonding and lone pairs to find the steric number, predict the electron-domain geometry, distinguish it from the molecular geometry when lone pairs are present, reason about lone-pair repulsion and bond-angle deviations (e.g., 104.5 degrees in water vs 109.5 degrees in methane), and finally compare VSEPR predictions to real molecules such as water, ammonia, methane, PF5, SF6, and XeF4.",
    "workplace": "wp_vsepr_lab",
    "start": "step_lewis_and_steric",
    "actions": [
      {
        "id": "step_lewis_and_steric",
        "instruction": {
          "title": "Step 1: Read the Lewis Structure & Count Domains",
          "description": "Scan the Lewis Structure Reference Card. Identify the central atom, then count its bonding pairs and lone pairs. Together these give the steric number, the total number of electron domains around the central atom. Tap Next when you have your steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_lewis_card",
              "type": "predicate",
              "augmentation": "pred_lewis_diagram",
              "poi": "poi_diagram_face"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_steric_count_anim",
              "poi": "poi_top"
            },
            {
              "target": "thing_lewis_card",
              "type": "primitive",
              "augmentation": "audio",
              "url": "https://assets.example.com/vsepr/audio_intro_vsepr.mp3"
            },
            {
              "target": "thing_lewis_card",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Steric number = bonding pairs + lone pairs"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_card",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_central_atom",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lewis_and_steric"
          }
        ]
      },
      {
        "id": "step_electron_domain_geometry",
        "instruction": {
          "title": "Step 2: Predict the Electron-Domain Geometry",
          "description": "Use your steric number to select the electron-domain geometry: 2 = linear, 3 = trigonal planar, 4 = tetrahedral, 5 = trigonal bipyramidal, 6 = octahedral. Watch the domains spread out on the stage to minimize mutual repulsion. Present the Model Kit marker to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_geometry_stage",
              "type": "predicate",
              "augmentation": "pred_domain_geometry_anim",
              "poi": "poi_center"
            },
            {
              "target": "place_geometry_stage",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "SN 2-6: linear, trigonal planar, tetrahedral, trigonal bipyramidal, octahedral"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_geometry_stage",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_model_kit",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step_molecular_geometry",
        "instruction": {
          "title": "Step 3: Electron-Domain vs. Molecular Geometry",
          "description": "Not every domain is a bond. Replace one or more bonding pairs with lone pairs on the model kit and observe how the molecular shape differs from the electron-domain geometry, producing bent, trigonal pyramidal, seesaw, T-shaped, square planar, or square pyramidal shapes. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_model_kit",
              "type": "predicate",
              "augmentation": "pred_domain_geometry_anim",
              "poi": "poi_tray"
            },
            {
              "target": "place_geometry_stage",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_center",
              "text": "Lone pairs are invisible in the molecular shape: e.g. tetrahedral domains -> bent (H2O) or pyramidal (NH3)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_model_kit",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_geometry_stage",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_molecular_geometry"
          }
        ]
      },
      {
        "id": "step_lonepair_deviation",
        "instruction": {
          "title": "Step 4: Lone Pairs and Bond-Angle Deviations",
          "description": "Lone pairs sit closer to the central atom and occupy more angular space than bonding pairs, squeezing the bonding pairs together. Watch how this pushes the H-O-H angle in water down to 104.5 degrees, compared with the ideal 109.5 degrees in methane. Tap Next when the comparison finishes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_lonepair_repulsion_anim",
              "poi": "poi_top"
            },
            {
              "target": "place_geometry_stage",
              "type": "predicate",
              "augmentation": "pred_deviation_video",
              "poi": "poi_center"
            },
            {
              "target": "thing_central_atom",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Lone-pair repulsion: H2O 104.5 vs CH4 109.5"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_geometry_stage",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lonepair_deviation"
          }
        ]
      },
      {
        "id": "step_real_molecules",
        "instruction": {
          "title": "Step 5: Compare Predictions to Real Molecules",
          "description": "Present the comparison shelf to reveal real molecule models: water, ammonia, methane, PF5, SF6, and XeF4. Match each predicted VSEPR geometry against the experimentally observed structure and confirm your reasoning. Presenting the Lewis card ends the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_comparison_shelf",
              "type": "predicate",
              "augmentation": "pred_molecule_gallery",
              "poi": "poi_display"
            },
            {
              "target": "place_comparison_shelf",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "H2O bent, NH3 pyramidal, CH4 tetrahedral, PF5 trig. bipyramidal, SF6 octahedral, XeF4 square planar"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_comparison_shelf",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_lewis_card",
            "duration": 2000
          }
        ]
      }
    ]
  }
