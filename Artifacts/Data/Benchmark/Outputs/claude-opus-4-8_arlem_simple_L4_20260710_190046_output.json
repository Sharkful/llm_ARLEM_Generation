  "activity": {
    "id": "act_heart_anatomy",
    "name": "The Human Heart: Structure and Circulation",
    "description": "A guided AR exploration of cardiac anatomy and blood flow. Students identify the four chambers, four valves, and major vessels of the heart, trace the dual-loop (pulmonary and systemic) circulation, examine the wall-thickness asymmetry between the ventricles, and study how the atrioventricular and semilunar valves prevent backflow during the cardiac cycle.",
    "workplace": "wp_heart_anatomy",
    "start": "step_orientation",
    "actions": [
      {
        "id": "step_orientation",
        "instruction": {
          "title": "1. Gross Orientation of the Heart",
          "description": "View the intact heart (left) beside a cutaway heart (right). The apex points down and slightly left. Rotate both models to explore. Remember: the right and left sides are named from the patient's perspective, so they appear reversed from yours. Tap Next when ready."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "anim_exterior_view",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "anim_exterior_view",
              "poi": "default"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_orientation",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "intact_heart",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_orientation"
          }
        ]
      },
      {
        "id": "step_structural_tour",
        "instruction": {
          "title": "2. Guided Structural Tour",
          "description": "Follow the highlights through the cutaway heart: the four chambers (right atrium, right ventricle, left atrium, left ventricle), then the four valves (tricuspid, pulmonary, mitral/bicuspid, aortic), then the major vessels (superior & inferior vena cava, pulmonary arteries, pulmonary veins, aorta). Note the dual naming of the mitral (bicuspid) valve. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "anim_chamber_highlights",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "tricuspid_valve",
              "text": "Tricuspid Valve"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "aortic_valve",
              "text": "Aortic Valve"
            },
            {
              "target": "intact_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "vessel_aorta",
              "text": "Aorta"
            },
            {
              "target": "intact_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "vessel_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_structural_tour",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "cutaway_heart",
              "augmentation": "*"
            },
            {
              "target": "intact_heart",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_structural_tour"
          }
        ]
      },
      {
        "id": "step_dual_circuit",
        "instruction": {
          "title": "3. Dual-Circuit Color-Coded Blood Flow",
          "description": "Watch color-coded blood flow: blue = deoxygenated (right heart, pulmonary arteries, systemic veins), red = oxygenated (left heart, pulmonary veins, systemic arteries). The right side pumps blood to the lungs (pulmonary circuit); the left side pumps blood to the body (systemic circuit). Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "anim_dual_circuit_flow",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_ventricle",
              "text": "Pulmonary Circuit (to lungs)"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_ventricle",
              "text": "Systemic Circuit (to body)"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_dual_circuit",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "cutaway_heart",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_dual_circuit"
          }
        ]
      },
      {
        "id": "step_rbc_trace",
        "instruction": {
          "title": "4. Red Blood Cell Journey",
          "description": "Trace one red blood cell along the full circuit: right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary trunk & arteries \u2192 lungs (blue turns red) \u2192 pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta \u2192 body \u2192 back via the vena cava. Tap Next when the loop completes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "anim_rbc_journey",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_atrium",
              "text": "Start: Right Atrium (deoxygenated)"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_rbc_trace",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "cutaway_heart",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_rbc_trace"
          }
        ]
      },
      {
        "id": "step_wall_thickness",
        "instruction": {
          "title": "5. Ventricular Wall Thickness",
          "description": "Compare two cross-sections at the same level. The right ventricle wall is thin (~3\u20135 mm) because it pumps only to the low-pressure pulmonary circuit. The left ventricle wall is much thicker (~10\u201315 mm) because it must perfuse the entire body against high resistance \u2014 roughly a three-to-one ratio. Rotate to compare, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ventricle_cross_sections",
              "type": "predicate",
              "augmentation": "anim_ventricle_compare",
              "poi": "default"
            },
            {
              "target": "ventricle_cross_sections",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_wall",
              "text": "Right Ventricle wall ~3\u20135 mm"
            },
            {
              "target": "ventricle_cross_sections",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_wall",
              "text": "Left Ventricle wall ~10\u201315 mm"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_wall_thickness",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "ventricle_cross_sections",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_wall_thickness"
          }
        ]
      },
      {
        "id": "step_valve_function",
        "instruction": {
          "title": "6. Valve Function & Backflow Prevention",
          "description": "See each valve swap between open and closed states. Atrioventricular valves (tricuspid, mitral) prevent backflow into the atria when ventricles contract; semilunar valves (pulmonary, aortic) prevent backflow into the ventricles when they relax. During contraction, AV valves close and semilunar valves open; during relaxation, the reverse. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "anim_valve_open_close",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "tricuspid_valve",
              "text": "Tricuspid (AV valve)"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "mitral_valve",
              "text": "Mitral (AV valve)"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "pulmonary_valve",
              "text": "Pulmonary (semilunar)"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "aortic_valve",
              "text": "Aortic (semilunar)"
            },
            {
              "target": "info_panel",
              "type": "predicate",
              "augmentation": "narration_valve_function",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "cutaway_heart",
              "augmentation": "*"
            },
            {
              "target": "info_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "quiz_panel",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_valve_function"
          }
        ]
      },
      {
        "id": "step_recap",
        "instruction": {
          "title": "7. Recap & Review",
          "description": "Review the five concept areas: (1) the inventory of chambers, valves, and vessels; (2) the dual-circuit organization of pulmonary and systemic circulation; (3) the path of blood through the full loop; (4) the wall-thickness asymmetry between the ventricles; and (5) how valves prevent backflow. Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "quiz_panel",
              "type": "predicate",
              "augmentation": "img_summary",
              "poi": "default"
            },
            {
              "target": "quiz_panel",
              "type": "predicate",
              "augmentation": "narration_recap",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "quiz_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_recap"
          }
        ]
      }
    ]
  }
}