  "activity": {
    "id": "act_vsepr_walkthrough",
    "name": "Predicting Molecular Shape with VSEPR Theory",
    "description": "A linear, eight-part AR walkthrough of VSEPR theory for General Chemistry I. Students count electron domains from Lewis structures, watch domains settle into minimum-repulsion geometries, distinguish electron-domain geometry from molecular geometry, explore lone pair angular asymmetry, tour real molecules, and complete two prediction activities before a closing recap.",
    "workplace": "wp_vsepr_lab",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "instruction": {
          "title": "1. The Core Idea of VSEPR",
          "description": "Electron pairs around a central atom repel one another. A molecule adopts whatever 3D shape places its electron domains as far apart as possible. Study the flat Lewis structure of water and recall the rule: each single, double, or triple bond OR lone pair counts as one electron domain. Tap Continue when ready."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "narration_intro"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "top",
              "text": "Central Atom"
            },
            {
              "target": "lewis_panel",
              "type": "predicate",
              "augmentation": "lewis_water_image",
              "poi": "display"
            },
            {
              "target": "lewis_panel",
              "type": "predicate",
              "augmentation": "domain_count_image",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*"
            },
            {
              "target": "lewis_panel",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_intro"
          }
        ]
      },
      {
        "id": "step_repulsion",
        "instruction": {
          "title": "2. Minimum-Repulsion Principle",
          "description": "Watch two electron domains drift apart to 180\u00b0 (linear). A third domain settles into trigonal planar at 120\u00b0, and a fourth into a tetrahedron at 109.5\u00b0. Faint repulsion vectors flash between domains as they rearrange. Tap Continue to add more domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "narration_repulsion"
            },
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "anim_domains_settle",
              "poi": "center",
              "state": "linear_to_tetrahedral"
            },
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "summary_slot",
              "text": "2=Linear  3=Trigonal Planar  4=Tetrahedral"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_stage",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_repulsion"
          }
        ]
      },
      {
        "id": "step_catalog",
        "instruction": {
          "title": "3. Completing the Geometry Catalog",
          "description": "A fifth domain rearranges into trigonal bipyramidal (three equatorial at 120\u00b0, two axial at 90\u00b0), and a sixth into octahedral (all neighbors at 90\u00b0). Rotate the molecule to view from any angle, then review the summary of all five electron-domain geometries. Tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "narration_catalog"
            },
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "anim_add_5_6_domains",
              "poi": "center",
              "state": "tbp_to_octahedral"
            },
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "geometry_summary_image",
              "poi": "summary_slot"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_stage",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_catalog"
          }
        ]
      },
      {
        "id": "step_ed_vs_mol",
        "instruction": {
          "title": "4. Electron-Domain vs. Molecular Geometry",
          "description": "Starting from tetrahedral methane (CH4), watch a hydrogen become a lone pair to form ammonia (NH3, trigonal pyramidal), then a second to form water (H2O, bent). The electron-domain geometry stays tetrahedral throughout, but the molecular shape changes because lone pairs aren't part of the visible shape. Tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "narration_ed_vs_mol"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "anim_methane_to_water",
              "poi": "default",
              "state": "ch4_nh3_h2o"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "top",
              "text": "ED: Tetrahedral | Molecular: changes with lone pairs"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_ed_vs_mol"
          }
        ]
      },
      {
        "id": "step_lonepair",
        "instruction": {
          "title": "5. Lone Pair Angular Asymmetry",
          "description": "Compare methane (109.5\u00b0), ammonia (107\u00b0), and water (104.5\u00b0) side by side. Lone-pair clouds are drawn larger because a lone pair is held by only one atom, so it spreads out and compresses the bonding angles. Toggle the overlay to see the H-X-H angle shrink as lone pairs increase. Tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "comparison_table",
              "type": "predicate",
              "augmentation": "narration_lonepair"
            },
            {
              "target": "comparison_table",
              "type": "predicate",
              "augmentation": "lonepair_overlay_image",
              "poi": "display"
            },
            {
              "target": "comparison_table",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "default",
              "text": "CH4 109.5\u00b0  >  NH3 107\u00b0  >  H2O 104.5\u00b0"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "comparison_table",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lonepair"
          }
        ]
      },
      {
        "id": "step_gallery",
        "instruction": {
          "title": "6. Gallery of Real Molecules",
          "description": "Approach each molecule to see its Lewis structure beside its 3D structure: CO2 (linear), BF3 (trigonal planar), CH4 (tetrahedral), PF5 (trigonal bipyramidal), SF6 (octahedral), plus NH3 (trigonal pyramidal), H2O (bent), and XeF4 (square planar). Confirm the count of bonding domains and lone pairs. Approach the gallery marker or tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "narration_gallery"
            },
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "gallery_molecules_anim",
              "poi": "slot_2",
              "state": "all_geometries"
            },
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "slot_1",
              "text": "Linear \u00b7 Trigonal Planar \u00b7 Tetrahedral \u00b7 TBP \u00b7 Octahedral"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "molecule_gallery",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_molecule_gallery",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_gallery"
          }
        ]
      },
      {
        "id": "step_drag_challenge",
        "instruction": {
          "title": "7. Prediction Activity: Drag the Domains",
          "description": "A central atom appears with loose electron domains. Drag them into the correct arrangement \u2014 when within tolerance of the correct angles, the geometry snaps into place. Repeat for 2, 3, 4, 5, and 6 domains, then for mixed cases where one domain is a lone pair (e.g. tetrahedral position, trigonal pyramidal shape). Tap Continue when finished."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "challenge_stand",
              "type": "predicate",
              "augmentation": "drag_domains_anim",
              "poi": "work_area",
              "state": "drag_mode"
            },
            {
              "target": "challenge_stand",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "default",
              "text": "Drag domains to minimize repulsion"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "challenge_stand",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_drag_challenge"
          }
        ]
      },
      {
        "id": "step_pick_challenge",
        "instruction": {
          "title": "8. Prediction Activity: Pick the Geometry",
          "description": "A Lewis structure of an unfamiliar molecule (SF4, ClF3, BrF5, or I3-) appears with three or four candidate 3D structures. Determine the steric number and lone pair count, then select the matching geometry. The reasoning is walked through after each choice. Tap Continue to the recap."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "challenge_stand",
              "type": "predicate",
              "augmentation": "pick_options_image",
              "poi": "options_row"
            },
            {
              "target": "challenge_stand",
              "type": "predicate",
              "augmentation": "label_geometry",
              "poi": "default",
              "text": "Count domains \u2192 ED geometry \u2192 account for lone pairs \u2192 molecular geometry"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "challenge_stand",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_pick_challenge"
          }
        ]
      },
      {
        "id": "step_recap",
        "instruction": {
          "title": "9. Recap",
          "description": "Review the five concept areas covered: the minimum-repulsion principle; the five electron-domain geometries and their angles; the distinction between electron-domain and molecular geometry; lone pair angular asymmetry; and the application to real molecules. Tap Finish to end the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "narration_recap"
            },
            {
              "target": "geometry_stage",
              "type": "predicate",
              "augmentation": "recap_summary_image",
              "poi": "center"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_stage",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_recap"
          }
        ]
      }
    ]
  }
