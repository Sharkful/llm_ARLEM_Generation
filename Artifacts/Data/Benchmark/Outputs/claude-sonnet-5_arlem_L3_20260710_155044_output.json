            "id": "overtake_understood",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step5_predict_retrograde",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "heliocentric_overlook",
        "predicate": "pred_prediction_diagram",
        "instruction": {
          "title": "Predict the Next Retrograde Event",
          "description": "Using the orrery model, identify the relative positions of Earth and Mars where retrograde motion will occur (near opposition). Manipulate the orbit markers and predict when, roughly every 26 months, the next retrograde loop should begin."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "orrery_model",
              "type": "predicate",
