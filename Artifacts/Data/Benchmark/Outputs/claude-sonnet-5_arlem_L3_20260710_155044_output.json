  "activity": {
    "id": "act_retrograde_mars",
    "name": "Apparent Retrograde Motion: From Earth's Sky to the Heliocentric View",
    "description": "A guided AR lab in which students observe Mars's retrograde loop first from a simulated Earth-based night sky view, then from an external heliocentric vantage point, building an intuitive and physical understanding of why outer planets appear to reverse direction. Students compare the geocentric epicycle explanation with the heliocentric relative-motion explanation, learn to predict retrograde events, and compare Mars's loop to those of Jupiter and Saturn.",
    "language": "en",
    "workplace": "wp_retrograde_mars",
    "start": "step1_intro_sky",
    "actions": [
      {
        "id": "step1_intro_sky",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "earth_sky_station",
        "predicate": "pred_narration_intro",
        "instruction": {
          "title": "Welcome: Mars in the Night Sky",
          "description": "Stand at the star chart station. Over the coming weeks (simulated), watch how Mars normally drifts slowly eastward against the background stars. Listen to the introduction, then tap Start to begin the time-lapse."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_sky_station",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            },
            {
              "target": "earth_sky_station",
              "type": "predicate",
              "augmentation": "pred_mars_path_stars",
              "poi": "default",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "earth_sky_station",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_observe_loop",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "earth_sky_station",
        "predicate": "pred_mars_loop_animation",
        "instruction": {
          "title": "Watch the Retrograde Loop Unfold",
          "description": "Observe the animated time-lapse: Mars slows its eastward drift, reverses into a westward loop for about two months, then resumes moving eastward. Trace the full loop shape against the constellations before continuing."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_sky_station",
              "type": "predicate",
              "augmentation": "pred_mars_loop_animation",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "earth_sky_station",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "loop_watched",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "mars_globe",
            "duration": 3,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_geocentric_vs_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "heliocentric_overlook",
        "predicate": "pred_narration_geocentric",
        "instruction": {
          "title": "Two Explanations: Epicycles vs. Relative Motion",
          "description": "Move to the heliocentric overlook zone. First review the geocentric model, where Mars's loop required an awkward epicycle riding on a larger deferent. Then compare it to the heliocentric orbit animation, where the loop emerges naturally. Notice which model requires fewer assumptions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_overlook",
              "type": "predicate",
              "augmentation": "pred_narration_geocentric",
              "poi": "default"
            },
            {
              "target": "heliocentric_overlook",
              "type": "predicate",
              "augmentation": "pred_epicycle_diagram",
              "poi": "default",
              "viewport": "actions"
            },
            {
              "target": "orrery_model",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_animation",
              "poi": "sun_position"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_overlook",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "orrery_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "models_compared",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "models_compared",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_earth_overtakes_mars",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "heliocentric_overlook",
        "predicate": "pred_narration_heliocentric",
        "instruction": {
          "title": "Earth Overtakes Mars: The Passing-Car Analogy",
          "description": "Watch Earth, on its faster inner orbit, catch up to and pass the slower-moving Mars on the orrery model. Just like a car in the next lane appears to drift backward when your car passes it, Mars appears to reverse direction from our point of view. Labels highlight Earth's greater speed and Mars's slower motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "orrery_model",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_animation",
              "poi": "sun_position"
            },
            {
              "target": "earth_globe",
              "type": "predicate",
              "augmentation": "pred_label_earth_faster",
              "poi": "default",
              "text": "Earth: faster inner orbit"
            },
            {
              "target": "mars_globe",
              "type": "predicate",
              "augmentation": "pred_label_mars_slower",
              "poi": "default",
              "text": "Mars: slower outer orbit"
            },
            {
              "target": "heliocentric_overlook",
              "type": "predicate",
              "augmentation": "pred_car_passing_analogy_video",
              "poi": "wide_view"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
