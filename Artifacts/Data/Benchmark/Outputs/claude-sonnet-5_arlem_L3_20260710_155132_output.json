      {
        "id": "step5_helicase_ssb",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_replication_station",
        "predicate": "observed",
        "instruction": {
          "title": "Unwinding the Helix: Helicase and SSB Proteins",
          "description": "At the replication fork model, observe helicase unwinding the double helix, separating the two parental strands. Single-strand binding proteins (SSB) then coat the exposed single strands to prevent them from re-annealing or degrading."
        },
