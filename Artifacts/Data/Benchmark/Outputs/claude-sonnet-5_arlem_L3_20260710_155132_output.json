            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "marker_base_kit",
            "duration": 1500,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_antiparallel_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_analysis_station",
        "predicate": "explained",
        "instruction": {
          "title": "Understanding Antiparallel Strand Directionality",
          "description": "Directional arrows appear on each backbone showing 5' and 3' ends. Notice one strand runs 5' to 3' from bottom to top while its partner runs 3' to 5'. Listen to the narration explaining why this antiparallel arrangement is required for base pairing geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_anim_antiparallel_arrows",
