  "activity": {
    "id": "activity_dna_replication_lab",
    "name": "DNA Double Helix Structure and Semiconservative Replication",
    "description": "A hands-on AR lab in which students examine a 3D double helix model to identify the sugar-phosphate backbones, nitrogenous bases, and hydrogen bonds; apply complementary base-pairing rules; understand antiparallel strand orientation; and then walk through the molecular machinery of DNA replication at the replication fork, culminating in an understanding of the semiconservative mechanism.",
    "language": "en",
    "workplace": "wp_dna_replication",
    "start": "step1_intro_structure",
    "actions": [
      {
        "id": "step1_intro_structure",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_analysis_station",
        "predicate": "experienced",
        "instruction": {
          "title": "Introducing the Double Helix",
          "description": "Walk up to the analysis station and observe the 3D double helix model. Listen to the introduction describing the overall architecture of DNA: two strands winding around a common axis to form a right-handed double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_audio_intro_structure",
              "poi": "default"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_anim_helix_rotate",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "marker_helix_model",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_backbone_bases",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_analysis_station",
        "predicate": "identified",
        "instruction": {
          "title": "Identifying the Backbone and Bases",
          "description": "Labels will highlight the two sugar-phosphate backbones on the outside of the helix and the nitrogenous bases projecting inward. Rotate the model and tap each labeled component to confirm you can locate the backbone and the base-pair core."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone_left",
              "text": "Sugar-Phosphate Backbone (Strand 1)"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone_right",
              "text": "Sugar-Phosphate Backbone (Strand 2)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "backbone_confirmed",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "backbone_confirmed",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_base_pairing",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_analysis_station",
        "predicate": "practiced",
        "instruction": {
          "title": "Applying Complementary Base-Pairing Rules",
          "description": "Using the base pairing kit, place the A, T, G, and C tiles to build correct pairs. Observe the animated hydrogen bonds: adenine pairs with thymine via two hydrogen bonds, guanine pairs with cytosine via three. Reference the base-pairing chart, then confirm you can predict a complementary sequence."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_anim_hbond_at",
              "poi": "poi_basepair_at"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_anim_hbond_gc",
              "poi": "poi_basepair_gc"
            },
            {
              "target": "thing_base_kit",
              "type": "predicate",
              "augmentation": "pred_image_basepair_chart",
              "poi": "default",
              "viewport": "reactions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "thing_base_kit",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
