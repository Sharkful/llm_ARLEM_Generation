  "activity": {
    "id": "activity_heart_anatomy_circulation",
    "name": "Heart Anatomy and Blood Flow AR Lab",
    "description": "A guided AR training session in which nursing, kinesiology, and pre-health students explore a life-size 3D heart model to identify the four chambers, four valves, and major vessels, then trace the dual-loop circulation (pulmonary and systemic) and compare right vs. left ventricular wall thickness.",
    "language": "en",
    "workplace": "workplace_heart_anatomy",
    "start": "step1_identify_chambers",
    "actions": [
      {
        "id": "step1_identify_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_heart_station",
        "predicate": "pred_audio_narration_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Look at the 3D heart model on the table. Labels will appear identifying the right atrium, right ventricle, left atrium, and left ventricle. Walk around the model to view each chamber from different angles, then click Next when you can name all four."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_right_atrium",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_right_ventricle",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_left_atrium",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_left_ventricle",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_identify_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_heart_station",
        "predicate": "pred_audio_narration_valves",
        "instruction": {
          "title": "Locate the Four Heart Valves",
          "description": "The removable valve set on the tray corresponds to the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Labels now appear on the heart model at each valve location. An animation shows each valve opening and closing to prevent backflow. Tap a valve label to hear its function, then proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_tricuspid",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_pulmonary_valve",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_mitral",
              "poi": "poi_mitral_valve",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_aortic_valve",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve"
            },
            {
              "target": "thing_valve_tray",
              "type": "predicate",
              "augmentation": "pred_anim_valve_cycle",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "thing_valve_tray",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_identify_vessels",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_heart_station",
        "instruction": {
          "title": "Identify the Major Vessels",
          "description": "Reference the vessel chart beside the model. Labels appear on the heart model marking the superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Note which vessels carry blood into versus out of the heart. Click Next once you can name each vessel and its connection point."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_svc",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_ivc",
              "poi": "poi_ivc",
              "text": "Inferior Vena Cava"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_pulmonary_artery",
              "poi": "poi_pulmonary_artery",
              "text": "Pulmonary Artery"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_pulmonary_vein",
              "poi": "poi_pulmonary_vein",
              "text": "Pulmonary Vein"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_label_aorta",
              "poi": "poi_aorta",
              "text": "Aorta"
            },
            {
              "target": "thing_vessel_chart",
              "type": "predicate",
              "augmentation": "pred_img_wall_thickness_diagram",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "thing_vessel_chart",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_trace_circulation",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens_1",
        "location": "place_heart_station",
        "predicate": "pred_audio_narration_circulation",
        "instruction": {
          "title": "Trace the Dual-Loop Circulation",
          "description": "Watch the animated blood flow: deoxygenated blood (shown in blue) enters the right atrium from the SVC/IVC, flows through the tricuspid valve into the right ventricle, then through the pulmonary valve to the lungs. Oxygenated blood (shown in red) returns via the pulmonary veins to the left atrium, through the mitral valve into the left ventricle, and out the aortic valve through the aorta. Follow the full cycle twice, then say 'continue' to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_anim_deoxy_blood_flow",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_anim_oxy_blood_flow",
              "poi": "default"
            },
            {
              "target": "place_review_station",
              "type": "predicate",
              "augmentation": "pred_video_cardiac_cycle",
              "poi": "default",
              "viewport": "reactions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "*"
