            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_launch_projectile",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "projectile_range",
        "predicate": "launched",
        "instruction": {
          "title": "Launching a Projectile",
          "description": "Move to the Projectile Launch Range. The launcher's initial velocity vector v0 is decomposed into a horizontal component vx and a vertical component vy, just like you did on the workbench. Adjust the launch angle and speed using the parameter panel, then trigger the launcher to fire the projectile."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "pred_component_lines",
              "poi": "muzzle"
            },
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "pred_angle_arc_label",
              "text": "launch angle"
            },
            {
