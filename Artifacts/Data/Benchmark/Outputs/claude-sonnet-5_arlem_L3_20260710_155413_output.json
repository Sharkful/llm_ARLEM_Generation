        },
        "triggers": [
          {
            "mode": "sensor",
            "id": "launcher_sensor",
            "type": "tangible",
            "key": "fired",
            "value": "true",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step5_independence_of_motion",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens1",
        "location": "projectile_range",
        "predicate": "observed",
        "instruction": {
          "title": "Independence of Horizontal and Vertical Motion",
          "description": "Watch the projectile fly. Notice the horizontal velocity arrow (vx) stays constant in length throughout the flight, while the vertical velocity arrow (vy) shrinks to zero at the peak and then grows in the opposite direction during descent. This shows gravity acts only vertically, so horizontal and vertical motions are independent. Click Continue when the projectile lands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "pred_projectile_trail",
              "poi": "default"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "pred_velocity_vectors_live",
              "poi": "default"
            },
            {
              "target": "trajectory_screen",
