  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion",
    "description": "A hands-on AR lab where students first explore vector addition and decomposition as abstract mathematical objects, then apply these skills to analyze and manipulate the trajectory of a projectile launched at an arbitrary angle.",
    "language": "en",
    "workplace": "wp_vectors_projectile",
    "start": "step1_intro_vectors",
    "actions": [
      {
        "id": "step1_intro_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "vector_workbench",
        "predicate": "launched",
        "instruction": {
          "title": "Introducing Vectors",
          "description": "Two arrows, Vector A and Vector B, appear on the workbench. Each represents a displacement with both magnitude and direction. Observe their lengths (magnitude) and orientations (direction). Say 'next' or click Continue when ready to add them together."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "pred_vector_arrow",
              "poi": "default"
            },
            {
              "target": "vector_b",
              "type": "predicate",
              "augmentation": "pred_vector_arrow",
              "poi": "default"
            },
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "tip",
              "text": "|A| = 25 units"
            },
            {
              "target": "vector_b",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "tip",
              "text": "|B| = 22 units"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_tip_to_tail",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "vector_workbench",
        "predicate": "demonstrated",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Watch as Vector B slides so its tail touches the tip of Vector A. The resultant vector R is drawn from the tail of A to the tip of B. This is the tip-to-tail method of graphical vector addition. Click Continue when you understand the resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_b",
              "type": "predicate",
              "augmentation": "pred_tip_to_tail",
              "poi": "tip"
            },
            {
              "target": "resultant_vector",
              "type": "predicate",
              "augmentation": "pred_vector_arrow",
              "poi": "default"
            },
            {
              "target": "resultant_vector",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "text": "R = A + B"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "vector_b",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue1",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_decompose_components",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "vector_workbench",
        "predicate": "decomposed",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "The resultant vector R is now decomposed into a horizontal component Rx and a vertical component Ry, forming a right triangle. Use trigonometry: Rx = R cos(theta), Ry = R sin(theta). Observe the projection lines dropping to each axis. Click Continue to reconstruct R from its components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "resultant_vector",
              "type": "predicate",
              "augmentation": "pred_component_lines",
              "poi": "default"
            },
            {
              "target": "resultant_vector",
              "type": "predicate",
              "augmentation": "pred_angle_arc_label",
              "text": "theta"
            },
            {
              "target": "resultant_vector",
              "type": "predicate",
              "augmentation": "pred_trig_formula"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
