            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_lone_pair_effect",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens_device",
        "location": "reference_zone",
        "predicate": "observed",
        "instruction": {
          "title": "Lone Pairs Reshape the Molecule",
          "description": "Lone pairs occupy more angular space than bonding pairs because they are held closer to the central atom by only one nucleus, spreading out more. Replace a bonding domain with a lone pair on the tetrahedral kit and observe the molecular geometry change from tetrahedral to trigonal pyramidal (NH3-like) or bent (H2O-like), with bond angles compressed below the ideal 109.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lone_pair_indicator",
              "type": "predicate",
              "augmentation": "pred_lone_pair_cloud",
              "poi": "default"
            },
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "pred_bond_angle_label",
              "poi": "domain_label_spot",
              "text": "104.5\u00b0 (H2O) vs 109.5\u00b0 (CH4 ideal)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "electron_domain_kit",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "lone_pair_indicator",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
