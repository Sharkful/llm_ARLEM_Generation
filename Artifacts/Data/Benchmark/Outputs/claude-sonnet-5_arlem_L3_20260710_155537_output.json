        "viewport": "actions",
        "type": "actions",
        "device": "hololens_device",
        "location": "reference_zone",
        "predicate": "reviewed",
        "instruction": {
          "title": "Explore the Five Fundamental Geometries",
          "description": "Step through each fundamental electron-domain geometry: linear, trigonal planar, tetrahedral, trigonal bipyramidal, and octahedral. For each, note how lone pairs produce the derived molecular shapes: bent, trigonal pyramidal, seesaw, T-shaped, square planar, and square pyramidal."
        },
        "enter": {
