  "activity": {
    "id": "vsepr_activity",
    "name": "VSEPR Theory: Predicting Molecular Geometry",
    "description": "An AR lab guiding students from a Lewis structure through steric number determination, electron-domain geometry, lone-pair effects on molecular shape, and comparison with real molecules (H2O, NH3, CH4, PF5, SF6, XeF4).",
    "language": "en",
    "workplace": "vsepr_workplace",
    "start": "step1_lewis_intro",
    "actions": [
      {
        "id": "step1_lewis_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_device",
        "location": "reference_zone",
        "predicate": "launched",
        "instruction": {
          "title": "Start with the Lewis Structure",
          "description": "Examine the Lewis structure card. Identify the central atom, count the bonding pairs (shared electron pairs forming bonds) and any lone pairs (unshared electron pairs) on that central atom. This count is the foundation for VSEPR analysis."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lewis_structure_card",
              "type": "predicate",
              "augmentation": "pred_lewis_highlight",
              "poi": "default"
            },
            {
              "target": "lewis_structure_card",
              "type": "predicate",
              "augmentation": "pred_geometry_narration",
              "poi": "above_card"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_structure_card",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_steric_number",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_device",
        "location": "reference_zone",
        "predicate": "counted",
        "instruction": {
          "title": "Determine the Steric Number",
          "description": "Add the number of bonding pairs to the number of lone pairs on the central atom to get the steric number. This value (2 through 6) determines which of the five fundamental electron-domain geometries applies."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lewis_structure_card",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "above_card",
              "text": "Steric Number = Bonding Pairs + Lone Pairs"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_structure_card",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "domain_kit1",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_electron_domain_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_device",
        "location": "reference_zone",
        "predicate": "manipulated",
        "instruction": {
          "title": "Watch Electron Domains Minimize Repulsion",
          "description": "Manipulate the domain spheres on the electron-domain kit. Watch as the domains push apart and settle into the arrangement that minimizes mutual repulsion: linear (2), trigonal planar (3), tetrahedral (4), trigonal bipyramidal (5), or octahedral (6) electron-domain geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "pred_domain_repulsion_anim",
              "poi": "center_atom"
            },
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "pred_tetrahedral_geometry",
              "poi": "domain_label_spot"
            },
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "pred_geometry_narration",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
