        "viewport": "reactions",
        "type": "reactions",
        "device": "dev_hololens",
        "location": "place_orbit_table",
        "predicate": "observed",
        "instruction": {
          "title": "Linking the Two Perspectives",
          "description": "A side-by-side view shows the heliocentric model and Earth's night sky together. A line drawn from Earth through Mars extends to the background stars. Watch it sweep eastward during normal motion, then reverse and sweep westward as Earth overtakes Mars \u2014 exactly when Mars retraces its path in the night sky. This retrograde loop is a real apparent motion produced by geometry, not an illusion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_sightline_pointer",
              "type": "predicate",
