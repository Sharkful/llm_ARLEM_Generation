  "activity": {
    "id": "act_retrograde_motion_lab",
    "name": "Apparent Retrograde Motion of Mars: From Earth-Sky to Heliocentric Geometry",
    "description": "A seven-step AR lab guiding students from a naked-eye observation of Mars's retrograde loop, through the geocentric epicycle explanation, to the heliocentric resolution, an embodied overtaking activity, a comparison across outer planets, a prediction challenge, and a closing recap.",
    "language": "en",
    "workplace": "wp_retrograde_motion",
    "start": "step1_night_sky",
    "actions": [
      {
        "id": "step1_night_sky",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_night_sky",
        "predicate": "observed",
        "instruction": {
          "title": "The Puzzle: Mars Moves Backward",
          "description": "Stand under the virtual night sky and watch the constellations of the ecliptic (Leo, Virgo, Libra, Scorpio) appear around you. Mars glows as a red point among the stars. Watch as time fast-forwards through six months: Mars drifts eastward, slows, loops westward for about two months, then resumes eastward motion. A trail marks its complete path. Why would a planet ever move backward?"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_constellation_labels",
              "poi": "poi_ecliptic_band"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_trail_anim",
              "poi": "default"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_night_sky",
              "type": "*"
            },
            {
              "target": "thing_mars",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_orbit_table",
        "predicate": "observed",
        "instruction": {
          "title": "The Geocentric Explanation: Epicycles and Deferents",
          "description": "Earth sits at the center. Mars rides a small circle (the epicycle) which itself rides a larger circle (the deferent) around Earth. Watch the machinery run: when Mars is on the inner part of its epicycle, closest to Earth, its combined motion produces the observed backward loop. Notice how finely the epicycle size, deferent size, and speeds must be tuned for this to work."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_epicycle_apparatus",
              "type": "predicate",
              "augmentation": "pred_epicycle_anim",
              "poi": "default"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "pred_narration_geocentric",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_epicycle_apparatus",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "step2_geocentric",
            "duration": 4000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_orbit_table",
        "predicate": "observed",
        "instruction": {
          "title": "The Heliocentric View: Earth Overtakes Mars",
          "description": "Rise above the ecliptic plane to view the solar system from outside. The Sun sits at the center; Earth orbits at 1 AU in one year, Mars at 1.52 AU in 1.88 years. Watch Earth catch up to and overtake Mars roughly every 26 months. The same retrograde event from the opening scene replays here \u2014 but now no epicycles are needed. Just two smooth ellipses."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_earth_model",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_anim",
              "poi": "poi_earth_orbit_path"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_anim",
              "poi": "poi_mars_orbit_path"
            },
            {
              "target": "learner_01",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
