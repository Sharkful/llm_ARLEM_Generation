  "activity": {
    "id": "dna_structure_replication_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An AR lab guiding students through the three-dimensional structure of DNA and the mechanism of semiconservative replication, from schematic base-pairing through the fully assembled replication fork and the Meselson-Stahl-style prediction activity.",
    "language": "en",
    "workplace": "dna_replication_workplace",
    "start": "step1_schematic_ladder",
    "actions": [
      {
        "id": "step1_schematic_ladder",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens2",
        "location": "ladder_station",
        "predicate": "narration_intro_ladder",
        "instruction": {
          "title": "The DNA Ladder: Backbones and Bases",
          "description": "Observe the schematic ladder model. Two vertical lines represent the sugar-phosphate backbones; the colored rungs are base pairs (adenine=red, thymine=blue, guanine=yellow, cytosine=green). Narration introduces DNA as a repeating polymer with bases projecting inward."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ladder_model",
              "type": "predicate",
              "augmentation": "ladder_anim",
              "poi": "default"
            },
            {
              "target": "ladder_station",
              "type": "predicate",
              "augmentation": "narration_intro_ladder",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "ladder_station",
              "type": "*",
              "viewport": "actions"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "marker_ladder",
            "duration": 3000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_helix_twist",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens2",
        "location": "helix_station",
        "predicate": "narration_helix_twist",
        "instruction": {
          "title": "From Ladder to Helix",
          "description": "Watch the ladder twist into the realistic double-helix shape. Toggle between the schematic ladder and the helix to build the mental mapping between the two views. Note that one full turn spans approximately ten base pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "helix_anim",
              "poi": "default"
            },
            {
              "target": "helix_station",
              "type": "predicate",
              "augmentation": "narration_helix_twist",
              "viewport": "actions"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "toggle_label",
              "poi": "default",
              "text": "Toggle: Ladder / Helix"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "helix_station",
              "type": "*",
              "viewport": "actions"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "toggle_view",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start_replication",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_antiparallel_direction",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens2",
        "location": "helix_station",
        "predicate": "narration_antiparallel",
        "instruction": {
          "title": "Antiparallel Strands: 5' to 3'",
          "description": "Arrows along each backbone show opposite directions. Labels mark the 5' and 3' termini of each strand. Rotate the helix and confirm the antiparallel arrangement from any angle - this is forced by the directional chemistry of the backbone."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "direction_arrows_anim",
              "poi": "default"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "terminus_5prime_label",
              "poi": "top_terminus",
              "text": "5' end"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "terminus_3prime_label",
              "poi": "bottom_terminus",
              "text": "3' end"
            },
            {
              "target": "helix_station",
              "type": "predicate",
              "augmentation": "narration_antiparallel",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "helix_station",
              "type": "*",
              "viewport": "actions"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "confirmed_rotation",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "marker_pairing",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_base_pairing_activity",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens2",
        "location": "pairing_station",
        "predicate": "narration_base_pairing",
        "instruction": {
          "title": "Complete the Complementary Strand",
          "description": "Drag bases from the palette (A, T, G, C) to complete the complementary sequence opposite the template strand 5'-ATGCCAGT-3'. Correct pairs snap into place with hydrogen bonds shown as dashed lines: two lines for A-T, three for G-C."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "base_palette",
              "type": "predicate",
              "augmentation": "hbond_AT_anim",
              "poi": "slot_A"
            },
