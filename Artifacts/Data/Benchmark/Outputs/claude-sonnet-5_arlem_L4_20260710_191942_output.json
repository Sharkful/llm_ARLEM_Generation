  "activity": {
    "id": "heart_anatomy_activity",
    "name": "Heart Anatomy and Blood Flow AR Lab",
    "description": "A step-by-step AR training activity guiding nursing, kinesiology, and pre-health students through the structural anatomy of the human heart and the dual-circuit path of blood flow, culminating in interactive quizzes on structure identification and circulation tracing.",
    "language": "en",
    "workplace": "heart_anatomy_workplace",
    "start": "step1_orientation",
    "actions": [
      {
        "id": "step1_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "exterior_station",
        "predicate": "narration_intro",
        "instruction": {
          "title": "Heart Orientation Overview",
          "description": "A full-size human heart appears in anatomical position, apex pointing down and slightly left. An intact exterior copy sits beside a cutaway copy. Rotate both models together to explore the exterior landmarks and understand that the heart's right and left sides are labeled from the patient's perspective, not the viewer's."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "intact_heart_model",
              "type": "predicate",
              "augmentation": "narration_intro",
              "poi": "default"
            },
            {
              "target": "cutaway_heart_model",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/animations/heart_idle_rotate.glb"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "intact_heart_model",
              "type": "predicate",
              "augmentation": "narration_intro"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_structural_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "cutaway_station",
        "predicate": "narration_structural_tour",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Follow the highlighted labels in sequence: four chambers (right atrium, right ventricle, left atrium, left ventricle), four valves (tricuspid, pulmonary, mitral/bicuspid, aortic), then major vessels (superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, aorta). Note how each interior structure maps to the exterior landmarks on the intact heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_ra",
              "poi": "ra_poi",
              "text": "Right Atrium"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_rv",
              "poi": "rv_poi",
              "text": "Right Ventricle"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_la",
              "poi": "la_poi",
              "text": "Left Atrium"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_lv",
              "poi": "lv_poi",
              "text": "Left Ventricle"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_valve_tricuspid",
              "poi": "tricuspid_poi",
              "text": "Tricuspid Valve"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_valve_pulmonary",
              "poi": "pulmonary_valve_poi",
              "text": "Pulmonary Valve"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_valve_mitral",
              "poi": "mitral_poi",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "cutaway_heart_model",
              "type": "predicate",
              "augmentation": "label_valve_aortic",
              "poi": "aortic_valve_poi",
              "text": "Aortic Valve"
            },
            {
              "target": "intact_heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_svc",
