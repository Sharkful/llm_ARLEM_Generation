        "device": "hololens_1",
        "location": "vector_workspace",
        "predicate": "narration_intro_vectors",
        "instruction": {
          "title": "What Is a Vector?",
          "description": "A single arrow floats before you, tail fixed at the origin. Grab its head and drag it around to see the magnitude and direction labels update. Notice that rotating your own viewpoint does not change the arrow itself."
        },
        "enter": {
          "remove_self": false,
          "activates": [
