  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion: From Abstract Arrows to Flight",
    "description": "An AR lab guiding students from the foundational concept of vectors (magnitude, direction, addition, decomposition) through to their application in analyzing two-dimensional projectile motion, culminating in a targeting challenge and a free-exploration sandbox.",
    "language": "en",
    "workplace": "wp_vectors_projectile",
    "start": "step1_vector_intro",
    "actions": [
