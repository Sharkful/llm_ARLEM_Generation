      {
        "id": "electron_vs_molecular_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "central_workstation",
        "predicate": "observed",
        "instruction": {
          "title": "Electron-Domain vs. Molecular Geometry",
          "description": "The tetrahedral arrangement returns with four bonding domains, representing methane (CH4): electron-domain geometry and molecular geometry are both tetrahedral. Watch as a hydrogen is replaced by a lone pair, forming ammonia (NH3) \u2014 the electron-domain geometry stays tetrahedral, but the molecular geometry becomes trigonal pyramidal. A second hydrogen is replaced with a lone pair, forming water (H2O), and the molecular geometry becomes bent."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "methane_ammonia_water_set",
              "type": "predicate",
              "augmentation": "anim_lone_pair_swap",
