  "activity": {
    "id": "vsepr_activity",
    "name": "VSEPR Theory: Predicting Molecular Geometry",
    "description": "A hands-on AR lab guiding students from Lewis structures through VSEPR's minimum-repulsion principle to the five electron-domain geometries, the electron-domain vs. molecular geometry distinction, lone pair angular asymmetry, and real-molecule application, culminating in two interactive prediction challenges and a recap.",
    "language": "en",
    "workplace": "vsepr_workplace",
    "start": "intro_setup",
    "actions": [
      {
        "id": "intro_setup",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "central_workstation",
        "predicate": "launched",
        "instruction": {
          "title": "Introducing VSEPR Theory",
          "description": "A central atom appears before you. VSEPR theory states that bonding pairs and lone pairs around a central atom repel one another, and the molecule adopts the geometry that places these electron domains as far apart as possible. Review the flat Lewis structure of water on the reference table and recall that each single, double, or triple bond, and each lone pair, counts as one electron domain."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Central Atom"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_intro"
            },
            {
              "target": "lewis_water_diagram",
              "type": "predicate",
              "augmentation": "img_repulsion_vectors",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_water_diagram",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "minimum_repulsion_demo",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "central_workstation",
        "predicate": "observed",
        "instruction": {
          "title": "The Minimum-Repulsion Principle",
          "description": "Watch as two electron domains repel each other and settle 180 degrees apart, forming a linear arrangement. A third domain is added, rearranging into trigonal planar at 120 degrees. A fourth domain produces a tetrahedron at 109.5 degrees. Faint repulsion vectors appear during each rearrangement and fade as the geometry stabilizes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "anim_domains_repel",
              "poi": "default",
              "state": "two_domains_linear"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_repulsion"
            },
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "img_repulsion_vectors",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "img_repulsion_vectors"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue1",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "domain_kit_marker",
            "duration": 3,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "five_geometries_catalog",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "central_workstation",
        "predicate": "observed",
        "instruction": {
          "title": "Completing the Geometry Catalog",
          "description": "A fifth domain is added, rearranging the tetrahedron into a trigonal bipyramidal shape with three equatorial domains at 120 degrees and two axial domains at 90 degrees. A sixth domain produces an octahedral arrangement with all neighbors at 90 degrees. Rotate the molecule to view it from any angle, then review the summary panel showing all five electron-domain geometries with their domain counts and angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "electron_domain_kit",
              "type": "predicate",
              "augmentation": "anim_trigonal_bipyramidal_form",
              "poi": "default"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_five_geometries"
            },
            {
              "target": "geometry_summary_panel",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Linear(2,180) Trigonal Planar(3,120) Tetrahedral(4,109.5) Trig. Bipyramidal(5,90/120) Octahedral(6,90)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
