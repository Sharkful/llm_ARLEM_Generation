  "activity": {
    "id": "act_retrograde_motion_lab",
    "name": "Why Does Mars Move Backward? Exploring Apparent Retrograde Motion",
    "description": "A guided AR investigation in which students first observe Mars's apparent retrograde loop against the background stars from an Earth-based viewpoint, then move to an external heliocentric viewpoint to see how the loop naturally results from Earth overtaking Mars on their respective orbits. Students then compare the geocentric epicycle explanation with the heliocentric explanation, practice predicting when retrograde motion will occur, and finally compare Mars's loop to the smaller loops of Jupiter and Saturn.",
    "workplace": "wp_retrograde_motion",
    "start": "step1_earth_sky_view",
    "actions": [
      {
        "id": "step1_earth_sky_view",
        "instruction": {
          "title": "Watch Mars from Earth",
          "description": "Look at the star field marker representing the night sky. Over the simulated weeks, observe Mars normally drifting eastward against the background stars, then slowing, reversing into a westward loop for about two months, and finally resuming its eastward motion. Note the constellations Mars passes through."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_earth_view",
              "type": "predicate",
              "augmentation": "pred_star_background_image",
              "poi": "default"
            },
            {
              "target": "place_earth_view",
              "type": "predicate",
              "augmentation": "pred_mars_sky_path_animation",
              "poi": "poi_zenith"
            },
            {
              "target": "place_earth_view",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_earth_view",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_action_button"
          },
          {
            "mode": "detect",
            "id": "marker_solar_system_mat",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step2_heliocentric_view",
        "instruction": {
          "title": "Switch to the Outside View",
          "description": "Now view the same time period from a vantage point outside the solar system. Watch Earth on its smaller, faster orbit and Mars on its larger, slower orbit around the Sun. Notice the moment when Earth 'overtakes' Mars on the inside track."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_view",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_animation",
              "poi": "default"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_earth_label",
              "poi": "poi_label_anchor",
              "text": "Earth (faster, inner orbit)"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_label",
              "poi": "poi_label_anchor",
              "text": "Mars (slower, outer orbit)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_view",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_action_button"
          },
          {
            "mode": "detect",
            "id": "marker_mars_model",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step3_overtake_analogy",
        "instruction": {
          "title": "The Passing-Car Analogy",
          "description": "Watch the short video comparing Earth overtaking Mars to a car passing a slower car in the next lane on a highway. Notice how the slower car briefly appears to drift backward relative to the distant scenery, exactly as Mars appears to drift backward relative to the distant stars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_view",
              "type": "predicate",
              "augmentation": "pred_overtake_car_analogy_video",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_view",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_action_button"
          }
        ]
      },
      {
        "id": "step4_geocentric_vs_heliocentric",
        "instruction": {
          "title": "Epicycles vs. Elegant Orbits",
          "description": "Compare the geocentric model's diagram, which requires an awkward epicycle loop bolted onto Mars's path to explain the retrograde motion, with the heliocentric diagram, where the loop emerges naturally from Earth and Mars simply orbiting the Sun at different speeds. Consider which model is more parsimonious."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_geocentric_epicycle_image",
              "poi": "poi_label_anchor"
            },
            {
              "target": "place_solar_system_view",
              "type": "predicate",
              "augmentation": "pred_heliocentric_diagram_image",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_solar_system_view",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_action_button"
          }
        ]
      },
      {
        "id": "step5_predict_retrograde",
        "instruction": {
          "title": "Predict the Next Retrograde Loop",
          "description": "Using the orbital position animation, practice predicting when the next retrograde episode for Mars will occur based on the relative positions of Earth and Mars in their orbits. Recall that this cycle repeats roughly every 26 months."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_view",
              "type": "predicate",
              "augmentation": "pred_retrograde_prediction_animation",
              "poi": "poi_mars_orbit"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_orbit_speed_label",
              "poi": "poi_label_anchor",
              "text": "Earth: ~365 days/orbit"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_orbit_speed_label",
              "poi": "poi_label_anchor",
              "text": "Mars: ~687 days/orbit"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_view",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_action_button"
          }
        ]
      },
      {
        "id": "step6_compare_outer_planets",
        "instruction": {
          "title": "Compare Mars, Jupiter, and Saturn",
          "description": "Examine the comparison panel showing the apparent retrograde loops of Mars, Jupiter, and Saturn side by side. Notice that Jupiter's and Saturn's loops are smaller than Mars's loop because they are farther from the Sun, making the relative-motion effect from Earth's overtaking less pronounced."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_outer_planets_panel",
              "type": "predicate",
              "augmentation": "pred_jupiter_saturn_loop_image",
              "poi": "default"
            },
            {
              "target": "thing_outer_planets_panel",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "poi_jupiter_slot"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_outer_planets_panel",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab_button"
          }
        ]
      }
    ]
  }
