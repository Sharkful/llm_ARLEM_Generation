  "activity": {
    "id": "activity_dna_structure_replication",
    "name": "DNA Double Helix Structure and Semiconservative Replication",
    "description": "A six-step AR lab guiding students from the three-dimensional structure of the DNA double helix through complementary base pairing, antiparallel strand orientation, and the enzymatic mechanism of semiconservative DNA replication.",
    "workplace": "wp_dna_replication",
    "start": "step1_intro_helix",
    "actions": [
      {
        "id": "step1_intro_helix",
        "instruction": {
          "title": "The Double Helix",
          "description": "Point your device at the DNA helix model. Observe the two sugar-phosphate backbones spiraling around a common central axis, forming the iconic double helix shape. Tap 'Next' or wait for detection to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "anim_helix_spin",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "audio_narration_structure",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand1",
              "text": "Sugar-Phosphate Backbone (Strand 1)"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand2",
              "text": "Sugar-Phosphate Backbone (Strand 2)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_next1"
          },
          {
            "mode": "detect",
            "id": "marker_helix_model",
            "duration": 3
          }
        ]
      },
      {
        "id": "step2_base_pairing",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Move to the base pair model station. The four nitrogenous bases\u2014adenine, thymine, guanine, and cytosine\u2014project inward from the backbones. Adenine pairs with thymine via two hydrogen bonds; guanine pairs with cytosine via three hydrogen bonds. Examine both pairings closely."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "base_pair_model",
              "type": "predicate",
              "augmentation": "img_hydrogen_bonds_at",
              "poi": "at_pair_site"
            },
            {
              "target": "base_pair_model",
              "type": "predicate",
              "augmentation": "img_hydrogen_bonds_gc",
              "poi": "gc_pair_site"
            },
            {
              "target": "base_pair_model",
              "type": "predicate",
              "augmentation": "label_base_names",
              "poi": "at_pair_site",
              "text": "Adenine - Thymine (2 H-bonds)"
            },
            {
              "target": "base_pair_model",
              "type": "predicate",
              "augmentation": "label_base_names",
              "poi": "gc_pair_site",
              "text": "Guanine - Cytosine (3 H-bonds)"
            },
            {
              "target": "base_pair_model",
              "type": "predicate",
              "augmentation": "audio_narration_basepairing",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "base_pair_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_next2"
          },
          {
            "mode": "detect",
            "id": "marker_basepair_station",
            "duration": 3
          }
        ]
      },
      {
        "id": "step3_antiparallel_orientation",
        "instruction": {
          "title": "Antiparallel Strand Orientation",
          "description": "Return to the DNA helix model. Notice the directional arrows along each backbone: one strand runs 5' to 3' while its complementary strand runs 3' to 5' in the opposite direction. This antiparallel arrangement is essential to the helix's structure and to how replication proceeds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "anim_antiparallel_flow",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand1",
              "text": "5' to 3' Direction"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand2",
              "text": "3' to 5' Direction"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_next3"
          }
        ]
      },
      {
        "id": "step4_replication_fork_unwinding",
        "instruction": {
          "title": "Opening the Replication Fork",
          "description": "Move to the replication fork station. Helicase unwinds the double helix at the replication fork, separating the two parental strands. Single-strand binding proteins then coat the exposed single strands to prevent them from re-annealing or degrading."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_helicase_unwind",
              "poi": "helicase_site"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "label_enzyme_name",
              "poi": "helicase_site",
              "text": "Helicase"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "audio_narration_replication",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_helicase_unwind"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_next4"
          },
          {
            "mode": "detect",
            "id": "marker_fork_station",
            "duration": 3
          }
        ]
      },
      {
        "id": "step5_leading_lagging_strands",
        "instruction": {
          "title": "Leading and Lagging Strand Synthesis",
          "description": "DNA polymerase synthesizes new DNA only in the 5' to 3' direction. On one template strand, synthesis is continuous, forming the leading strand. On the other template, synthesis must occur discontinuously in short Okazaki fragments, forming the lagging strand. DNA ligase later joins these fragments together."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_polymerase_synthesis",
              "poi": "leading_strand_site"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "label_enzyme_name",
              "poi": "leading_strand_site",
              "text": "Leading Strand (Continuous Synthesis)"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_okazaki_ligation",
              "poi": "lagging_strand_site"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "label_enzyme_name",
              "poi": "lagging_strand_site",
              "text": "Lagging Strand (Okazaki Fragments + Ligase)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_next5"
          }
        ]
      },
      {
        "id": "step6_semiconservative_summary",
        "instruction": {
          "title": "Semiconservative Replication Summary",
          "description": "Watch the summary video at the replication zone. Each resulting daughter DNA molecule contains one original parental strand and one newly synthesized strand\u2014this is why replication is called semiconservative. Consider how this pattern would appear after a second round of replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_zone",
              "type": "predicate",
              "augmentation": "video_semiconservative_summary",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "end_lab"
          }
        ]
      }
    ]
  }
}