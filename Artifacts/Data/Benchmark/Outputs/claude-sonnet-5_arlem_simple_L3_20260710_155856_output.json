  "activity": {
    "id": "activity_heart_bloodflow",
    "name": "Structural Anatomy and Blood Flow of the Human Heart",
    "description": "A guided AR lab in which students explore a 3D heart model to identify the four chambers, four valves, and major vessels, then trace the dual-loop path of blood through the pulmonary and systemic circuits, and finally compare ventricular wall thickness to understand the pressure demands of each circuit.",
    "workplace": "wp_heart_anatomy",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "instruction": {
          "title": "Welcome to the Heart Lab",
          "description": "Point your device at the heart model marker to begin. You will identify the heart's chambers, valves, and vessels, then trace blood flow through the pulmonary and systemic circuits."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/images/heart_overview_diagram.png"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_audio_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start"
          },
          {
            "mode": "detect",
            "id": "det_heart_model_marker",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step_identify_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Observe the labels appearing on the heart model. Locate the right atrium, right ventricle, left atrium, and left ventricle. Note their relative positions and sizes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_audio_narration_chambers",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "chambers_confirmed"
          }
        ]
      },
      {
        "id": "step_identify_valves_vessels",
        "instruction": {
          "title": "Identify the Four Valves and Major Vessels",
          "description": "Examine the tricuspid, pulmonary, mitral, and aortic valves on the heart model, then look at the vessel tray to identify the superior and inferior vena cava, pulmonary arteries and veins, and the aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_tricuspid_valve",
              "text": "Tricuspid Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_mitral_valve",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve"
            },
            {
              "target": "major_vessels_tray",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "major_vessels_tray",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_ivc",
              "text": "Inferior Vena Cava"
            },
            {
              "target": "major_vessels_tray",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_pulmonary_artery",
              "text": "Pulmonary Artery"
            },
            {
              "target": "major_vessels_tray",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_pulmonary_vein",
              "text": "Pulmonary Vein"
            },
            {
              "target": "major_vessels_tray",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_aorta",
              "text": "Aorta"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_audio_narration_valves",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "major_vessels_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "valves_vessels_confirmed"
          },
          {
            "mode": "detect",
            "id": "det_vessel_tray_marker",
            "duration": 1500
          }
        ]
      },
      {
        "id": "step_trace_pulmonary_circuit",
        "instruction": {
          "title": "Trace the Pulmonary Circuit (Right Heart)",
          "description": "Watch the animation showing deoxygenated blood entering the right atrium from the vena cavae, passing through the tricuspid valve into the right ventricle, then through the pulmonary valve and pulmonary arteries to the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "right_heart_station",
              "type": "predicate",
              "augmentation": "pred_anim_blood_flow_pulmonary",
              "poi": "default"
            },
            {
              "target": "right_heart_station",
              "type": "predicate",
              "augmentation": "pred_anim_valve_open_close",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_audio_narration_circulation",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "right_heart_station",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_right_side_marker",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "pulmonary_traced"
          }
        ]
      },
      {
        "id": "step_trace_systemic_circuit",
        "instruction": {
          "title": "Trace the Systemic Circuit (Left Heart)",
          "description": "Watch the animation showing oxygenated blood returning via the pulmonary veins to the left atrium, passing through the mitral valve into the left ventricle, then through the aortic valve and aorta out to the entire body."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "left_heart_station",
              "type": "predicate",
              "augmentation": "pred_anim_blood_flow_systemic",
              "poi": "default"
            },
            {
              "target": "left_heart_station",
              "type": "predicate",
              "augmentation": "pred_anim_valve_open_close",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_video_cardiac_cycle",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "left_heart_station",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_left_side_marker",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "systemic_traced"
          }
        ]
      },
      {
        "id": "step_compare_wall_thickness",
        "instruction": {
          "title": "Compare Ventricular Wall Thickness",
          "description": "Examine the right and left ventricle myocardium cross-section samples side by side. Notice that the left ventricle wall is substantially thicker. This reflects the higher pressure needed to pump blood through the entire systemic circulation, compared to the lower-pressure pulmonary circuit served by the right ventricle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "right_ventricle_wall_sample",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "default",
              "text": "Right Ventricle Wall (thinner, pulmonary pressure)"
            },
            {
              "target": "left_ventricle_wall_sample",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "default",
              "text": "Left Ventricle Wall (thicker, systemic pressure)"
            },
            {
              "target": "left_ventricle_wall_sample",
              "type": "predicate",
              "augmentation": "pred_img_wall_thickness_compare",
              "poi": "default"
            },
            {
              "target": "left_ventricle_wall_sample",
              "type": "predicate",
              "augmentation": "pred_audio_narration_wallthickness",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "right_ventricle_wall_sample",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "left_ventricle_wall_sample",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "wall_thickness_confirmed"
          }
        ]
      },
      {
        "id": "step_summary",
        "instruction": {
          "title": "Lab Summary: Structure and Function of the Heart",
          "description": "You have identified all four chambers, four valves, and major vessels, traced blood through the pulmonary and systemic circuits, and compared ventricular wall thickness to circulatory pressure demands. Review the overview diagram to consolidate your understanding before completing the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_img_heart_overview",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
}