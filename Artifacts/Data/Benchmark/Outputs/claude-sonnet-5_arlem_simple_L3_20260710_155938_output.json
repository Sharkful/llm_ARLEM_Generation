  "activity": {
    "id": "vector_projectile_activity",
    "name": "Vectors and Projectile Motion Exploration",
    "description": "A guided AR lab where students first explore vector addition and decomposition as abstract mathematical operations, then apply these concepts to understand two-dimensional projectile motion, culminating in an exploration of how launch angle and speed affect trajectory, range, and maximum height.",
    "workplace": "vector_projectile_workplace",
    "start": "step1_intro_vectors",
    "actions": [
      {
        "id": "step1_intro_vectors",
        "instruction": {
          "title": "Introducing Vectors",
          "description": "Look at the two arrows on the vector board. Each arrow is a vector: it has both a magnitude (length) and a direction. Tap 'Start' when you're ready to see them combined."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "vector_arrow_anim",
              "poi": "default"
            },
            {
              "target": "vector_b",
              "type": "predicate",
              "augmentation": "vector_arrow_anim",
              "poi": "default"
            },
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "narration_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_vectors"
          }
        ]
      },
      {
        "id": "step2_tip_to_tail",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Watch as Vector B's tail moves to Vector A's tip. The resultant vector, drawn from Vector A's tail to Vector B's tip, represents the sum A + B. Observe the resultant arrow appear at the marked spot, then tap 'Next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "tip_to_tail_anim",
              "poi": "default"
            },
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "resultant_label",
              "poi": "resultant_spot",
              "text": "Resultant: A + B"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_a",
              "type": "primitive",
              "augmentation": "*"
            },
            {
              "target": "vector_b",
              "type": "primitive",
              "augmentation": "*"
            },
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "tip_to_tail_anim"
            },
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "resultant_label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_decomposition"
          }
        ]
      },
      {
        "id": "step3_decomposition",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "Any vector can be broken into a horizontal (x) component and a vertical (y) component. Watch Vector A decompose into its x and y pieces, and study the right-triangle trigonometry relating magnitude, angle, and components. Tap the vector board marker again once you understand, then proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "decomposition_anim",
              "poi": "default"
            },
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "component_x_label",
              "poi": "tip",
              "text": "Ax = A\u00b7cos(\u03b8)"
            },
            {
              "target": "vector_a",
              "type": "predicate",
              "augmentation": "component_y_label",
              "poi": "tip",
              "text": "Ay = A\u00b7sin(\u03b8)"
            },
            {
              "target": "vector_workspace",
              "type": "predicate",
              "augmentation": "trig_formula_image",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_a",
              "type": "primitive",
              "augmentation": "*"
            },
            {
              "target": "vector_workspace",
              "type": "primitive",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "vector_board_marker",
            "duration": 3
          },
          {
            "mode": "click",
            "id": "next_to_projectile_setup"
          }
        ]
      },
      {
        "id": "step4_projectile_setup",
        "instruction": {
          "title": "Setting Up the Projectile",
          "description": "Now let's apply vectors to motion. The ball on the launch pad has an initial velocity vector at a chosen angle above the horizontal. This vector will be decomposed into a constant horizontal velocity component and a changing vertical velocity component. Detect the launch pad marker to begin the launch."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "vector_arrow_anim",
              "poi": "launch_point"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "component_x_label",
              "poi": "launch_point",
              "text": "Vx = V\u00b7cos(\u03b8) \u2014 constant"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "component_y_label",
              "poi": "launch_point",
              "text": "Vy = V\u00b7sin(\u03b8) \u2014 changes with gravity"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_ball",
              "type": "primitive",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "launch_pad_marker",
            "duration": 2
          }
        ]
      },
      {
        "id": "step5_flight_independence",
        "instruction": {
          "title": "Independent Horizontal and Vertical Motion",
          "description": "Watch the projectile fly. Notice the horizontal velocity arrow stays the same length throughout, while the vertical velocity arrow shrinks to zero at the peak, then grows in the opposite direction during descent. This demonstrates that horizontal and vertical motions are independent. Tap 'Next' when the ball lands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "projectile_launch_anim",
              "poi": "default"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "trajectory_path_anim",
              "poi": "default"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "velocity_vector_anim",
              "poi": "default"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "independence_video",
              "poi": "landing_point"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "max_height_label",
              "poi": "peak_point",
              "text": "Max Height: Vy = 0"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "trajectory_zone",
              "type": "primitive",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_exploration"
          }
        ]
      },
      {
        "id": "step6_explore_angle_speed",
        "instruction": {
          "title": "Exploring Launch Angle and Speed",
          "description": "Adjust the launch angle and speed to see how they affect the trajectory shape, range, and maximum height. Study the range-vs-angle chart to identify which launch angle produces the maximum range for a fixed speed. Tap 'Finish' to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "trajectory_path_anim",
              "poi": "default"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "range_angle_chart",
              "poi": "landing_point"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "max_height_label",
              "poi": "peak_point",
              "text": "Max Height varies with angle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
}