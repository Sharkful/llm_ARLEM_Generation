  "activity": {
    "id": "vsepr_geometry_activity",
    "name": "Exploring VSEPR Theory and Molecular Geometry",
    "description": "A guided AR lab where students count electron domains from Lewis structures, build minimum-repulsion electron-domain geometries, apply lone-pair modifications to derive molecular shapes, and compare predictions to real molecules like water, ammonia, methane, PF5, SF6, and XeF4.",
    "workplace": "vsepr_workplace",
    "start": "step1_lewis_and_steric_number",
    "actions": [
      {
        "id": "step1_lewis_and_steric_number",
        "instruction": {
          "title": "Count Electron Domains",
          "description": "Examine the Lewis structure card. Count the number of bonding pairs and lone pairs around the central atom to determine its steric number. This number is the key input for predicting geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lewis_structure_card",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/images/lewis_structure_diagram.png"
            },
            {
              "target": "lewis_structure_card",
              "type": "predicate",
              "augmentation": "narration_intro",
              "poi": "above_card"
            },
            {
              "target": "lewis_structure_card",
              "type": "predicate",
              "augmentation": "steric_number_label",
              "poi": "above_card",
              "text": "Steric Number = Bonding Pairs + Lone Pairs"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_structure_card",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start"
          },
          {
            "mode": "detect",
            "id": "marker_lewis_card",
            "duration": 3
          }
        ]
      },
      {
        "id": "step2_electron_domain_geometry",
        "instruction": {
          "title": "Build the Electron-Domain Geometry",
          "description": "Using the central atom kit, arrange the electron domains so they minimize mutual repulsion. Watch the domains settle into one of the five fundamental geometries: linear, trigonal planar, tetrahedral, trigonal bipyramidal, or octahedral."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "electron_domain_animation",
              "poi": "orbit_ring",
              "state": "repulsion_settle"
            },
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "geometry_name_label",
              "poi": "default",
              "text": "Electron-Domain Geometry"
            },
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "narration_geometry",
              "poi": "orbit_ring"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_kit",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue"
          },
          {
            "mode": "detect",
            "id": "marker_central_atom_kit",
            "duration": 3
          }
        ]
      },
      {
        "id": "step3_lone_pair_effect",
        "instruction": {
          "title": "Apply Lone Pair Effects",
          "description": "Replace one or more bonding domains with lone pairs. Notice how lone pairs occupy more angular space, pushing bonding pairs closer together and producing molecular shapes such as bent, trigonal pyramidal, seesaw, T-shaped, square planar, or square pyramidal."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "lone_pair_highlight_animation",
              "poi": "lone_pair_slot",
              "state": "expand"
            },
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "molecular_shape_label",
              "poi": "default",
              "text": "Molecular Geometry (Lone Pairs Included)"
            },
            {
              "target": "central_atom_kit",
              "type": "predicate",
              "augmentation": "narration_lone_pair",
              "poi": "lone_pair_slot"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_kit",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue"
          }
        ]
      },
      {
        "id": "step4_bond_angle_deviation",
        "instruction": {
          "title": "Explore Bond Angle Deviations",
          "description": "Compare idealized bond angles to observed values. See why water's H-O-H angle is 104.5\u00b0 instead of 109.5\u00b0: extra lone-pair repulsion compresses the bonding-pair angles below the ideal tetrahedral value."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geometry_display_zone",
              "type": "primitive",
              "augmentation": "video",
              "poi": "center_stage",
              "url": "https://assets.example.com/videos/bond_angle_deviation.mp4"
            },
            {
              "target": "geometry_display_zone",
              "type": "predicate",
              "augmentation": "bond_angle_video",
              "poi": "center_stage"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_display_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue"
          },
          {
            "mode": "detect",
            "id": "anchor_geometry_zone",
            "duration": 3
          }
        ]
      },
      {
        "id": "step5_compare_real_molecules",
        "instruction": {
          "title": "Compare to Real Molecules",
          "description": "Examine the molecule tray containing water, ammonia, methane, PF5, SF6, and XeF4. Match each VSEPR-predicted geometry to the experimentally observed structure of the real molecule."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_comparison_tray",
              "type": "predicate",
              "augmentation": "molecule_model_animation",
              "poi": "tray_left",
              "state": "cycle_molecules"
            },
            {
              "target": "molecule_comparison_tray",
              "type": "primitive",
              "augmentation": "image",
              "poi": "tray_right",
              "url": "https://assets.example.com/images/vsepr_comparison_table.png"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "molecule_comparison_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue"
          },
          {
            "mode": "detect",
            "id": "marker_molecule_tray",
            "duration": 3
          }
        ]
      },
      {
        "id": "step6_summary",
        "instruction": {
          "title": "Summary: VSEPR in Action",
          "description": "Review the full comparison table linking steric number, electron-domain geometry, lone pair count, and resulting molecular shape. Reflect on how VSEPR theory successfully predicts real molecular structures."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "summary_zone",
              "type": "primitive",
              "augmentation": "image",
              "poi": "panel_pos",
              "url": "https://assets.example.com/images/vsepr_comparison_table.png"
            },
            {
              "target": "summary_zone",
              "type": "predicate",
              "augmentation": "comparison_table_image",
              "poi": "panel_pos"
            },
            {
              "target": "summary_zone",
              "type": "predicate",
              "augmentation": "narration_summary",
              "poi": "panel_pos"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish"
          }
        ]
      }
    ]
  }
}