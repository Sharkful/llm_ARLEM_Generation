  "activity": {
    "id": "activity_retrograde_mars",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "Students explore why Mars appears to periodically reverse direction in the night sky, comparing the geocentric epicycle explanation to the heliocentric explanation, physically embodying the overtaking effect, comparing outer planets, and predicting retrograde events.",
    "workplace": "wp_retrograde_mars",
    "start": "step1_night_sky",
    "actions": [
      {
        "id": "step1_night_sky",
        "instruction": {
          "title": "Observing Mars from Earth",
          "description": "Stand on virtual Earth at night and watch Mars drift eastward against the background constellations of Leo, Virgo, Libra, and Scorpio. Over six months, observe Mars slow, reverse into a westward loop of about 15 degrees, then resume its eastward motion. Click 'Continue' or wait for the loop animation to finish to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_ecliptic_labels",
              "poi": "default",
              "text": "Leo / Virgo / Libra / Scorpio"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_loop_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_trail",
              "poi": "default"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_night_sky",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start"
          },
          {
            "mode": "detect",
            "id": "thing_mars",
            "duration": 3
          }
        ]
      },
      {
        "id": "step2_geocentric",
        "instruction": {
          "title": "The Geocentric Explanation: Epicycles",
          "description": "Earth sits at the center while Mars rides a small epicycle circle, which itself rides a larger deferent circle. Watch the machinery run and notice that when Mars is on the inner part of the epicycle, its combined motion makes it appear to move backward as seen from Earth. Click 'Continue' when ready to move to the heliocentric view."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_epicycle_model",
              "type": "predicate",
              "augmentation": "pred_epicycle_deferent_anim",
              "poi": "default"
            },
            {
              "target": "thing_epicycle_model",
              "type": "predicate",
              "augmentation": "pred_epicycle_label",
              "poi": "epicycle_center",
              "text": "Epicycle"
            },
            {
              "target": "thing_epicycle_model",
              "type": "predicate",
              "augmentation": "pred_deferent_label",
              "poi": "default",
              "text": "Deferent"
            },
            {
              "target": "thing_epicycle_model",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_epicycle_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_geocentric"
          }
        ]
      },
      {
        "id": "step3_heliocentric",
        "instruction": {
          "title": "The Heliocentric Resolution",
          "description": "Rise above the ecliptic plane to view the solar system from outside. Watch Earth (1 AU, 1-year period) and Mars (1.52 AU, 1.88-year period) orbit the Sun at their correct relative speeds. See Earth overtake Mars roughly every 26 months, replaying the retrograde event with no epicycles needed -- just two smooth ellipses. Click 'Continue' to link this to the night-sky view."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits_anim",
              "poi": "default"
            },
            {
              "target": "place_outside_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_sun",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_outside_solar_system",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_heliocentric"
          }
        ]
      },
      {
        "id": "step4_linked_perspectives",
        "instruction": {
          "title": "Linking the Two Perspectives",
          "description": "View both the heliocentric model and Earth's night sky side by side. As Earth approaches Mars, a line-of-sight sweeps eastward through the constellations; as Earth overtakes Mars, the line reverses and sweeps westward, exactly matching Mars's retrograde loop in the night-sky view. This is a real apparent motion produced by geometry, not an illusion. Click 'Continue' to try the embodied walking activity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "pred_sidebyside_video",
              "poi": "default"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_lineofsight_anim",
              "poi": "default"
            },
            {
              "target": "place_outside_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_sun",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_outside_solar_system",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_linked_perspectives"
          }
        ]
      },
      {
        "id": "step5_embodied_walk",
        "instruction": {
          "title": "Embodied Overtaking Activity",
          "description": "Stand at the center of the starfield with a stationary Mars placed several feet in front of you. Walk slowly around the small circle on the floor representing Earth's orbit while keeping your gaze on Mars. As you pass the point of closest approach, watch Mars appear to move backward against the stars -- a retrograde effect you have personally generated. Complete the full loop marked on the floor to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_walk_circle",
              "type": "predicate",
              "augmentation": "pred_walk_path_marker",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_loop_anim",
              "poi": "default"
            },
            {
              "target": "place_walk_circle",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_walk_circle",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_walk_circle",
            "duration": 5
          },
          {
            "mode": "click",
            "id": "step5_embodied_walk"
          }
        ]
      },
      {
        "id": "step6_outer_planet_comparison",
        "instruction": {
          "title": "Comparing Outer Planets",
          "description": "With Earth, Mars, Jupiter (5.2 AU), and Saturn (9.5 AU) all visible, step through a retrograde event for each planet. Notice Mars's loop spans about 15 degrees, Jupiter's about 10 degrees, and Saturn's about 7 degrees -- more distant planets show smaller loops because Earth's orbital motion subtends a smaller angle from farther away. Click 'Continue' to try the prediction challenge."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_jupiter",
              "type": "predicate",
              "augmentation": "pred_outer_planets_compare_anim",
              "poi": "default"
            },
            {
              "target": "thing_jupiter",
              "type": "predicate",
              "augmentation": "pred_loop_angle_label",
              "poi": "default",
              "text": "Jupiter: ~10 deg loop"
            },
            {
              "target": "thing_saturn",
              "type": "predicate",
              "augmentation": "pred_loop_angle_label",
              "poi": "sat_default",
              "text": "Saturn: ~7 deg loop"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_loop_angle_label",
              "poi": "default",
              "text": "Mars: ~15 deg loop"
            },
            {
              "target": "place_outside_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_jupiter",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_saturn",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_outside_solar_system",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6_outer_planet_comparison"
          }
        ]
      },
      {
        "id": "step7_prediction_challenge",
        "instruction": {
          "title": "Prediction Challenge: Where Does Retrograde Occur?",
          "description": "With Earth fixed on its orbit, drag Mars around its own orbit while watching the inset showing the night-sky view. Place Mars within the arc near opposition, where Earth is poised to overtake it on the inside track, and the inset will confirm the retrograde loop. Repeat with Earth at a different position to confirm it is the relative Earth-Mars geometry, not absolute position, that matters. Click 'Continue' to view the recap."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_loop_anim",
              "poi": "default"
            },
            {
              "target": "place_outside_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_sun",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_outside_solar_system",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step7_prediction_challenge"
          }
        ]
      },
      {
        "id": "step8_recap",
        "instruction": {
          "title": "Recap: The Puzzle of Retrograde Motion",
          "description": "Review the five concept areas covered: the observed retrograde phenomenon, the geocentric epicycle explanation, the heliocentric resolution, the linkage between Earth-sky and outside views, and the comparison of loop sizes across outer planets. Click 'Finish' to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_recap_summary_image",
              "poi": "default"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
