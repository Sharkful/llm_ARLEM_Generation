  "activity": {
    "id": "act_dna_replication_lab",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A ten-step AR lab guiding students from the schematic DNA ladder through the realistic double helix, antiparallel strand directionality, interactive base pairing, and a full build-up of the replication fork (helicase, SSBs, DNA polymerase, ligase), concluding with a semiconservative replication prediction activity and concept recap.",
    "workplace": "wp_dna_replication",
    "start": "step1_schematic_ladder",
    "actions": [
      {
        "id": "step1_schematic_ladder",
        "instruction": {
          "title": "The Schematic DNA Ladder",
          "description": "Observe the flat, ladder-like model of DNA. The two vertical lines represent the sugar-phosphate backbones; the horizontal rungs are base pairs, color-coded and labeled by base identity (A red, T blue, G yellow, C green). Click Next when ready to see how this schematic becomes the real double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_ladder",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/anim/dna_ladder_schematic.glb"
            },
            {
              "target": "thing_dna_ladder",
              "type": "predicate",
              "augmentation": "pred_ladder_schematic",
              "poi": "default"
            },
            {
              "target": "thing_dna_ladder",
              "type": "predicate",
              "augmentation": "pred_narration_intro"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_ladder",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step2_realistic_helix",
        "instruction": {
          "title": "From Ladder to Helix",
          "description": "Watch the schematic ladder twist into the realistic double-helix shape. The backbones spiral around a common axis, completing one full turn approximately every ten base pairs. Toggle between schematic and realistic views to build the mental mapping, then click Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/anim/dna_helix_realistic.glb"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_helix_realistic",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_toggle_label",
              "poi": "default",
              "text": "Toggle: Schematic / Realistic"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_narration_helix_turn"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step3_antiparallel_direction",
        "instruction": {
          "title": "Antiparallel Strands and 5' to 3' Directionality",
          "description": "Examine the arrows along each backbone: one strand points up, the other down. Labels mark the 5' and 3' termini of each strand. This antiparallel arrangement is forced by the directional chemistry of the sugar-phosphate backbone. Rotate the helix to confirm the arrows from any angle, then click Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_direction_arrows",
              "poi": "default"
            },
            {
              "target": "place_helix_stage",
              "type": "predicate",
              "augmentation": "pred_terminus_label_5",
              "poi": "poi_5prime_end",
              "text": "5' end"
            },
            {
              "target": "place_helix_stage",
              "type": "predicate",
              "augmentation": "pred_terminus_label_3",
              "poi": "poi_3prime_end",
              "text": "3' end"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_narration_antiparallel"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "type": "*"
            },
            {
              "target": "place_helix_stage",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step4_base_pairing_activity",
        "instruction": {
          "title": "Interactive Base-Pairing Activity",
          "description": "A complete template strand (5'-ATGCCAGT-3') sits on the left; complete the complementary strand on the right by dragging bases from the palette below. Correct pairs (A-T with two hydrogen bonds, G-C with three) snap into place with dashed bond lines. Detect the completed strand to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_pairing_station",
              "type": "predicate",
              "augmentation": "pred_base_palette",
              "poi": "default"
            },
            {
              "target": "thing_pairing_station",
              "type": "predicate",
              "augmentation": "pred_hbond_dashed_lines",
              "poi": "default"
            },
            {
              "target": "thing_pairing_station",
              "type": "predicate",
              "augmentation": "pred_narration_pairing"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_pairing_station",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_pairing_station",
            "duration": 3
          },
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step5_helicase",
        "instruction": {
          "title": "Helicase Unwinds the Double Helix",
          "description": "Helicase, labeled at one end of the DNA, moves along the helix breaking hydrogen bonds and unwinding the two strands, exposing the bases. Watch it work its way along a stretch of DNA, then click Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_helicase_model",
              "poi": "poi_helicase_spot"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_helicase"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_helicase"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step6_ssb_proteins",
        "instruction": {
          "title": "Single-Strand Binding Proteins Stabilize the Strands",
          "description": "As the strands separate behind helicase, single-strand binding proteins (SSBs) attach to each exposed strand, holding them open and preventing re-pairing or folding. Click Next to introduce DNA polymerase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_ssb_model",
              "poi": "default"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_ssb"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_ssb"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step7_leading_strand",
        "instruction": {
          "title": "DNA Polymerase and the Leading Strand",
          "description": "DNA polymerase attaches to the template strand oriented so synthesis proceeds in the same direction as the moving fork. It travels 3' to 5' along the template, building the new strand continuously 5' to 3'. Free nucleotides pair and are added as the leading strand grows. Click Next to see the lagging strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_polymerase_leading",
              "poi": "poi_leading_spot"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_leading"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_leading"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step8_lagging_strand",
        "instruction": {
          "title": "The Lagging Strand and Okazaki Fragments",
          "description": "On the opposite template strand, polymerase must work away from the fork, producing short Okazaki fragments before jumping back to start anew. After several fragments form, DNA ligase seals them into a continuous strand. Click Next to view the complete replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_polymerase_lagging",
              "poi": "poi_lagging_spot"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_ligase_model",
              "poi": "poi_ligase_spot"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_narration_lagging"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "*"
