          }
        ]
      },
      {
        "id": "step6_valve_function",
        "instruction": {
          "title": "Valve Function: Preventing Backflow",
          "description": "Examine the four valves in open and closed states. Atrioventricular valves (tricuspid, mitral) close during ventricular contraction; semilunar valves (pulmonary, aortic) open during contraction and close during relaxation, preventing backflow at every phase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "valve_open_closed_animation",
