      {
        "id": "step8_flow_quiz",
        "instruction": {
          "title": "Blood Flow Tracing Quiz",
          "description": "Starting from a given structure (e.g., 'blood has just entered the right atrium'), select the next correct structure in the circulatory path. Distinguish pulmonary arteries (deoxygenated) from pulmonary veins (oxygenated) as you trace the full pulmonary and systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
