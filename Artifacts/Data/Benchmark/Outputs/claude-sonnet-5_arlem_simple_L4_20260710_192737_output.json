  "activity": {
    "id": "heart_anatomy_activity",
    "name": "Structural Anatomy and Blood Flow of the Human Heart",
    "description": "A guided AR lab exploring the four chambers, four valves, and major vessels of the heart, tracing dual-circuit blood flow, comparing ventricular wall thickness, examining valve function, and reinforcing learning with identification and flow-tracing quizzes.",
    "workplace": "heart_anatomy_workplace",
    "start": "step1_overview",
    "actions": [
      {
        "id": "step1_overview",
        "instruction": {
          "title": "Exterior Overview of the Heart",
          "description": "Two full-size heart models appear side by side: an intact exterior view on the left and a cutaway interior view on the right. Rotate to explore gross orientation. Note that anatomical left/right is from the patient's perspective, not the viewer's."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_intact",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/heart_intact_fullsize.glb"
            },
            {
              "target": "heart_cutaway",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/heart_cutaway_fullsize.glb"
            },
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "narration_intro"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start"
          },
          {
            "mode": "detect",
            "id": "marker_heart_cutaway",
            "duration": 3
          }
        ]
      },
      {
        "id": "step2_structural_tour",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Follow the highlighted labels on the cutaway heart to learn the four chambers, four valves, and major vessels in sequence: right atrium, right ventricle, left atrium, left ventricle; tricuspid, pulmonary, mitral/bicuspid, aortic valves; superior/inferior vena cava, pulmonary arteries, pulmonary veins, aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_chamber",
              "poi": "poi_right_atrium"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_chamber",
              "poi": "poi_right_ventricle"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_chamber",
              "poi": "poi_left_atrium"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_chamber",
              "poi": "poi_left_ventricle"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_valve",
              "poi": "poi_tricuspid_valve"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_valve",
              "poi": "poi_pulmonary_valve"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_valve",
              "poi": "poi_mitral_valve"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "highlight_valve",
              "poi": "poi_aortic_valve"
            },
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "highlight_vessel",
              "poi": "poi_svc"
            },
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "highlight_vessel",
              "poi": "poi_ivc"
            },
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "highlight_vessel",
              "poi": "poi_pulmonary_vessels"
            },
            {
              "target": "heart_intact",
              "type": "predicate",
              "augmentation": "highlight_vessel",
              "poi": "poi_aorta"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "narration_tour",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_cutaway",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "heart_intact",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step3_dual_circuit",
        "instruction": {
          "title": "Dual-Circuit Color-Coded Blood Flow",
          "description": "Watch blue deoxygenated blood flow through the right heart and pulmonary arteries, and red oxygenated blood flow through the left heart and pulmonary veins/aorta. Observe the pulmonary circuit and systemic circuit as two distinct loops."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "blood_flow_stream",
              "poi": "default"
            },
            {
              "target": "heart_cutaway",
              "type": "predicate",
              "augmentation": "narration_dual_circuit",
              "poi": "default"
            },
            {
              "target": "heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_atrium",
              "text": "Pulmonary Circuit (blue)"
            },
            {
              "target": "heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_atrium",
              "text": "Systemic Circuit (red)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_cutaway",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step4_rbc_trace",
        "instruction": {
          "title": "Trace a Red Blood Cell Through the Heart",
          "description": "A red blood cell begins in the superior vena cava. Press Next to advance it step-by-step through the tricuspid valve, right ventricle, pulmonary valve, pulmonary arteries, lungs (color change to red), pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, aorta, and back through systemic veins. Replay as needed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rbc_token",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/rbc_sphere_blue.glb"
            },
            {
              "target": "rbc_token",
              "type": "predicate",
              "augmentation": "rbc_move_animation",
              "poi": "default"
            },
            {
              "target": "rbc_token",
              "type": "predicate",
              "augmentation": "narration_rbc_trace",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rbc_token",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step5_wall_thickness",
        "instruction": {
          "title": "Ventricular Wall Thickness Comparison",
          "description": "Compare cross-sections of the right ventricle (thin wall, ~3-5mm) and left ventricle (thick wall, ~10-15mm) at the same horizontal level. The left ventricle's thicker myocardium reflects the higher pressure needed to perfuse the systemic circuit versus the low-pressure pulmonary circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ventricle_crosssection_station",
              "type": "predicate",
              "augmentation": "wall_thickness_image",
              "poi": "default"
            },
            {
              "target": "ventricle_crosssection_station",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_rv_wall",
              "text": "Right Ventricle Wall ~3-5mm"
            },
            {
              "target": "ventricle_crosssection_station",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_lv_wall",
              "text": "Left Ventricle Wall ~10-15mm"
            },
            {
              "target": "ventricle_crosssection_station",
              "type": "predicate",
              "augmentation": "narration_wall_thickness",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "ventricle_crosssection_station",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
