  "activity": {
    "id": "act_vectors_projectile_lab",
    "name": "Vectors and Projectile Motion: From Abstract Arrows to Flight Paths",
    "description": "A sequential AR lab introducing 2D/3D vectors (magnitude/direction, tip-to-tail addition, decomposition into components) and applying these tools to two-dimensional projectile motion, culminating in a targeting challenge, free-exploration sandbox, and recap.",
    "workplace": "wp_vectors_projectile",
    "start": "step1_intro_vector",
    "actions": [
      {
        "id": "step1_intro_vector",
        "instruction": {
          "title": "Introducing the Vector",
          "description": "A single arrow floats in the workspace with its tail at the origin. Notice the magnitude and direction labels update as you drag the arrowhead. Vectors have both size and direction, unlike scalars such as mass or temperature."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_vector_arrow_anim",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "poi_head",
              "text": "Magnitude: 5.0 m"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_direction_label",
              "poi": "poi_head",
              "text": "Direction: 37\u00b0 from x-axis"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "pred_axis_lines",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_narration_intro_vectors",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_arrow",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          },
          {
            "mode": "detect",
            "id": "det_vector_table",
            "duration": 3
          }
        ]
      },
      {
        "id": "step2_vector_addition",
        "instruction": {
          "title": "Adding Vectors Tip-to-Tail",
          "description": "Two vectors, blue and green, are placed tip-to-tail. The red resultant vector runs from the origin to the head of the second vector. Try swapping the order of blue and green \u2014 the resultant stays the same."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "pred_two_vectors_addition_anim",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "pred_resultant_arrow_anim",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "pred_narration_addition",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_workspace",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step3_vector_decomposition",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "A single vector is broken into x, y, and z component arrows placed tip-to-tail. Resize each component and watch the original vector update. This is addition in reverse: the components sum back to the original vector via the Pythagorean theorem."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_decomposition_anim",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "pred_narration_decomposition",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_arrow",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step4_transition_2d_plane",
        "instruction": {
          "title": "Entering the Projectile Motion Plane",
          "description": "The 3D vector workspace gives way to a 2D vertical plane with labeled horizontal and vertical axes. A ball rests at the left with an initial velocity vector pointing up and to the right. Because gravity acts only vertically, the entire motion stays within this plane."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_2d_plane_image",
              "poi": "default"
            },
            {
              "target": "thing_projectile_ball",
              "type": "predicate",
              "augmentation": "pred_initial_velocity_arrow",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_narration_transition_projectile",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_narration_transition_projectile"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          },
          {
            "mode": "detect",
            "id": "det_plane_surface",
            "duration": 2
          }
        ]
      },
      {
        "id": "step5_projectile_flight_demo",
        "instruction": {
          "title": "Watching the Projectile Fly",
          "description": "The initial velocity is decomposed into horizontal and vertical component arrows. Launch the ball and watch: the horizontal arrow stays constant, while the vertical arrow shrinks to zero at the peak and grows again during descent. The parabolic path traces the combination of these two independent motions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_projectile_ball",
              "type": "predicate",
              "augmentation": "pred_component_arrows_anim",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_trajectory_trail",
              "poi": "poi_peak"
            },
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_narration_independence",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_projectile_ball",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_projectile_plane",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next"
          }
        ]
      },
      {
        "id": "step6_max_range_discovery",
        "instruction": {
          "title": "Discovering the 45-Degree Maximum Range",
          "description": "Use the angle and speed controls to launch the ball repeatedly. Watch the range display and history panel. Try angle pairs like 30/60 and 20/70 and compare their ranges. Explore around 35-55 degrees to find the angle that maximizes range for a fixed speed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_control_panel",
              "type": "predicate",
              "augmentation": "pred_angle_speed_controls",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "type": "predicate",
