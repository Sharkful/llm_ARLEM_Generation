          }
        ]
      },
      {
        "id": "step9_recap",
        "instruction": {
          "title": "Recap: VSEPR Theory Summary",
          "description": "Review the five key concept areas: the minimum-repulsion principle, the five electron-domain geometries and their angles, the distinction between electron-domain and molecular geometry, lone pair angular asymmetry, and application to real molecules. Each area is highlighted as narration reviews it."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "summary_wall",
