  "activity": {
    "id": "chemistry-vsepr-activity",
    "name": "VSEPR Theory Activity",
    "description": "Explore VSEPR theory to predict molecular geometries.",
    "workplace": "chemistry-vsepr-workplace",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "Introduction to VSEPR Theory",
          "description": "Welcome! This lab explores VSEPR theory. We'll start by determining the steric number from a Lewis structure. Click to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab-bench",
              "type": "predicate",
              "augmentation": "label-steric-number",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro"
          }
        ]
      },
      {
        "id": "step2_steric_number",
        "instruction": {
          "title": "Steric Number and Electron Domains",
          "description": "The steric number is the count of bonding pairs plus lone pairs around the central atom. This number determines the electron-domain geometry. Click to see the electron-domain geometries."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab-bench",
              "type": "predicate",
              "augmentation": "audio-steric-number-explanation",
              "poi": "default"
            },
            {
              "target": "lab-bench",
              "type": "predicate",
              "augmentation": "label-electron-domain-geometry",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_steric_number"
          }
        ]
      },
      {
        "id": "step3_electron_geometries",
        "instruction": {
          "title": "Electron Domain Geometries",
          "description": "Here are the five basic electron-domain geometries. Observe how electron domains arrange to minimize repulsion. Click on a molecule to explore its geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-linear",
              "poi": "default",
              "state": "0"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-trigonal-planar",
              "poi": "default",
              "state": "1"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-tetrahedral",
              "poi": "default",
              "state": "2"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-trigonal-bipyramidal",
              "poi": "default",
              "state": "3"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-octahedral",
              "poi": "default",
              "state": "4"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "water-molecule"
          },
          {
            "mode": "detect",
            "id": "ammonia-molecule"
          },
          {
            "mode": "detect",
            "id": "methane-molecule"
          },
          {
            "mode": "detect",
            "id": "pf5-molecule"
          },
          {
            "mode": "detect",
            "id": "sf6-molecule"
          },
          {
            "mode": "detect",
            "id": " XeF4-molecule"
          }
        ]
      },
      {
        "id": "step4_molecular_geometries",
        "instruction": {
          "title": "Molecular Geometries and Lone Pairs",
          "description": "Lone pairs occupy more space than bonding pairs, influencing molecular geometry. Observe the differences between electron-domain and molecular geometries. Click to learn about lone pair repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-bent",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-trigonal-pyramidal",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-seesaw",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-t-shaped",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-square-planar",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-square-pyramidal",
              "poi": "default"
            },
            {
              "target": "lab-bench",
              "type": "predicate",
              "augmentation": "audio-lone-pair-repulsion",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-linear"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-trigonal-planar"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-tetrahedral"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-trigonal-bipyramidal"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "animation-octahedral"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_molecular_geometries"
          }
        ]
      },
      {
        "id": "step5_comparison",
        "instruction": {
          "title": "Comparing Predictions to Reality",
          "description": "Let's compare VSEPR predictions with real molecules. Click to see examples and hear a summary."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule-display-area",
              "type": "predicate",
              "augmentation": "label-molecular-geometry",
              "poi": "default"
            },
            {
              "target": "molecule-display-area",
              "type": "predicate",
              "augmentation": "audio-geometry-comparison",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_comparison"
          }
        ]
      }
    ]
  }
