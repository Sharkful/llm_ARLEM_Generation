  "activity": {
    "id": "dna-replication-activity",
    "name": "DNA Replication Activity",
    "description": "Explore the structure and replication of DNA.",
    "workplace": "dna-replication-workplace",
    "start": "step-1-intro",
    "actions": [
      {
        "id": "step-1-intro",
        "instruction": {
          "title": "Introduction to DNA Structure",
          "description": "Observe the schematic representation of the DNA ladder and learn about its basic components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-schematic-ladder",
              "type": "predicate",
              "augmentation": "show-schematic-ladder"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_intro.mp3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-1"
          }
        ]
      },
      {
        "id": "step-2-helix",
        "instruction": {
          "title": "The Double Helix",
          "description": "Witness the DNA ladder transform into the iconic double helix. Note the base pairs stacking within."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-schematic-ladder",
              "type": "predicate",
              "augmentation": "show-schematic-ladder"
            },
            {
              "target": "dna-helix",
              "type": "predicate",
              "augmentation": "show-double-helix"
            }
          ],
          "deactivate": [
            {
              "target": "dna-schematic-ladder",
              "type": "predicate",
              "augmentation": "show-schematic-ladder"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-2"
          }
        ]
      },
      {
        "id": "step-3-antiparallel",
        "instruction": {
          "title": "Antiparallel Strands and Directionality",
          "description": "Observe the arrows indicating the 5' to 3' directionality of each strand. Understand why they run in opposite directions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-helix",
              "type": "predicate",
              "augmentation": "show-antiparallel-arrows"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_antiparallel.mp3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-3"
          }
        ]
      },
      {
        "id": "step-4-base-pairing",
        "instruction": {
          "title": "Complementary Base Pairing Activity",
          "description": "Drag and drop bases from the palette to correctly pair them with the template strand. Observe the hydrogen bonds (2 for A-T, 3 for G-C)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-helix",
              "type": "predicate",
              "augmentation": "show-base-pairing-activity"
            },
            {
              "target": "palette-zone",
              "type": "predicate",
              "augmentation": "show-base-pairing-activity"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_pairing_rules.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna-helix",
              "type": "predicate",
              "augmentation": "show-antiparallel-arrows"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "complete-pairing-step-4"
          }
        ]
      },
      {
        "id": "step-5-replication-fork-start",
        "instruction": {
          "title": "DNA Replication: The Fork",
          "description": "Observe the initiation of the replication fork. Helicase begins to unwind the DNA."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-helicase-animation"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_replication_process.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna-helix",
              "type": "predicate",
              "augmentation": "*"
            },
            {
              "target": "palette-zone",
              "type": "predicate",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-5"
          }
        ]
      },
      {
        "id": "step-6-ssb-proteins",
        "instruction": {
          "title": "Stabilizing Single Strands",
          "description": "Single-strand binding proteins (SSBs) appear to stabilize the unwound DNA strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-ssb-proteins"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-6"
          }
        ]
      },
      {
        "id": "step-7-leading-strand",
        "instruction": {
          "title": "Leading Strand Synthesis",
          "description": "DNA polymerase synthesizes the leading strand continuously in the 5' to 3' direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-polymerase-leading"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-7"
          }
        ]
      },
      {
        "id": "step-8-lagging-strand",
        "instruction": {
          "title": "Lagging Strand Synthesis (Okazaki Fragments)",
          "description": "Observe discontinuous synthesis on the lagging strand, forming Okazaki fragments. DNA ligase will join them."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-polymerase-lagging"
            },
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-ligase-animation"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-8"
          }
        ]
      },
      {
        "id": "step-9-replication-fork-full",
        "instruction": {
          "title": "The Complete Replication Fork",
          "description": "View the entire replication fork with all enzymes active. Understand the leading vs. lagging strand asymmetry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-replication-fork-full"
            }
          ],
          "deactivate": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-polymerase-leading"
            },
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-polymerase-lagging"
            },
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "show-dna-ligase-animation"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next-button-step-9"
          }
        ]
      },
      {
        "id": "step-10-semiconservative-activity",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "See how DNA replicates semiconservatively. Predict the outcome of a second round of replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-molecule",
              "type": "predicate",
              "augmentation": "show-semiconservative-replication-round1"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_semiconservative.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "predict-round-2-step-10"
          }
        ]
      },
      {
        "id": "step-11-conclusion",
        "instruction": {
          "title": "Conclusion and Recap",
          "description": "Review the key concepts of DNA structure and replication covered in this lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "workspace-origin",
              "type": "predicate",
              "augmentation": "summary-screen"
            },
            {
              "target": "workspace-origin",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/dna_conclusion.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna-molecule",
              "type": "predicate",
              "augmentation": "show-semiconservative-replication-round1"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "end-lab-step-11"
          }
        ]
      }
    ]
  }
}