  "activity": {
    "id": "dna_replication_lab",
    "name": "DNA Replication and Structure Analysis",
    "description": "A guided molecular biology tour of DNA structure and the mechanism of semiconservative replication.",
    "language": "en",
    "workplace": "mol_bio_lab_01",
    "start": "step1_structure",
    "actions": [
      {
        "id": "step1_structure",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "lab_table_place",
        "predicate": "view_structure_predicate",
        "instruction": {
          "title": "DNA Structure Exploration",
          "description": "Observe the DNA double helix. Notice the antiparallel sugar-phosphate backbones and the nitrogenous bases pairing inside."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
              "augmentation": "dna_helix_model_pred"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_base_pairing",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_base_pairing",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "lab_table_place",
        "predicate": "examine_pairing_predicate",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Examine the A-T and G-C pairings. A-T forms two hydrogen bonds, while G-C forms three. Understanding this specificity is key to replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
              "augmentation": "base_pair_label_pred"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
              "augmentation": "dna_helix_model_pred"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_unwinding",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_unwinding",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "lab_table_place",
        "predicate": "observe_helicase_predicate",
        "instruction": {
          "title": "Initiating Replication: Unwinding",
          "description": "Watch as Helicase unwinds the double helix at the replication fork, creating single-stranded templates stabilized by proteins."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
              "augmentation": "helicase_animation_pred"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
              "augmentation": "base_pair_label_pred"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_polymerase",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_polymerase",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "lab_table_place",
        "predicate": "observe_polymerase_predicate",
        "instruction": {
          "title": "DNA Polymerase Activity",
          "description": "Observe DNA Polymerase synthesizing the leading strand continuously 5' to 3'. Note how the lagging strand must be synthesized in segments."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model_thing",
              "type": "predicate",
