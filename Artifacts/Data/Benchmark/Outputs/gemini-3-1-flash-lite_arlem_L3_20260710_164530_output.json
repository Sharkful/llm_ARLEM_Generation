        "location": "workstation_alpha",
        "predicate": "launched",
        "instruction": {
          "title": "Vector Addition (Tip-to-Tail)",
          "description": "Drag the second vector to the tip of the first. The resultant vector connects the start of the first to the end of the second."
        },
