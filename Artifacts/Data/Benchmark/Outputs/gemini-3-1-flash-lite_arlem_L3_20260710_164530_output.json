        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Observe the 3D vector model. Note how magnitude (length) and direction (angle) define the vector. Use your hand to rotate the vector to see its components."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_addition",
            "type": "action",
            "operator": "equal"
          }
