  "activity": {
    "id": "astro_retrograde_lab",
    "name": "Apparent Retrograde Motion Lab",
    "description": "A module exploring why outer planets appear to move backward in the night sky using geocentric and heliocentric models.",
    "language": "en",
    "workplace": "astro_lab_workplace",
    "start": "step_01_observation",
    "actions": [
      {
        "id": "step_01_observation",
        "viewport": "actions",
        "type": "actions",
        "device": "headset_01",
        "location": "station_night_sky",
        "predicate": "viewing_observation",
        "instruction": {
          "title": "The Retrograde Puzzle",
          "description": "Observe the red point of Mars drifting against the background constellations. Notice how it eventually slows, reverses into a loop, and resumes its path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "station_night_sky",
              "type": "predicate",
              "augmentation": "label_night_sky",
              "poi": "default"
            },
            {
              "target": "model_mars",
              "type": "predicate",
              "augmentation": "anim_mars_loop",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "station_night_sky",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_02_geocentric",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "headset_01",
        "location": "station_orrery",
        "predicate": "viewing_geocentric",
        "instruction": {
          "title": "The Geocentric Explanation",
          "description": "The geocentric model explains this motion using epicycles. Notice how Mars moves on a small circle that orbits Earth, creating the apparent backward loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "model_mars",
              "type": "predicate",
              "augmentation": "label_epicycle",
              "poi": "default"
            },
            {
              "target": "station_orrery",
              "type": "predicate",
              "augmentation": "anim_geocentric_model",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "station_orrery",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_03_heliocentric",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_03_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "headset_01",
        "location": "station_orrery",
        "predicate": "viewing_heliocentric",
        "instruction": {
          "title": "The Heliocentric Solution",
          "description": "Observe the solar system from above. Earth orbits faster than Mars. The retrograde loop occurs naturally as Earth overtakes Mars on the inside track."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "station_orrery",
              "type": "predicate",
              "augmentation": "anim_heliocentric_view",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "station_orrery",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_04_linkage",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_04_linkage",
        "viewport": "actions",
        "type": "actions",
        "device": "headset_01",
        "location": "station_orrery",
        "predicate": "viewing_linkage",
        "instruction": {
          "title": "Linking Perspectives",
          "description": "Compare the two views. The line-of-sight from Earth to Mars shows that the apparent backward motion is a direct consequence of relative orbital geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
