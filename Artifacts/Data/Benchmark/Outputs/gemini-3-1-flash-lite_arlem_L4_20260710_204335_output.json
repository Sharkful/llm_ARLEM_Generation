  "activity": {
    "id": "heart_anatomy_lab_001",
    "name": "Human Heart Structure and Function",
    "description": "Anatomy lab on human heart structure and circulatory pathways.",
    "language": "en",
    "workplace": "anatomy_lab_01",
    "start": "scene_1_intro",
    "actions": [
      {
        "id": "scene_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "AR_Headset_01",
        "location": "main_lab_table",
        "predicate": "label_chambers",
        "instruction": {
          "title": "Introduction to Cardiac Anatomy",
          "description": "Observe the two heart models. The left shows the exterior anatomy; the right is a cutaway revealing internal chambers. Note that the right/left sides are labeled from the patient's perspective. Rotate the models to explore."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "scene_1_intro",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "scene_2_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "AR_Headset_01",
        "location": "main_lab_table",
        "predicate": "label_chambers",
        "instruction": {
          "title": "Structural Anatomy Tour",
          "description": "The tour identifies the four chambers, four valves, and major vessels. Observe how these structures map between the intact and cutaway models."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_cutaway_thing",
