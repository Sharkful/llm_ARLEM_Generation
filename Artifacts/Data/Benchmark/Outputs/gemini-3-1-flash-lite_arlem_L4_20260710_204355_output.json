            "mode": "click",
            "id": "molecular_vs_electron",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "lone_pair_asymmetry",
        "viewport": "actions",
        "type": "actions",
        "device": "headset01",
        "location": "lab_bench",
        "predicate": "viewed_asymmetry",
        "instruction": {
          "title": "Lone Pair Asymmetry",
          "description": "Compare methane, ammonia, and water. Lone pairs occupy more angular space, compressing bond angles. Observe the change from 109.5 to 104.5 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
