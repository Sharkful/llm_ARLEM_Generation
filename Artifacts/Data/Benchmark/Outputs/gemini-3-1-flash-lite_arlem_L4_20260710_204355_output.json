  "activity": {
    "id": "vsepr_lab_001",
    "name": "VSEPR Theory Explorer",
    "description": "A 5-step interactive lab exploring VSEPR theory, electron-domain geometries, and molecular shapes.",
    "language": "en",
    "workplace": "chemistry_lab_01",
    "start": "intro_scene",
    "actions": [
      {
        "id": "intro_scene",
        "viewport": "actions",
        "type": "actions",
        "device": "headset01",
        "location": "lab_bench",
        "predicate": "viewed_intro",
        "instruction": {
          "title": "Introduction to VSEPR Theory",
          "description": "Electrons in bonding pairs and lone pairs around a central atom repel one another. VSEPR theory predicts that molecules adopt a geometry that minimizes this repulsion. Count domains (bonds + lone pairs) from the Lewis structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "workspace_origin",
              "type": "predicate",
              "augmentation": "vsepr_intro_label",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "workspace_origin",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "intro_scene",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "repulsion_demo",
        "viewport": "actions",
        "type": "actions",
        "device": "headset01",
        "location": "lab_bench",
        "predicate": "viewed_repulsion",
        "instruction": {
          "title": "Minimum Repulsion Principle",
          "description": "Observe the domains as they rearrange to minimize repulsion. A 4th domain results in a tetrahedral arrangement with 109.5-degree angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "four_domain_tetrahedral",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "molecule_kit",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "repulsion_demo",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "molecular_vs_electron",
        "viewport": "actions",
        "type": "actions",
        "device": "headset01",
        "location": "lab_bench",
        "predicate": "viewed_distinction",
        "instruction": {
          "title": "Geometry Distinction",
          "description": "The electron-domain geometry (tetrahedral) remains constant, but the molecular geometry changes as bonded atoms are replaced by invisible lone pairs. Notice the transition from tetrahedral (CH4) to trigonal pyramidal (NH3) to bent (H2O)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "tetrahedral_series",
              "poi": "default"
            }
          ],
          "deactivate": [],
