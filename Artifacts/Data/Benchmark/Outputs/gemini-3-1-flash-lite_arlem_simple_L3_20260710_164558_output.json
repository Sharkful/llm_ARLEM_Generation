  "activity": {
    "id": "retrograde_lab_001",
    "name": "Retrograde Motion Explorer",
    "description": "A lab demonstrating retrograde motion through Earth-based and space-based perspectives.",
    "workplace": "astro_lab_room",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "Introduction to Retrograde Motion",
          "description": "Welcome. We will explore why Mars appears to move backward in the night sky. Tap the console to begin."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "display_console",
              "type": "predicate",
              "augmentation": "label_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "display_console"
          }
        ]
      },
      {
        "id": "step_2_geocentric_view",
        "instruction": {
          "title": "The Geocentric Perspective",
          "description": "Observe the apparent path of Mars from Earth. Notice how it drifts east, loops west, then continues east. Click the model when finished observing."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "solar_system_model",
              "type": "predicate",
              "augmentation": "anim_earth_mars_view",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "solar_system_model"
          }
        ]
      },
      {
        "id": "step_3_heliocentric_view",
        "instruction": {
          "title": "The Heliocentric Reality",
          "description": "Now view the solar system from above. Notice Earth's faster orbit overtaking Mars. Click the Sun to continue."
        },
        "enter": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "solar_system_model",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "sun_model"
          }
        ]
      },
      {
        "id": "step_4_explanation",
        "instruction": {
          "title": "Physics of the Overtake",
          "description": "Like passing a car on the highway, Earth 'laps' Mars, creating the illusion of retrograde motion. Click the console to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "display_console",
              "type": "predicate",
              "augmentation": "label_overtake_physics",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "display_console"
          }
        ]
      },
      {
        "id": "step_5_comparison",
        "instruction": {
          "title": "Planetary Comparison",
          "description": "Finally, observe how more distant planets like Jupiter and Saturn show smaller loops. Tap the model to conclude the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "solar_system_model",
              "type": "predicate",
              "augmentation": "anim_jupiter_saturn_comp",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "solar_system_model"
          }
        ]
      }
    ]
  }
