        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_trace"
          }
        ]
      },
      {
        "id": "step5_myocardium",
        "instruction": {
          "title": "Ventricular Wall Thickness",
          "description": "Compare the thin right ventricular wall to the thick, powerful left ventricular wall. Why the difference?"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model_tangible",
              "type": "predicate",
              "augmentation": "label_chambers_pred",
              "poi": "heart_center"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model_tangible",
              "augmentation": "label_chambers_pred"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
