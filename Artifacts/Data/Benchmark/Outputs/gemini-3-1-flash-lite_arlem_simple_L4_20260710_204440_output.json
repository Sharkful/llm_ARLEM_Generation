  "activity": {
    "id": "physics_lab_activity",
    "name": "Vector Mechanics and Projectile Motion",
    "description": "An exploration of vectors and their application to 2D projectile motion.",
    "workplace": "physics_lab_wp",
    "start": "intro_vectors",
    "actions": [
      {
        "id": "intro_vectors",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Explore vectors by dragging the arrow head. Observe how magnitude and angle change."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_worktable",
              "type": "predicate",
              "augmentation": "vector_arrow"
            },
            {
              "target": "vector_worktable",
              "type": "predicate",
              "augmentation": "mag_label",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_worktable"
          }
        ]
      },
      {
        "id": "vector_addition",
        "instruction": {
          "title": "Vector Addition",
          "description": "Observe the tip-to-tail addition of two vectors to form a resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_worktable",
              "type": "predicate",
              "augmentation": "resultant_sum"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_worktable"
          }
        ]
      },
      {
        "id": "vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Decompose the vector into x, y, and z components. Notice how they sum back to the original."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_worktable",
              "type": "predicate",
              "augmentation": "component_decomp"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_worktable"
          }
        ]
      },
      {
        "id": "projectile_intro",
        "instruction": {
          "title": "Projectile Motion Setup",
          "description": "Visualize projectile motion in 2D space. The velocity vector is decomposed into horizontal and vertical components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "physics_lab_area",
              "type": "predicate",
              "augmentation": "projectile_plane"
            },
            {
              "target": "physics_lab_area",
              "type": "predicate",
              "augmentation": "initial_velocity"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "physics_lab_area"
          }
        ]
      },
      {
        "id": "projectile_flight",
        "instruction": {
          "title": "Analyzing Projectile Motion",
          "description": "Watch the ball's flight. Observe how the vertical component changes while the horizontal remains constant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "physics_lab_area",
              "type": "predicate",
              "augmentation": "flight_animation"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "physics_lab_area"
          }
        ]
      }
    ]
