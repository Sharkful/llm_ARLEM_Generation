  "activity": {
    "id": "vsepr_lab_activity",
    "name": "VSEPR Theory Exploration",
    "description": "Exploring VSEPR theory, electron-domain geometries, and molecular shapes.",
    "workplace": "vsepr_lab_workplace",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "instruction": {
          "title": "Introduction to VSEPR Theory",
          "description": "Electrons repel each other. Molecules adopt shapes that keep these electron domains as far apart as possible. Each bond or lone pair counts as one domain."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "workspace_origin",
              "type": "predicate",
              "augmentation": "vsepr_intro_label",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_intro"
          }
        ]
      },
      {
        "id": "step_geometry_basics",
        "instruction": {
          "title": "Minimum Repulsion Principle",
          "description": "Watch as electron domains rearrange to minimize repulsion. Observe how they settle into linear, trigonal planar, and tetrahedral arrangements."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom_place",
              "type": "predicate",
              "augmentation": "repulsion_animation",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_place",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "step_geometry_basics"
          }
        ]
      },
      {
        "id": "step_geometry_catalog",
        "instruction": {
          "title": "Geometry Catalog",
          "description": "We add 5th and 6th domains to form trigonal bipyramidal and octahedral shapes. Observe the summary of all five fundamental geometries."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "reference_panel_place",
              "type": "predicate",
              "augmentation": "geom_summary_image",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "reference_panel_place",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_geometry_catalog"
          }
        ]
      },
      {
        "id": "step_domain_vs_molecular",
        "instruction": {
          "title": "Domain vs. Molecular Geometry",
          "description": "Compare methane (CH4) to ammonia (NH3) and water (H2O). Notice how replacing bonding domains with lone pairs changes molecular geometry while keeping the electron-domain geometry tetrahedral."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_view_place",
              "type": "predicate",
              "augmentation": "methane_model",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "workspace_origin",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "molecule_view_place",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "step_domain_vs_molecular"
          }
        ]
      },
      {
        "id": "step_lone_pair_asymmetry",
        "instruction": {
          "title": "Lone Pair Asymmetry",
          "description": "Lone pairs occupy more angular space than bonding pairs. Observe the bond angles in CH4 (109.5\u00b0), NH3 (107\u00b0), and H2O (104.5\u00b0) decreasing as lone pairs increase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "reference_panel_place",
              "type": "predicate",
              "augmentation": "angles_comparison_image",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lone_pair_asymmetry"
          }
        ]
      }
    ]
  }
