            1.5
          ],
          "scale": [
            0.05,
            0.05,
            0.05
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "label_mars",
          "position": [
            0,
            1.4,
            1.5
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ],
          "components": [
            {
              "componentType": "textMeshPro",
              "text": "Retrograde Loop Path",
              "fontSize": 30
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "intro_apparent_motion",
          "autoAdvance": true,
          "changes": [
            {
              "target": "mars_marker"
            }
          ],
          "changeMeaning": "Introduce the concept by showing Mars stationary in the sky.",
          "narration": "Normally, Mars drifts slowly eastward against the background stars. However, every 26 months, it appears to reverse direction."
        },
        {
          "clipName": "clip1",
          "audioClip": "retrograde_loop_start",
          "autoAdvance": true,
          "changes": [
            {
              "target": "mars_marker",
              "eulerAngles": [
                0,
                0,
                15
              ]
            }
          ],
          "changeMeaning": "Mars begins moving along a looped path across the sky.",
          "narration": "This is retrograde motion. Mars slows, traces a westward loop for two months, and then resumes its eastward trek."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "The Heliocentric Mechanism",
      "description": "Students observe the same phenomenon from space to understand the orbital mechanics behind the illusion.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Explain why retrograde motion occurs due to Earth overtaking an outer planet.",
        "Contrast geocentric and heliocentric explanations.",
        "Compare retrograde loops of different outer planets."
      ],
      "instructions": [
        "Observe how the relative orbital speeds create the apparent retrograde loop."
      ],
