            {
              "target": "mars_orbiting"
            }
          ],
          "changeMeaning": "Show Earth and Mars orbiting the Sun.",
          "narration": "In the heliocentric model, this loop is a natural result of Earth moving faster on its inner orbit and overtaking Mars."
        },
        {
          "clipName": "clip3",
          "audioClip": "overtaking_effect",
          "autoAdvance": true,
          "changes": [
            {
              "target": "earth_orbiting"
            }
          ],
          "changeMeaning": "Earth passes Mars, creating the illusion of relative backward motion.",
          "narration": "Just like passing a slower car on a highway, Mars appears to drift backward as we pass it."
        },
        {
          "clipName": "clip4",
          "audioClip": "compare_planets",
          "autoAdvance": true,
          "changes": [
