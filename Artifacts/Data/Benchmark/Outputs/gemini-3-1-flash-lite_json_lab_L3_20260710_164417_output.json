      "moduleName": "Apparent Retrograde Motion: Earth Perspective",
      "description": "Students observe Mars's apparent retrograde motion from Earth's surface perspective.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Describe the apparent path of Mars across the night sky."
      ],
      "instructions": [
        "Watch how Mars traces a loop against the background constellations."
      ],
      "objects": [
