{
  "version": "2.0",
  "labId": "vector_projectile_motion_lab_001",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "General Physics I (Mechanics)",
  "objectives": [
    "Understand vector representation and addition.",
    "Master the mechanics of 2D projectile motion.",
    "Analyze independence of motion and gravity's role."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Vector Basics",
      "description": "Introduction to vector representation and graphical addition.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Represent a two-dimensional vector by its magnitude and direction.",
        "Add vectors graphically using the tip-to-tail method."
      ],
      "instructions": [
        "Observe the vector arrow and its magnitude label.",
        "Watch as a second vector is added to find the resultant."
      ],
      "objects": [
        {
          "prefab": "arrowPrefab",
          "name": "vectorArrow",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0,
            0,
            0
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "vectorLabel",
          "position": [
            0,
            0.5,
            0
          ],
          "scale": [
            1,
            1,
            1
          ]
        },
        {
          "prefab": "arrowPrefab",
          "name": "vectorArrow2",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.3,
            0.3,
            0.3
          ]
        },
        {
          "prefab": "arrowPrefab",
          "name": "resultantVector",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0,
            0,
            0
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "intro_vector_concept",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorArrow",
              "scale": [
                0.3,
                0.3,
                0.3
              ]
            },
            {
              "target": "vectorLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "V = 10 m/s",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Spawning the vector arrow and magnitude label.",
          "narration": "Vectors represent physical quantities with both magnitude and direction. Here, we see a velocity vector."
        },
        {
          "clipName": "clip1",
          "audioClip": "vector_addition_tip_to_tail",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorArrow2",
              "position": [
                0.5,
                0.5,
                0
              ]
            },
            {
              "target": "resultantVector",
              "position": [
                0.25,
                0.75,
                0
              ],
              "scale": [
                0.5,
                0.5,
                0.5
              ]
            }
          ],
          "changeMeaning": "Adding the second vector and resultant vector.",
          "narration": "By placing vectors tip-to-tail, we find their resultant. This is the foundation of adding multi-dimensional forces or velocities."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Projectile Motion Mechanics",
      "description": "Applying vector decomposition to understand projectile motion.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Explain why horizontal and vertical motions are independent.",
        "Identify the moment of maximum height as the point where vertical velocity is zero."
      ],
      "instructions": [
        "Observe the projectile path.",
        "Note the constant horizontal speed and changing vertical speed."
      ],
      "objects": [
        {
          "prefab": "moveableSphere",
          "name": "projectileSphere",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0,
            0,
            0
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "peakLabel",
          "position": [
            0.5,
            1,
            0
          ],
          "scale": [
            1,
            1,
            1
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip2",
          "audioClip": "projectile_motion_start",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectileSphere",
              "position": [
                0,
                0.5,
                0
              ],
              "scale": [
                0.2,
                0.2,
                0.2
              ]
            }
          ],
          "changeMeaning": "Setting up the projectile trajectory path.",
          "narration": "Now, let's apply vectors to projectile motion. The initial velocity vector determines the entire trajectory."
        },
        {
          "clipName": "clip3",
          "audioClip": "independence_of_motion",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectileSphere",
              "components": [
                {
                  "componentType": "simpleRotation",
                  "timeRate": 1.0,
                  "rotationTime": 5
                }
              ]
            }
          ],
          "changeMeaning": "Showing constant horizontal movement and gravity-affected vertical movement.",
          "narration": "Notice how the horizontal velocity remains constant, while gravity causes the vertical velocity to change. They are independent."
        },
        {
          "clipName": "clip4",
          "audioClip": "max_height_analysis",
          "autoAdvance": true,
          "changes": [
            {
              "target": "peakLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Vy = 0 at peak",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Labeling the peak of the trajectory.",
          "narration": "At the peak of the arc, the vertical velocity is zero. This is a critical point for calculations."
        }
      ]
    }
  ]
}