  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Introduction to Vectors",
      "description": "Exploration of vectors as abstract mathematical objects with magnitude and direction.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Students will represent a two-dimensional vector by its magnitude and direction."
      ],
      "instructions": [
        "Grab the head of the blue arrow to manipulate the vector. Observe the magnitude and angle values."
      ],
      "objects": [
        {
          "prefab": "moveableSphere",
          "name": "physicsVectorArrow",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.1,
            0.5,
            0.1
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "vectorLabel",
          "position": [
            0,
            1.2,
            0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ],
          "components": [
            {
              "componentType": "textMeshPro",
              "text": "Magnitude: 0, Angle: 0",
              "fontSize": 30
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "vector_intro_narration",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Magnitude: 5.0m, Angle: 45 deg",
                  "fontSize": 30
                }
              ]
            },
            {
              "target": "physicsVectorArrow",
              "position": [
                0,
                0.5,
                0
              ]
            }
          ],
          "changeMeaning": "Initialize the vector scene with a single arrow and coordinate labels.",
          "narration": "Vectors are quantities with both magnitude and direction. Unlike scalars, they exist in space. Grab the arrow head to see how magnitude and angle update."
        },
        {
          "clipName": "clip1",
          "audioClip": "vector_interaction_narration",
          "autoAdvance": false,
          "changes": [
            {
              "target": "vectorLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Magnitude: 7.2m, Angle: 30 deg",
                  "fontSize": 30
                }
              ]
            },
            {
              "target": "physicsVectorArrow",
              "eulerAngles": [
                0,
                30,
                0
              ]
            }
          ],
          "changeMeaning": "Show dynamic updates to vector labels.",
          "narration": "As you rotate or resize the vector, note how the magnitude and angle components change in real-time."
        }
      ]
    },
    {
