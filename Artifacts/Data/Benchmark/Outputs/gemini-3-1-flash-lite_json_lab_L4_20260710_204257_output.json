            0,
            0
          ],
          "scale": [
            0.1,
            0.5,
            0.1
          ]
        },
        {
          "prefab": "moveableSphere",
          "name": "secondVectorArrow",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.1,
            0.5,
            0.1
          ]
        },
        {
          "prefab": "moveableSphere",
          "name": "resultantVectorArrow",
          "position": [
            0,
            0,
            0
