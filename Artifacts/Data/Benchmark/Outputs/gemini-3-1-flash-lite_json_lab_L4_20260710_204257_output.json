      "clips": [
        {
          "clipName": "clip2",
          "audioClip": "vector_addition_narration",
          "autoAdvance": false,
          "changes": [
            {
              "target": "secondVectorArrow",
              "position": [
                0.5,
                0,
                0
              ]
            },
            {
              "target": "resultantVectorArrow",
              "position": [
                0,
                0,
                0.3
              ]
            }
          ],
          "changeMeaning": "Add a second vector to demonstrate tip-to-tail addition.",
          "narration": "Vector addition is performed tip-to-tail. The resultant vector spans from the origin to the head of the final vector. Notice how the resultant changes as you move the constituent vectors."
        }
      ]
    },
