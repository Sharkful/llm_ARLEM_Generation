  "activity": {
    "id": "retrograde_activity",
    "name": "Understanding Retrograde Motion",
    "description": "An exploration of apparent retrograde motion in the heliocentric and geocentric models.",
    "language": "en",
    "workplace": "retrograde_lab_wp",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "earth_viewpoint",
        "instruction": {
          "title": "Observing Mars",
          "description": "Welcome to the Apparent Retrograde Motion lab. Let's observe the night sky over several weeks from Earth's surface. Notice how Mars slowly drifts eastward relative to the background stars. Click your headset to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_viewpoint",
              "type": "predicate",
              "augmentation": "anim_night_sky",
              "poi": "default",
              "state": "eastward_drift"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "audio_narration"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_2_retrograde"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_retrograde",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "earth_viewpoint",
        "instruction": {
          "title": "The Retrograde Loop",
          "description": "Wait, what is happening? Roughly every 26 months, Mars appears to slow down, reverses direction (westward) for about two months, then resumes its eastward motion. Say 'Next' to explore why this retrograde loop occurs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_model",
              "type": "predicate",
              "augmentation": "anim_night_sky",
              "poi": "default",
              "state": "retrograde_loop"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_3_geocentric"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "ar_headset",
            "value": "Next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "space_viewpoint",
        "instruction": {
          "title": "The Geocentric Explanation",
          "description": "In the ancient Earth-centered (geocentric) model, astronomers had to invent complex 'epicycles'\u2014circles moving on circles\u2014to explain this backwards loop. This made the model awkward and complicated. Click the space observatory viewpoint to shift perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "space_viewpoint",
              "type": "predicate",
              "augmentation": "img_epicycle",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_4_heliocentric"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "space_viewpoint",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "space_viewpoint",
        "instruction": {
          "title": "The Heliocentric Solution",
          "description": "Now view from outside the solar system! In the heliocentric model, Earth orbits faster than Mars. The loop happens naturally because Earth overtakes Mars on the inside track, like a faster car passing a slower one. Move closer to the Earth model to trigger the next step."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_model",
              "type": "predicate",
              "augmentation": "anim_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_5_outer_planets"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "earth_model",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_5_outer_planets",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "space_viewpoint",
        "instruction": {
          "title": "Comparing Outer Planets",
          "description": "Jupiter and Saturn also exhibit retrograde motion. However, because they are further away from the Sun, the relative motion effect is smaller, resulting in smaller retrograde loops. Click the outer planets model to finish the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "jupiter_saturn_model",
              "type": "predicate",
              "augmentation": "anim_outer_loops",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "jupiter_saturn_model",
            "operator": "equal"
          }
        ]
      }
    ]
  }
}