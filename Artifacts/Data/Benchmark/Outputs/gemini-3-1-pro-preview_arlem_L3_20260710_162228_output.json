  "activity": {
    "id": "act_heart_anatomy",
    "name": "Anatomy Lab: The Human Heart and Circulation",
    "description": "An exploration of the structural anatomy of the human heart, tracing the path of blood through the four chambers, identifying the valves, and comparing myocardial thickness across the dual-loop circulation.",
    "language": "en",
    "workplace": "wp_heart_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens",
        "location": "dissection_table",
        "instruction": {
          "title": "Introduction to the Heart",
          "description": "Welcome to the Human Anatomy AR Lab. Today we will explore the structural anatomy of the human heart. Please locate the heart model on the dissection table."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "pred_audio_intro"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_2_chambers"
            }
          ],
          "deactivate": [
            {
              "target": "learner",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_1_intro",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens",
        "location": "dissection_table",
        "instruction": {
          "title": "The Four Chambers",
          "description": "The heart has four chambers: two upper atria and two lower ventricles. The right side handles deoxygenated blood, while the left side handles oxygenated blood. Say 'Next' to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "pred_audio_chambers"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_ra",
              "text": "Right Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_rv",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_la",
              "text": "Left Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_lv",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_3_valves"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_2_chambers",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens",
        "location": "dissection_table",
        "instruction": {
          "title": "Heart Valves & Backflow Prevention",
          "description": "Notice the four valves. They ensure one-way blood flow. Atrioventricular valves separate atria from ventricles, while semilunar valves separate ventricles from exiting arteries. Click 'Next' on your device."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "pred_audio_valves"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_anim_valves",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_pulmonary",
              "text": "Pulmonary Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_mitral",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_aortic",
              "text": "Aortic Valve"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_4_flow"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_valves",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_flow",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens",
        "location": "dissection_table",
        "instruction": {
          "title": "Tracing Blood Flow",
          "description": "Follow the animation tracing the dual-loop circulation. Deoxygenated blood travels from the right heart to the lungs. Oxygenated blood returns to the left heart and is pumped to the body. Click 'Next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "pred_audio_flow"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_anim_flow",
              "poi": "default"
            },
            {
              "target": "lungs_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_lungs",
              "text": "Pulmonary Circuit (To Lungs)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_5_myocardium"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "lungs_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_flow",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_5_myocardium",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens",
        "location": "dissection_table",
        "instruction": {
          "title": "Myocardial Thickness",
          "description": "Observe the difference in wall thickness. The left ventricle has a much thicker myocardium because it must generate higher pressure to perfuse the entire systemic circuit, compared to the lower pressure pulmonary circuit. Say 'Finish'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "pred_audio_myocardium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_lv_wall",
              "text": "Thick Myocardium (Systemic Circuit)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "poi_rv_wall",
              "text": "Thinner Myocardium (Pulmonary Circuit)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "predicate"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_5_myocardium",
            "type": "action",
            "operator": "equal"
          }
        ]
      }
    ]
  }
