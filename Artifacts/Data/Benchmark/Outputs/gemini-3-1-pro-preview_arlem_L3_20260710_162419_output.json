  "activity": {
    "id": "act_vectors_projectiles",
    "name": "Vectors and Projectiles Lab",
    "description": "An AR lab on 2D vectors and projectile motion kinematics.",
    "language": "en",
    "workplace": "wp_physics_vectors",
    "start": "step_1_vector_components",
    "actions": [
      {
        "id": "step_1_vector_components",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_bench",
        "instruction": {
          "title": "1. Vector Components",
          "description": "Welcome to the physics lab. Let's explore vectors! A 2D velocity vector can be broken down into horizontal (x) and vertical (y) components. Observe the vector on the board. Click Next when ready."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_vector_v",
              "poi": "center"
            },
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_vector_vx",
              "poi": "center"
            },
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_vector_vy",
              "poi": "center"
            },
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "center",
              "text": "Velocity = Vx + Vy"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_vector_components",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_vector_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_bench",
        "instruction": {
          "title": "2. Tip-to-Tail Addition",
          "description": "We can reconstruct the original vector using the tip-to-tail method. Watch how the x and y components add together graphically to form the resultant vector. Right-triangle trigonometry relates these magnitudes. Say 'Continue'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_tiptotail_anim",
              "poi": "center"
            },
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "center",
              "text": "Say 'Continue' to advance"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_board",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_2_vector_addition",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_projectile_independence",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_bench",
        "instruction": {
          "title": "3. Independent Motions",
          "description": "Now look at the projectile launcher. When a projectile is fired, its horizontal and vertical motions are independent! Gravity acts only vertically, so Vy changes while Vx remains constant. Click Next to analyze the peak."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_projectile_traj",
              "poi": "muzzle"
            },
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "muzzle",
              "text": "Constant Vx, Changing Vy"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_label_generic"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_projectile_independence",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_max_height",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_bench",
        "instruction": {
          "title": "4. Maximum Height",
          "description": "Identify the maximum height of the trajectory. At this exact moment, the vertical velocity (Vy) becomes zero before reversing direction. Look closely at the peak label to trigger the next step."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_projectile_traj",
              "poi": "muzzle"
            },
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "peak",
              "text": "Vy = 0 at Maximum Height"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_launcher",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_5_adjust_angle",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_floor",
        "instruction": {
          "title": "5. Launch Angle and Range",
          "description": "Move to the floor zone. Launch angle affects the trajectory's range and height. A 45-degree angle produces the maximum range. Adjust the launcher and click Launch to hit the target."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_floor",
              "type": "predicate",
              "augmentation": "pred_audio_launch",
              "poi": "default"
            },
            {
              "target": "thing_target",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "bullseye",
              "text": "Target: Max Range (45 degrees)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_target",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_adjust_angle",
            "type": "action",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_6_conclusion",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_floor",
        "instruction": {
          "title": "6. Conclusion",
          "description": "Excellent! You have successfully represented vectors, decomposed them, and observed how independent horizontal and vertical motions govern projectile kinematics. Click Finish to conclude the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_audio_success",
              "poi": "default"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "default",
              "text": "Lab Complete!"
            }
          ],
