              "type": "action",
              "augmentation": "act_compare_planets"
            }
          ],
          "deactivate": [
            {
              "target": "solar_system_table",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_compare_planets",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "solar_system_table",
        "instruction": {
          "title": "Comparing Outer Planets",
          "description": "Observe Jupiter and Saturn alongside Mars. Mars makes a large 15-degree loop, Jupiter makes a 10-degree loop, and Saturn's is only 7 degrees. More distant planets show smaller loops because Earth's orbital motion subtends a smaller angle from farther away, similar to how parallax affects nearby objects more strongly than distant ones."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "jupiter_saturn_model",
              "type": "predicate",
              "augmentation": "anim_compare_planets"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "audio_compare"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
