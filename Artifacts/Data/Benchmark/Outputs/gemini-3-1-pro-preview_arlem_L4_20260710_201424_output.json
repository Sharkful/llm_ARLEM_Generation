              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_rbc_trace",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Step-by-Step RBC Trace",
          "description": "Follow a single red blood cell tracing the full circulation path. Notice how the atrium contracts to push the cell through the atrioventricular valve, followed by ventricular contraction pushing it through the semilunar valve."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_model_cutaway",
              "poi": "default"
            },
            {
              "target": "red_blood_cell",
              "type": "predicate",
              "augmentation": "pred_anim_rbc",
              "poi": "default"
            },
            {
