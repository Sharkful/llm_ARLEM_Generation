  "activity": {
    "id": "activity_heart_anatomy",
    "name": "Human Heart Anatomy and Blood Flow",
    "description": "An exploration of the structural anatomy of the human heart, blood paths, dual-loop circulation, and ventricular wall thickness. Designed for undergraduate Anatomy and Physiology students.",
    "language": "en",
    "workplace": "workplace_anatomy_lab",
    "start": "step_1_orientation",
    "actions": [
      {
        "id": "step_1_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Exterior View & Gross Orientation",
          "description": "Observe the full-size human heart models in the workspace. On the left is the intact exterior showing major vessels entering and leaving. On the right is a cutaway view exposing the four chambers, the septum, and the four valves. You can rotate both models to understand the anatomical orientation from a patient's perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "intact_heart",
              "type": "predicate",
              "augmentation": "pred_model_intact",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_model_cutaway",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "pred_audio_scene1",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Follow the highlights as we tour the internal structures. We will identify the four chambers, the four valves separating them, and the major vessels including the superior and inferior vena cava, pulmonary arteries/veins, and aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_model_cutaway",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Right Atrium"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Right Ventricle"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Left Atrium"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Left Ventricle"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Tricuspid & Pulmonary Valves"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Mitral/Bicuspid & Aortic Valves"
            },
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "pred_audio_scene2",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_dual_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Dual-Circuit Blood Stream",
          "description": "Observe the continuous color-coded blood flow. Blue represents deoxygenated blood in the right side being pumped to the pulmonary circuit. Red represents oxygenated blood returning to the left side and pumped to the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_model_cutaway",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_anim_flow",
              "poi": "default"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Pulmonary Circuit (Low O2)"
            },
            {
              "target": "cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Systemic Circuit (High O2)"
            },
