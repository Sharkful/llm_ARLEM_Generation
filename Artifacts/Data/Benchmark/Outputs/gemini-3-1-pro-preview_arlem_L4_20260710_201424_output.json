        "id": "step_6_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Valve Function & Preventing Backflow",
          "description": "Watch the synchronization of the valves. Atrioventricular valves prevent backflow into atria during contraction, while semilunar valves prevent backflow into ventricles during relaxation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
