        ]
      },
      {
        "id": "step_5_wall_thickness",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "lab_bench",
        "instruction": {
          "title": "Wall Thickness Asymmetry",
          "description": "Compare the myocardial thickness of the ventricles. The right ventricle has a thin wall for the low-pressure pulmonary circuit, while the left ventricle's thick wall provides the high pressure needed for systemic perfusion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cross_section",
              "type": "predicate",
              "augmentation": "pred_model_cross",
              "poi": "default"
            },
            {
              "target": "cross_section",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "RV Myocardium (~3-5 mm)"
            },
            {
              "target": "cross_section",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "LV Myocardium (~10-15 mm)"
            },
            {
              "target": "lab_bench",
