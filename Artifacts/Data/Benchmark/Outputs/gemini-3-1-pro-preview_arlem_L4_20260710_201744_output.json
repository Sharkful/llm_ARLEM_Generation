  "activity": {
    "id": "act_projectile_motion",
    "name": "Vectors and Projectile Motion Lab",
    "description": "An exploration of vectors as mathematical tools for representing quantities with magnitude and direction, and the application of vector operations to 2D projectile motion.",
    "language": "en",
    "workplace": "wp_physics_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "workspace_3d",
        "instruction": {
          "title": "1. Introduction to Vectors",
          "description": "A vector represents a quantity with both size (magnitude) and direction. Grab the arrow's head to move it around in 3D space; notice how the numerical magnitude and direction labels update in real-time. Click the vector to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow",
              "type": "predicate",
              "augmentation": "anim_intro",
              "poi": "default"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "narr_1"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_arrow",
              "augmentation": "anim_intro"
            },
            {
              "target": "learner",
              "augmentation": "narr_1"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_arrow",
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "workspace_3d",
        "instruction": {
          "title": "2. Vector Addition",
          "description": "Vector addition uses the tip-to-tail method. The blue and green vectors add up to the red resultant. Swap their order and see that the resultant remains the same. Click the vector to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
