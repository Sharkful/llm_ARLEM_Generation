  "activity": {
    "id": "activity_vsepr",
    "name": "VSEPR Theory and Molecular Geometry",
    "description": "An exploration of VSEPR theory and how it predicts the three-dimensional geometry of covalent molecules. Students learn to determine steric numbers, predict electron-domain and molecular geometries, understand lone pair asymmetry, and predict 3D structures from Lewis structures.",
    "language": "en",
    "workplace": "workplace_chem_lab",
    "start": "action_1",
    "actions": [
      {
        "id": "action_1",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_desk",
        "instruction": {
          "title": "1. Introduction to VSEPR",
          "description": "Welcome to the VSEPR Lab. A molecule's 3D geometry is predicted from its flat Lewis structure. We count the electron domains (bonds and lone pairs) around the central atom. Since electrons repel one another, these domains space out as far as possible to minimize repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_desk",
              "type": "predicate",
              "augmentation": "pred_audio_intro"
            },
            {
              "target": "place_desk",
              "type": "predicate",
              "augmentation": "pred_img_lewis",
              "poi": "label_poi"
            },
            {
              "target": "place_desk",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "label_poi",
              "text": "Water (H2O) Lewis Structure"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_desk",
              "type": "*"
            }
          ],
          "messages": [
            {
              "target": "device_headset",
              "type": "device",
              "text": "proceed",
              "launch": "action_2"
            }
          ],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "device_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_2",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_desk",
        "instruction": {
          "title": "2. The Minimum-Repulsion Principle",
          "description": "Watch the domains arrange themselves. Two domains form a linear shape at 180 degrees. Three form a trigonal planar shape at 120 degrees. Four domains produce a tetrahedral geometry at 109.5 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_audio_repulse"
            },
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_anim_repulse",
              "poi": "default"
            },
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "label_poi",
              "text": "Tetrahedral (109.5\u00b0)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_center",
              "type": "*"
            }
          ],
          "messages": [
            {
              "target": "device_headset",
              "type": "device",
              "text": "proceed",
              "launch": "action_3"
            }
          ],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "device_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_3",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_desk",
        "instruction": {
          "title": "3. Expanded Octets",
          "description": "Building from the tetrahedron, a fifth domain creates a trigonal bipyramidal shape (90 and 120 degrees). A sixth domain yields an octahedral shape, with all adjacent domains perfectly separated by 90 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_audio_expand"
            },
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_anim_expand",
              "poi": "default"
            },
            {
              "target": "thing_center",
              "type": "predicate",
              "augmentation": "pred_label",
              "poi": "label_poi",
