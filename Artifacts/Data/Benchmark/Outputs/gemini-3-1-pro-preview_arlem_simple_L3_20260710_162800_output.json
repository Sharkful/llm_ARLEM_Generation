  "activity": {
    "id": "retrograde_motion_lab",
    "name": "Apparent Retrograde Motion",
    "description": "An interactive lab demonstrating how the apparent retrograde motion of Mars is caused by Earth overtaking it in a heliocentric orbit, comparing this phenomenon across the outer planets.",
    "workplace": "astronomy_lab_01",
    "start": "act_1_night_sky",
    "actions": [
      {
        "id": "act_1_night_sky",
        "instruction": {
          "title": "The Night Sky View",
          "description": "Observe Mars's apparent path across the background stars over several months. Notice how it normally drifts eastward, but periodically slows down, loops westward for about two months, and then resumes its eastward motion. This is called 'apparent retrograde motion'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_earth_view",
              "type": "predicate",
              "augmentation": "pred_night_sky_video"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_earth_view",
              "type": "action",
              "augmentation": "act_2_geocentric"
            }
          ],
          "deactivate": [
            {
              "target": "place_earth_view",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_1_night_sky"
          }
        ]
      },
      {
        "id": "act_2_geocentric",
        "instruction": {
          "title": "The Geocentric Epicycle Model",
          "description": "Historically, the geocentric (Earth-centered) model explained this loop using complex 'epicycles' - small circular orbits superimposed on larger ones. Watch the animation to see how ancient astronomers imagined Mars moving."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_epicycle_anim",
              "poi": "center"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "action",
              "augmentation": "act_3_heliocentric"
            }
          ],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_2_geocentric"
          }
        ]
      },
      {
        "id": "act_3_heliocentric",
        "instruction": {
          "title": "The Heliocentric Reality",
          "description": "Now let's step outside the solar system. In the heliocentric (Sun-centered) model, both Earth and Mars orbit the Sun. Earth is on an inner track and moves faster than Mars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_heliocentric_anim",
              "poi": "center"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_label",
              "text": "Mars"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "action",
              "augmentation": "act_4_overtaking"
            }
          ],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_3_heliocentric"
          }
        ]
      },
      {
        "id": "act_4_overtaking",
        "instruction": {
          "title": "The Overtaking Effect",
          "description": "As Earth overtakes Mars on the inside track, our line of sight to Mars shifts backward against the distant stars. It's an optical illusion, just like passing a slower car on the highway! Pick up or lean in to inspect the Mars model to confirm its smooth orbit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_heliocentric_anim",
              "poi": "center"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_look_closer_label",
              "text": "Inspect Mars Model"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_mars",
              "type": "action",
              "augmentation": "act_5_jupiter_saturn"
            }
          ],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_mars"
          }
        ]
      },
      {
        "id": "act_5_jupiter_saturn",
        "instruction": {
          "title": "Comparing Outer Planets",
          "description": "Mars has a very wide retrograde loop because it is close to Earth. Jupiter and Saturn are much farther away. Because they are more distant, the parallax effect is smaller, resulting in narrower, less dramatic retrograde loops."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system",
              "type": "predicate",
              "augmentation": "pred_jup_sat_anim",
              "poi": "center"
            },
            {
              "target": "thing_jupiter",
              "type": "predicate",
              "augmentation": "pred_jupiter_label",
              "text": "Jupiter"
            },
            {
              "target": "thing_saturn",
              "type": "predicate",
              "augmentation": "pred_saturn_label",
              "text": "Saturn"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_jupiter",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_saturn",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_5_jupiter_saturn"
          }
        ]
      }
    ]
  }
