  "activity": {
    "id": "dna_replication_activity",
    "name": "DNA Structure and Replication Lab",
    "description": "An exploration of the three-dimensional structure of DNA and the semiconservative process by which it replicates. Students will examine the double helix, base pairing, and the replication fork mechanisms including leading and lagging strand synthesis.",
    "workplace": "molbio_lab_wp",
    "start": "step_1",
    "actions": [
      {
        "id": "step_1",
        "instruction": {
          "title": "The Double Helix and Backbone",
          "description": "Observe the 3D DNA model. Notice the two antiparallel sugar-phosphate backbones spiraling around a common axis to form the double helix structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model",
              "type": "predicate",
              "augmentation": "p_backbone",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "dna_model",
              "type": "action",
              "augmentation": "step_2"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1"
          }
        ]
      },
      {
        "id": "step_2",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Examine the nitrogenous bases projecting inward. Adenine (A) always pairs with Thymine (T) via 2 hydrogen bonds, while Guanine (G) pairs with Cytosine (C) via 3 hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model",
              "type": "predicate",
              "augmentation": "p_base_pairs",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "dna_model",
              "type": "action",
              "augmentation": "step_3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2"
          }
        ]
      },
      {
        "id": "step_3",
        "instruction": {
          "title": "Antiparallel Orientation",
          "description": "Notice the directionality of the strands. Because of the sugar-phosphate backbone's structure, one strand runs 5' to 3', while the complementary strand runs 3' to 5'. This is the antiparallel orientation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "helix_top",
              "text": "5' to 3' Directionality"
            },
            {
              "target": "dna_model",
              "type": "predicate",
              "augmentation": "p_antiparallel",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "enzyme_station",
              "type": "action",
              "augmentation": "step_4"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3"
          }
        ]
      },
      {
        "id": "step_4",
        "instruction": {
          "title": "Unwinding the Helix",
          "description": "To begin replication, the helix must unwind. Look at the Enzyme Station to grab Helicase. Watch how Helicase unwinds the double helix at the replication fork, while single-strand binding proteins stabilize the exposed strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model",
              "type": "predicate",
              "augmentation": "p_helicase",
              "poi": "replication_fork"
            },
            {
              "target": "enzyme_station",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Look here for Helicase"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "dna_model",
              "type": "action",
              "augmentation": "step_5"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "enzyme_station"
          }
        ]
      },
      {
        "id": "step_5",
        "instruction": {
          "title": "Synthesizing New Strands",
          "description": "DNA polymerase synthesizes new strands, but only in the 5' to 3' direction. The leading strand is synthesized continuously. The lagging strand is built discontinuously in short Okazaki fragments, which are later joined by DNA ligase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_model",
              "type": "predicate",
              "augmentation": "p_polymerase",
              "poi": "replication_fork"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "whiteboard",
              "type": "action",
              "augmentation": "step_6"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5"
          }
        ]
      },
      {
        "id": "step_6",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "After replication is complete, each new daughter DNA molecule contains one original parental strand and one newly-synthesized strand. This is why DNA replication is known as a semiconservative process."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "whiteboard",
              "type": "predicate",
              "augmentation": "p_semi",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6"
          }
        ]
      }
    ]
  }
