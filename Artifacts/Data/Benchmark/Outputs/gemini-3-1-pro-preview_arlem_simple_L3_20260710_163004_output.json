  "activity": {
    "id": "act_heart_anatomy",
    "name": "Human Heart Anatomy & Blood Flow",
    "description": "An interactive lab exploring the structural anatomy of the human heart, tracing the dual-loop circulation, and understanding myocardium thickness and valve function.",
    "workplace": "wp_anatomy_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "The Four Chambers",
          "description": "Welcome! Observe the human heart model. Identify the right and left atria (top) and ventricles (bottom)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_ra",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_rv",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_la",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_lv",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_heart",
              "type": "action",
              "augmentation": "step_2_right_side"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_intro"
          }
        ]
      },
      {
        "id": "step_2_right_side",
        "instruction": {
          "title": "The Pulmonary Circuit: Right Side",
          "description": "Deoxygenated blood enters the Right Atrium, passes the tricuspid valve, and is pumped by the Right Ventricle to the lungs. Point your wand at the Right Ventricle to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_blue_flow",
              "poi": "poi_rv"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_heart",
              "type": "action",
              "augmentation": "step_3_lungs"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_pointer",
            "duration": 1500
          }
        ]
      },
      {
        "id": "step_3_lungs",
        "instruction": {
          "title": "Oxygenation in the Lungs",
          "description": "Blood travels via the pulmonary arteries to the lungs, where it drops off CO2 and picks up Oxygen."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_lungs",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Lungs: Gas Exchange"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_heart",
              "type": "action",
              "augmentation": "step_4_left_side"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_lungs"
          }
        ]
      },
      {
        "id": "step_4_left_side",
        "instruction": {
          "title": "The Systemic Circuit: Left Side",
          "description": "Oxygenated blood returns to the Left Atrium via pulmonary veins, passes the mitral valve into the Left Ventricle, and is pumped out the Aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_red_flow",
              "poi": "poi_lv"
            },
            {
              "target": "thing_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_aorta",
              "text": "Aorta"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_board",
              "type": "action",
              "augmentation": "step_5_myocardium"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_left_side"
          }
        ]
      },
      {
        "id": "step_5_myocardium",
        "instruction": {
          "title": "Myocardium Thickness",
          "description": "Look at the diagram on the whiteboard. The Left Ventricle has a much thicker myocardium (muscle wall) because it must pump blood through the entire body under high pressure, unlike the right side which only pumps to the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_board",
              "type": "predicate",
              "augmentation": "pred_myocardium_img",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_board",
              "type": "action",
              "augmentation": "step_6_valves"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_myocardium"
          }
        ]
      },
      {
        "id": "step_6_valves",
        "instruction": {
          "title": "Heart Valves",
          "description": "Notice the atrioventricular and semilunar valves. They prevent backflow, ensuring one-way blood flow during the cardiac cycle. This concludes the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_board",
              "type": "predicate",
              "augmentation": "pred_valves_img",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6_valves"
          }
        ]
      }
    ]
  }
}