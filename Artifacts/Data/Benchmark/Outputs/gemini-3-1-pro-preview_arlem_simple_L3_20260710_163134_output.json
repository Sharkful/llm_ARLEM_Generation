  "activity": {
    "id": "act_vectors_projectile",
    "name": "Vectors and 2D Projectile Motion Lab",
    "description": "An interactive physics lab exploring vector addition, right-triangle trigonometric decomposition, and their application to 2D projectile motion. Students observe how independent horizontal and vertical motions create a parabolic trajectory.",
    "workplace": "wp_vectors_projectile",
    "start": "step_1_vector_add",
    "actions": [
      {
        "id": "step_1_vector_add",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Vectors represent quantities with both magnitude and direction. Look at the Vector Board to observe how two vectors are added graphically using the tip-to-tail method to produce a resultant vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vectorboard",
              "type": "predicate",
              "augmentation": "pred_anim_vector_add",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vectorboard",
              "type": "predicate",
              "augmentation": "pred_anim_vector_add",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_vector_add"
          }
        ]
      },
      {
        "id": "step_2_components",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Any two-dimensional vector can be decomposed into horizontal (x) and vertical (y) components using right-triangle trigonometry. Notice how the original vector forms the hypotenuse of the triangle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vectorboard",
              "type": "predicate",
              "augmentation": "pred_anim_components",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vectorboard",
              "type": "predicate",
              "augmentation": "pred_anim_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_components"
          }
        ]
      },
      {
        "id": "step_3_cannon_setup",
        "instruction": {
          "title": "Initial Velocity of a Projectile",
          "description": "Let's apply vectors to projectile motion. Focus on the Cannon. The initial launch angle and speed determine the initial velocity vector, which is instantly decomposed into independent horizontal and vertical velocities."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cannon",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "muzzle",
              "text": "V0 = Vx + Vy"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_cannon",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "muzzle"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_cannon_setup"
          }
        ]
      },
      {
        "id": "step_4_independent_motion",
        "instruction": {
          "title": "Independent x and y Motions",
          "description": "Observe the simulated trajectory. Because gravity only acts downwards, the horizontal velocity (Vx) remains perfectly constant. The vertical velocity (Vy) decreases steadily on the way up, reaches zero at maximum height, and increases downwards."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_launchpad",
              "type": "predicate",
              "augmentation": "pred_anim_trajectory",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_launchpad",
              "type": "predicate",
              "augmentation": "pred_anim_trajectory",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_independent_motion"
          }
        ]
      },
      {
        "id": "step_5_max_range",
        "instruction": {
          "title": "Maximizing the Projectile Range",
          "description": "The combination of constant horizontal motion and accelerated vertical motion creates a parabolic path. Adjust the cannon to exactly 45 degrees to achieve the theoretical maximum range, and watch the projectile strike the Target Zone."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cannon",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "default",
              "text": "Adjust to 45\u00b0 Launch Angle"
            },
            {
              "target": "place_targetzone",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "default",
              "text": "Expected Max Range Impact"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_cannon",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "default"
            },
            {
              "target": "place_targetzone",
              "type": "predicate",
              "augmentation": "pred_label_generic",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_cannon"
          }
        ]
      }
    ]
