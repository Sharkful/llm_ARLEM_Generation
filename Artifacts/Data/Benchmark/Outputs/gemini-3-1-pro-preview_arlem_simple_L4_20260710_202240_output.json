  "activity": {
    "id": "act_dna_rep",
    "name": "DNA Structure and Replication",
    "description": "An exploration of the three-dimensional structure of DNA and the semiconservative process by which it replicates.",
    "workplace": "wp_molbio_lab",
    "start": "step_1_ladder",
    "actions": [
      {
        "id": "step_1_ladder",
        "instruction": {
          "title": "The DNA Ladder",
          "description": "Observe the schematic ladder representation of DNA. The vertical lines represent the sugar-phosphate backbones, while the horizontal rungs are the nitrogenous bases (A, T, G, C) pairing across the center. Note the specific complementary base pairings."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_ladder",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "action",
              "augmentation": "step_2_helix"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_stand"
          }
        ]
      },
      {
        "id": "step_2_helix",
        "instruction": {
          "title": "The Double Helix",
          "description": "Watch as the schematic ladder twists into the realistic double-helix shape. The backbones spiral around a common axis, completing a full turn approximately every ten base pairs. This is the 3D geometry of DNA in living cells."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_helix",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_helix",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "action",
              "augmentation": "step_3_antiparallel"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_stand"
          }
        ]
      },
      {
        "id": "step_3_antiparallel",
        "instruction": {
          "title": "Antiparallel Orientation",
          "description": "Notice the arrows appearing on the backbones. One strand runs 5' to 3' upwards, while the complementary strand runs 3' to 5' downwards. This antiparallel orientation is determined by the directional chemistry of the sugar-phosphate backbones."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_antiparallel",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_antiparallel",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "action",
              "augmentation": "step_4_unwinding"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_stand"
          }
        ]
      },
      {
        "id": "step_4_unwinding",
        "instruction": {
          "title": "Unwinding the Fork",
          "description": "Replication begins! Observe the Helicase enzyme unwinding the double helix by breaking hydrogen bonds. Behind it, Single-Strand Binding Proteins (SSBs) attach to prevent the exposed strands from collapsing back together."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_unwinding",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_unwinding",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "action",
              "augmentation": "step_5_polymerase"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_stand"
          }
        ]
      },
      {
        "id": "step_5_polymerase",
        "instruction": {
          "title": "Synthesizing New Strands",
          "description": "DNA Polymerase arrives. Because it only synthesizes 5' to 3', the 'leading strand' is built continuously towards the fork. The 'lagging strand' is built discontinuously away from the fork in short segments called Okazaki fragments, which DNA Ligase later joins."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_polymerase",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_polymerase",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "action",
              "augmentation": "step_6_semiconservative"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_stand"
          }
        ]
      },
      {
        "id": "step_6_semiconservative",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "The result of replication is two daughter molecules. Notice their colors: each has one original (gold) strand and one newly-synthesized (silver) strand. This is why DNA replication is termed 'semiconservative'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_stand",
              "type": "predicate",
              "augmentation": "anim_semiconservative",
              "poi": "default"
            },
            {
              "target": "place_lab_bench",
              "type": "predicate",
              "augmentation": "audio_semiconservative",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
