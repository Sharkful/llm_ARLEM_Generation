  "activity": {
    "id": "act_heart_anatomy",
    "name": "Human Anatomy Lab: The Heart",
    "description": "An exploration of the structural anatomy of the human heart, the dual-loop circulation, and the functional dynamics of its chambers and valves.",
    "workplace": "wp_anatomy_lab",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "Exterior View of the Heart",
          "description": "Welcome to the Anatomy Lab. In front of you is a full-size human heart. On the left is the intact exterior showing major vessels. On the right is a cutaway view exposing the internal chambers. Note that left and right refer to the patient's left and right. Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_intact",
              "type": "predicate",
              "augmentation": "pred_audio_intro",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_audio_intro_cutaway",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro"
          }
        ]
      },
      {
        "id": "step2_tour",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Let's take a structural tour. Observe the highlighted chambers and valves in the cutaway view. The sequence runs from the right atrium, through the tricuspid valve to the right ventricle, and similarly on the left side through the mitral/bicuspid valve. Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_audio_tour",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_tour"
          }
        ]
      },
      {
        "id": "step3_dual_circuit",
        "instruction": {
          "title": "Dual-Circuit Blood Stream",
          "description": "Notice the flowing colors. The right side pumps deoxygenated (blue) blood to the lungs via the pulmonary circuit. The left side pumps oxygenated (red) blood to the rest of the body via the systemic circuit. Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_anim_blood_flow",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_audio_circuit",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Pulmonary Circuit (Blue)"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Systemic Circuit (Red)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_dual_circuit"
          }
        ]
      },
      {
        "id": "step4_rbc_trace",
        "instruction": {
          "title": "Red Blood Cell Trace",
          "description": "Follow this single red blood cell. It enters the superior vena cava, travels through the right atrium and ventricle, gets oxygenated in the lungs, returns to the left atrium, and is pumped out the aorta. Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_rbc",
              "type": "predicate",
              "augmentation": "pred_audio_rbc",
              "poi": "default"
            },
            {
              "target": "thing_rbc",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Red Blood Cell Path"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_rbc_trace"
          }
        ]
      },
      {
        "id": "step5_wall_thickness",
        "instruction": {
          "title": "Ventricular Wall Thickness Asymmetry",
          "description": "Look at the cross-section zone. Compare the thin right ventricular wall (low pressure, pulmonary) with the thick left ventricular myocardium (high pressure, systemic). Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_cross_section",
              "type": "predicate",
              "augmentation": "pred_img_cross_section",
              "poi": "default"
            },
            {
              "target": "place_cross_section",
              "type": "predicate",
              "augmentation": "pred_audio_thickness",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_wall_thickness"
          }
        ]
      },
      {
        "id": "step6_valve_function",
        "instruction": {
          "title": "Valve Function and Backflow",
          "description": "Watch the atrioventricular (tricuspid/mitral) and semilunar (pulmonary/aortic) valves open and close. Their leaflet structures seal tight to prevent backflow during the cardiac cycle. Click to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_anim_valves",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_audio_valves",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6_valve_function"
          }
        ]
      },
      {
        "id": "step7_recap",
        "instruction": {
          "title": "Summary Recap & Quiz",
          "description": "You have explored the chambers, valves, vessels, circuits, wall thicknesses, and flow mechanisms of the human heart. Please complete the structure and blood flow quizzes in your lab manual to finish. Click to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_quiz",
