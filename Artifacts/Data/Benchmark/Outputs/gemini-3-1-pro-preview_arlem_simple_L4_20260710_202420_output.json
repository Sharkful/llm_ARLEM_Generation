  "activity": {
    "id": "act_vectors_projectiles",
    "name": "Physics Mechanics: Vectors and Projectiles",
    "description": "An exploration of vectors and their application to 2D projectile motion. Students interact with abstract vectors, perform addition and decomposition, and then apply these concepts to analyze the parabolic trajectories of projectiles.",
    "workplace": "wp_physics_lab",
    "start": "act_intro",
    "actions": [
      {
        "id": "act_intro",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Welcome to the General Physics Mechanics Lab. Before us is a 3D vector representing a physical quantity with magnitude and direction. Grab the arrow's head and drag it around. Notice how the magnitude and direction angle values update in real-time based on your positioning, while the core properties of the vector remain consistent regardless of your viewing angle. Tap the arrow when you are ready to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "anim_vector_intro",
              "poi": "default"
            },
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "audio_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_vector",
              "type": "action",
              "augmentation": "act_addition",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_vector",
              "type": "*",
              "augmentation": "*",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_arrow"
          }
        ]
      },
      {
        "id": "act_addition",
        "instruction": {
          "title": "Vector Addition",
          "description": "Now we see two vectors. We can combine them using the tip-to-tail method. The red resultant vector is drawn from the tail of the first to the head of the second. Try swapping the order of the green and blue vectors\u2014you'll see the resultant remains exactly the same! Tap the arrow to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "anim_addition",
              "poi": "default"
            },
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "audio_addition",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_vector",
              "type": "action",
              "augmentation": "act_decomp",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_vector",
              "type": "*",
              "augmentation": "*",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_arrow"
          }
        ]
      },
      {
        "id": "act_decomp",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Decomposition is vector addition in reverse. We can break down any vector into x, y, and z component vectors along the axes. Notice how these components add up tip-to-tail to reconstruct the original vector. Drag the components to see how the original vector responds. Tap the arrow to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "anim_decomp",
              "poi": "default"
            },
            {
              "target": "place_vector",
              "type": "predicate",
              "augmentation": "audio_decomp",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [
            {
              "target": "place_projectile",
              "type": "action",
              "augmentation": "act_proj_demo",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_vector",
              "type": "*",
              "augmentation": "*",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_arrow"
          }
        ]
      },
      {
        "id": "act_proj_demo",
        "instruction": {
          "title": "Projectile Motion Demonstration",
          "description": "Let's apply these vectors to projectile motion in a 2D vertical plane. The initial velocity vector is decomposed into horizontal (constant) and vertical (affected by gravity) components. Watch the ball trace its parabolic trajectory. Notice how horizontal and vertical motions are independent! Tap the projectile launcher when you are ready."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile",
              "type": "predicate",
              "augmentation": "anim_proj_demo",
              "poi": "default"
            },
