  "activity": {
    "id": "vsepr_activity",
    "name": "VSEPR Theory and Molecular Geometry",
    "description": "An exploration of VSEPR theory showing how electron pair repulsion predicts the three-dimensional geometry of molecules.",
    "workplace": "vsepr_workplace",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "1. Introduction to VSEPR",
          "description": "Welcome to VSEPR theory. Electrons in bonding and lone pairs repel each other. Molecules adopt shapes that place these domains as far apart as possible to minimize repulsion. Observe the flat Lewis structure on the board."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "vsepr_intro_audio",
              "poi": "default"
            },
            {
              "target": "whiteboard",
              "type": "predicate",
              "augmentation": "lewis_water_img",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "action",
              "augmentation": "step_2_repulsion"
            }
          ],
          "deactivate": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "vsepr_intro_audio"
            },
            {
              "target": "whiteboard",
              "type": "predicate",
              "augmentation": "lewis_water_img"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lab_bench"
          }
        ]
      },
      {
        "id": "step_2_repulsion",
        "instruction": {
          "title": "2. The Minimum-Repulsion Principle",
          "description": "Watch the domains arrange themselves. Two domains drift to a 180\u00b0 linear arrangement. A third creates a 120\u00b0 trigonal planar geometry, and a fourth domain pushes the structure into a 109.5\u00b0 tetrahedron."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "repulsion_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "action",
              "augmentation": "step_3_expanded"
            }
          ],
          "deactivate": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "repulsion_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lab_bench"
          }
        ]
      },
      {
        "id": "step_3_expanded",
        "instruction": {
          "title": "3. Five and Six Domains",
          "description": "Building on the tetrahedron, adding a fifth domain creates a trigonal bipyramidal geometry (90\u00b0 and 120\u00b0). A sixth produces an octahedral arrangement, where all neighbors sit exactly at 90\u00b0 apart."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "octahedral_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "action",
              "augmentation": "step_4_lone_pairs"
            }
          ],
          "deactivate": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "octahedral_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lab_bench"
          }
        ]
      },
      {
        "id": "step_4_lone_pairs",
        "instruction": {
          "title": "4. Electron vs. Molecular Geometry",
          "description": "Observe what happens when bonding atoms are replaced by lone pairs. The underlying electron-domain geometry remains tetrahedral, but the molecular geometry changes to trigonal pyramidal, then bent. Lone pairs occupy more angular space!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "lone_pair_effect_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "action",
              "augmentation": "step_5_gallery"
            }
          ],
          "deactivate": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "lone_pair_effect_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lab_bench"
          }
        ]
      },
      {
        "id": "step_5_gallery",
        "instruction": {
          "title": "5. Real Molecule Gallery",
          "description": "Compare the three molecules in front of you. See how the bond angles compress from 109.5\u00b0 to 107\u00b0 to 104.5\u00b0 as lone pairs are added. Detect the water molecule with your device to conclude the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "model_methane",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Methane (CH4): Tetrahedral (109.5\u00b0)"
            },
            {
              "target": "model_ammonia",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Ammonia (NH3): Trigonal Pyramidal (107\u00b0)"
            },
            {
              "target": "model_water",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Water (H2O): Bent (104.5\u00b0)"
            },
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "gallery_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "model_methane",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "model_ammonia",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "model_water",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "gallery_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "model_water"
          }
        ]
      }
    ]
  }
