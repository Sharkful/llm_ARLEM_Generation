      "clips": [
        {
          "clipName": "m1_clip1_prograde",
          "autoAdvance": false,
          "changeMeaning": "Set the initial state of the sky with Mars exhibiting normal eastward motion.",
          "narration": "Welcome to our observation of the night sky. For most of the year, outer planets like Mars exhibit prograde motion, meaning they slowly drift eastward against the background constellations night after night. Watch as Mars begins its normal path."
        },
        {
          "clipName": "m1_clip2_retrograde",
          "autoAdvance": false,
          "changes": [
            {
              "target": "marsApparent"
            },
            {
              "target": "skyLabel"
            },
            {
              "target": "marsApparent"
            },
            {
              "target": "skyLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Retrograde Loop (Westward)",
                  "color": [
                    1,
                    0,
                    0,
                    1
                  ],
                  "fontSize": 40
                }
              ]
            }
          ],
          "changeMeaning": "Shift Mars into a retrograde loop and update the label.",
          "narration": "However, roughly every 26 months, something strange happens. Mars appears to slow down, stop, and reverse its direction, moving westward for about two months in a 'retrograde loop'. Ancient astronomers had to invent complex epicycles to explain this strange puzzle in their Earth-centered models."
        },
        {
          "clipName": "m1_clip3_resume",
          "autoAdvance": false,
          "changes": [
            {
              "target": "marsApparent"
            },
            {
              "target": "skyLabel"
            },
            {
              "target": "marsApparent"
            },
            {
              "target": "skyLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Prograde Motion Resumed",
                  "color": [
                    1,
                    1,
                    1,
                    1
                  ],
                  "fontSize": 40
                }
              ]
            }
          ],
          "changeMeaning": "Complete the loop and resume eastward motion, updating the label.",
          "narration": "After this brief westward detour, Mars stops again and resumes its normal eastward journey. This apparent loop was the central observation that eventually drove the scientific revolution toward a heliocentric, or sun-centered, model of the solar system."
        }
      ]
    },
