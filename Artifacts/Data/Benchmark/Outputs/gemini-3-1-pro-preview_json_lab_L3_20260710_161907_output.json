{
  "version": "2.0",
  "labId": "chem101_vsepr_geometry",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "General Chemistry I",
  "estimatedLength": "30 minutes",
  "objectives": [
    "Determine the steric number of a central atom from its Lewis structure by counting bonding pairs and lone pairs.",
    "Predict the electron-domain geometry of a molecule from its steric number.",
    "Distinguish electron-domain geometry from molecular geometry.",
    "Explain why lone pairs occupy more angular space than bonding pairs, and predict the direction of bond-angle deviations.",
    "Apply VSEPR predictions to specific molecules and compare predicted geometries to experimentally observed structures."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Introduction to VSEPR and Steric Numbers",
      "description": "Learn how electron pairs repel each other to form fundamental electron-domain geometries.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-10",
      "educationalObjectives": [
        "Determine the steric number of a central atom from its Lewis structure.",
        "Predict the tetrahedral electron-domain geometry for a steric number of 4."
      ],
