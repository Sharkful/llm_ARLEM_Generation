                  "fontSize": 40
                }
              ]
            }
          ],
          "changeMeaning": "Switch to SF6 to show Octahedral geometry",
          "narration": "Sulfur hexafluoride (SF6) has 6 bonding domains. To minimize repulsion, these six domains position themselves evenly along the X, Y, and Z axes, creating an octahedral geometry where all bond angles are exactly 90 degrees."
        },
        {
          "clipName": "clip3_xef4",
          "autoAdvance": false,
          "changes": [
