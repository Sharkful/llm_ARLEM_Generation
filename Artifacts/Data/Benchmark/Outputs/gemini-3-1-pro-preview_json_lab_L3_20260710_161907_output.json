                1,
                1
              ],
              "fontSize": 40
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip1_intro",
          "autoAdvance": false,
          "changeMeaning": "Initial state, showing a single central atom and introducing VSEPR.",
          "narration": "Welcome to the VSEPR Theory lab. VSEPR stands for Valence Shell Electron Pair Repulsion. We start with a central carbon atom. Let's look at how electron domains arrange themselves around it."
        },
        {
          "clipName": "clip2_tetrahedral",
          "autoAdvance": false,
          "changes": [
            {
              "target": "methane_mol",
              "enabled": true
            },
            {
              "target": "central_carbon",
              "enabled": false
            },
            {
              "target": "title_text",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Tetrahedral Geometry (109.5\u00b0)",
                  "color": [
                    1,
                    1,
                    1,
                    1
                  ],
                  "fontSize": 40
                }
              ]
            }
          ],
          "changeMeaning": "Spawn four electron domains to show tetrahedral geometry",
          "narration": "When carbon forms four single bonds, like in Methane (CH4), these four electron domains mutually repel. To minimize this repulsion in 3D space, they form a tetrahedral geometry with bond angles of exactly 109.5 degrees."
        },
        {
          "clipName": "clip3_tetrahedral_rotate",
          "autoAdvance": false,
          "changes": [
            {
              "target": "methane_mol",
              "components": [
                {
                  "componentType": "simpleRotation",
                  "timeRate": 1.0,
                  "rotationTime": 12
                }
              ]
            },
            {
              "target": "title_text",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Notice how the atoms are maximally separated in 3D space.",
                  "color": [
                    1,
                    1,
                    1,
                    1
                  ],
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Rotate the methane molecule to allow students to see the 3D structure from all sides",
          "narration": "Notice that a tetrahedron allows the four hydrogen atoms to be as far apart from one another as geometrically possible. This minimizes the electrostatic repulsion between the bonding electron pairs."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Lone Pairs and Molecular Shape",
      "description": "Explore how lone pairs alter molecular geometry and compress bond angles compared to idealized structures.",
