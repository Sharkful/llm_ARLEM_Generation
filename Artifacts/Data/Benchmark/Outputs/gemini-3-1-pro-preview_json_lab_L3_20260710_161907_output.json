      "clips": [
        {
          "clipName": "clip1_compare_intro",
          "autoAdvance": false,
          "changeMeaning": "Show methane, ammonia, and water molecules side by side for comparison",
          "narration": "Now let's compare three molecules that all have a steric number of 4: Methane, Ammonia, and Water. While their electron-domain geometries are all tetrahedral, their molecular geometries are different."
        },
        {
          "clipName": "clip2_ammonia_lone_pair",
          "autoAdvance": false,
          "changes": [
            {
              "target": "ammonia_mol",
              "eulerAngles": [
                0,
                45,
                0
              ],
              "scale": [
                0.2,
                0.2,
                0.2
              ]
            },
            {
              "target": "angle_text",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Ammonia (NH3) - Trigonal Pyramidal",
                  "color": [
                    0.8,
                    0.8,
                    1,
                    1
                  ],
                  "fontSize": 35
                }
              ]
            }
          ],
          "changeMeaning": "Highlight ammonia and explain lone pair effect on geometry",
          "narration": "Ammonia has three bonding pairs and one lone pair. Because the lone pair is only attracted to one nucleus, it spreads out more in space. This extra repulsion pushes the bonding pairs closer together, compressing the bond angle from 109.5 to 107 degrees. This shape is called trigonal pyramidal."
        },
        {
          "clipName": "clip3_water_lone_pairs",
          "autoAdvance": false,
          "changes": [
            {
              "target": "ammonia_mol",
              "eulerAngles": [
                0,
                0,
                0
              ],
              "scale": [
                0.15,
                0.15,
                0.15
              ]
            },
            {
              "target": "water_mol",
              "eulerAngles": [
                0,
                45,
                0
              ],
              "scale": [
                0.2,
                0.2,
                0.2
              ]
            },
            {
              "target": "angle_text",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Water (H2O) - Bent Geometry",
                  "color": [
                    0.6,
                    0.8,
                    1,
                    1
                  ],
                  "fontSize": 35
                }
              ]
            }
          ],
          "changeMeaning": "Highlight water and explain the effect of two lone pairs",
          "narration": "Water has two bonding pairs and two lone pairs. The two lone pairs exert even greater repulsion, squeezing the remaining hydrogen atoms closer together. The resulting H-O-H bond angle is compressed further to 104.5 degrees, creating a 'bent' molecular geometry."
        }
      ]
    },
