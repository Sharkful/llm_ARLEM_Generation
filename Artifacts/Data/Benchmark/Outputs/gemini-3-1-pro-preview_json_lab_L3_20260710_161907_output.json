        {
          "clipName": "clip1_pf5",
          "autoAdvance": false,
          "changeMeaning": "Introduce Trigonal Bipyramidal geometry with PF5",
          "narration": "Elements in period 3 and below can have expanded octets. Phosphorus pentafluoride (PF5) has 5 bonding pairs and no lone pairs. They arrange into a trigonal bipyramidal geometry, with 90-degree and 120-degree bond angles."
        },
        {
          "clipName": "clip2_sf6",
          "autoAdvance": false,
