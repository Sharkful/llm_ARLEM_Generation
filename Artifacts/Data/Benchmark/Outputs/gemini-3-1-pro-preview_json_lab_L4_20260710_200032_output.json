        {
          "clipName": "clip2_intro",
          "autoAdvance": false,
          "changes": [],
          "changeMeaning": "Introduce the Geocentric model with Earth at the center.",
          "narration": "To explain this backward motion, ancient Greek and medieval astronomers used a geocentric model, placing Earth firmly at the center of the universe."
        },
        {
          "clipName": "clip2_machinery",
          "autoAdvance": false,
          "changes": [
            {
              "target": "deferentPath",
              "color": [
                0.5,
                0.5,
                1,
                1
              ]
            },
            {
              "target": "epicyclePath",
              "color": [
                1,
                0.5,
                0.5,
                1
              ]
            }
          ],
          "changeMeaning": "Highlight the epicycle and deferent machinery.",
          "narration": "In this model, Mars doesn't just orbit Earth in a simple circle. It rides on a smaller circle called an epicycle, which itself rides on a larger circle called a deferent."
        },
        {
          "clipName": "clip2_retrograde_loop",
          "autoAdvance": false,
          "changes": [
            {
              "target": "marsGeocentric",
              "components": [
                {
                  "componentType": "newscript",
                  "scriptName": "epicycleAnimator",
                  "scriptDescription": "Animates the object along an epicycle path, combining motion of a deferent circle and an epicycle circle to trace a looping trajectory. Required inputs: deferent radius, epicycle radius, deferent speed, epicycle speed."
                }
              ]
            }
          ],
          "changeMeaning": "Start the epicycle motion to demonstrate the looping effect.",
          "narration": "Watch what happens when we run the machinery. When Mars reaches the inner part of its epicycle\u2014closest to Earth\u2014the combined motions make it appear to move backward. This clever math reproduced the loop, but it required increasingly complex and perfectly tuned circles for every planet."
        }
      ]
