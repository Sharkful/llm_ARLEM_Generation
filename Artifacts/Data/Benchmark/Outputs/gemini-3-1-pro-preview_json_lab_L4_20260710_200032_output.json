      "clips": [
        {
          "clipName": "clip1_intro",
          "autoAdvance": false,
          "changes": [],
          "changeMeaning": "Setup initial view of the night sky with Mars drifting slowly eastward.",
          "narration": "Welcome to the night sky. For thousands of years, humans watched the stars and noticed that a few bright points of light wandered among them. We call them planets, from the Greek word for 'wanderer'. Notice the red dot\u2014that is Mars. Most of the time, it drifts slowly eastward against the background stars."
        },
        {
          "clipName": "clip1_retrograde_start",
          "autoAdvance": false,
          "changes": [
            {
              "target": "marsPoint",
              "position": [
                -0.2,
                0.1,
                1.5
              ]
            },
            {
              "target": "nightSkyLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Wait, what is happening? Mars has slowed, halted, and is now moving westward! This backward motion is called 'Apparent Retrograde Motion'.",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Mars slows down, halts, and begins its westward retrograde loop.",
          "narration": "But watch carefully over the next few months. Mars slows down, comes to a halt, and then does something bizarre\u2014it starts moving backward, westward, tracing a loop in the sky for about two months."
        },
        {
          "clipName": "clip1_resume_eastward",
          "autoAdvance": false,
          "changes": [
            {
              "target": "marsPoint",
              "position": [
                0.4,
                0,
                1.5
              ]
            },
            {
              "target": "nightSkyLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "After roughly two months, it halts again and resumes its normal eastward journey. Why would a planet move backward? This was the central puzzle of pre-modern astronomy.",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Mars completes its loop and resumes normal eastward motion.",
          "narration": "After roughly two months, it halts again and resumes its normal eastward journey. Why would a planet move backward? This behavior, roughly every 26 months, was the central puzzle of pre-modern astronomy."
        }
      ]
    },
