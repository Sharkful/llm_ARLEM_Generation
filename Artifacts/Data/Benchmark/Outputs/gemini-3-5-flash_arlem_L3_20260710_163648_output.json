  "activity": {
    "id": "retrograde_motion_activity",
    "name": "Understanding Apparent Retrograde Motion",
    "description": "An interactive lab exploring how the heliocentric model naturally explains retrograde motion through relative orbital speeds.",
    "language": "en",
    "workplace": "retrograde_motion_workplace",
    "start": "step_1_sky_view",
    "actions": [
      {
        "id": "step_1_sky_view",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "observation_desk",
        "predicate": "launched",
        "instruction": {
          "title": "1. Observe Retrograde from Earth",
          "description": "Look at the holographic Sky Dome model. You will see Mars moving eastward relative to the background constellations. Note how it slows down, reverses direction (westward) to make a loop, and then continues eastward. This anomalous loop is called apparent retrograde motion. Click the confirm button or say 'Understand Retrograde' to move on."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "sky_dome_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Observe Mars's Path Against Constellations"
            },
            {
              "target": "sky_dome_model",
              "type": "predicate",
              "augmentation": "mars_loop_animation",
              "poi": "mars_path"
            },
            {
              "target": "observation_desk",
              "type": "predicate",
              "augmentation": "intro_audio",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "confirm_retrograde",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "observation_desk",
        "predicate": "launched",
        "instruction": {
          "title": "2. The Geocentric Riddle (Epicycles)",
          "description": "In ancient times, astronomers believed Earth was the center of the universe (Geocentric model). To explain Mars's loops, Ptolemy proposed complex 'epicycles'\u2014planets moving on small circles that themselves orbit Earth on larger circles. Examine the floating model. This layout was mathematically complex and lacked elegant simplicity (parsimony). Say 'Go Heliocentric' to see how Copernicus simplified this."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "sky_dome_model",
              "type": "predicate",
              "augmentation": "epicycle_explanation_img",
              "poi": "default"
            },
            {
              "target": "sky_dome_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Ptolemaic Epicycle Model Simulation"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_3_heliocentric"
            }
          ],
          "deactivate": [
            {
              "target": "sky_dome_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "go_heliocentric",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "celestial_observatory_zone",
        "predicate": "launched",
        "instruction": {
          "title": "3. Heliocentric perspective (The Overtaking Effect)",
          "description": "Step into the Celestial Observatory Zone. Look down at the Heliocentric Orbit Simulator. Copernicus solved the retrograde riddle: Earth orbits the Sun faster than Mars on an inner track. As Earth catches up and overtakes Mars, your perspective line-of-sight projects Mars backward against the stars, creating an optical illusion of backward motion. Say 'Align Orbits' to zoom in on the alignment."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_mars_orbit_model",
              "type": "predicate",
              "augmentation": "heliocentric_overtake_anim",
              "poi": "default"
            },
            {
              "target": "earth_mars_orbit_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "earth_orbit",
              "text": "Earth (Inner Fast Orbit) Overtaking Mars (Outer Slower Orbit)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_4_opposition"
            }
          ],
          "deactivate": [
            {
              "target": "earth_mars_orbit_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "align_orbits",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_opposition",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "celestial_observatory_zone",
        "predicate": "launched",
        "instruction": {
          "title": "4. Opposition Alignment",
          "description": "Retrograde motion occurs exactly when Earth passes closest to Mars (called 'opposition', where the Sun, Earth, and Mars form a straight line). Notice how the relative backward drift is strongest at this exact alignment point. Say 'Observe Comparison' to analyze how other planets behave."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_mars_orbit_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "sun",
              "text": "Opposition Alignment: Sun - Earth - Mars"
            },
            {
              "target": "earth_mars_orbit_model",
              "type": "predicate",
              "augmentation": "heliocentric_overtake_anim",
              "poi": "default",
              "state": "opposition_pause"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "action",
              "augmentation": "step_5_comparison"
            }
          ],
          "deactivate": [
            {
              "target": "earth_mars_orbit_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "observe_comparison",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_5_comparison",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "observation_desk",
        "predicate": "launched",
        "instruction": {
          "title": "5. Comparative Loops (Mars, Jupiter, Saturn)",
          "description": "Look at the Planetary Properties Display. More distant planets like Jupiter and Saturn also experience retrograde motion, but because they are much farther away from Earth, the angle of the relative line-of-sight shift is much smaller. Thus, Mars's retrograde loop is the largest and most dramatic of the outer planets. Say 'Finish Lab' to complete the experience."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "planetary_properties_display",
              "type": "predicate",
              "augmentation": "comparative_loops_img",
              "poi": "chart_area"
            },
            {
              "target": "planetary_properties_display",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Retrograde Loop Sizes: Mars > Jupiter > Saturn"
            },
            {
              "target": "observation_desk",
              "type": "predicate",
              "augmentation": "summary_audio",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "planetary_properties_display",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "observation_desk",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "finish_lab",
            "operator": "equal"
          }
        ]
      }
    ]
  }
