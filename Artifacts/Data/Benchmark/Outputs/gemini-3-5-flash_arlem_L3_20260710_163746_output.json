  "activity": {
    "id": "act_dna_replication_training",
    "name": "DNA Structure and Replication AR Training",
    "description": "Interactive AR training scenario exploring the molecular architecture of the DNA double helix and the dynamics of its semiconservative replication.",
    "language": "en",
    "workplace": "wp_dna_replication_lab",
    "start": "act_dna_structure",
    "actions": [
      {
        "id": "act_dna_structure",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_lab_bench",
        "predicate": "observed",
        "instruction": {
          "title": "The Antiparallel Double Helix",
          "description": "Identify the antiparallel structure of the DNA double helix. Observe the two sugar-phosphate backbones spiraling in opposite directions: one running 5' to 3' (marked by the 5' carbon phosphate end) and the other running 3' to 5' (marked by the 3' hydroxyl end)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "poi_top_left",
              "text": "5' End"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "poi_top_right",
              "text": "3' End"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "poi_bottom_left",
              "text": "3' End"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "poi_bottom_right",
              "text": "5' End"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "btn_next_1",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_base_pairing",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_lab_bench",
        "predicate": "interacted",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Look inside the helix to examine nitrogenous base pairing. Adenine (A) always pairs with Thymine (T) via two hydrogen bonds. Guanine (G) pairs with Cytosine (C) via three hydrogen bonds. This complementary pairing maintains the uniform width of the double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_hbond_2",
              "poi": "poi_pair_at",
              "text": "Adenine-Thymine (2 H-Bonds)"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "pred_label_hbond_3",
              "poi": "poi_pair_gc",
              "text": "Guanine-Cytosine (3 H-Bonds)"
            }
          ],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "btn_next_2",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_replication_unwinding",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_lab_bench",
        "predicate": "observed",
        "instruction": {
          "title": "Unwinding the Helix",
          "description": "Move to the Replication Fork model. Observe how Helicase unwinds the double helix at the replication fork, breaking hydrogen bonds. Single-strand binding (SSB) proteins coat the single template strands to prevent them from reannealing."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_anim_helicase",
              "poi": "poi_fork_junction"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_label_ssb",
              "poi": "poi_ssb_binding",
              "text": "SSB Proteins (Stabilizers)"
            }
          ],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "btn_next_3",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_strand_synthesis",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_lab_bench",
        "predicate": "observed",
        "instruction": {
          "title": "Continuous vs. Discontinuous Synthesis",
          "description": "Analyze DNA Polymerase activity. Since polymerase only synthesizes DNA in the 5' to 3' direction, synthesis is asymmetric. The leading strand is synthesized continuously towards the fork. The lagging strand is synthesized discontinuously away from the fork in Okazaki fragments."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_anim_polymerase_leading",
              "poi": "poi_leading_strand"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_anim_polymerase_lagging",
              "poi": "poi_lagging_strand"
            }
          ],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "btn_next_4",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_ligation_semiconservative",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens",
        "location": "place_assembly_desk",
        "predicate": "completed",
        "instruction": {
          "title": "Ligation and Semiconservative Completion",
          "description": "Observe DNA Ligase sealing the nicks between Okazaki fragments to complete the lagging strand. Notice the final output at the Assembly Desk: each of the two new daughter DNA molecules contains one original parental strand and one newly synthesized strand\u2014the hallmark of semiconservative replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_anim_ligase",
              "poi": "poi_okazaki_joint"
            },
            {
              "target": "place_assembly_desk",
              "type": "predicate",
              "augmentation": "pred_img_semiconservative",
              "poi": "poi_semiconservative_diagram"
            }
          ],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "btn_finish",
            "operator": "equal"
          }
        ]
      }
    ]
  }
