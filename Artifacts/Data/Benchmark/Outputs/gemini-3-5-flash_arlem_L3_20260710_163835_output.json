  "activity": {
    "id": "heart_anatomy_activity",
    "name": "Human Heart Anatomy and Blood Flow Path",
    "description": "This AR learning module guides undergraduate anatomy students through the structural anatomy of the human heart, ventricular myocardial thickness differences, and the sequential flow of blood through both the pulmonary and systemic loops.",
    "language": "en",
    "workplace": "heart_anatomy_lab",
    "start": "step_1_chambers",
    "actions": [
      {
        "id": "step_1_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "anatomy_bench",
        "predicate": "visualized",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Locate the four muscular chambers on the 3D heart model. Note their orientations: the atria are superior, while the ventricles are inferior. Observe that the right side of the heart is shown on the anatomical right (your left)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_atrium",
              "text": "Right Atrium (RA)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_ventricle",
              "text": "Right Ventricle (RV)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_atrium",
              "text": "Left Atrium (LA)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_ventricle",
              "text": "Left Ventricle (LV)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_1_chambers",
            "key": "voice_next",
            "value": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_valves_vessels",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "anatomy_bench",
        "predicate": "visualized",
        "instruction": {
          "title": "Valves and Major Outflow Vessels",
          "description": "Identify the key valves preventing backflow and the primary vessels. Examine the Tricuspid Valve between the RA and RV, and the Mitral Valve between the LA and LV. Then locate the major outflow vessels at the base of the heart: the Pulmonary Trunk and the Aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "tricuspid_valve",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "mitral_valve",
              "text": "Mitral / Bicuspid Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "aorta",
              "text": "Aorta (Systemic Output)"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "pulmonary_artery",
              "text": "Pulmonary Trunk / Artery"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_2_valves_vessels",
            "key": "voice_next",
            "value": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_pulmonary_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "anatomy_bench",
        "predicate": "visualized",
        "instruction": {
          "title": "Trace the Pulmonary Circuit (Right Side)",
          "description": "Observe the flow of deoxygenated blood. It enters the Right Atrium from the Vena Cavae, flows through the Tricuspid Valve, is pumped from the Right Ventricle into the Pulmonary Arteries, and travels to the lungs for gas exchange. This is the low-pressure pulmonary loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_pulmonary_flow",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "right_ventricle",
              "text": "Pumps deoxygenated blood to the lungs via pulmonary arteries"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_3_pulmonary_circuit",
            "key": "voice_next",
            "value": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_systemic_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "anatomy_bench",
        "predicate": "visualized",
        "instruction": {
          "title": "Trace the Systemic Circuit (Left Side)",
          "description": "Trace the return of oxygenated blood. Red blood cells return from the lungs via pulmonary veins to the Left Atrium, flow through the Mitral Valve to the Left Ventricle, and are forcefully ejected through the Aortic Valve into the Aorta to nourish systemic tissues."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_systemic_flow",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "left_ventricle",
              "text": "Pumps oxygenated blood to the entire body via the aorta"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_4_systemic_circuit",
            "key": "voice_next",
            "value": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_5_myocardium_thickness",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "reference_desk",
        "predicate": "analyzed",
        "instruction": {
          "title": "Compare Myocardial Thickness",
          "description": "Examine the cross-sectional view of the heart. Notice the dramatic structural difference: the Left Ventricle wall is about three times thicker than the Right Ventricle wall. This extra myocardium is required to generate the high arterial pressure needed to perfuse the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dissection_tray",
              "type": "predicate",
              "augmentation": "img_myocardium_compare",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "myocardium_rv",
              "text": "Thin Wall (~0.4 cm): Low resistance loop to lungs"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "myocardium_lv",
              "text": "Thick Wall (~1.2 cm): High resistance loop to system"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step_5_myocardium_thickness",
            "key": "voice_next",
            "value": "next",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_6_valve_mechanics",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "anatomy_bench",
        "predicate": "completed",
        "instruction": {
          "title": "Valve Mechanics and Auscultation",
          "description": "Listen to the heart sounds using the virtual stethoscope. The 'lub' (S1) is caused by the sudden closure of the AV valves (mitral and tricuspid) as ventricles contract. The 'dub' (S2) is caused by the closure of the semilunar valves (aortic and pulmonary) at the end of systole, preventing backward flow."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "stethoscope",
              "type": "predicate",
              "augmentation": "audio_heartbeat",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "tricuspid_valve",
              "text": "S1 (Lub): closure of Atrioventricular Valves"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "aorta",
              "text": "S2 (Dub): closure of Semilunar Valves"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "dissection_tray",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6_valve_mechanics",
            "operator": "equal"
          }
        ]
      }
    ]
  }
