  "activity": {
    "id": "vector_projectile_activity",
    "name": "Vector Operations & Projectile Motion Lab",
    "description": "An AR learning experience exploring 2D vector mathematics, component decomposition, tip-to-tail vector addition, and independent kinematics inside parabolic projectile motion.",
    "language": "en",
    "workplace": "physics_vectors_workplace",
    "start": "step1_vector_intro",
    "actions": [
      {
        "id": "step1_vector_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "vector_workspace",
        "predicate": "launched",
        "instruction": {
          "title": "Introduction to 2D Vectors",
          "description": "Look at the Vector Interaction Board. A vector represents a physical quantity possessing both a magnitude (length) and a direction (angle relative to the positive x-axis). Observe the highlighted Vector A on the Cartesian grid."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_a_arrow",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "primitive",
              "augmentation": "label",
              "poi": "vector_origin",
              "text": "Vector A (Magnitude: 5m, Angle: 37 degrees)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_board",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_vector_decomposition",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "vector_workspace",
        "predicate": "launched",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Decompose Vector A into horizontal (Ax) and vertical (Ay) components. Using right-triangle trigonometry, Ax = A * cos(theta) and Ay = A * sin(theta). Observe the horizontal and vertical projections highlighted on the grid."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_decomp",
              "poi": "vector_origin"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_x_component",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "label_y_component",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_board",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_vector_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "vector_workspace",
        "predicate": "launched",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Observe how Vector A and Vector B are added graphically using the tip-to-tail method. The tail of Vector B is placed at the tip of Vector A. The Resultant Vector (R = A + B) starts at the tail of A and ends at the tip of B."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_a_arrow",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_b_arrow",
              "poi": "vector_origin"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_r_arrow",
              "poi": "default"
            }
