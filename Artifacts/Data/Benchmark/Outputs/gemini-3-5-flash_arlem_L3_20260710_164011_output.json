  "activity": {
    "id": "vsepr_geometry_lab_activity",
    "name": "VSEPR Theory and Molecular Geometries Lab",
    "description": "An interactive AR lab detailing the application of Valence Shell Electron Pair Repulsion (VSEPR) theory to predict 3D molecular geometries from Lewis structures, demonstrating lone-pair compression effects and hypervalent shapes.",
    "language": "en",
    "workplace": "vsepr_chemistry_lab_workplace",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2_headset",
        "location": "prep_bench",
        "predicate": "read",
        "instruction": {
          "title": "Steric Numbers & Repulsion Theory",
          "description": "Examine the 2D Lewis structures displayed on the virtual Lewis Board. Predict the steric number (bonding pairs + lone pairs) of Carbon in Methane, Nitrogen in Ammonia, and Oxygen in Water. Say the voice command 'Identify Domains' when you are ready to construct these 3D systems in the sandbox."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lewis_builder",
              "type": "predicate",
              "augmentation": "vsepr_intro_anim",
              "poi": "left_panel"
            },
            {
              "target": "lewis_builder",
              "type": "predicate",
              "augmentation": "repulsion_chart",
              "poi": "right_panel"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_builder",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "lewis_builder",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_methane",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2_headset",
        "location": "prep_bench",
        "predicate": "interacted",
        "instruction": {
          "title": "Steric Number 4: Ideal Tetrahedral Geometry",
          "description": "Observe the methane molecule (CH4). With a steric number of 4 and 0 lone pairs, the electron domains repel each other equally to form a perfect tetrahedral geometry. Select the central Carbon atom on the VSEPR sandbox to confirm the uniform 109.5\u00b0 bond angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vsepr_sandbox",
              "type": "predicate",
              "augmentation": "methane_tetrahedral",
              "poi": "domain_node"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "narration_methane",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vsepr_sandbox",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "learner",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vsepr_sandbox",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_03_ammonia",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2_headset",
        "location": "prep_bench",
        "predicate": "interacted",
        "instruction": {
          "title": "Lone Pair Compression: Ammonia",
          "description": "Examine the Ammonia (NH3) molecule. Its steric number is still 4, but 1 domain is a non-bonding lone pair. Lone pairs occupy more angular space because they are only attracted to one nucleus, repelling the bonding pairs closer together. Note the compressed 107.3\u00b0 bond angle and Trigonal Pyramidal molecular shape. Say 'Confirm Ammonia' to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vsepr_sandbox",
              "type": "predicate",
              "augmentation": "ammonia_pyramidal",
              "poi": "domain_node"
            },
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "narration_ammonia",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
