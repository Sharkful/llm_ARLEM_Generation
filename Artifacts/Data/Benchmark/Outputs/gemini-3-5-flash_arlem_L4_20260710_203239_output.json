  "activity": {
    "id": "act_retrograde_motion_exploration",
    "name": "Apparent Retrograde Motion Exploration",
    "description": "An interactive AR laboratory exploring apparent retrograde motion. Students observe retrograde motion from both Earth-bound and heliocentric perspectives, discover why Mars appears to reverse its path as Earth overtakes it, and compare retrograde effects across multiple outer planets.",
    "language": "en",
    "workplace": "wp_astronomy_lab",
    "start": "act_sky_obs",
    "actions": [
      {
        "id": "act_sky_obs",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_observation_deck",
        "predicate": "observed",
        "instruction": {
          "title": "Observing the Mystery of Retrograde Motion",
          "description": "Look up at the simulated night sky. Watch Mars (the red planet) drift eastward through Leo and Virgo, slow down, loop backward (westward) for two months, then resume its eastward path. This is apparent retrograde motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_observation_deck",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/audio/intro_phenomenon.mp3"
            },
            {
              "target": "place_observation_deck",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "sky_center",
              "url": "https://assets.example.com/models/mars_retrograde_sky.glb"
            },
            {
              "target": "place_observation_deck",
              "type": "predicate",
              "augmentation": "label_constellation_leo",
              "poi": "leo"
            },
            {
              "target": "place_observation_deck",
              "type": "predicate",
              "augmentation": "label_constellation_virgo",
              "poi": "virgo"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_panel",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_geocentric_explanation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_simulation_table",
        "predicate": "observed",
        "instruction": {
          "title": "The Geocentric Solution: Epicycles",
          "description": "Examine the geocentric model. Earth is at the center. To explain Mars's backward loop, ancient astronomers placed Mars on a small rotating circle (the epicycle) which itself rotates around Earth on a larger circle (the deferent). Watch how Mars moves backward when on the inner loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_geocentric_model",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/audio/geocentric.mp3"
            },
            {
              "target": "thing_geocentric_model",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/models/geocentric_epicycles.glb"
            },
            {
              "target": "thing_geocentric_model",
              "type": "predicate",
              "augmentation": "label_epicycle",
              "poi": "epicycle_loc"
            },
            {
              "target": "thing_geocentric_model",
              "type": "predicate",
              "augmentation": "label_deferent",
              "poi": "deferent_loc"
            }
          ],
          "deactivate": [
            {
              "target": "place_observation_deck",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_panel",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_heliocentric_explanation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_simulation_table",
        "predicate": "observed",
        "instruction": {
          "title": "The Heliocentric Revolution",
          "description": "Now view the solar system from above. The Sun is at the center. Earth orbits faster on the inside track, while Mars orbits slower on the outside. Observe how Earth naturally catches up to and overtakes Mars. No epicycles are needed!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heliocentric_model",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
