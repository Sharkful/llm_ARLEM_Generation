  "activity": {
    "id": "heart_anatomy_lab_activity",
    "name": "Human Heart Structure & Circulation Lab",
    "description": "Learn the structures, pathways, and physiological concepts of the human heart in 3D AR.",
    "language": "en",
    "workplace": "heart_anatomy_lab_workplace",
    "start": "action_gross_anatomy",
    "actions": [
      {
        "id": "action_gross_anatomy",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "study_desk",
        "predicate": "oriented",
        "instruction": {
          "title": "Gross Anatomy and Orientation",
          "description": "Observe the two side-by-side models of the human heart on the study desk. The left is intact showing external vessel structures, while the right is a cutaway view exposing the chambers and valves. Walk around the desk to view the anatomical orientation from a patient perspective (where the left side of the heart is on your right)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "audio_scene1"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_la",
              "poi": "la_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_lv",
              "poi": "lv_poi"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_structural_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "study_desk",
        "predicate": "inspected",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Follow the guided tour as the system highlights each major chamber, valve, and blood vessel. Locate the four chambers (RA, RV, LA, LV), the four valves (tricuspid, pulmonary, mitral/bicuspid, aortic), and key vessels (vena cava, pulmonary trunk/arteries, pulmonary veins, aorta)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "audio_scene2"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_ra",
              "poi": "ra_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_rv",
              "poi": "rv_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_tricuspid",
              "poi": "tricuspid_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_pulmonary",
              "poi": "pulmonary_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_mitral",
              "poi": "mitral_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_aortic",
              "poi": "aortic_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_svc",
              "poi": "svc_poi"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "label_aorta",
              "poi": "aorta_poi"
            }
          ],
          "deactivate": [
            {
              "target": "double_heart",
              "augmentation": "label_la"
            },
            {
              "target": "double_heart",
              "augmentation": "label_lv"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_dual_circulation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "study_desk",
        "predicate": "observed",
        "instruction": {
          "title": "Dual-Circuit Flow Demonstration",
          "description": "Watch the continuous fluid pathways running through both models. Blue streams represent deoxygenated blood flowing through the right side of the heart to the pulmonary circuit (lungs). Red streams represent oxygenated blood returning from the lungs and being pumped through the left side to the systemic circuit (body)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "audio_scene3"
            },
            {
              "target": "double_heart",
              "type": "predicate",
              "augmentation": "anim_blood_flow",
              "poi": "cutaway_view"
            }
          ],
          "deactivate": [
            {
              "target": "double_heart",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_rbc_trace",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "study_desk",
        "predicate": "completed",
        "instruction": {
          "title": "Red Blood Cell Pathway Trace",
          "description": "An interactive red blood cell will now spawn at the superior vena cava. Walk alongside the cell. Click 'Next' on your interface to step the cell forward through the chambers, valves, capillaries (where it turns red), and out to the aorta, observing how its chemical state and pathway match the cardiac cycle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rbc_tracer",
              "type": "predicate",
              "augmentation": "audio_scene4"
            },
            {
              "target": "rbc_tracer",
              "type": "predicate",
              "augmentation": "anim_rbc_trace",
              "poi": "cell_pos"
            }
          ],
          "deactivate": [
            {
              "target": "double_heart",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_wall_thickness",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "study_desk",
        "predicate": "compared",
        "instruction": {
          "title": "Ventricle Wall Thickness Asymmetry",
          "description": "Compare the cross-sections of the left and right ventricles. Note that the left ventricle's muscular wall (myocardium) is roughly 3 times thicker than the right. This structural asymmetry is essential because the left ventricle must generate high pressure to perfuse the entire systemic body, while the right ventricle only pumps to the nearby low-resistance lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ventricle_sections",
              "type": "predicate",
              "augmentation": "audio_scene5"
            },
            {
              "target": "ventricle_sections",
              "type": "predicate",
              "augmentation": "img_ventricle_wall",
              "poi": "default"
            }
          ],
          "deactivate": [
