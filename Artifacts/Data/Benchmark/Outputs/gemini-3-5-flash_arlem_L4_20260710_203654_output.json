  "activity": {
    "id": "act_vector_projectile_motion",
    "name": "Vector Operations & 2D Projectile Motion Lab",
    "description": "An AR Mechanics training experience covering vectors, addition, decomposition, and projectile motion.",
    "language": "en",
    "workplace": "wp_physics_vectors",
    "start": "act_1_intro",
    "actions": [
      {
        "id": "act_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hmd",
        "location": "place_vector_bench",
        "predicate": "launched",
        "instruction": {
          "title": "Introduction to 3D Vectors",
          "description": "A single 3D vector arrow is projected before you. Grab the arrowhead to modify its direction and length. Watch how the real-time magnitude (length) and angular direction coordinates update. Walk around the vector to see how changing your viewpoint does not alter the underlying physics model."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_axes_grid",
              "poi": "default"
            },
            {
              "target": "thing_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_vector_arrow",
              "poi": "default"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_narration_1",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "device_hmd",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "act_2_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hmd",
        "location": "place_vector_bench",
        "predicate": "launched",
        "instruction": {
          "title": "Vector Addition (Tip-to-Tail Method)",
          "description": "Two physical-looking vectors appear: blue (Vector A) and green (Vector B). Vector B is placed tip-to-tail at the head of Vector A. Observe the red resultant vector (A + B) starting from the origin and ending at Vector B's head. Manipulate either component and note that addition order does not change the final resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_adder",
              "type": "predicate",
              "augmentation": "pred_vector_addition_rig",
              "poi": "default"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "pred_narration_2",
              "poi": "default"
            }
