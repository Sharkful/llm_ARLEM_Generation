  "activity": {
    "id": "vsepr_theory_activity",
    "name": "Valence Shell Electron Pair Repulsion (VSEPR) Theory Lab",
    "description": "An interactive training scenario guiding general chemistry students through predicting molecular structures using VSEPR theory.",
    "language": "en",
    "workplace": "vsepr_chemistry_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "central_bench",
        "predicate": "launched",
        "instruction": {
          "title": "Welcome to VSEPR Theory Lab",
          "description": "Observe the central atom displayed on the bench. Look at the reference board to see a flat Lewis structure of water, and listen to the introduction on how we translate 2D structures into 3D configurations using electron domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "primitive",
              "augmentation": "audio",
              "url": "https://assets.chemistry-lab.edu/audio/vsepr_intro_narrative.mp3"
            },
            {
              "target": "reference_board",
              "type": "predicate",
              "augmentation": "lewis_water_img",
              "poi": "default"
            },
            {
              "target": "vsepr_model",
              "type": "predicate",
              "augmentation": "central_atom_mesh",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "ar_headset",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_repulsion_principle",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "central_bench",
        "predicate": "launched",
        "instruction": {
          "title": "Minimizing Repulsion (Steric 2, 3, 4)",
          "description": "Watch how 2, 3, and 4 electron domains repel each other to establish linear, trigonal planar, and tetrahedral geometries. Faint green force vectors show repulsion forces dynamically reducing as the shapes settle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vsepr_model",
              "type": "predicate",
              "augmentation": "repulsion_movement_anim",
              "poi": "default"
            },
            {
              "target": "learner",
              "type": "primitive",
              "augmentation": "audio",
