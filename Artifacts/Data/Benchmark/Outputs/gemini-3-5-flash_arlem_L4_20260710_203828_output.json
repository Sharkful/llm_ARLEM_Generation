        "predicate": "launched",
        "instruction": {
          "title": "Steric Numbers 5 & 6 Geometries",
          "description": "Observe the addition of the 5th and 6th domains, creating trigonal bipyramidal (90/120 degree angles) and octahedral (90 degree angles) shapes. Rotate the models freely to analyze the axial and equatorial domains."
        },
        "enter": {
