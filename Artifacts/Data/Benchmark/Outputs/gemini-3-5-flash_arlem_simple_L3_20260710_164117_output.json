  "activity": {
    "id": "act_retrograde_exploration",
    "name": "Apparent Retrograde Motion Lab",
    "description": "An interactive AR investigation of apparent retrograde motion, allowing students to transition from geocentric observations of Mars's loop to a heliocentric understanding of orbital overtaking, and compare this effect across other outer planets.",
    "workplace": "wp_astronomy_lab",
    "start": "act_intro_earth_view",
    "actions": [
      {
        "id": "act_intro_earth_view",
        "instruction": {
          "title": "Observing Retrograde Motion from Earth",
          "description": "Stand at the Earth Observation Deck. Look up at the sky dome to watch Mars drift eastward against the constellations. Note how it slows down, reverses direction (westward) for a brief loop, and then continues eastward. This is apparent retrograde motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_observation_deck",
              "type": "predicate",
              "augmentation": "pred_retrograde_video",
              "poi": "sky_dome",
              "url": "https://assets.example.com/videos/mars_retrograde_skyview.mp4"
            },
            {
              "target": "earth_observation_deck",
              "type": "predicate",
              "augmentation": "pred_audio_explanation_step1",
              "poi": "default",
              "url": "https://assets.example.com/audio/intro_retrograde.mp3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "earth_observation_deck"
          }
        ]
      },
      {
        "id": "act_geocentric_model",
        "instruction": {
          "title": "The Geocentric Explanation (Epicycles)",
          "description": "Observe how the Ptolemaic (geocentric) model explained this movement. Mars was believed to travel along a small orbit (epicycle) which itself orbited Earth on a larger path (deferent). Note how complex and counter-intuitive this mechanism is."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_observation_deck",
              "type": "predicate",
              "augmentation": "pred_geocentric_epicycle_anim",
              "poi": "sky_dome",
              "url": "https://assets.example.com/models/geocentric_epicycles.glb"
            },
            {
              "target": "earth_observation_deck",
              "type": "predicate",
              "augmentation": "pred_audio_explanation_step2",
              "poi": "default",
              "url": "https://assets.example.com/audio/geocentric_epicycles.mp3"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "earth_observation_deck",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "earth_observation_deck"
          }
        ]
      },
      {
        "id": "act_heliocentric_orrery",
        "instruction": {
          "title": "The Heliocentric Model: Overtaking Mars",
          "description": "Step over to the Heliocentric Orrery. Look down at the concentric circular orbits of Earth and Mars. Watch Earth, moving faster on its inner orbit, overtake Mars. Notice how the retrograde loop occurs naturally from this viewpoint without epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_orrery",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits_anim",
              "poi": "sun_center",
              "url": "https://assets.example.com/models/heliocentric_orrery.glb"
            },
            {
              "target": "heliocentric_orrery",
              "type": "predicate",
              "augmentation": "pred_audio_explanation_step3",
              "poi": "default",
              "url": "https://assets.example.com/audio/heliocentric_explanation.mp3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "heliocentric_orrery"
          }
        ]
      },
      {
        "id": "act_overtaking_demo",
        "instruction": {
          "title": "Deep Dive: Earth Overtaking Mars",
          "description": "Locate the physical Mars model. Align your gaze to scan its code. This displays Mars's specific orbital characteristics (26-month synodic period) and visualizes the geometric lines of sight projecting from Earth to Mars against the stars during overtaking."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_model",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_loop_label",
              "poi": "info_tag",
              "url": "https://assets.example.com/labels/mars_retrograde_details.png"
            },
            {
              "target": "mars_model",
              "type": "predicate",
              "augmentation": "pred_audio_explanation_step4",
              "poi": "default",
              "url": "https://assets.example.com/audio/mars_orbital_stats.mp3"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_orrery",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "mars_model"
          }
        ]
      },
      {
        "id": "act_compare_planets",
        "instruction": {
          "title": "Comparing Retrograde Across the Solar System",
          "description": "Examine the Jupiter and Saturn models. Observe the visual charts comparing retrograde loop shapes. Note how more distant outer planets yield smaller, less dramatic loops in Earth's sky because of the vast distances and their slower orbital velocities."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "jupiter_model",
              "type": "predicate",
              "augmentation": "pred_outer_planets_comparison_img",
              "poi": "info_tag",
              "url": "https://assets.example.com/images/planet_loops_comparison.png"
            },
            {
              "target": "saturn_model",
              "type": "predicate",
              "augmentation": "pred_audio_explanation_step5",
              "poi": "info_tag",
              "url": "https://assets.example.com/audio/outer_planets_retrograde.mp3"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "jupiter_model"
          }
        ]
      }
    ]
  }
