  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Replication Lab",
    "description": "Interactive AR exploration of DNA structure and the molecular mechanics of replication.",
    "workplace": "wp_dna_lab_bench",
    "start": "act_intro_structure",
    "actions": [
      {
        "id": "act_intro_structure",
        "instruction": {
          "title": "DNA Double Helix & Antiparallel Strands",
          "description": "Examine the 3D model of the DNA double helix. Notice the two ribbon-like sugar-phosphate backbones spiraling around a common axis. The strands are antiparallel: one runs 5' to 3' while the opposing strand runs 3' to 5'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone",
              "text": "Antiparallel Sugar-Phosphate Backbone (5' to 3' vs 3' to 5')"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_audio_explanation",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "poi_backbone"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_audio_explanation",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_model"
          }
        ]
      },
      {
        "id": "act_base_pairing",
        "instruction": {
          "title": "Complementary Base-Pairing Rules",
          "description": "Observe the nitrogenous bases pointing inward. They pair specifically: Adenine pairs with Thymine (stabilized by two hydrogen bonds) and Guanine pairs with Cytosine (stabilized by three hydrogen bonds)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_bases",
              "text": "Complementary Base Pairing: A-T (2 H-Bonds), G-C (3 H-Bonds)"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_img_basepairing",
              "poi": "poi_bases"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_bases"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_img_basepairing",
              "poi": "poi_bases"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_model"
          }
        ]
      },
      {
        "id": "act_replication_fork",
        "instruction": {
          "title": "Unwinding and Initiation",
          "description": "Move to the Replication Fork model. Identify the enzyme Helicase unwinding the parental DNA double helix, and Single-Strand Binding Proteins stabilizing the exposed single strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_anim_replication",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_anim_replication",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_replication_fork_model"
          }
        ]
      },
      {
        "id": "act_leading_strand",
        "instruction": {
          "title": "Continuous Leading Strand Synthesis",
          "description": "Because DNA Polymerase can only add nucleotides in the 5' to 3' direction, it synthesizes the leading strand continuously, directly following the replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_leading_strand",
              "text": "Continuous Leading Strand (Synthesized 5' -> 3')"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_leading_strand"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_replication_fork_model"
          }
        ]
      },
      {
        "id": "act_lagging_strand",
        "instruction": {
          "title": "Discontinuous Lagging Strand Synthesis",
          "description": "The lagging strand is oriented in the opposite direction. Synthesis occurs discontinuously away from the fork in short Okazaki fragments, which DNA Ligase must eventually seal together."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_video_okazaki",
              "poi": "poi_lagging_strand"
            },
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_lagging_strand",
              "text": "Lagging Strand (Discontinuous Okazaki Fragments)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_video_okazaki",
              "poi": "poi_lagging_strand"
            },
            {
              "target": "thing_replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "poi_lagging_strand"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_replication_fork_model"
          }
        ]
      },
      {
        "id": "act_semiconservative_wrap",
        "instruction": {
          "title": "Semiconservative Replication Result",
          "description": "Review the resulting daughter strands at the gel station. Observe that each new DNA double helix contains one original conserved parental strand and one newly synthesized strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_gel_station",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "default",
              "text": "Semiconservative Completion: One Parent Strand, One New Strand"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_gel_station",
              "type": "predicate",
              "augmentation": "pred_label_bases",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_gel_station"
          }
        ]
      }
    ]
  }
