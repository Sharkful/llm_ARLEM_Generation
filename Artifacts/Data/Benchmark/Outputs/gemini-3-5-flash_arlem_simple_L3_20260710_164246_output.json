  "activity": {
    "id": "act_heart_anatomy_tour",
    "name": "Structural Anatomy and Dual Circulation of the Human Heart",
    "description": "An interactive, step-by-step AR lab exploration of the human heart's structural anatomy, tracing the pathway of blood through chambers, valves, and systemic versus pulmonary circuits.",
    "workplace": "wp_anatomy_lab",
    "start": "action_01_chambers",
    "actions": [
      {
        "id": "action_01_chambers",
        "instruction": {
          "title": "Locate the Four Heart Chambers",
          "description": "Inspect the physical heart model on the bench. Locate the thin-walled upper receiving chambers (Right Atrium and Left Atrium) and the thick-walled lower pumping chambers (Right Ventricle and Left Ventricle). Note the structural differences between them."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_02_valves",
        "instruction": {
          "title": "Identify the Heart Valves",
          "description": "Observe the four key valves that enforce one-way blood flow. Find the atrioventricular (AV) valves (Tricuspid and Mitral/Bicuspid) separating the atria from the ventricles, and the semilunar valves (Pulmonary and Aortic) guarding the major arterial exits."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_03_pulmonary_circuit",
        "instruction": {
          "title": "The Pulmonary Circulation Loop",
          "description": "Focus on the physical Lungs Diagram to trace the low-pressure pulmonary circuit. Deoxygenated blood enters the Right Atrium, passes through the Tricuspid Valve, and is pumped by the Right Ventricle through the Pulmonary Valve into the lungs for oxygenation."
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_pulmonary_diagram"
          }
        ]
      },
      {
        "id": "action_04_systemic_circuit",
        "instruction": {
          "title": "The Systemic Circuit & Myocardium",
          "description": "Focus on the Systemic Diagram. Oxygenated blood from the lungs enters the Left Atrium, passes the Mitral Valve, and reaches the Left Ventricle. From there, it is pumped through the Aortic Valve and Aorta to the entire body. Note why the Left Ventricle has a much thicker muscular wall than the Right."
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_systemic_diagram"
          }
        ]
      },
      {
        "id": "action_05_summary",
        "instruction": {
          "title": "Cardiac Cycle & Ventricular Workloads",
          "description": "Listen to the audio summary outlining the dual-loop circulation, backflow prevention by the valves, and the clinical importance of ventricular wall thickness ratios. Click anywhere on the main bench to finish the lab experience."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_main_bench"
          }
        ]
      }
    ]
  }
