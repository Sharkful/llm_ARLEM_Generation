  "activity": {
    "id": "act_vectors_projectile",
    "name": "Vectors & Projectile Motion AR Lab",
    "description": "An introductory, hands-on AR lab module designed for General Physics students to grasp vector mathematics, graphical addition, component decomposition, and 2-dimensional kinematics using a projectile launcher.",
    "workplace": "wp_physics_lab",
    "start": "step1_vector_basics",
    "actions": [
      {
        "id": "step1_vector_basics",
        "instruction": {
          "title": "Step 1: Intro to Vectors",
          "description": "Look at the physical Vector Board on your desk. Observe the two colored arrows representing Vector A (red) and Vector B (blue). Note that their length represents magnitude and their orientation represents direction in 2D space."
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_tip_to_tail"
          }
        ]
      },
      {
        "id": "step2_tip_to_tail",
        "instruction": {
          "title": "Step 2: Tip-to-Tail Addition",
          "description": "Watch the animation on your Vector Board. Vector B's tail slides dynamically to the tip of Vector A. The green Resultant Vector starts at the tail of A and ends at the tip of B. This is the graphic tip-to-tail addition method."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_vector_addition_anim",
              "poi": "default"
            },
            {
              "target": "thing_vector_board",
              "type": "predicate",
              "augmentation": "pred_label_resultant",
              "poi": "poi_resultant",
              "text": "Resultant Vector R = A + B"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_board"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_decomposition"
          }
        ]
      },
      {
        "id": "step3_decomposition",
        "instruction": {
          "title": "Step 3: Vector Decomposition",
          "description": "Turn to the Whiteboard. To analyze real projectile motion, any diagonal vector must be resolved into independent horizontal (x) and vertical (y) component vectors. Look at the trigonometric equations displayed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_whiteboard",
              "type": "predicate",
              "augmentation": "pred_vector_decomp_img",
              "poi": "poi_trig_diagram"
            },
            {
              "target": "place_whiteboard",
              "type": "predicate",
              "augmentation": "pred_label_v_x",
              "poi": "poi_graph_origin",
              "text": "V_x = V * cos(\u03b8)"
            },
            {
              "target": "place_whiteboard",
              "type": "predicate",
              "augmentation": "pred_label_v_y",
              "poi": "poi_graph_origin",
              "text": "V_y = V * sin(\u03b8)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_whiteboard"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_trajectory"
          }
        ]
      },
      {
        "id": "step4_trajectory",
        "instruction": {
          "title": "Step 4: Independent Motions",
          "description": "Look at the Projectile Launcher. When a ball is launched, its initial velocity decomposes into V_x and V_y. Gravity only acts vertically; thus, horizontal velocity stays constant while vertical velocity changes constantly, creating a parabolic flight path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_trajectory_anim",
              "poi": "poi_muzzle"
            },
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_label_v_x",
              "poi": "poi_angle_dial",
              "text": "V_x remains constant. a_y = -g."
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launcher"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_range_angle"
          }
        ]
      },
      {
        "id": "step5_range_angle",
        "instruction": {
          "title": "Step 5: Angle and Range",
          "description": "Observe the Landing Ramp. Adjust the angle dial on the launcher to see how range varies. Note that a 45-degree launch angle achieves the maximum horizontal range, whereas a 90-degree angle maximizes vertical peak height."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_landing_grid",
              "type": "predicate",
              "augmentation": "pred_trajectory_anim",
              "poi": "poi_range_scale"
            },
            {
              "target": "thing_landing_grid",
              "type": "predicate",
              "augmentation": "pred_label_resultant",
              "poi": "poi_impact_point",
              "text": "45\u00b0 yields Max Range"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_landing_grid"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6_complete"
          }
        ]
      },
      {
        "id": "step6_complete",
        "instruction": {
          "title": "Step 6: Module Completed",
          "description": "Excellent! You have successfully mastered 2D vectors, mathematical decomposition, and their direct kinematics applications to projectile trajectories. Please return the lab items to their starting places."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_lab_desk",
              "type": "predicate",
              "augmentation": "pred_label_resultant",
              "poi": "poi_desk_center",
              "text": "Lab Completed Successfully!"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_lab_desk"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_vector_basics"
          }
        ]
      }
    ]
  }
