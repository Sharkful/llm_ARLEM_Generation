  "activity": {
    "id": "vsepr_theory_lab",
    "name": "VSEPR Theory & Molecular Geometries",
    "description": "Interactive lab exploring VSEPR Theory, electron domains, and molecular geometry deviations in Methane, Ammonia, and Water.",
    "workplace": "vsepr_lab_workplace",
    "start": "step1_vsepr_intro",
    "actions": [
      {
        "id": "step1_vsepr_intro",
        "instruction": {
          "title": "Introduction to VSEPR Theory",
          "description": "Look at the interactive board to watch an introduction to Valence Shell Electron Pair Repulsion (VSEPR) theory and learn how to determine steric numbers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "interactive_board",
              "type": "predicate",
              "augmentation": "vsepr_intro_video",
              "poi": "screen",
              "url": "https://assets.example.com/vsepr_intro.mp4"
            },
            {
              "target": "interactive_board",
              "type": "predicate",
              "augmentation": "vsepr_rules_label",
              "poi": "default",
              "text": "Steric Number = (Bonding Pairs) + (Lone Pairs)"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "interactive_board"
          }
        ]
      },
      {
        "id": "step2_tetrahedral_geometry",
        "instruction": {
          "title": "Step 2: Ideal Tetrahedral Shape (CH4)",
          "description": "Find and scan the Methane (CH4) model. Observe how the four bonding domains arrange themselves symmetrically in 3D space to minimize repulsion, forming the ideal tetrahedral angle of 109.5 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "methane_model",
              "type": "predicate",
              "augmentation": "tetrahedral_diagram",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "methane_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "methane_model"
          }
        ]
      },
      {
        "id": "step3_trigonal_pyramidal_repulsion",
        "instruction": {
          "title": "Step 3: Lone Pair Repulsion (NH3)",
          "description": "Scan the Ammonia (NH3) model. Observe how the single lone pair on the nitrogen atom occupies more space than the bonding pairs, pushing the N-H bonds closer together and reducing the bond angle to 107.3 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ammonia_model",
              "type": "predicate",
              "augmentation": "ammonia_repulsion_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "ammonia_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "ammonia_model"
          }
        ]
      },
      {
        "id": "step4_bent_geometry_water",
        "instruction": {
          "title": "Step 4: Double Lone Pair Compression (H2O)",
          "description": "Scan the Water (H2O) model. Water contains two bonding pairs and two highly repulsive lone pairs on the central oxygen atom. Watch them compress the H-O-H angle down to 104.5 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "water_model",
              "type": "predicate",
              "augmentation": "bent_geometry_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "water_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "water_model"
          }
        ]
      },
      {
        "id": "step5_bond_angle_comparison",
        "instruction": {
          "title": "Step 5: Angle Comparison & Review",
          "description": "Look at your chemistry lab bench. Review the summary diagram comparing ideal tetrahedral, trigonal pyramidal, and bent molecular shapes alongside their final steric angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lab_bench",
              "type": "predicate",
              "augmentation": "bond_angle_comparison",
              "poi": "workzone"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lab_bench",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "lab_bench"
          }
        ]
      }
    ]
  }
