  "activity": {
    "id": "astronomy_retrograde_lab",
    "name": "Apparent Retrograde Motion Lab",
    "description": "An interactive AR exploration of planetary retrograde motion, teaching undergraduate students how the heliocentric model naturally explains why planets appear to move backward against the stars.",
    "workplace": "astronomy_classroom_lab",
    "start": "step_1_observation",
    "actions": [
      {
        "id": "step_1_observation",
        "instruction": {
          "title": "The Mystery of Retrograde Motion",
          "description": "Look up at the night sky celestial dome. Watch Mars drift slowly eastward, trace a dramatic retrograde loop westward against the constellations Leo and Virgo, and then resume its eastward motion. This strange loop was the ultimate cosmic mystery of ancient astronomy."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_celestial_dome",
              "type": "predicate",
              "augmentation": "pred_mars_retro_anim",
              "poi": "sky_dome"
            },
            {
              "target": "place_celestial_dome",
              "type": "predicate",
              "augmentation": "pred_audio_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_2_geocentric",
        "instruction": {
          "title": "The Geocentric Solution: Epicycles",
          "description": "Examine the Ptolemaic geocentric model on the orrery. To explain the loop, ancient astronomers placed Mars on a small rotating circle (an epicycle) which itself rolled along a larger circle (the deferent) around Earth. Observe how this complex geometry produces the apparent loop when Mars is closest to Earth."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_geocentric_anim",
              "poi": "default"
            },
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_audio_geocentric",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_orrery_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_3_heliocentric",
        "instruction": {
          "title": "The Copernican Revolution: Overtaking",
          "description": "Now shift to the Copernicus heliocentric model on the orrery. Watch Earth (moving faster on its inner orbit) catch up to and overtake Mars (moving slower on its outer orbit). The loop is gone; both planets trace perfect, simple ellipses around the Sun."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_heliocentric_anim",
              "poi": "default"
            },
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_audio_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_orrery_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_4_perspective_linkage",
        "instruction": {
          "title": "Connecting the Two Perspectives",
          "description": "Observe this side-by-side visualization. Watch the sightline drawn from Earth through Mars as Earth overtakes it. See how this geometric line of sight naturally sweeps backward across the distant stars, creating the illusion of retrograde motion without needing any epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_line_of_sight_anim",
              "poi": "default"
            },
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_audio_linkage",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_orrery_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_5_embodied_overtaking",
        "instruction": {
          "title": "Be the Earth: Embodied Overtaking",
          "description": "Walk slowly along the highlighted orbital ring on the floor (representing Earth's orbit) while keeping your eyes locked on the virtual Mars ahead. Watch Mars's position shift against the stars on the far wall. As you pass Mars, its apparent direction backward is generated purely by your own forward motion!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_floor_orbit",
              "type": "predicate",
              "augmentation": "pred_walking_guide",
              "poi": "default"
            },
            {
              "target": "place_floor_orbit",
              "type": "predicate",
              "augmentation": "pred_audio_embodied",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_floor_orbit",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_6_outer_planets",
        "instruction": {
          "title": "Comparing Mars, Jupiter, and Saturn",
          "description": "Observe how retrograde loops change for more distant planets. Compare Mars, Jupiter, and Saturn. Because Jupiter and Saturn are much farther away from Earth, the angle subtended by Earth's overtaking motion is smaller, leading to progressively smaller apparent loops (15\u00b0 vs 10\u00b0 vs 7\u00b0)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_outer_planets_comparison",
              "poi": "default"
            },
            {
              "target": "thing_orrery_model",
              "type": "predicate",
              "augmentation": "pred_audio_planets",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_orrery_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_7_prediction_challenge",
        "instruction": {
          "title": "Prediction Challenge: Spotting Opposition",
          "description": "Use the console slider to orbit Mars. Place Mars in the correct orbital position where an observer on Earth would see it undergo retrograde motion. Hint: Seek 'opposition', where Earth is aligned directly between the Sun and Mars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_interactive_console",
              "type": "predicate",
              "augmentation": "pred_prediction_game",
              "poi": "screen"
            },
            {
              "target": "thing_interactive_console",
              "type": "predicate",
              "augmentation": "pred_audio_prediction",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_interactive_console",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      },
      {
        "id": "step_8_recap",
        "instruction": {
          "title": "Summary & Key Takeaways",
          "description": "Review the key concepts: the observed retrograde loop, the convoluted geocentric epicycle explanation, the simpler Copernican heliocentric overtaking geometry, the line-of-sight sweep, and why distant outer planets have smaller loops. You have completed the lab!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_classroom_board",
              "type": "predicate",
              "augmentation": "pred_summary_slide",
              "poi": "default"
            },
            {
              "target": "thing_classroom_board",
              "type": "predicate",
              "augmentation": "pred_audio_recap",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_classroom_board",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_console"
          }
        ]
      }
    ]
  }
