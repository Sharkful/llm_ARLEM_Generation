  "activity": {
    "id": "dna_replication_lab",
    "name": "DNA Structure and Semiconservative Replication Lab",
    "description": "An interactive, 11-step AR laboratory walk-through exploring DNA molecular structure and the mechanics of semiconservative replication at the replication fork.",
    "workplace": "bio_lab_bench_workplace",
    "start": "step_1_ladder_schematic",
    "actions": [
      {
        "id": "step_1_ladder_schematic",
        "instruction": {
          "title": "The DNA Ladder Schematic",
          "description": "Observe the flat, schematic ladder structure of DNA in the workspace. The vertical rails represent the repeating sugar-phosphate backbones, and the horizontal rungs represent complementary nitrogenous base pairs: Adenine (A, Red) pairs with Thymine (T, Blue), and Guanine (G, Yellow) pairs with Cytosine (C, Green)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_ladder_model",
              "type": "predicate",
              "augmentation": "pred_ladder_visual",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_ladder_model",
              "augmentation": "pred_ladder_visual",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_ladder_schematic"
          }
        ]
      },
      {
        "id": "step_2_double_helix",
        "instruction": {
          "title": "The Double Helix Geometry",
          "description": "Watch the flat ladder twist into a 3D double helix. Observe how the two backbones spiral around a common central axis, with the base pairs stacking horizontally on the interior of the structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_helix_visual",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "pred_helix_visual",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_double_helix"
          }
        ]
      },
      {
        "id": "step_3_antiparallel_direction",
        "instruction": {
          "title": "Antiparallel Strands (5' to 3')",
          "description": "Observe the arrows showing the opposite direction of each strand. One strand runs 5' to 3' (referring to carbon positions on the deoxyribose sugar), while its complement runs 3' to 5'. This antiparallel orientation is a defining physical trait of the double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_antiparallel_labels",
              "poi": "prime_5_end",
              "text": "5' End"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_antiparallel_labels",
              "poi": "prime_3_end",
              "text": "3' End"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_antiparallel_direction"
          }
        ]
      },
      {
        "id": "step_4_base_pairing_game",
        "instruction": {
          "title": "Interactive Base-Pairing Rules",
          "description": "Complete the empty right strand by pairing the correct complementary bases. Remember the rules: Adenine (A) always pairs with Thymine (T) via 2 hydrogen bonds, and Guanine (G) pairs with Cytosine (C) via 3 hydrogen bonds. Drag the bases from the palette into place."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_ladder_model",
              "type": "predicate",
              "augmentation": "pred_base_pairing_prompt",
              "poi": "strand_right",
              "text": "Complete the complementary strand sequence."
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_ladder_model"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_base_pairing_game"
          }
        ]
      },
      {
        "id": "step_5_helicase_unwind",
        "instruction": {
          "title": "Helicase Unwinding",
          "description": "Watch Helicase bind to the double helix. This ring-shaped enzyme moves along the DNA, breaking the hydrogen bonds that hold base pairs together to separate the two strands and create the replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rep_fork_model",
              "type": "predicate",
              "augmentation": "pred_helicase_anim",
              "poi": "helicase_site"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rep_fork_model",
              "augmentation": "pred_helicase_anim",
              "poi": "helicase_site"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_helicase_unwind"
          }
        ]
      },
      {
        "id": "step_6_ssb_stabilization",
        "instruction": {
          "title": "Single-Strand Binding Proteins (SSBs)",
          "description": "Single-strand binding proteins (SSBs) now bind to the exposed single DNA strands. They stabilize the unstable single-stranded DNA and prevent the strands from snapping back together before replication is complete."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rep_fork_model",
              "type": "predicate",
              "augmentation": "pred_ssb_anim",
              "poi": "ssb_site"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rep_fork_model",
              "augmentation": "pred_ssb_anim",
              "poi": "ssb_site"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6_ssb_stabilization"
          }
        ]
      },
      {
        "id": "step_7_leading_strand",
        "instruction": {
          "title": "Leading Strand Continuous Synthesis",
          "description": "DNA Polymerase III binds to the leading strand template. Because DNA Polymerase can only synthesize a new strand in the 5'-to-3' direction, it is able to synthesize this strand continuously, following directly behind the moving replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rep_fork_model",
              "type": "predicate",
              "augmentation": "pred_leading_polymerase_anim",
              "poi": "leading_polymerase"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rep_fork_model",
              "augmentation": "pred_leading_polymerase_anim",
              "poi": "leading_polymerase"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_7_leading_strand"
          }
        ]
      },
      {
        "id": "step_8_lagging_strand",
        "instruction": {
          "title": "Discontinuous Lagging Strand Synthesis",
          "description": "Observe the lagging strand template. Because polymerase must synthesize in the 5'-to-3' direction, it has to work backward away from the replication fork, producing short, discontinuous segments called Okazaki fragments. These are later joined together by DNA Ligase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rep_fork_model",
              "type": "predicate",
              "augmentation": "pred_lagging_polymerase_anim",
              "poi": "lagging_polymerase"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rep_fork_model",
              "augmentation": "pred_lagging_polymerase_anim",
              "poi": "lagging_polymerase"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_8_lagging_strand"
          }
        ]
      },
      {
        "id": "step_9_replication_fork_overview",
        "instruction": {
          "title": "The Active Replication Fork",
          "description": "Observe the complete, active replication fork. Notice how the antiparallel structure of the DNA templates forces this asymmetry, requiring one continuous leading strand and one discontinuous lagging strand. Ensure you can identify all five molecular components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "rep_fork_model",
              "type": "predicate",
              "augmentation": "pred_replication_fork_full_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "rep_fork_model",
              "augmentation": "pred_replication_fork_full_anim",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_9_replication_fork_overview"
          }
        ]
      },
      {
        "id": "step_10_semiconservative_prediction",
        "instruction": {
          "title": "Semiconservative Replication Quiz",
          "description": "Look at the parental DNA molecule (gold) split and replicate. Each daughter molecule contains one original strand (gold) and one newly synthesized strand (silver). Predict the resulting strand distribution after a second round of replication!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "presentation_board",
              "type": "predicate",
              "augmentation": "pred_semiconservative_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "presentation_board",
              "augmentation": "pred_semiconservative_anim",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_10_semiconservative_prediction"
          }
        ]
      },
      {
        "id": "step_11_recap_summary",
        "instruction": {
          "title": "Lab Review & Recap",
          "description": "Great job! You have explored the physical architecture of the double helix, the base-pairing principles, the directional constraints of replication, and the semiconservative model. Complete your lab notes on DNA replication before exiting."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "presentation_board",
              "type": "predicate",
              "augmentation": "pred_summary_slide",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "presentation_board",
              "augmentation": "pred_summary_slide",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_11_recap_summary"
          }
        ]
      }
    ]
  }
