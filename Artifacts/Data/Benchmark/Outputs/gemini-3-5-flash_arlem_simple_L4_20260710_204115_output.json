  "activity": {
    "id": "activity_heart_anatomy_lab",
    "name": "Human Heart Anatomy & Blood Flow Path",
    "description": "An interactive exploration of human heart chambers, valves, systemic/pulmonary circulation loops, and wall thickness asymmetry.",
    "workplace": "workplace_anatomy_lab",
    "start": "action_intro",
    "actions": [
      {
        "id": "action_intro",
        "instruction": {
          "title": "Orientation to the Heart",
          "description": "Examine the exterior of the intact heart and the internal structures of the cutaway heart side-by-side. Note how left/right labels are reversed because they reflect the patient's perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_intact",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Intact Heart (Anterolateral View)"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Cutaway Heart (Internal Structures)"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_structural_tour"
          }
        ]
      },
      {
        "id": "action_structural_tour",
        "instruction": {
          "title": "Chambers and Valves Tour",
          "description": "Locate the four chambers (Right Atrium, Right Ventricle, Left Atrium, Left Ventricle) and notice how the Tricuspid and Mitral (Bicuspid) valves act as doors between them."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mitral",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_tour",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cutaway",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_dual_circulation"
          }
        ]
      },
      {
        "id": "action_dual_circulation",
        "instruction": {
          "title": "Dual-Circuit Circulation",
          "description": "Observe how deoxygenated blood flows through the blue pulmonary circuit to the lungs, while oxygenated blood flows through the red systemic circuit to nourish the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_anim_blood_flow",
              "poi": "default"
            },
            {
              "target": "place_anatomy_lab",
              "type": "predicate",
              "augmentation": "pred_img_circuits",
              "poi": "default"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_flow",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cutaway",
              "augmentation": "*"
            },
            {
              "target": "place_anatomy_lab",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_rbc_trace"
          }
        ]
      },
      {
        "id": "action_rbc_trace",
        "instruction": {
          "title": "Red Blood Cell Path Trace",
          "description": "Follow a single red blood cell as it travels from the vena cava, is pumped through the right side to the lungs (where it turns red), returns to the left side, and gets pumped out the aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_anim_rbc",
              "poi": "default"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_trace",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cutaway",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_myocardium_thickness"
          }
        ]
      },
      {
        "id": "action_myocardium_thickness",
        "instruction": {
          "title": "Ventricular Wall Asymmetry",
          "description": "Compare the ventricular wall thicknesses. The left ventricle's myocardium is 3x thicker because it must generate enough systemic pressure to pump blood to the entire body, not just the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cross_section",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_rv_myocardium",
              "text": "Right Ventricle Myocardium (3-5 mm thick)"
            },
            {
              "target": "thing_heart_cross_section",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_lv_myocardium",
              "text": "Left Ventricle Myocardium (10-15 mm thick) - High pressure generator"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_myocardium",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cross_section",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_valve_mechanics"
          }
        ]
      },
      {
        "id": "action_valve_mechanics",
        "instruction": {
          "title": "Valve Mechanics & Backflow Prevention",
          "description": "Examine how the AV valves (tricuspid/mitral) and semilunar valves (pulmonary/aortic) change states. They seal shut under pressure to prevent backwards blood flow."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve: Prevents backflow into Right Atrium during ventricular contraction"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve: Prevents backflow into Right Ventricle during relaxation"
            },
            {
              "target": "place_dissecting_bench",
              "type": "predicate",
              "augmentation": "pred_audio_valves",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cutaway",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_intro"
          }
        ]
      }
    ]
  }
}