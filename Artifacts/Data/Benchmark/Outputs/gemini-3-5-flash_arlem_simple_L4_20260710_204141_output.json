  "activity": {
    "id": "act_physics_vectors_projectile",
    "name": "General Physics I: Vectors and Projectile Motion Lab",
    "description": "An interactive General Physics lab covering 3D vector algebra operations (addition, decomposition) and their direct application to 2D projectile kinematics.",
    "workplace": "wp_physics_vectors",
    "start": "step_01_intro",
    "actions": [
      {
        "id": "step_01_intro",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Explore the fundamental concept of vectors. Walk around the arrow, drag its head to scale, and observe how magnitude and direction indicators update in real time."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_manipulator",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Grab and drag the vector head in space"
            },
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_audio_intro"
            },
            {
              "target": "thing_vector_manipulator",
              "type": "predicate",
              "augmentation": "pred_vector_arrow_static",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_manipulator",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_sandbox",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_01_intro"
          }
        ]
      },
      {
        "id": "step_02_addition",
        "instruction": {
          "title": "Vector Addition (Tip-to-Tail)",
          "description": "See how two distinct vectors add graphically using the tip-to-tail technique. Reorient either vector and see the red resultant adjust dynamically."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_audio_addition"
            },
            {
              "target": "thing_vector_manipulator",
              "type": "predicate",
              "augmentation": "pred_vector_addition_diagram",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_manipulator",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_sandbox",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_02_addition"
          }
        ]
      },
      {
        "id": "step_03_decomposition",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Reverse vector addition by breaking down a single vector into its respective coordinate axis components (x, y, z). Notice how the components form a right-angled triangle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_audio_decomp"
            },
            {
              "target": "thing_vector_manipulator",
              "type": "predicate",
              "augmentation": "pred_vector_decomp_diagram",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_manipulator",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_sandbox",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_03_decomposition"
          }
        ]
      },
      {
        "id": "step_04_projectile_intro",
        "instruction": {
          "title": "Transition to Projectile Motion",
          "description": "Step into projectile motion! We apply vectors in a 2D vertical plane containing an initial velocity vector under the influence of gravity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_firing_range",
              "type": "predicate",
