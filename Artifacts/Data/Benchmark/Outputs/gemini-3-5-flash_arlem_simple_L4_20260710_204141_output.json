          }
        ]
      },
      {
        "id": "step_05_projectile_flight",
        "instruction": {
          "title": "Independence of Motion",
          "description": "Watch the projectile trajectory. The horizontal velocity vector remains constant, while the vertical velocity vector changes steadily under gravity, passing through zero at the maximum height."
