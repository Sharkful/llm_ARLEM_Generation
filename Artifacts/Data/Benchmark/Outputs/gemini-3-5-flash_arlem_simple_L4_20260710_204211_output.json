  "activity": {
    "id": "act_vsepr_exploration",
    "name": "VSEPR Theory & Molecular Geometry",
    "description": "An interactive exploration of the Valence Shell Electron Pair Repulsion (VSEPR) theory, mapping steric numbers to 3D electron-domain and molecular geometries.",
    "workplace": "wp_vsepr_lab",
    "start": "act_intro",
    "actions": [
      {
        "id": "act_intro",
        "instruction": {
          "title": "Introduction to VSEPR Theory",
          "description": "Welcome to the VSEPR Theory lab. Look at the reference wall to view a flat Lewis structure of water. Notice how we count electron domains: every single, double, or triple bond, and every lone pair, counts as one domain. Today we will see how these domains arrange themselves in 3D space to minimize repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_wall",
              "type": "predicate",
              "augmentation": "pred_lewis_water_panel",
              "poi": "default"
            },
            {
              "target": "place_main_bench",
              "type": "predicate",
              "augmentation": "pred_vsepr_intro_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      },
      {
        "id": "act_repulsion_2_to_4",
        "instruction": {
          "title": "Minimum Repulsion (Steric Numbers 2-4)",
          "description": "Observe the central atom. Watch as 2, 3, and then 4 electron domains are added. Notice how they spontaneously push away from one another due to mutual electrostatic repulsion, settling into linear (180\u00b0), trigonal planar (120\u00b0), and tetrahedral (109.5\u00b0) arrangements."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_linear_planar_tetra_anim",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_reference_wall",
              "augmentation": "pred_lewis_water_panel"
            },
            {
              "target": "place_main_bench",
              "augmentation": "pred_vsepr_intro_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      },
      {
        "id": "act_repulsion_5_to_6",
        "instruction": {
          "title": "Five & Six Domains (Steric Numbers 5-6)",
          "description": "Now we expand to higher coordination numbers. Watch 5 domains settle into a trigonal bipyramidal shape (90\u00b0 and 120\u00b0 angles), and 6 domains form an octahedral structure (all 90\u00b0 angles). Refer to the summary chart on the wall for characteristic angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_bipyramidal_octahedral_anim",
              "poi": "default"
            },
            {
              "target": "place_reference_wall",
              "type": "predicate",
              "augmentation": "pred_summary_geometries_img",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "pred_linear_planar_tetra_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      },
      {
        "id": "act_domain_vs_molecular",
        "instruction": {
          "title": "Domain vs. Molecular Geometry",
          "description": "Compare how molecular geometry differs from electron domain geometry. Watch as we replace bonding domains in a tetrahedral system (methane) with lone pairs (ammonia, then water). The underlying domain skeleton stays tetrahedral, but the molecular shape transitions from tetrahedral to trigonal pyramidal, and finally to bent."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_domain_vs_molecular_anim",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "pred_bipyramidal_octahedral_anim"
            },
            {
              "target": "place_reference_wall",
              "augmentation": "pred_summary_geometries_img"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      },
      {
        "id": "act_lone_pair_asymmetry",
        "instruction": {
          "title": "Lone Pair Angular Asymmetry",
          "description": "Observe why lone pairs compress adjacent bond angles. Because they are held by only one nucleus, lone pairs occupy more angular space than bonding pairs. Compare methane (109.5\u00b0), ammonia (107\u00b0), and water (104.5\u00b0) side by side on the comparison deck to see this asymmetry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_comparison_deck",
              "type": "predicate",
              "augmentation": "pred_asymmetry_comparison_img",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "pred_domain_vs_molecular_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      },
      {
        "id": "act_gallery_and_recap",
        "instruction": {
          "title": "VSEPR Molecular Gallery & Recap",
          "description": "Explore real-world examples: CO2, BF3, CH4, PF5, SF6, and XeF4. Walk around the comparison deck to observe their 3D layouts, and read the summary recap on the reference wall. Click the board to complete the lab!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_comparison_deck",
              "type": "predicate",
              "augmentation": "pred_gallery_molecules_anim",
              "poi": "default"
            },
            {
              "target": "place_reference_wall",
              "type": "predicate",
              "augmentation": "pred_recap_text",
              "poi": "default",
              "text": "VSEPR Recap: Minimizing electron repulsion dictates spatial geometry. Domain geometries guide physical structures, and lone pairs modify visible shapes while compressing bond angles."
            }
          ],
          "deactivate": [
            {
              "target": "thing_comparison_deck",
              "augmentation": "pred_asymmetry_comparison_img"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_interactive_board"
          }
        ]
      }
    ]
  }
}