          "clipName": "clip0",
          "audioClip": "heliocentric_revolution",
          "autoAdvance": false,
          "changes": [],
          "changeMeaning": "Introduce the Sun-centered model with Earth and Mars orbits.",
          "narration": "Now let's look at the heliocentric model proposed by Copernicus. Here, the Sun sits at the center, and all planets orbit in simple, smooth paths. Notice that Earth is closer to the Sun and orbits faster than Mars."
        },
        {
          "clipName": "clip1",
          "audioClip": "overtaking_phase",
          "autoAdvance": false,
          "changes": [
            {
              "target": "heliocentricLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Earth Overtaking Mars",
                  "color": [
                    255,
                    255,
                    255,
                    255
                  ],
                  "fontSize": 32
                }
              ]
            }
          ],
          "changeMeaning": "Earth catches up to Mars, showing the normal eastward sweep of the projection.",
          "narration": "As Earth catches up to the slower-moving Mars, watch the projected line of sight on the background stars. When Earth is far behind, the line of sight sweeps eastward normally."
        },
        {
          "clipName": "clip2",
          "audioClip": "opposition_and_retrograde",
          "autoAdvance": false,
          "changes": [
            {
              "target": "heliocentricLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Retrograde: Perspective Effect",
                  "color": [
                    255,
                    255,
                    255,
                    255
                  ],
                  "fontSize": 32
                }
              ]
            }
          ],
          "changeMeaning": "Show the line of sight sweeping backward as Earth passes Mars, producing the retrograde illusion.",
          "narration": "At the moment Earth passes Mars, our faster speed makes Mars appear to drift backward against the distant background stars. This is identical to passing a slower car on the highway\u2014it appears to drift backward relative to the distant scenery, even though both cars are moving forward!"
        },
        {
          "clipName": "clip3",
          "audioClip": "resuming_prograde",
          "autoAdvance": false,
          "changes": [
            {
              "target": "heliocentricLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "The Power of Parsimony",
                  "color": [
                    255,
                    255,
                    255,
                    255
                  ],
                  "fontSize": 32
                }
              ]
            }
          ],
          "changeMeaning": "Earth pulls ahead, and the normal prograde drift resumes.",
          "narration": "Once Earth pulls far enough ahead, the line of sight resumes its normal eastward sweep. This heliocentric explanation is far more parsimonious: the complex loop is just a natural consequence of perspective and relative motion!"
        }
      ]
