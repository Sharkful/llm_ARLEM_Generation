      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "geocentric_explanation",
          "autoAdvance": false,
          "changes": [],
          "changeMeaning": "Show Earth at the center and the deferent orbit representing the geocentric model.",
          "narration": "In the geocentric model, popularized by Ptolemy, Earth sat static at the center. To explain retrograde motion, planets couldn't just orbit Earth in simple circles; they had to orbit on smaller circles called epicycles."
        },
        {
          "clipName": "clip1",
          "audioClip": "complex_epicycle_motion",
          "autoAdvance": false,
          "changes": [
            {
              "target": "geocentricLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Ptolemaic Epicycles",
                  "color": [
                    255,
                    255,
                    255,
                    255
                  ],
                  "fontSize": 32
                }
              ]
            }
          ],
          "changeMeaning": "Show the combined motion of the epicycle and deferent to create the apparent retrograde loop.",
          "narration": "As the center of the epicycle carried Mars along the main orbit, called the deferent, Mars spun on its small epicycle. When Mars was on the inner part of the epicycle, its backward speed exceeded its forward orbital speed, creating the illusion of a retrograde loop."
        },
        {
          "clipName": "clip2",
          "audioClip": "complexity_and_parsimony",
          "autoAdvance": false,
          "changes": [
            {
              "target": "geocentricLabel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "The Problem of Complexity",
                  "color": [
                    255,
                    255,
                    255,
                    255
                  ],
                  "fontSize": 32
                }
              ]
            }
          ],
          "changeMeaning": "Discuss the complexity and lack of physical basis for epicycles.",
          "narration": "While this mathematical trick worked, it was highly artificial. As observations improved, astronomers had to add epicycles on top of epicycles to maintain accuracy. This lacked scientific parsimony."
        }
      ]
    },
