              "enabled": true
            },
            {
              "target": "geo_label_epicycle",
              "enabled": true
            }
          ],
          "changeMeaning": "Labels for epicycle and deferent are enabled to highlight the mechanics.",
          "narration": "Watch Mars as it loops. When Mars is on the inner part of its epicycle\u2014the side closest to Earth\u2014its backward speed on the epicycle is faster than its forward speed on the deferent. This combined motion creates the illusion of moving backward."
        },
        {
          "clipName": "clip_geo_critique",
          "audioClip": "retro_geo_critique",
          "autoAdvance": false,
          "changes": [
