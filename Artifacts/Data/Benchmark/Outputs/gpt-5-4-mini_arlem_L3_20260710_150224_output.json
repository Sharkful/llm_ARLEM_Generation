            "id": "step-2-earth-view",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step-3-geocentric",
        "viewport": "warnings",
        "type": "warnings",
        "device": "hl2",
        "location": "observation-desk",
        "predicate": "geocentric-epicycle-video",
        "instruction": {
          "title": "Compare the geocentric explanation",
          "description": "Review how the geocentric model used epicycles to force Mars into a loop. This explanation can match the observation, but it is less parsimonious than the heliocentric model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step-3-geocentric",
            "type": "action",
            "viewport": "warnings",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step-4-heliocentric",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hl2",
        "location": "solar-system-model-zone",
        "predicate": "heliocentric-orbit-animation",
        "instruction": {
          "title": "Switch to the heliocentric view",
          "description": "Inspect the orbital model. Watch Earth on the inner, faster orbit overtake Mars on the outer, slower orbit. The retrograde loop is an apparent effect created by this relative motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
