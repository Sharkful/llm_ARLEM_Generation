            "id": "step-4-heliocentric",
            "duration": 3,
            "type": "tangible",
            "viewport": "reactions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step-5-predict-retrograde",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2",
        "location": "planet-comparison-zone",
        "predicate": "planet-comparison-image",
        "instruction": {
          "title": "Predict and compare outer planets",
          "description": "Use the planet comparison cards to compare Mars, Jupiter, and Saturn. Predict when retrograde occurs by identifying when Earth is positioned to overtake the planet, and explain why more distant planets show smaller loops."
