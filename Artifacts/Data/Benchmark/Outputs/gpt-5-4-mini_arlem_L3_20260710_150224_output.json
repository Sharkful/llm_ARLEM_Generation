  "activity": {
    "id": "astronomy-retrograde-activity",
    "name": "Exploring Apparent Retrograde Motion",
    "description": "A guided AR lab for introductory astronomy students investigating why Mars appears to move backward in the sky. Learners first track the apparent loop from Earth\u2019s surface, then switch to a heliocentric view to connect the observed motion to Earth overtaking Mars. The activity ends with comparisons to geocentric epicycles and with Jupiter and Saturn to reinforce how orbital distance affects loop size.",
    "language": "en",
    "workplace": "astronomy-retrograde-workplace",
    "start": "step-1-orient",
    "actions": [
      {
        "id": "step-1-orient",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2",
        "location": "observation-desk",
        "predicate": "intro-label",
        "instruction": {
          "title": "Orient to the investigation",
          "description": "Look at the observation desk and identify the retrograde motion lab setup. Read the overview: Mars normally drifts eastward against the stars, but during retrograde it slows, reverses westward, and then resumes eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step-1-orient",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step-2-earth-view",
        "viewport": "actions",
        "type": "actions",
        "device": "hl2",
        "location": "sky-dome-zone",
        "predicate": "mars-path-animation",
        "instruction": {
          "title": "Trace Mars from Earth",
          "description": "Examine the sky dome and follow Mars night after night. Notice the eastward drift, the westward loop during retrograde, and the return to eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
