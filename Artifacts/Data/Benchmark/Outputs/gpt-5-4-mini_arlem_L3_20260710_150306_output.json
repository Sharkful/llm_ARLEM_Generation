  "activity": {
    "id": "bio_dna_lab_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An introductory AR laboratory experience for undergraduate biology and biochemistry students. Learners inspect a 3D DNA double helix, identify its structural components and complementary base pairing, examine antiparallel strand orientation, and then step through DNA replication at a replication fork to understand the coordinated roles of helicase, single-strand binding proteins, DNA polymerase, and DNA ligase. The activity emphasizes why DNA synthesis proceeds continuously on the leading strand and discontinuously on the lagging strand, and concludes with a semiconservative inheritance check.",
    "language": "en",
    "workplace": "bio_dna_lab_wp",
    "start": "step1_structure_overview",
    "actions": [
      {
        "id": "step1_structure_overview",
        "viewport": "actions",
        "type": "actions",
        "device": "holo_headset_01",
        "location": "bench_a",
        "predicate": "dna_structure_overview",
        "instruction": {
          "title": "DNA architecture overview",
          "description": "Inspect the double helix and identify the major structural elements: the sugar-phosphate backbones on the outside, nitrogenous bases facing inward, and hydrogen bonds holding complementary base pairs together. Move around the model to view its three-dimensional helical shape."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_complete",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_base_pairing",
        "viewport": "actions",
        "type": "actions",
        "device": "holo_headset_01",
        "location": "bench_a",
        "predicate": "show_base_pairing_image",
        "instruction": {
          "title": "Complementary base pairing",
          "description": "Use the sequence panel to apply the pairing rules: adenine pairs with thymine through two hydrogen bonds, and guanine pairs with cytosine through three hydrogen bonds. Determine the complementary strand for the displayed sequence."
        },
        "enter": {
