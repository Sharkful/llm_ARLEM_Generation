  "activity": {
    "id": "heart_blood_flow_activity",
    "name": "Heart Anatomy and Blood Flow Exploration",
    "description": "A guided AR lab for undergraduate anatomy students to identify heart structures, trace blood flow through the pulmonary and systemic circuits, and connect ventricular wall thickness with pressure demands and valve function.",
    "language": "en",
    "workplace": "heart_anatomy_lab",
    "start": "step1_orientation",
    "actions": [
      {
        "id": "step1_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "table_top",
        "predicate": "intro_overlay",
        "instruction": {
          "title": "Orient to the heart model",
          "description": "Observe the whole-heart model on the lab table. Identify the anterior view and use the overlay to locate the right side of the heart on your left in the model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_orientation",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "cardio_focus_zone",
        "predicate": "chamber_labels",
        "instruction": {
          "title": "Identify the four chambers",
          "description": "Move closer to the chamber labels and name the right atrium, right ventricle, left atrium, and left ventricle. Notice how the atria sit superior to the ventricles and how the left ventricle appears more muscular."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step2_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "cardio_focus_zone",
        "predicate": "valve_labels",
        "instruction": {
          "title": "Locate the four valves",
          "description": "Identify the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Use the valve overlay to match each valve with the chambers or chamber-vessel pairs it separates."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_blood_pathway",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "viewer_stand",
        "predicate": "blood_flow_animation",
        "instruction": {
          "title": "Trace blood through the heart",
          "description": "Follow the animated blood pathway in order: body \u2192 superior and inferior vena cava \u2192 right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary arteries \u2192 lungs \u2192 pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta \u2192 body."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step4_blood_pathway",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step5_circuits",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "cardio_focus_zone",
        "predicate": "pulmonary_vs_systemic_chart",
        "instruction": {
          "title": "Compare pulmonary and systemic circulation",
          "description": "Compare the two loops: the pulmonary circuit carries deoxygenated blood from the right ventricle to the lungs and back to the left atrium, while the systemic circuit carries oxygenated blood from the left ventricle to the body and back to the right atrium."
        },
        "enter": {
