            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step6_wall_thickness",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "table_top",
        "predicate": "ventricle_wall_comparison",
        "instruction": {
          "title": "Explain ventricular wall thickness and valve function",
          "description": "Examine the wall-thickness comparison and explain why the left ventricle is thicker: it generates the higher pressure needed for systemic circulation. Conclude by stating how the atrioventricular and semilunar valves prevent backflow during the cardiac cycle."
        },
