  "activity": {
    "id": "act_vsepr_theory_lab",
    "name": "VSEPR Theory: From Lewis Structure to Molecular Shape",
    "description": "A guided AR laboratory experience for General Chemistry I students that introduces VSEPR theory, steric number, electron-domain geometry, molecular geometry, and bond-angle deviations using interactive molecule models and reference examples.",
    "language": "en",
    "workplace": "chem_vsepr_lab",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_bench_surface",
        "predicate": "pred_intro_lewis",
        "instruction": {
          "title": "Start with the Lewis structure",
          "description": "Inspect the Lewis structure board and identify the central atom, bonding pairs, and lone pairs. This step introduces the core idea that electron domains arrange to minimize repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_molecule_kit",
              "augmentation": "pred_electron_geometry"
            },
            {
              "target": "thing_angle_gauge",
              "augmentation": "pred_angle_deviation"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_board",
              "augmentation": "pred_intro_lewis"
            },
            {
