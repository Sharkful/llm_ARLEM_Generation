  "activity": {
    "id": "astro_retrograde_activity",
    "name": "Understanding Apparent Retrograde Motion",
    "description": "A step-by-step AR lab for introductory astronomy that guides learners through Mars's observed retrograde loop, geocentric versus heliocentric explanations, cross-planet comparison, and a prediction challenge based on orbital geometry.",
    "language": "en",
    "workplace": "astro_retrograde_lab_wp",
    "start": "step1_observe_mars",
    "actions": [
      {
        "id": "step1_observe_mars",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "night_observation_zone",
        "predicate": "mars_path_intro_label",
        "instruction": {
          "title": "Observe Mars's apparent path",
          "description": "Watch Mars drift eastward against the constellations, slow, reverse westward in a retrograde loop, and then resume eastward motion. Use the trail to identify the full path over time."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "orbit_table",
              "augmentation": "geocentric_epicycle_video"
            },
            {
              "target": "earth_walk_ring",
              "augmentation": "heliocentric_orbits_animation"
            },
            {
              "target": "orbit_table",
              "augmentation": "planet_comparison_label"
            },
            {
              "target": "orbit_table",
              "augmentation": "prediction_prompt_label"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "sky_dome",
              "augmentation": "mars_path_intro_label"
            },
            {
              "target": "mars_model",
