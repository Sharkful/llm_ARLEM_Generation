  "activity": {
    "id": "dna_structure_replication_activity",
    "name": "DNA Structure, Antiparallelity, and Semiconservative Replication",
    "description": "A guided AR lab for introductory molecular biology students exploring DNA double-helix structure, complementary base pairing, antiparallel orientation, replication enzymes, leading/lagging strand synthesis, and semiconservative replication.",
    "language": "en",
    "workplace": "biology_dna_ar_lab",
    "start": "step1_schematic",
    "actions": [
      {
        "id": "step1_schematic",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens2",
        "location": "bench_surface",
        "predicate": "dna_label_structural_overview",
        "instruction": {
          "title": "1. Identify the DNA ladder",
          "description": "Observe the flat DNA schematic. Locate the sugar-phosphate backbones on the outside, the nitrogenous bases on the inside, and the base pairs connecting the two strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
