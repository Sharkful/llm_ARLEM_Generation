  "activity": {
    "id": "act_vsepr_geometry_training",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Geometry",
    "description": "A guided AR lab for General Chemistry I in which learners count electron domains, predict electron-domain geometry, distinguish molecular geometry from electron-domain geometry, and apply VSEPR to common molecules. The experience progresses from core principle to catalog, comparison, and prediction practice.",
    "language": "en",
    "workplace": "chem_vsepr_lab",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_main_bench",
        "predicate": "pred_intro_vsepr",
        "instruction": {
          "title": "Start with the VSEPR idea",
          "description": "Look at the central atom model and the flat Lewis structure panel. VSEPR says electron domains around a central atom spread out to minimize repulsion. Tap to continue when you have identified the central atom and the Lewis structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom_model",
              "augmentation": "pred_intro_vsepr"
            },
            {
              "target": "thing_lewis_panel",
              "augmentation": "pred_lewis_count"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "device_ar_headset",
        "location": "place_main_bench",
        "predicate": "pred_lewis_count",
        "instruction": {
          "title": "Count electron domains",
          "description": "Use the Lewis structure to count bonding pairs and lone pairs around the central atom. Remember: a single bond, double bond, triple bond, and lone pair each count as one electron domain. Say 'next' after you have counted the domains."
        },
        "enter": {
