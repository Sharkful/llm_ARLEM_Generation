            "mode": "click",
            "id": "step2_next"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "The westward loop",
          "description": "Now observe the retrograde loop itself. Mars appears to reverse direction for roughly two months, creating a backward loop in the sky."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_next"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Why the loop happens in heliocentric astronomy",
          "description": "Switch to the solar-system view. Earth moves on a smaller, faster orbit and overtakes Mars. This changing line of sight makes Mars appear to reverse direction, even though both planets continue moving smoothly in the same general orbital direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_next"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Compare Mars, Jupiter, and Saturn",
          "description": "Compare retrograde loops for outer planets. Mars shows the most dramatic loop because Earth overtakes it more strongly; Jupiter and Saturn show smaller loops because their greater distances from the Sun reduce the relative-motion effect."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
