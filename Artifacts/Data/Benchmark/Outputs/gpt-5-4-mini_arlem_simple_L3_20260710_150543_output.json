          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Model comparison: geocentric versus heliocentric",
          "description": "Conclude by contrasting explanations. The geocentric model requires epicycles to fit the observed loop, while the heliocentric model explains retrograde motion naturally through relative orbital motion and is preferred for its parsimony."
        },
