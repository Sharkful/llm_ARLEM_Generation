  "activity": {
    "id": "astro_activity_retrograde_linear",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A linear AR lesson for introductory astronomy students exploring why Mars appears to move backward against the stars during retrograde motion. Students first observe the path from Earth's surface, then switch to a heliocentric view to understand how Earth's faster orbit overtakes Mars. The lesson ends by comparing Mars with Jupiter and Saturn.",
    "workplace": "astro_workplace_retrograde",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Retrograde motion: the sky puzzle",
          "description": "Begin with the night-sky path of Mars. Notice that Mars usually drifts eastward relative to the background stars, but it periodically slows, reverses into a westward loop, and then resumes eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_next"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Watch the eastward drift",
          "description": "Focus on the first part of the cycle, when Mars moves slowly eastward against the constellations before the reversal begins."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
