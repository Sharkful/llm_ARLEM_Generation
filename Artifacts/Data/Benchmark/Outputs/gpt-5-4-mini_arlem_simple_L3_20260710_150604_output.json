          }
        ]
      },
      {
        "id": "step6_semiconservative",
        "instruction": {
          "title": "6. Semiconservative Outcome",
          "description": "Finish by connecting the process to the final products: each daughter DNA molecule contains one parental strand and one newly synthesized strand. DNA ligase completes the sealing of the lagging strand fragments."
        },
