  "activity": {
    "id": "dna_replication_linear_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR walkthrough of DNA structure, base pairing, antiparallel orientation, and the core enzymatic steps of semiconservative DNA replication.",
    "workplace": "bio_dna_replication_lab",
    "start": "step1_structure",
    "actions": [
      {
        "id": "step1_structure",
        "instruction": {
          "title": "1. DNA Double Helix",
          "description": "Inspect the double helix and identify the sugar-phosphate backbones on the outside, the bases projecting inward, and the hydrogen-bonded base pairs that hold the strands together."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue1"
          }
        ]
      },
      {
        "id": "step2_basepairing",
        "instruction": {
          "title": "2. Complementary Base Pairing",
          "description": "Use the reference card to match adenine with thymine and guanine with cytosine. Note that A-T pairs form two hydrogen bonds, while G-C pairs form three hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue2"
          }
        ]
      },
      {
        "id": "step3_antiparallel",
        "instruction": {
          "title": "3. Antiparallel Strand Orientation",
          "description": "Examine how the two DNA strands run in opposite directions: one strand is oriented 5' to 3' and the complementary strand 3' to 5'. This antiparallel arrangement is a direct consequence of the backbone polarity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue3"
          }
        ]
      },
      {
        "id": "step4_replicationfork",
        "instruction": {
          "title": "4. Replication Fork and Enzymes",
          "description": "Move to the replication fork and observe helicase opening the helix, single-strand binding proteins stabilizing the separated strands, and DNA polymerase beginning new strand synthesis."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "continue4"
          }
        ]
      },
      {
        "id": "step5_leading_lagging",
        "instruction": {
          "title": "5. Leading and Lagging Strand Synthesis",
          "description": "Observe how DNA polymerase extends new DNA only in the 5' to 3' direction. The leading strand is synthesized continuously toward the fork, while the lagging strand is synthesized discontinuously as Okazaki fragments."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
