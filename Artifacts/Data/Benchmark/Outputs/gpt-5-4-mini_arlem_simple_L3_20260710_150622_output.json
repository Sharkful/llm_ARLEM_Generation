  "activity": {
    "id": "anatomy_heart_activity",
    "name": "Heart Anatomy and Blood Flow AR Lab",
    "description": "A linear AR lab for identifying the major chambers, valves, and vessels of the human heart and tracing the pulmonary and systemic circulation loops. Students progress from orientation to chamber identification, valve identification, blood flow tracing, and functional comparison of the right and left ventricles.",
    "workplace": "anatomy_heart_workplace",
    "start": "step_1",
    "actions": [
      {
        "id": "step_1",
        "instruction": {
          "title": "Orient to the heart model",
          "description": "Observe the full heart model and read the title label. Identify the anterior view and notice the major regions that will be explored in the next steps."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_next"
          }
        ]
      },
      {
        "id": "step_2",
        "instruction": {
          "title": "Identify the four chambers",
          "description": "Use the overlay to locate the right atrium, right ventricle, left atrium, and left ventricle. Compare the relative positions of the right and left sides of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_next"
          }
        ]
      },
      {
        "id": "step_3",
        "instruction": {
          "title": "Locate the valves",
          "description": "Examine the valve overlay and identify the tricuspid, pulmonary, mitral, and aortic valves. Note how the atrioventricular valves separate atria from ventricles, while the semilunar valves separate ventricles from the great vessels."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_next"
          }
        ]
      },
      {
        "id": "step_4",
        "instruction": {
          "title": "Trace the dual circulation pathway",
          "description": "Follow the animated blood flow path from the vena cavae into the right atrium, through the right ventricle and pulmonary arteries to the lungs, then back via pulmonary veins to the left atrium and out the aorta to the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_next"
          }
        ]
      },
      {
        "id": "step_5",
        "instruction": {
          "title": "Compare ventricular wall thickness",
          "description": "Inspect the cutaway to compare the right and left ventricular myocardium. The left ventricle is thicker because it must generate higher pressure to perfuse the systemic circuit, whereas the right ventricle pumps only to the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "step_5_next",
            "duration": 2
          }
        ]
      },
      {
        "id": "step_6",
        "instruction": {
          "title": "Review the completed flow",
          "description": "Review the labeled heart, valves, and circulation pathway together. Confirm the roles of the pulmonary circuit and systemic circuit and the backflow prevention function of the valves."
        },
        "enter": {
