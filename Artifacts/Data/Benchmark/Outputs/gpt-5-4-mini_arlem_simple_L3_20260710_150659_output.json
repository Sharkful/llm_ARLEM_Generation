  "activity": {
    "id": "chem_vsepr_activity",
    "name": "VSEPR Geometry Explorer",
    "description": "A simplified linear AR lesson for General Chemistry I in which students count electron domains from Lewis structures, identify electron-domain geometry, distinguish molecular geometry from electron-domain geometry, and compare predictions with common molecules including H2O, NH3, CH4, PF5, SF6, and XeF4.",
    "workplace": "chem_vsepr_lab",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Start with a Lewis structure",
          "description": "Open the Lewis-structure prompt and count the bonding pairs and lone pairs around the central atom to determine the steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
