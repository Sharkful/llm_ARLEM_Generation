  "activity": {
    "id": "dna_replication_intro",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A simplified AR lab for introductory molecular biology students exploring DNA structure, base pairing, antiparallel orientation, and semiconservative replication at the replication fork.",
    "workplace": "bio_dna_lab",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "1. DNA as a Base-Paired Ladder",
          "description": "Examine the schematic ladder representation. Identify the sugar-phosphate backbones on the sides and the paired nitrogenous bases forming the rungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
