          }
        ]
      },
      {
        "id": "step5_valves",
        "instruction": {
          "title": "Valve Function",
          "description": "Examine the tricuspid, pulmonary, mitral, and aortic valves and note how atrioventricular and semilunar valves prevent backflow during the cardiac cycle."
        },
        "enter": {
          "remove_self": false,
