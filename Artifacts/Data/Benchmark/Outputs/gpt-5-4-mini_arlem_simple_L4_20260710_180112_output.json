  "activity": {
    "id": "heart_anatomy_activity",
    "name": "Human Heart Anatomy: Structure and Blood Flow",
    "description": "A simplified linear AR lab for undergraduate anatomy students to identify heart structures, trace blood flow through the pulmonary and systemic circuits, compare ventricular wall thickness, and connect valve mechanics to prevention of backflow.",
    "workplace": "heart_workspace",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "Heart Orientation",
          "description": "View the intact heart and identify its anatomical orientation. Notice the apex points down and slightly left from the patient's perspective, and the right/left sides are reversed from the viewer's point of view."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro"
          }
        ]
      },
      {
        "id": "step2_chambers",
        "instruction": {
          "title": "Four Chambers",
          "description": "Study the cutaway heart and identify the right atrium, right ventricle, left atrium, and left ventricle in order."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
