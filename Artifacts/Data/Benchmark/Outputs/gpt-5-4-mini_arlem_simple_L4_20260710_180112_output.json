        "triggers": [
          {
            "mode": "click",
            "id": "step3_blood_path"
          }
        ]
      },
      {
        "id": "step4_thickness",
        "instruction": {
          "title": "Ventricle Wall Thickness",
          "description": "Compare the ventricular walls and observe that the left ventricle has a much thicker myocardium than the right ventricle because it pumps blood through the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
