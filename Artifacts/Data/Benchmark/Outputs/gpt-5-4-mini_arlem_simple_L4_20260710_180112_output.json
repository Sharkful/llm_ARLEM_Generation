          }
        ]
      },
      {
        "id": "step3_blood_path",
        "instruction": {
          "title": "Path of Blood",
          "description": "Trace deoxygenated blood entering the right atrium, moving through the tricuspid valve and right ventricle, then to the lungs and back through the left side of the heart as oxygenated blood."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
