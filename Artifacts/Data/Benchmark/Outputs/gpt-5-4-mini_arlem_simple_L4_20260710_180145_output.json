            "mode": "click",
            "id": "step4"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Lone pairs compress bond angles",
          "description": "Study the comparison panel and note that lone pairs occupy more angular space than bonding pairs, reducing bond angles from the ideal values."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
