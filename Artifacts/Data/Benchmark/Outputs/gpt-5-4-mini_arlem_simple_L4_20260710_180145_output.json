  "activity": {
    "id": "chem_vsepr_activity",
    "name": "VSEPR Geometry Builder",
    "description": "A simplified AR lab introducing VSEPR theory, electron-domain geometries, and the relationship between electron pairs, lone pairs, and molecular shape for common covalent molecules.",
    "workplace": "chem_vsepr_ws",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Start: VSEPR idea and Lewis counting",
          "description": "Observe the central atom and Lewis-structure reference. Count each bonding pair and lone pair as one electron domain, then press to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Electron-domain geometry: 2 and 3 domains",
          "description": "Watch the domains settle into the minimum-repulsion arrangement. Compare linear for two domains and trigonal planar for three domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Electron-domain geometry: 4, 5, and 6 domains",
          "description": "Compare tetrahedral, trigonal bipyramidal, and octahedral arrangements. Notice the different axial and equatorial positions in five-domain geometries."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Molecular geometry versus electron-domain geometry",
          "description": "Compare a tetrahedral arrangement with one and two lone pairs. The underlying electron-domain geometry stays the same while the molecular shape changes to trigonal pyramidal and bent."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
