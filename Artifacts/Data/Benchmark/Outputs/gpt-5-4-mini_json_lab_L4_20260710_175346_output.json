              "target": "marsTrail",
              "enabled": true
            }
          ],
          "changeMeaning": "Mars begins its slow eastward drift and the trail is revealed so students can connect the moving point to its accumulated path across the sky.",
          "narration": "At first, Mars moves slowly eastward. Over weeks, the motion is subtle, but the changing position is real and measurable."
        },
        {
          "clipName": "clip2",
          "audioClip": "scene1_retrograde_loop",
          "autoAdvance": true,
          "changes": [
            {
              "target": "marsSkyPoint",
              "position": [
                -0.08,
                1.36,
                -1.2
              ]
            }
          ],
          "changeMeaning": "Mars reverses direction and begins its westward loop, demonstrating the retrograde portion of the apparent path.",
          "narration": "Then Mars appears to stop and drift backward, tracing the retrograde loop. This is not a physical reversal in Mars's orbit; it is an apparent reversal in our sky."
        },
        {
          "clipName": "clip3",
          "audioClip": "scene1_resume_eastward",
          "autoAdvance": true,
          "changes": [
            {
              "target": "marsSkyPoint",
              "position": [
                0.6,
                1.33,
                -1.2
              ]
            }
          ],
          "changeMeaning": "Mars finishes the loop and resumes eastward motion, completing the full observational pattern that students should recognize.",
          "narration": "After a few months, the loop ends and Mars resumes its normal eastward motion. This full sequence is the observational clue we will explain in the next scenes."
        }
      ]
