  "activity": {
    "id": "act-astro-retrograde-01",
    "name": "Apparent Retrograde Motion: Mars Loop and the Earth-Overshooting Explanation",
    "description": "Students explore the apparent retrograde motion of Mars in two linked perspectives. First, they view Mars from Earth by tracking its eastward drift, slow-down, westward loop, and return to eastward motion against the star field. Then they switch to a heliocentric perspective outside the solar system and observe smooth Earth and Mars orbits where the loop naturally arises when Earth overtakes Mars. Learners then compare retrograde loops for Jupiter and Saturn, and practice predicting when an outer planet is likely to enter retrograde using relative orbital motion. AR augmentations guide the learner by activating and deactivating animations, images, and prompts on the constellation viewing board and the heliocentric orbit stand.",
    "language": "en",
    "workplace": "wp-astro-retrograde-01",
    "start": "step-01-intro-setup",
    "actions": [
      {
        "id": "step-01-intro-setup",
        "viewport": "actions",
        "type": "actions",
        "device": "device-1",
        "location": "place-night-sky-board",
        "predicate": "pred-mars-loop-timeline",
        "instruction": {
          "title": "Set the stage: What does Mars do in retrograde?",
          "description": "Look at the night-sky board. You\u2019ll observe Mars\u2019s apparent path over time: slow eastward drift, then a westward loop, then a return to eastward motion."
        },
