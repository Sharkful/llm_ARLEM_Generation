    "id": "act-vectors-projectile-2d-01",
    "name": "AR Lab: Vectors to Projectile Motion (Tip-to-Tail \u2192 Components \u2192 Independence \u2192 Trajectory)",
    "description": "Guided AR exploration for General Physics I (Mechanics). Learners visualize 2D vectors as magnitude+direction and as x/y components, then apply the same vector operations to analyze projectile motion at an arbitrary launch angle. The experience progresses from vector addition to component decomposition to the physical independence of horizontal and vertical motion, culminating in predictions about trajectory range and maximum height as launch angle and speed change.",
    "language": "en",
    "workplace": "wp-mech-vec-proj-01",
    "start": "action-01-intro-vectors",
    "actions": [
      {
        "id": "action-01-intro-vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "device-hmd-01",
        "location": "place-vector-station",
        "instruction": {
          "title": "Welcome: Vectors in 2D",
          "description": "A vector has magnitude (length) and direction (angle). In this lab you\u2019ll represent vectors as arrows and then rewrite the same arrow as horizontal (x) and vertical (y) components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
