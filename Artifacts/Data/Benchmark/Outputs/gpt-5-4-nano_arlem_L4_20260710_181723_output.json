  "activity": {
    "id": "activity_heart_dual_circuit_ar_01",
    "name": "Heart Chambers, Valves, Vessels & Dual-Loop Blood Flow (AR Lab)",
    "description": "Guided AR lab for Human Anatomy & Physiology I: identify the four heart chambers, four valves, and major vessels; trace dual-loop circulation (pulmonary vs systemic); compare ventricular wall thickness; examine valve open/closed states and backflow prevention; and complete interactive identification and path-tracing quizzes with replayable flows.",
    "language": "en",
    "workplace": "heart_lab_workplace_01",
    "start": "action_01_intro_view",
    "actions": [
      {
        "id": "action_01_intro_view",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_heart_models_zone",
        "predicate": "p_noop",
        "instruction": {
          "title": "Welcome: Meet the Heart Models",
          "description": "Scan the heart lab area. You\u2019ll see two full-size heart models: an intact exterior view and a cutaway interior view. Rotate together to match anatomical orientation (apex down and slightly left). Then follow the guided tour steps as labels appear."
        },
        "enter": {
