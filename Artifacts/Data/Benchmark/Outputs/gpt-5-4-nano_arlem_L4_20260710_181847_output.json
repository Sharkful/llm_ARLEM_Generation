  "activity": {
    "id": "activity_vectors_projectiles_arlem",
    "name": "AR Lab: Vectors to Projectile Motion (2D Projectile)",
    "description": "Guided AR training that starts with abstract vectors (magnitude + direction), then builds toward vector addition (tip-to-tail), vector decomposition (reverse addition into x/y components), and finally applies these to 2D projectile motion with gravity acting only vertically. Learners manipulate vectors/components in 3D and observe how the projectile\u2019s horizontal and vertical motions are independent, culminating in maximum-range discovery and a targeting challenge, with a free-exploration sandbox and recap.",
    "language": "en",
    "workplace": "wf_physics_vectors_projectiles_lab",
    "start": "action_1_intro_vector_object",
    "actions": [
      {
        "id": "action_1_intro_vector_object",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_abs_vector_zone",
        "predicate": "pred_vector_intro_arrow_and_values",
        "instruction": {
          "title": "Vectors: magnitude and direction",
          "description": "Look at the floating arrow. The magnitude is the arrow length, and the direction is where the arrow points. Grab the arrow head and drag\u2014notice the magnitude and direction values update in real time."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
