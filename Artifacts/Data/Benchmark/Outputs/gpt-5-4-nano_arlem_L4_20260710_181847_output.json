        "predicate": "pred_vector_addition_swap_order_test",
        "instruction": {
          "title": "Check commutativity",
          "description": "Swap the order of the two added vectors (green laid on top of blue vs. blue on top of green). The red resultant should point to the same overall direction and magnitude."
        },
