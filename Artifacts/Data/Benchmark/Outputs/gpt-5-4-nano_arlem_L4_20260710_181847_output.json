        ]
      },
      {
        "id": "action_2_vector_addition_tip_to_tail",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_abs_vector_zone",
        "predicate": "pred_vector_addition_tip_to_tail_setup",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Two arrows appear: blue first, then green starting at the blue head. The red arrow is the resultant from the tail of blue to the head of green. Grab the blue or green arrow to reorient them\u2014watch the resultant update."
        },
        "enter": {
