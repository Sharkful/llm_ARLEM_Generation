        ]
      },
      {
        "id": "action_4",
        "instruction": {
          "title": "Geocentric vs heliocentric: parsimony check",
          "description": "Compare the two explanations. In the geocentric model, retrograde loops require extra complexity, while in the heliocentric model the loop emerges naturally from relative orbital motion."
        },
        "enter": {
          "remove_self": false,
