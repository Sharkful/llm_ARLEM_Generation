          }
        ]
      },
      {
        "id": "action_3",
        "instruction": {
          "title": "Why it happens (heliocentric): Earth overtakes Mars",
          "description": "Switch to the outside solar system view. Earth\u2019s faster inner orbit gradually overtakes Mars. The changing viewing geometry makes Mars\u2019s apparent motion loop backward against the distant stars."
        },
        "enter": {
          "remove_self": false,
