  "activity": {
    "id": "arlem-mars-retrograde-reduced-1",
    "name": "Reduced ARLEM: Apparent Retrograde Motion Puzzle",
    "description": "A linear, simplified AR lab for 100-level astronomy students. Learners step through the apparent eastward drift, retrograde westward loop, and resumption of eastward motion for Mars from the Earth night-sky perspective, then explain the heliocentric cause in terms of Earth overtaking a slower outer planet. The lab ends by comparing Mars, Jupiter, and Saturn loop sizes qualitatively (smaller loops for more distant planets).",
    "workplace": "mars-retrograde-lab-wp1",
    "start": "action_1",
    "actions": [
      {
        "id": "action_1",
        "instruction": {
          "title": "Set the Scene: Mars drifts eastward",
          "description": "In the Earth night-sky view, start with Mars moving slowly eastward (prograde) relative to the background stars. Notice the overall forward drift pattern before retrograde begins."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_1"
          }
        ]
      },
      {
        "id": "action_2",
        "instruction": {
          "title": "The Retrograde Episode: Slow, reverse, loop",
          "description": "During retrograde, Mars appears to slow, stop, then move westward for a short interval, tracing a loop before resuming its eastward motion. Follow the apparent path across the starfield."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
