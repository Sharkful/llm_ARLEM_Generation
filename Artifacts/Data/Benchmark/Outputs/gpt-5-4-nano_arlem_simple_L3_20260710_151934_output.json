  "activity": {
    "id": "arlem_dna_structure_replication_linear_reduced_v2",
    "name": "DNA Structure & Semiconservative Replication (Reduced ARLEM) - Linear",
    "description": "A linear, click/detect-driven AR lab for Introductory Molecular Biology. Students first explore the 3D organization of the DNA double helix, then the components and base-pairing logic (A\u2013T, G\u2013C). Next they examine antiparallel strand orientation and directionality (5'\u21923' vs 3'\u21925'). Finally, they trace replication at the fork (helicase, DNA polymerase, ligase) and conclude with the semiconservative model.",
    "workplace": "dna_lab_arlem_reduced_ws",
    "start": "action_1_intro_double_helix",
    "actions": [
      {
        "id": "action_1_intro_double_helix",
        "instruction": {
          "title": "DNA Double Helix: Components in 3D",
          "description": "Activate the double-helix model. Identify two sugar\u2011phosphate backbones spiraling around a common axis and the inward-projecting bases. Focus on overall 3D organization before details."
        },
        "enter": {
