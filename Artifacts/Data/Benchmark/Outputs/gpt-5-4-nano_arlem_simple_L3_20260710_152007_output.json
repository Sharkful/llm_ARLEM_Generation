  "activity": {
    "id": "act_heart_dual_circulation_linear_reduced",
    "name": "Reduced AR Heart: Chambers \u2192 Valves \u2192 Vessels \u2192 Dual-Loop Flow \u2192 Left Ventricular Wall",
    "description": "A linear, reduced AR lesson for identifying heart chambers, valves, major vessels, and tracing dual-loop circulation (pulmonary vs systemic). Students progress through five click/detect-driven steps, each enabling a focused set of labels/visuals and corresponding narration.",
    "workplace": "heart_ar_lab_reduced",
    "start": "step1_chambers",
    "actions": [
      {
        "id": "step1_chambers",
        "instruction": {
          "title": "Identify the Four Heart Chambers",
          "description": "Locate and name the right atrium, right ventricle, left atrium, and left ventricle. Focus on the chamber boundaries first before adding valves or vessels."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trg_step1_click"
          }
        ]
      },
      {
        "id": "step2_valves",
        "instruction": {
          "title": "Recognize the Four Heart Valves",
          "description": "Identify the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Use valve positions to understand which chambers they separate."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trg_step2_detect",
            "duration": 2
          }
        ]
      },
      {
        "id": "step3_vessels",
        "instruction": {
          "title": "Locate Major Vessels Entering and Leaving",
          "description": "Identify vessels: superior vena cava (SVC) and inferior vena cava (IVC) entering the right atrium; pulmonary arteries and pulmonary veins; and the aorta leaving the left ventricle."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trg_step3_click"
          }
        ]
      },
      {
        "id": "step4_dual_circulation",
        "instruction": {
          "title": "Trace Dual-Loop Blood Circulation",
          "description": "Follow the path of blood through the heart: body \u2192 right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary arteries \u2192 lungs \u2192 pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta. Distinguish pulmonary (lung) vs systemic (body) circuits."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trg_step4_detect",
            "duration": 2
          }
        ]
      },
      {
        "id": "step5_left_ventricle_wall",
        "instruction": {
          "title": "Explain Left vs Right Ventricular Wall Thickness",
          "description": "Observe the thicker left ventricular myocardium. Connect wall thickness to required pressure: the left ventricle pumps to the entire systemic circulation, while the right ventricle primarily pumps to the lungs."
        },
        "enter": {
          "remove_self": false,
