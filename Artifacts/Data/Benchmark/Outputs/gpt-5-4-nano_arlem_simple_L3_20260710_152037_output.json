  "activity": {
    "id": "act_reduced_vectors_projectile_linear",
    "name": "Reduced ARLEM: Vectors to Projectile Motion",
    "description": "A linear, click/detect-driven reduced AR lab for General Physics I. Learners move through vector addition (tip-to-tail), vector decomposition using x\u2013y components and right-triangle trigonometry, then connect the components idea to 2D projectile motion: horizontal motion remains constant while vertical motion changes due to gravity, and maximum height occurs when vertical velocity is zero. Each step activates a small set of augmentations on tracked targets.",
    "workplace": "wp_physics_vectors_projectile_reduced",
    "start": "action_1_introduce_vector_addition",
    "actions": [
      {
        "id": "action_1_introduce_vector_addition",
        "instruction": {
          "title": "Vector A and Vector B: magnitude + direction",
          "description": "Use the AR targets to view Vector A and Vector B as directed quantities. Think of each vector as an arrow: its length is the magnitude and its angle gives the direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trig_a1_click"
          }
        ]
      },
      {
        "id": "action_2_tip_to_tail_addition",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Rotate and align the vectors so the head of Vector A meets the tail of Vector B. The resultant vector points from the start of Vector A to the end of Vector B."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trig_a2_detect_resultant"
          },
          {
            "mode": "click",
            "id": "trig_a2_click"
          }
        ]
      },
      {
        "id": "action_3_decompose_resultant_xy",
        "instruction": {
          "title": "Decompose the resultant into x and y components",
          "description": "Re-express the resultant vector using horizontal (x) and vertical (y) components. The components form a right triangle whose hypotenuse is the original vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trig_a3_click"
          }
        ]
      },
      {
        "id": "action_4_trig_relationships",
        "instruction": {
          "title": "Connect components to right-triangle trig",
          "description": "Use the angle relations: each component is the adjacent or opposite side relative to the vector magnitude. This mapping is what lets you compute component magnitudes from direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trig_a4_detect_axes"
          }
        ]
      },
      {
        "id": "action_5_projectile_motion_independence",
        "instruction": {
          "title": "Projectile motion: horizontal & vertical independence",
          "description": "Switch to projectile motion. Horizontal velocity stays constant (no horizontal force), while vertical motion accelerates due to gravity. The 2D trajectory emerges from combining both motions."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trig_a5_click"
          }
        ]
      },
      {
        "id": "action_6_max_height_vy_zero",
        "instruction": {
          "title": "Maximum height: vertical velocity equals zero",
          "description": "At the top of the trajectory, vertical velocity momentarily becomes zero. Horizontal velocity is still nonzero, so the projectile continues moving forward while vertical speed is zero at that instant."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
