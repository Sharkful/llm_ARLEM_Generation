  "activity": {
    "id": "activity_vsepr_reduced_01",
    "name": "VSEPR Geometry from Lewis Structure (Reduced ARLEM)",
    "description": "Reduced AR lab: count steric number from a Lewis structure, map to electron-domain geometry, then apply lone-pair effects to predict molecular shape and bond-angle deviations. Finally compare with real molecules.",
    "workplace": "vsepr_workplace_01",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "instruction": {
          "title": "VSEPR Core Idea",
          "description": "Start from a Lewis structure. Count regions of electron density (bonding pairs + lone pairs) around the central atom. VSEPR says they arrange to minimize mutual repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
