  "activity": {
    "id": "activity_mars_retrograde_reduced_linear",
    "name": "Reduced ARLEM: Apparent Retrograde Motion (linear)",
    "description": "A simplified, linear ARLEM sequence for 100-level astronomy students showing why Mars appears to move backward at intervals, contrasting geocentric epicycles with heliocentric relative motion and linking viewpoints with a line-of-sight sweep. Triggers advance only via click or marker detection; no branching logic is used.",
    "workplace": "mars_retrograde_lab_reduced",
    "start": "step_1_night_sky",
    "actions": [
      {
        "id": "step_1_night_sky",
        "instruction": {
          "title": "Observe Mars\u2019s apparent loop",
          "description": "In the night-sky scene, watch Mars drift slowly eastward against the background stars. Then it slows, halts, and reverses into a short westward loop before resuming its eastward motion. Use the trail behind Mars to track the full retrograde path."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t1_click"
          },
          {
            "mode": "detect",
            "id": "t1_detect"
          }
        ]
      },
      {
        "id": "step_2_geocentric_epicycles",
        "instruction": {
          "title": "Geocentric explanation: epicycle + deferent",
          "description": "Switch to the geocentric apparatus. Follow how Mars rides on an epicycle that moves along a deferent centered on Earth. When Mars is on the inner side of its epicycle, the combined circular motions make its apparent motion against the stars turn backward."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t2_click"
          },
          {
            "mode": "detect",
            "id": "t2_detect"
          }
        ]
      },
      {
        "id": "step_3_heliocentric_relative_motion",
        "instruction": {
          "title": "Heliocentric resolution: Earth overtakes Mars",
          "description": "Switch to the outside heliocentric view. Earth orbits the Sun faster (inner orbit) while Mars orbits more slowly. As Earth catches up and overtakes Mars, the changing geometry makes Mars\u2019s apparent position trace a retrograde loop naturally\u2014without epicycles."
        },
        "enter": {
          "remove_self": false,
