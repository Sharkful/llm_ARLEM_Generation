  "activity": {
    "id": "dna_replication_reduced_linear_1",
    "name": "Reduced ARLEM: DNA Double Helix to Semiconservative Replication",
    "description": "A simplified, linear AR lab for introductory molecular biology that uses click/detect-only navigation. Students progress from a DNA ladder schematic to a realistic double helix, then to antiparallel 5'\u21923' directionality, complementary base pairing with hydrogen-bond visualization, and finally a replication-fork overview and semiconservative prediction diagram. Augmentations are activated/deactivated on predefined workplace targets.",
    "workplace": "dnaLab_reduced_ws",
    "start": "action_1",
    "actions": [
      {
        "id": "action_1",
        "instruction": {
          "title": "Scene 1 \u2014 DNA as a Ladder (Backbone + Bases)",
          "description": "Observe the DNA ladder schematic: the repeating sugar\u2011phosphate backbone forms the ladder sides, and the nitrogenous bases form rungs projecting toward the interior. Focus on repeating regular structure before helix geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t1_click"
          }
        ]
      },
      {
        "id": "action_2",
        "instruction": {
          "title": "Scene 2 \u2014 Transition to the Double Helix",
          "description": "Switch mental models: the ladder representation transitions into a realistic double helix. Track the common helical axis while recognizing backbones spiraling around it and base pairs stacking inside."
        },
        "enter": {
          "remove_self": false,
