  "activity": {
    "id": "activity_heart_structures_dual_circulation_reduced",
    "name": "Reduced AR: Heart Structures + Dual Circulation",
    "description": "Linear reduced AR lab introducing the four heart chambers, four valves, major vessels, and the dual-loop blood circulation (pulmonary vs systemic). Learners follow a sequence of steps using click/detect triggers to reveal labels and conceptual audio/animations. (No branching, no persons/devices/sensors; limited triggers: click and detect.)",
    "workplace": "heart_anatomy_lab_reduced",
    "start": "action_1_open_orientation",
    "actions": [
      {
        "id": "action_1_open_orientation",
        "instruction": {
          "title": "Scene 1: Exterior view + orientation",
          "description": "Examine the full heart model. The learner\u2019s viewer perspective is mapped to the patient\u2019s anatomical right/left (apex oriented down and slightly to the left)."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t1"
          }
        ]
      },
      {
        "id": "action_2_interior_chambers",
        "instruction": {
          "title": "Scene 2: Cutaway tour of chambers",
          "description": "Focus on the cutaway interior and identify the four chambers in order: right atrium \u2192 right ventricle \u2192 left atrium \u2192 left ventricle."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "t2"
          }
        ]
      },
      {
        "id": "action_3_valves_and_backflow_concept",
        "instruction": {
          "title": "Scene 3: Valves prevent backflow",
          "description": "Highlight the four valves. Atrioventricular valves (between atria and ventricles) prevent backflow into atria during ventricular contraction; semilunar valves (between ventricles and outflow arteries) prevent backflow into ventricles during relaxation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t3"
          }
        ]
      },
      {
        "id": "action_4_major_vessels_mapping",
        "instruction": {
          "title": "Scene 4: Major vessels entering/leaving",
          "description": "Map inflow and outflow vessels. Identify in order: superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "t4"
          }
        ]
      },
      {
        "id": "action_5_dual_circulation_overview",
        "instruction": {
          "title": "Scene 5: Dual-loop circulation (pulmonary vs systemic)",
          "description": "Observe the color-coded flow pathways. Deoxygenated blood follows the right-side \u2192 pulmonary circuit to the lungs; oxygenated blood follows the left-side \u2192 systemic circuit to the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t5"
          }
        ]
      },
      {
        "id": "action_6_wall_thickness_asymmetry",
        "instruction": {
          "title": "Scene 6: Why the left ventricle is thicker",
          "description": "Compare ventricular cross-sections. The left ventricle wall is substantially thicker because it must generate higher pressure to perfuse the entire systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
