  "activity": {
    "id": "act_reduced_vectors_projectile_linear_01",
    "name": "Reduced ARLEM: Vectors to Projectile (Linear)",
    "description": "Simplified, click/detect-driven AR lab for General Physics I (vectors and 2D projectile motion). Linear steps only; no conditional branching. Instructions drive a guided sequence from abstract vectors to 2D projectile motion and the 45\u00b0 maximum-range result.",
    "workplace": "wp_vector_projectile_reduced_01",
    "start": "step1_vector_intro",
    "actions": [
      {
        "id": "step1_vector_intro",
        "instruction": {
          "title": "Vectors: magnitude + direction",
          "description": "Observe a single vector arrow anchored at a fixed origin. Notice that changing your viewing angle does not change the vector\u2014only your perspective. Magnitude corresponds to arrow length; direction corresponds to the arrow\u2019s pointing angle."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_arrowVector"
            },
            {
              "target": "thing_arrowVector"
            },
            {
              "target": "thing_arrowVector"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t_click_next"
          }
        ]
      },
      {
        "id": "step2_tip_to_tail_addition",
        "instruction": {
          "title": "Tip-to-tail addition",
          "description": "Two vectors (blue then green) form a tip-to-tail chain. The red resultant connects the tail of the first to the head of the second. The resultant visually represents the sum of the vectors."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_redResultant"
            },
            {
              "target": "place_additionZone"
            },
            {
              "target": "place_additionZone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "t_detect_addition_markers"
          },
          {
            "mode": "click",
            "id": "t_click_next2"
          }
        ]
      },
      {
        "id": "step3_decomposition_components",
        "instruction": {
          "title": "Decompose a vector into components",
          "description": "Reverse the addition idea: components along the axes build back to the original vector. Use the component arrows (x and y) to understand how the original vector is reconstructed from its parts."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_componentX"
            },
            {
              "target": "place_decompositionZone"
            },
            {
              "target": "place_decompositionZone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t_click_next3"
          }
        ]
      },
      {
        "id": "step4_projectile_setup_2d",
        "instruction": {
          "title": "Projectile motion as component motion",
          "description": "A ball launches in a 2D vertical plane. Gravity affects only the vertical component, so the horizontal and vertical motions are independent. Watch how the motion is represented by the arrows and the trajectory trail."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_velocityVector"
            },
            {
              "target": "thing_parabolaTrail"
            },
            {
              "target": "place_projectileZone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "t_detect_projectile_plane"
          },
          {
            "mode": "click",
            "id": "t_click_next4"
          }
        ]
      },
      {
        "id": "step5_max_range_45",
        "instruction": {
          "title": "Maximum range occurs at 45\u00b0",
          "description": "For launch and landing at the same height (fixed launch speed), the projectile\u2019s range is maximized at a launch angle of 45\u00b0. Connect this to how the horizontal and vertical velocity components trade off during flight."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_rangeMarker"
            },
            {
              "target": "place_rangeZone"
            },
            {
              "target": "place_rangeZone"
            }
          ]
        },
        "triggers": [
          {
