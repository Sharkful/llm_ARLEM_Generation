        "id": "action_step_3",
        "instruction": {
          "title": "Add a 3rd Domain \u2192 Trigonal Planar (120\u00b0)",
          "description": "When a third domain is added, the domains reposition to minimize repulsion, settling into trigonal planar arrangement (ideal angles 120\u00b0)."
        },
        "enter": {
