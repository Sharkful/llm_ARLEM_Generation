  "activity": {
    "id": "vsepr_reduced_arlem_linear_flow",
    "name": "VSEPR Reduced Lab: From Electron Domains to Molecular Shapes",
    "description": "Simplified linear ARLEM experience introducing VSEPR\u2019s minimum-repulsion idea from a Lewis structure. Students observe electron domains settling into linear, trigonal planar, and tetrahedral electron-domain geometries, then distinguish electron-domain geometry from molecular geometry when lone pairs are present, and finally apply the idea in a real-molecule gallery.",
    "workplace": "vsepr_lab_reduced_wp",
    "start": "action_step_1",
    "actions": [
      {
        "id": "action_step_1",
        "instruction": {
          "title": "VSEPR Core Idea",
          "description": "Electron pairs (bonding domains) and lone pairs around a central atom repel and arrange to minimize repulsion. Use the Lewis structure as a 2D input to predict the 3D arrangement."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "t1"
          }
        ]
      },
      {
        "id": "action_step_2",
        "instruction": {
          "title": "Add 2 Domains \u2192 Linear (180\u00b0)",
          "description": "Start with two electron domains. They settle as far apart as possible, forming a linear electron-domain geometry (ideal bond-domain angle 180\u00b0)."
        },
        "enter": {
          "remove_self": false,
