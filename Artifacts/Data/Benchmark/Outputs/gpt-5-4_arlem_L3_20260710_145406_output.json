  "activity": {
    "id": "act_retrograde_motion_training",
    "name": "Apparent Retrograde Motion of Outer Planets",
    "description": "A guided AR lab for introductory astronomy students exploring why Mars appears to reverse direction in the night sky, and how heliocentric orbital motion naturally explains retrograde loops for Mars, Jupiter, and Saturn.",
    "language": "en",
    "workplace": "wp_astronomy_retrograde_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset",
        "location": "place_observation_station",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the Retrograde Motion Problem",
          "description": "Look at the observation table. Begin by identifying the key observational puzzle: Mars usually drifts eastward relative to the background stars, then briefly slows, reverses westward, and later resumes eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
