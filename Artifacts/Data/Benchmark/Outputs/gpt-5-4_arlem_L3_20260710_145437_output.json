  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An AR-guided introductory molecular biology lab in which students inspect a 3D DNA model, identify structural components and antiparallel strand orientation, apply complementary base-pairing rules, and then trace semiconservative DNA replication through helicase action, stabilization of single strands, leading and lagging strand synthesis, ligation, and daughter molecule formation.",
    "language": "en",
    "workplace": "wp_dna_replication_lab",
    "start": "action_01_orient",
    "actions": [
      {
        "id": "action_01_orient",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_label_dna_overview",
        "instruction": {
          "title": "Orient to the DNA lab station",
          "description": "Look at the main lab bench to anchor the experience. Observe the DNA double helix model and prepare to identify its major structural components: backbones, bases, and hydrogen-bonded base pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
