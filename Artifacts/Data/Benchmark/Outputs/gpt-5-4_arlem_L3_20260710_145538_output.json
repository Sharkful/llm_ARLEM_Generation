        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the Heart Lab",
          "description": "Look at the anatomy lab bench and locate the heart model, circulation pathway board, and valve cutaway model. This session will guide you from basic structure to blood-flow function."
