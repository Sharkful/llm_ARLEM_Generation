  "activity": {
    "id": "act_heart_bloodflow_training",
    "name": "Heart Anatomy and Blood Flow AR Training",
    "description": "An augmented reality laboratory session for undergraduate anatomy students to identify the chambers, valves, and major vessels of the heart, then trace blood through pulmonary and systemic circulation while connecting structure to function.",
    "language": "en",
    "workplace": "wp_heart_anatomy_lab",
    "start": "step_01_intro",
