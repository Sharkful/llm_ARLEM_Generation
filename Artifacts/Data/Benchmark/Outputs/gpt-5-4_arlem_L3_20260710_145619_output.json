  "activity": {
    "id": "act_vectors_projectile_mechanics",
    "name": "Vectors and Projectile Motion AR Lab",
    "description": "An introductory AR lab for General Physics I in which students first build intuition for vectors as quantities with magnitude and direction, then apply vector addition and component decomposition to two-dimensional projectile motion. The experience emphasizes independent horizontal and vertical motion, maximum height, and the effects of launch angle and speed on trajectory, range, and height.",
    "language": "en",
    "workplace": "wp_physics_vectors_projectile",
    "start": "action_1_orientation",
    "actions": [
      {
        "id": "action_1_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_vector_station",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the vector workstation",
          "description": "Look at the Vector Demonstration Board. A labeled overlay introduces vectors as quantities with both magnitude and direction. Your goal is to connect graphical vector ideas to projectile motion in two dimensions."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
