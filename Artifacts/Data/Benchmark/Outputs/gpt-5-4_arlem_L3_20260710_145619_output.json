            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "thing_component_tiles",
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_3_components",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_vector_station",
        "predicate": "pred_components_anim",
        "instruction": {
          "title": "Decompose a vector into x and y components",
          "description": "Move to the Component Arrow Tiles. The AR overlay shows a single vector split into horizontal and vertical parts. Relate the vector magnitude and direction to its components using right-triangle trigonometry: vx = v cos(theta), vy = v sin(theta)."
        },
        "enter": {
          "remove_self": false,
