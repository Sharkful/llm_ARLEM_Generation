        "predicate": "pred_tip_to_tail_anim",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Observe two vectors placed sequentially on the board. Follow the animated arrows from the tail of the first vector to the tip of the second. Identify the single resultant vector that connects the starting point to the final endpoint."
        },
        "enter": {
          "remove_self": false,
