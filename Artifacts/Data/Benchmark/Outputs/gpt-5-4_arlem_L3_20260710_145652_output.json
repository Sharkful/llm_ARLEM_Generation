          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_molgeo",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_05_lone_pairs_angles",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_angle_station",
        "predicate": "pred_angle_deviation_image",
        "instruction": {
          "title": "Explain bond-angle deviations caused by lone pairs",
          "description": "Inspect the Bond Angle Gauge. Lone pairs occupy more angular space than bonding pairs, so they compress bond angles. Compare methane at 109.5 degrees with water at 104.5 degrees and predict the direction of deviation from ideal angles."
        },
