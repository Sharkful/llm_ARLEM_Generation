            "id": "detect_cards",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next_steric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_03_domain_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_model_station",
        "predicate": "pred_domain_geometries_anim",
        "instruction": {
          "title": "Match steric number to electron-domain geometry",
          "description": "Use the Electron Domain Model Kit. Observe the five fundamental electron-domain geometries: linear, trigonal planar, tetrahedral, trigonal bipyramidal, and octahedral. These are determined by the total number of electron domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_domain",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_04_molecular_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_model_station",
        "predicate": "pred_tetrahedral_vs_water_anim",
        "instruction": {
          "title": "Distinguish electron-domain geometry from molecular geometry",
          "description": "Now compare full domain arrangement with the visible atom arrangement. Lone pairs are included when naming electron-domain geometry, but ignored when naming molecular geometry. Watch how tetrahedral electron geometry can produce trigonal pyramidal or bent molecular shapes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
