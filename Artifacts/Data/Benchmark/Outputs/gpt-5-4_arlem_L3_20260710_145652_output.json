  "activity": {
    "id": "act_vsepr_training",
    "name": "VSEPR Theory and Molecular Geometry Exploration",
    "description": "An AR-guided General Chemistry I training session in which students move from Lewis structures to steric number, electron-domain geometry, molecular geometry, bond-angle deviations, and comparison with real molecular examples using VSEPR theory.",
    "language": "en",
    "workplace": "wp_vsepr_lab",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_main_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Welcome to the VSEPR lab",
          "description": "Look at the main bench to begin. This activity introduces how electron pairs around a central atom arrange themselves to minimize repulsion and determine molecular shape."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_steric_number",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lewis_station",
        "predicate": "pred_steric_count_overlay",
        "instruction": {
          "title": "Determine steric number from a Lewis structure",
          "description": "Focus on the Lewis Structure Card Set. Count each bonding region and lone pair region around the central atom as one electron domain to determine steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
