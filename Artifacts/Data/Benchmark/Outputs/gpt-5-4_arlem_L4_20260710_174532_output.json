  "activity": {
    "id": "act_astronomy_retrograde_01",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "An introductory AR astronomy lab in which learners observe Mars trace a retrograde loop in the night sky, compare geocentric and heliocentric explanations, connect both viewpoints geometrically, embody the overtaking effect, compare Mars with Jupiter and Saturn, and complete a prediction challenge.",
    "language": "en",
    "workplace": "wp_astronomy_retrograde_01",
    "start": "action_01_observe_mars",
    "actions": [
      {
        "id": "action_01_observe_mars",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_observation_zone",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Observe Mars in the Night Sky",
          "description": "Watch Mars drift eastward, reverse into a westward loop, and then return to eastward motion against the labeled constellations. Focus on the complete trail to identify the three phases of apparent retrograde motion."
        },
        "enter": {
