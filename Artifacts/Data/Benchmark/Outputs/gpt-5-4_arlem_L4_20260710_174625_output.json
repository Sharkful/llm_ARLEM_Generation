  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An AR-guided molecular biology lab in which undergraduate students explore the three-dimensional structure of DNA, practice complementary base pairing, and trace the semiconservative mechanism of DNA replication from helicase unwinding through ligase sealing of Okazaki fragments.",
    "language": "en",
    "workplace": "wp_dna_replication_bio200",
    "start": "action_01_intro_ladder",
    "actions": [
      {
        "id": "action_01_intro_ladder",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Scene 1: Schematic DNA ladder",
          "description": "Observe the simplified ladder representation of DNA. Identify the two sugar-phosphate backbones as the outer rails and the paired nitrogenous bases as the inner rungs. Notice that adenine pairs with thymine and guanine pairs with cytosine."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
