            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_ladder_to_helix",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_bench",
        "predicate": "pred_helix_animation",
        "instruction": {
          "title": "Scene 2: From ladder to double helix",
          "description": "Watch the ladder twist into a realistic double helix. Relate the simple base-pair ladder to the 3D spiral geometry, where the sugar-phosphate backbones wrap around a common axis and the bases stack inside the helix."
        },
        "enter": {
