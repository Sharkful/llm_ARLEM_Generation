        "predicate": "pred_antiparallel_label",
        "instruction": {
          "title": "Scene 3: Antiparallel strands and directionality",
          "description": "Examine the arrows and terminal labels on each backbone. One strand runs 5' to 3', while the complementary strand runs 3' to 5'. This opposite orientation is the antiparallel arrangement required by the directional chemistry of the sugar-phosphate backbone."
        },
        "enter": {
