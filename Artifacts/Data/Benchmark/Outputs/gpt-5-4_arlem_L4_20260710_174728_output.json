        "id": "action_06_valve_function",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_valve_function_anim",
        "instruction": {
          "title": "See How Valves Prevent Backflow",
          "description": "Examine the four valves as they alternate between open and closed states. The tricuspid and mitral valves are atrioventricular valves between atria and ventricles; the pulmonary and aortic valves are semilunar valves between ventricles and outflow vessels. During ventricular contraction, AV valves close and semilunar valves open; during relaxation, the reverse occurs."
        },
