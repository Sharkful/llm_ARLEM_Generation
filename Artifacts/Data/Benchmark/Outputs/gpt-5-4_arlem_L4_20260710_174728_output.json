  "activity": {
    "id": "act_heart_anatomy_dual_circulation",
    "name": "Heart Anatomy and Blood Flow AR Training",
    "description": "An undergraduate anatomy AR lab in which learners identify the chambers, valves, and vessels of the human heart; trace blood through pulmonary and systemic circulation; compare ventricular wall thickness; and explain how valves prevent backflow.",
    "language": "en",
    "workplace": "wp_heart_anatomy_lab",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_intro_labels",
        "instruction": {
          "title": "Orient to the Heart",
          "description": "Examine the side-by-side intact and cutaway heart models. Notice the apex points downward and slightly left, and remember that right and left are named from the patient's perspective, not your viewing position."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "continue_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_structure_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_structure_tour_labels",
        "instruction": {
          "title": "Tour Chambers, Valves, and Major Vessels",
          "description": "Follow the guided sequence on the cutaway heart: right atrium, right ventricle, left atrium, left ventricle; then tricuspid, pulmonary, mitral/bicuspid, and aortic valves; then superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Match each internal structure to its exterior landmark on the intact heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
