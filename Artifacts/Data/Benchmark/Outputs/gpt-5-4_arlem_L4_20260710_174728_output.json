        "id": "action_05_wall_thickness",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_wall_thickness_sections",
        "instruction": {
          "title": "Compare Right and Left Ventricular Wall Thickness",
          "description": "Inspect the ventricular cross-sections. The right ventricle has a relatively thin wall, about 3\u20135 mm, because it pumps to the low-pressure pulmonary circuit. The left ventricle has a much thicker wall, about 10\u201315 mm, because it must generate enough pressure to drive blood through the entire systemic circuit."
        },
