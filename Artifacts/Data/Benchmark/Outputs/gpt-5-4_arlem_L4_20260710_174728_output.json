            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_03_dual_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_dual_circuit_flow",
        "instruction": {
          "title": "Observe the Dual Circulation",
          "description": "Watch the flowing color-coded circulation. Blue indicates deoxygenated blood on the right side of the heart and in pulmonary arteries; red indicates oxygenated blood on the left side of the heart and in pulmonary veins and systemic arteries. Compare the pulmonary loop to the systemic loop."
        },
        "enter": {
