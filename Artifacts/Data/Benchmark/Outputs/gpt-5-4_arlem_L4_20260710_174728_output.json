        "id": "action_04_rbc_trace",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_rbc_trace_anim",
        "instruction": {
          "title": "Trace One Red Blood Cell Through the Full Circuit",
          "description": "Advance the large model red blood cell one structure at a time: superior vena cava, right atrium, tricuspid valve, right ventricle, pulmonary valve, pulmonary trunk, pulmonary arteries, lung capillaries, pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, aorta, systemic circulation, and back through systemic veins. Notice the color change from blue to red in the lungs and red to blue in systemic tissues."
        },
        "enter": {
