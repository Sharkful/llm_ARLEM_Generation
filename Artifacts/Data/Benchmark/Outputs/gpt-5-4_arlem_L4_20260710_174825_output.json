  "activity": {
    "id": "act_vectors_projectile_mechanics",
    "name": "Vectors and Two-Dimensional Projectile Motion",
    "description": "An AR training lab for introductory mechanics in which students explore vectors as quantities with magnitude and direction, practice graphical addition and decomposition, and apply vector components to understand two-dimensional projectile motion, independence of horizontal and vertical motion, and the maximum-range result.",
    "language": "en",
    "workplace": "wp_physics_vectors_projectile",
    "start": "action_01_intro_vector",
    "actions": [
      {
        "id": "action_01_intro_vector",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_intro_station",
        "predicate": "pred_intro_audio",
        "instruction": {
          "title": "Explore a Single Vector",
          "description": "Observe the floating vector on the vector workspace. Identify its magnitude and direction from the labels, and relate the arrow to the colored reference axes. Learning objective: represent a vector by both magnitude-direction form and by its orientation in space."
        },
        "enter": {
          "remove_self": false,
