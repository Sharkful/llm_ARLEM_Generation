        "id": "step_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_main_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Welcome to VSEPR Theory",
          "description": "Look at the central atom model and the water Lewis structure reference. Review the core idea that electron domains around a central atom arrange to minimize repulsion, and that each bond or lone pair counts as one domain when determining steric number."
        },
        "enter": {
