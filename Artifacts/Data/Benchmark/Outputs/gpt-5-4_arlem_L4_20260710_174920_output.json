  "activity": {
    "id": "act_vsepr_training",
    "name": "AR VSEPR Theory and Molecular Geometry Lab",
    "description": "An AR-guided General Chemistry I training session in which learners move from Lewis structures to VSEPR-based prediction of electron-domain and molecular geometries, compare ideal and observed bond angles, and practice identifying structures for real molecules.",
    "language": "en",
    "workplace": "wp_vsepr_chem_lab",
    "start": "step_01_intro",
    "actions": [
