  "activity": {
    "id": "act_astronomy_retrograde",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A linear AR activity for introductory astronomy students exploring how Mars appears to reverse direction in the sky and how heliocentric orbital motion explains the effect more simply than the geocentric model.",
    "workplace": "wp_astronomy_retrograde",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Welcome to Retrograde Motion",
          "description": "Find the Night Sky Star Chart. This lab introduces the puzzle of why Mars usually drifts eastward among the stars, then briefly reverses direction before moving eastward again."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_star_chart"
          },
          {
            "mode": "click",
            "id": "action_2_sky_path"
          }
        ]
      },
      {
        "id": "action_2_sky_path",
        "instruction": {
          "title": "Mars in the Night Sky",
          "description": "On the star chart, inspect the apparent path of Mars. Notice the usual eastward drift, the slowdown, the westward loop, and the return to eastward motion over several weeks."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_geocentric"
          }
        ]
      },
      {
        "id": "action_3_geocentric",
        "instruction": {
          "title": "The Geocentric Explanation",
          "description": "View an older Earth-centered explanation. In the geocentric model, Mars needed an added loop called an epicycle to reproduce the observed retrograde path, making the system more complicated."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_solar_board"
          },
          {
            "mode": "click",
            "id": "action_4_heliocentric"
          }
        ]
      },
      {
        "id": "action_4_heliocentric",
        "instruction": {
          "title": "The Heliocentric View",
          "description": "Now look at the Solar System Orbit Board. From outside the solar system, Earth and Mars both move smoothly around the Sun. Retrograde appears when faster Earth overtakes slower Mars."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_5_prediction"
          }
        ]
      },
      {
        "id": "action_5_prediction",
        "instruction": {
          "title": "Predicting Retrograde",
          "description": "Retrograde for an outer planet occurs near opposition, when Earth is passing between the Sun and that planet and is about to overtake or is overtaking it. Use this alignment to predict when the apparent reversal will happen."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_compare_card"
          },
          {
            "mode": "click",
            "id": "action_6_compare_planets"
          }
        ]
      },
      {
        "id": "action_6_compare_planets",
        "instruction": {
          "title": "Compare Mars, Jupiter, and Saturn",
          "description": "Find the Outer Planet Comparison Card. Compare the retrograde loops of Mars, Jupiter, and Saturn. More distant planets show smaller apparent loops because the relative-motion effect changes more gradually."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_7_summary"
          }
        ]
      },
      {
        "id": "action_7_summary",
        "instruction": {
          "title": "Summary",
          "description": "Review the main idea: Mars does not actually reverse its orbit. Apparent retrograde motion is a line-of-sight effect produced when Earth, on a faster inner orbit, passes a slower outer planet. This heliocentric explanation is simpler than adding epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
