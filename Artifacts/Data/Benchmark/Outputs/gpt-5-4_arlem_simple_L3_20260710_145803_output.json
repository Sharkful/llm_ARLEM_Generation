          {
            "mode": "click",
            "id": "action_4_fork_enzymes"
          }
        ]
      },
      {
        "id": "action_4_fork_enzymes",
        "instruction": {
          "title": "Identify Enzymes at the Replication Fork",
          "description": "Locate the replication fork model. Watch helicase unwind the double helix and single-strand binding proteins stabilize the separated templates. Learning objective: identify the functions of helicase and single-strand binding proteins during replication."
        },
        "enter": {
          "remove_self": false,
