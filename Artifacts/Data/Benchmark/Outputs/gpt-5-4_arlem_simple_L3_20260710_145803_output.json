  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR learning sequence for introductory molecular biology students. Learners inspect DNA structural features, apply base-pairing rules, examine antiparallel strand orientation, and then follow the major steps of replication to understand leading and lagging strand synthesis and semiconservative outcomes.",
    "workplace": "wp_dna_replication_lab",
    "start": "action_1_intro_structure",
    "actions": [
      {
        "id": "action_1_intro_structure",
        "instruction": {
          "title": "Inspect the Double Helix",
          "description": "Locate the DNA model. Observe the two sugar-phosphate backbones spiraling around a common axis and the bases projecting inward. Learning objective: identify the major structural components that assemble into the DNA double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_dna_model"
          },
          {
            "mode": "click",
            "id": "action_2_base_pairing"
          }
        ]
      },
      {
        "id": "action_2_base_pairing",
        "instruction": {
          "title": "Apply Complementary Base Pairing",
          "description": "Examine the base-pairing cards and compare adenine-thymine with guanine-cytosine. Note that A pairs with T through two hydrogen bonds, while G pairs with C through three hydrogen bonds. Learning objective: use complementary base-pairing rules to infer one strand from the other and explain why these pairings are specific."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_base_cards"
          },
          {
            "mode": "click",
            "id": "action_3_antiparallel"
          }
        ]
      },
      {
        "id": "action_3_antiparallel",
        "instruction": {
          "title": "Trace Antiparallel Strand Direction",
          "description": "Return to the DNA model and identify the 5'\u21923' direction on one backbone and the 3'\u21925' direction on the complementary backbone. Learning objective: explain how strand directionality produces the antiparallel arrangement of the two DNA strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
