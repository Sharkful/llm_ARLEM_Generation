          }
        ]
      },
      {
        "id": "action_5_leading_lagging",
        "instruction": {
          "title": "Compare Leading and Lagging Strand Synthesis",
          "description": "Observe DNA polymerase adding nucleotides only in the 5'\u21923' direction. Notice that one new strand is synthesized continuously, while the other is built in Okazaki fragments and later joined by ligase. Learning objective: relate antiparallel template orientation to continuous leading-strand synthesis and discontinuous lagging-strand synthesis."
        },
