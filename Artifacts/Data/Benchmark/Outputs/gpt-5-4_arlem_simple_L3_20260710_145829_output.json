  "activity": {
    "id": "act_heart_blood_flow_linear",
    "name": "Heart Structure and Blood Flow",
    "description": "A linear AR activity for undergraduate anatomy students to identify the chambers, valves, and major vessels of the human heart, then trace deoxygenated and oxygenated blood through pulmonary and systemic circulation while relating ventricular wall thickness and valve function to cardiac performance.",
    "workplace": "wp_heart_anatomy_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Detect the heart model to begin. This step introduces the heart as a four-chambered pump and previews the major structures you will identify."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_heart_model"
          },
          {
            "mode": "click",
            "id": "step_2_chambers"
          }
        ]
      },
      {
        "id": "step_2_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Study the highlighted heart model and name the right atrium, right ventricle, left atrium, and left ventricle. Compare the right and left sides of the heart as receiving and pumping chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_valves"
          }
        ]
      },
      {
        "id": "step_3_valves",
        "instruction": {
          "title": "Locate the Four Valves",
          "description": "Examine the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Distinguish atrioventricular valves from semilunar valves and note how each valve prevents backflow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_vessels"
          }
        ]
      },
      {
        "id": "step_4_vessels",
        "instruction": {
          "title": "Identify Major Vessels",
          "description": "Find the superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Relate each vessel to the chamber or valve it connects with."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_flow"
          }
        ]
      },
      {
        "id": "step_5_flow",
        "instruction": {
          "title": "Trace Dual Circulation",
          "description": "Follow the path of blood in order: body to right atrium, tricuspid valve, right ventricle, pulmonary valve, pulmonary arteries, lungs, pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, and aorta to the body. Distinguish the pulmonary circuit from the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6_wall_thickness"
          }
        ]
      },
      {
        "id": "step_6_wall_thickness",
        "instruction": {
          "title": "Compare Ventricular Wall Thickness",
          "description": "Observe why the left ventricle has a thicker myocardium than the right ventricle. Connect wall thickness to the higher pressure needed for systemic circulation compared with pulmonary circulation."
        },
        "enter": {
