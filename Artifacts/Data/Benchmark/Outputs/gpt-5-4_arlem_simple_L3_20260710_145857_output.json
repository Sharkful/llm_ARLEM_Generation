  "activity": {
    "id": "act_vectors_projectile_linear",
    "name": "Vectors and Projectile Motion",
    "description": "A linear AR learning activity for introductory mechanics. Students first explore vectors as magnitude-and-direction quantities, then practice graphical addition and component decomposition, and finally apply these ideas to two-dimensional projectile motion, including motion independence, changing velocity components, and the effects of launch angle and speed.",
    "workplace": "wp_vectors_projectile",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Step 1: Identify a vector",
          "description": "Observe a two-dimensional vector as a quantity with both magnitude and direction. This step introduces the graphical idea of an arrow representing size and orientation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_2_addition"
          }
        ]
      },
      {
        "id": "action_2_addition",
        "instruction": {
          "title": "Step 2: Add vectors tip-to-tail",
          "description": "Watch two vectors placed tip-to-tail and identify the resultant from the starting point of the first vector to the ending point of the second. This models graphical vector addition."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_components"
          }
        ]
      },
      {
        "id": "action_3_components",
        "instruction": {
          "title": "Step 3: Decompose a vector into x and y components",
          "description": "Examine how a vector can be split into horizontal and vertical components. Use the right triangle to connect the original vector\u2019s magnitude and angle with its x- and y-components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "action_4_projectile_intro",
            "duration": 1
          }
        ]
      },
      {
        "id": "action_4_projectile_intro",
        "instruction": {
          "title": "Step 4: Connect components to projectile motion",
          "description": "Now apply vector components to a launched projectile. The launch velocity can be resolved into constant horizontal motion and changing vertical motion under gravity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_5_independence"
          }
        ]
      },
      {
        "id": "action_5_independence",
        "instruction": {
          "title": "Step 5: See independent horizontal and vertical motion",
          "description": "Observe the projectile path and note that gravity acts only vertically. The horizontal velocity stays constant while the vertical velocity changes steadily, producing a parabolic path."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
