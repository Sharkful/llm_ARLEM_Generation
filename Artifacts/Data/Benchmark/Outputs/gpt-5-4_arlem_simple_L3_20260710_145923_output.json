  "activity": {
    "id": "act_vsepr_linear",
    "name": "VSEPR Theory and Molecular Geometry",
    "description": "A linear AR activity for General Chemistry I students that guides learners from Lewis structures to steric number, electron-domain geometry, molecular geometry, lone-pair effects, and real molecule examples using VSEPR theory.",
    "workplace": "wp_vsepr_chem101",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Introduction to VSEPR",
          "description": "Scan the Lewis Structure Reference Card to begin. Review the central idea of VSEPR: electron domains around a central atom arrange themselves to minimize repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_lewis_card"
          },
          {
            "mode": "click",
            "id": "action_2_steric"
          }
        ]
      },
      {
        "id": "action_2_steric",
        "instruction": {
          "title": "Determine Steric Number",
          "description": "Use the Lewis structure to count electron domains around the central atom. Count each bond region and each lone pair to determine steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_domains"
          }
        ]
      },
      {
        "id": "action_3_domains",
        "instruction": {
          "title": "Match Steric Number to Electron-Domain Geometry",
          "description": "Observe the five ideal electron-domain geometries produced by steric numbers 2 through 6: linear, trigonal planar, tetrahedral, trigonal bipyramidal, and octahedral."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_4_lonepairs"
          }
        ]
      },
      {
        "id": "action_4_lonepairs",
        "instruction": {
          "title": "From Electron Geometry to Molecular Shape",
          "description": "Now compare electron-domain geometry with molecular geometry. When one or more domains are lone pairs, the visible atom arrangement changes to shapes such as bent, trigonal pyramidal, seesaw, T-shaped, square pyramidal, and square planar."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_5_examples"
          }
        ]
      },
      {
        "id": "action_5_examples",
        "instruction": {
          "title": "Apply VSEPR to Real Molecules",
          "description": "Inspect example molecules and compare predictions with observed structures: water, ammonia, methane, PF5, SF6, and XeF4. Identify each molecule's electron-domain geometry and molecular geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_molecule_set"
          },
          {
            "mode": "click",
            "id": "action_6_angles"
          }
        ]
      },
      {
        "id": "action_6_angles",
        "instruction": {
          "title": "Explain Bond-Angle Deviations",
          "description": "Compare methane and water to explain why lone pairs occupy more angular space than bonding pairs. Note how lone-pair repulsion compresses bond angles, giving water an angle of about 104.5 degrees instead of the ideal tetrahedral 109.5 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_7_summary"
          }
        ]
      },
      {
        "id": "action_7_summary",
        "instruction": {
          "title": "Summary and Checkpoint",
          "description": "Summarize the workflow: count domains to find steric number, assign electron-domain geometry, remove lone-pair positions to find molecular geometry, and predict bond-angle changes. Use this checklist to review the main VSEPR ideas."
        },
