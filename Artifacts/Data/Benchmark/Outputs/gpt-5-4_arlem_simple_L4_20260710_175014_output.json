  "activity": {
    "id": "act_astronomy_retrograde_01",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A linear AR activity for introductory astronomy students exploring Mars's apparent retrograde motion from night-sky, geocentric, and heliocentric perspectives, then comparing Mars with Jupiter and Saturn.",
    "workplace": "wp_astronomy_retrograde_01",
    "start": "step_01_intro_sky",
    "actions": [
      {
        "id": "step_01_intro_sky",
        "instruction": {
          "title": "Observe the retrograde loop in the night sky",
          "description": "Look at the starfield board to watch Mars drift eastward, reverse into a westward loop, and then resume eastward motion. Learning objective: describe the apparent path of Mars during a retrograde episode."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_starfield_board"
          },
          {
            "mode": "click",
            "id": "step_02_geocentric"
          }
        ]
      },
      {
        "id": "step_02_geocentric",
        "instruction": {
          "title": "See the geocentric explanation",
          "description": "Inspect the epicycle model showing Mars riding on a small epicycle carried by a larger deferent around Earth. Learning objective: contrast the geocentric explanation with the observed loop and note its complexity."
        },
        "enter": {
          "remove_self": false,
