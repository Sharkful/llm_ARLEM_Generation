      },
      {
        "id": "step_03_heliocentric",
        "instruction": {
          "title": "Watch Earth overtake Mars",
          "description": "Move to the heliocentric solar-system model and watch Earth on its faster inner orbit overtake slower Mars. Learning objective: explain retrograde motion as a consequence of relative motion in the heliocentric model."
        },
        "enter": {
          "remove_self": false,
