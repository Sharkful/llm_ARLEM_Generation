            "id": "action_7_leading"
          }
        ]
      },
      {
        "id": "action_7_leading",
        "instruction": {
          "title": "Step 7: Leading strand synthesis",
          "description": "Follow DNA polymerase as it synthesizes the leading strand continuously. Because polymerase extends only in the 5' to 3' direction, it can track the fork on one template strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
