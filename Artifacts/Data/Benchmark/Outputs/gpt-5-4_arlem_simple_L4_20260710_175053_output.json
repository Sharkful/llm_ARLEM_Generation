        ]
      },
      {
        "id": "action_9_fork_summary",
        "instruction": {
          "title": "Step 9: Complete replication fork overview",
          "description": "Review the full replication fork with helicase, single-strand binding proteins, DNA polymerase on the leading and lagging strands, and ligase. Relate the leading-lagging asymmetry to the antiparallel structure of DNA."
        },
        "enter": {
