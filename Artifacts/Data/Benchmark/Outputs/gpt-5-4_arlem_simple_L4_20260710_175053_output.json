  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR learning activity for introductory molecular biology students that introduces DNA structure, complementary base pairing, antiparallel strand orientation, and the major steps of semiconservative DNA replication at the replication fork.",
    "workplace": "wp_dna_replication_lab",
    "start": "action_1_ladder_intro",
    "actions": [
      {
        "id": "action_1_ladder_intro",
        "instruction": {
          "title": "Step 1: DNA as a ladder",
          "description": "Detect the DNA ladder model to view a simplified schematic of DNA. Identify the two sugar-phosphate backbones and the inward-facing base pairs A, T, G, and C."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_dna_ladder_marker"
          },
          {
            "mode": "click",
            "id": "action_2_ladder_to_helix"
          }
        ]
      },
      {
        "id": "action_2_ladder_to_helix",
        "instruction": {
          "title": "Step 2: From ladder to double helix",
          "description": "View the ladder twist into a double helix. Observe the two backbones spiraling around a common axis with base pairs stacked in the interior."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_antiparallel"
          }
        ]
      },
      {
        "id": "action_3_antiparallel",
        "instruction": {
          "title": "Step 3: Antiparallel strand orientation",
          "description": "Inspect arrows and end labels on the double helix. One strand runs 5' to 3' while the complementary strand runs 3' to 5', showing the required antiparallel arrangement."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_4_base_pairing"
          }
        ]
      },
      {
        "id": "action_4_base_pairing",
        "instruction": {
          "title": "Step 4: Complementary base pairing",
          "description": "Use the base-pairing view to determine the complementary strand. Match A with T and G with C, and compare the two hydrogen bonds in A-T with the three hydrogen bonds in G-C."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_base_palette_anchor"
          },
          {
            "mode": "click",
            "id": "action_5_helicase"
          }
        ]
      },
      {
        "id": "action_5_helicase",
        "instruction": {
          "title": "Step 5: Helicase opens the helix",
          "description": "Watch helicase move along DNA and unwind the double helix. The enzyme breaks hydrogen bonds between paired bases to create a replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
