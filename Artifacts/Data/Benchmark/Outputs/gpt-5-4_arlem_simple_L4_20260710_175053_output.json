      },
      {
        "id": "action_8_lagging",
        "instruction": {
          "title": "Step 8: Lagging strand, Okazaki fragments, and ligase",
          "description": "Examine why the second new strand forms discontinuously. DNA polymerase builds short Okazaki fragments away from the fork, and DNA ligase later joins them into a continuous strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
