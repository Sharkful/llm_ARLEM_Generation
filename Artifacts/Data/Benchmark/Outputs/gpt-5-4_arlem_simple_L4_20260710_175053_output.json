            "id": "action_6_ssb"
          }
        ]
      },
      {
        "id": "action_6_ssb",
        "instruction": {
          "title": "Step 6: Single-strand binding proteins stabilize DNA",
          "description": "Observe single-strand binding proteins attach to the exposed template strands behind helicase. These proteins keep the strands open and available for replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
