  "activity": {
    "id": "act_heart_anatomy_linear",
    "name": "Heart Anatomy and Blood Flow Exploration",
    "description": "A linear AR activity for undergraduate anatomy students that introduces the external and internal anatomy of the heart, traces the path of blood through pulmonary and systemic circulation, compares ventricular wall thickness, and demonstrates valve function in preventing backflow.",
    "workplace": "wp_heart_anatomy_lab",
    "start": "action_intro",
    "actions": [
      {
        "id": "action_intro",
        "instruction": {
          "title": "Scene 1: Exterior Orientation",
          "description": "Observe the paired heart models. The left display shows the intact exterior with major vessels, and the right display shows a cutaway. Notice anatomical right and left are named from the patient's perspective, so they appear reversed to you."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_structure_tour"
          }
        ]
      },
      {
        "id": "action_structure_tour",
        "instruction": {
          "title": "Scene 2: Guided Structural Tour",
          "description": "Identify the four chambers, four valves, and major vessels in sequence. Compare each highlighted internal structure on the cutaway model with its exterior position on the intact model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_dual_circuit"
          }
        ]
      },
      {
        "id": "action_dual_circuit",
        "instruction": {
          "title": "Scene 3: Dual Circulation Overview",
          "description": "Watch blue deoxygenated blood flow through the right side of the heart and to the lungs, and red oxygenated blood flow through the left side and out to the body. Distinguish the pulmonary circuit from the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_rbc_trace"
          }
        ]
      },
      {
        "id": "action_rbc_trace",
        "instruction": {
          "title": "Scene 4: Step-by-Step Blood Path",
          "description": "Trace one blood cell through the full circuit: vena cava to right atrium, right ventricle, lungs, left atrium, left ventricle, aorta, systemic circulation, and back again. Follow the named structures in order."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_wall_thickness"
          }
        ]
      },
      {
        "id": "action_wall_thickness",
        "instruction": {
          "title": "Scene 5: Ventricular Wall Thickness",
          "description": "Compare the right and left ventricles in cross-section. Note that the left ventricle has a much thicker myocardium because it must generate higher pressure to drive systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_valve_function"
          }
        ]
      },
      {
        "id": "action_valve_function",
        "instruction": {
          "title": "Scene 6: Valve Function and Backflow Prevention",
          "description": "Examine the tricuspid, pulmonary, mitral, and aortic valves as they open and close. Relate atrioventricular valves to chamber-to-chamber flow and semilunar valves to ventricle-to-artery flow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_recap"
          }
        ]
      },
      {
        "id": "action_recap",
        "instruction": {
          "title": "Scene 7: Recap",
          "description": "Review the key concept areas: chambers, valves, vessels, pulmonary and systemic circuits, blood flow sequence, ventricular wall thickness, and valve function in preventing backflow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
