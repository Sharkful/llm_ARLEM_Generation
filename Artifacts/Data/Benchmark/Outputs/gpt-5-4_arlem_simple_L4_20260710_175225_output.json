  "activity": {
    "id": "act_vectors_projectile_linear",
    "name": "Vectors and Projectile Motion",
    "description": "A simplified linear AR activity for General Physics I in which students review vector magnitude and direction, graphical addition, decomposition into components, and the application of these ideas to two-dimensional projectile motion and range.",
    "workplace": "wp_physics_vectors_projectile",
    "start": "step_1_vector_intro",
    "actions": [
      {
        "id": "step_1_vector_intro",
        "instruction": {
          "title": "Vector as Magnitude and Direction",
          "description": "Observe a single vector anchored at the origin. Notice that the arrow represents both a magnitude and a direction relative to the visible axes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step_1"
          }
        ]
      },
      {
        "id": "step_2_vector_addition",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Study two vectors placed tip-to-tail and the resultant drawn from the first tail to the final head. This graphical construction shows how vectors add."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step_2"
          }
        ]
      },
      {
        "id": "step_3_vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition into Components",
          "description": "View one vector broken into horizontal and vertical components. The components reconstruct the original vector and connect directly to right-triangle trigonometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step_3"
          }
        ]
      },
      {
        "id": "step_4_projectile_setup",
        "instruction": {
          "title": "From Vectors to Projectile Motion",
          "description": "Shift to a two-dimensional projectile plane. The projectile starts with an initial velocity vector pointing upward and to the right, ready to be decomposed into x and y components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detected_launcher"
          }
        ]
      },
      {
        "id": "step_5_projectile_flight",
        "instruction": {
          "title": "Independent Horizontal and Vertical Motion",
          "description": "Watch the projectile fly. The horizontal velocity component remains constant, while the vertical component decreases to zero at maximum height and then points downward during descent."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step_5"
          }
        ]
      },
      {
        "id": "step_6_maximum_range",
        "instruction": {
          "title": "How Angle Affects Range",
          "description": "Compare launches at different angles for the same speed. Observe that the greatest range occurs near 45 degrees and that complementary angles produce the same range."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step_6"
          }
        ]
      },
      {
        "id": "step_7_target_challenge",
        "instruction": {
          "title": "Projectile Targeting Challenge",
          "description": "Use what you learned about components and range to hit a ground target. A target at the same elevation can often be reached by two complementary launch angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detected_target"
          }
        ]
      },
      {
        "id": "step_8_recap",
        "instruction": {
          "title": "Recap and Consolidation",
          "description": "Review the main ideas: vectors have magnitude and direction, vectors add tip-to-tail, components reconstruct vectors, projectile motion separates into independent horizontal and vertical parts, and 45 degrees maximizes range for equal launch and landing heights."
        },
