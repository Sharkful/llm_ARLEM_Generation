  "activity": {
    "id": "act_vsepr_linear",
    "name": "VSEPR Theory: From Lewis Structures to 3D Geometry",
    "description": "A linear AR learning activity for General Chemistry I students introducing VSEPR theory, the five electron-domain geometries, the distinction between electron-domain and molecular geometry, lone-pair angle compression, and real-molecule examples.",
    "workplace": "wp_vsepr_chem1",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "Step 1: Introduce VSEPR theory",
          "description": "Observe the central atom and the water Lewis structure. Count each bond or lone pair as one electron domain, and note that electron domains arrange to minimize repulsion. Learning objective: determine steric number from a Lewis structure and connect Lewis structures to 3D prediction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_domains_2to4"
          }
        ]
      },
      {
        "id": "step_2_domains_2to4",
        "instruction": {
          "title": "Step 2: Watch domains arrange for steric numbers 2, 3, and 4",
          "description": "See two, then three, then four electron domains spread apart into linear, trigonal planar, and tetrahedral arrangements. Learning objective: predict electron-domain geometry from steric number 2, 3, or 4."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
