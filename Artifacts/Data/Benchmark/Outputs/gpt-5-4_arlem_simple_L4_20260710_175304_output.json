        "triggers": [
          {
            "mode": "click",
            "id": "step_5_lone_pair_angles"
          }
        ]
      },
      {
        "id": "step_5_lone_pair_angles",
        "instruction": {
          "title": "Step 5: See how lone pairs compress bond angles",
          "description": "Compare methane, ammonia, and water side by side. Lone pairs occupy more angular space than bonding pairs, decreasing bond angles from 109.5\u00b0 to 107\u00b0 to 104.5\u00b0. Learning objective: explain why lone pairs cause deviations from ideal bond angles and predict the direction of those deviations."
        },
        "enter": {
