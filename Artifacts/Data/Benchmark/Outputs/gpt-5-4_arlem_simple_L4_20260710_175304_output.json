          }
        ]
      },
      {
        "id": "step_3_domains_5to6",
        "instruction": {
          "title": "Step 3: Extend the geometry set to 5 and 6 domains",
          "description": "Observe how adding a fifth and sixth domain produces trigonal bipyramidal and octahedral electron-domain geometries. Learning objective: identify the five fundamental electron-domain geometries and their ideal angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_edg_vs_mg"
          }
        ]
      },
      {
        "id": "step_4_edg_vs_mg",
        "instruction": {
          "title": "Step 4: Compare electron-domain geometry with molecular geometry",
          "description": "Follow the transition from methane to ammonia to water. The electron-domain geometry remains tetrahedral, but the molecular geometry changes as lone pairs replace bonded atoms. Learning objective: distinguish electron-domain geometry from molecular geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
