        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_sky_dome",
        "predicate": "pred_audio_lab_intro",
        "instruction": {
          "title": "Orient to the retrograde puzzle",
          "description": "Stand at the Night-Sky Observation Station. In this lab you will investigate why Mars sometimes appears to reverse direction against the stars even though planets do not physically stop and move backward in their orbits."
        },
