  "activity": {
    "id": "act_retrograde_motion_lab",
    "name": "Exploring Apparent Retrograde Motion of Mars",
    "description": "A hands-on AR lab for introductory astronomy students. Learners first observe Mars tracing an apparent retrograde loop across a star-field dome, then compare geocentric epicycle and heliocentric overtaking explanations. They use an alignment dial to predict retrograde events and compare the apparent loops of Mars, Jupiter, and Saturn.",
