  "activity": {
    "id": "act_dna_structure_semiconservative_replication",
    "name": "DNA Structure and Semiconservative Replication AR Investigation",
    "description": "A guided hands-on AR learning activity for 200-level molecular biology students. Learners inspect a three-dimensional DNA double helix, apply complementary base-pairing rules, connect antiparallel strand directionality to replication mechanics, and trace the roles of helicase, single-strand binding proteins, DNA polymerase, and DNA ligase in producing semiconservative daughter molecules.",
    "language": "en",
    "workplace": "wp_dna_replication_lab",
    "start": "step_01_orientation",
    "actions": [
