        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_structure_bench",
        "predicate": "pred_label_lab_overview",
        "instruction": {
          "title": "Orient to the DNA AR Lab",
          "description": "Stand at the DNA Structure Workbench and locate the physical DNA double helix model and base-pair tile tray. This session connects DNA architecture to the mechanism of semiconservative replication."
        },
