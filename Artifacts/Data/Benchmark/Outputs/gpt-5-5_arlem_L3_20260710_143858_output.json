  "activity": {
    "id": "act_heart_structure_blood_flow",
    "name": "Human Heart Structure and Blood Flow AR Lab",
    "description": "A guided AR laboratory for 200-level Human Anatomy and Physiology students. Learners inspect a physical heart model, valve and vessel identification cards, and a ventricular wall cross-section while AR labels, diagrams, audio narration, and flow animations teach chamber identification, valve function, major vessel anatomy, dual circulation, and the functional significance of left ventricular wall thickness.",
    "language": "en",
    "workplace": "wp_heart_anatomy_lab",
    "start": "step_01_orient",
    "actions": [
      {
        "id": "step_01_orient",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_model_table",
        "predicate": "label_orientation_goal",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Place the heart model on the worktable and face the anterior cutaway toward you. This step establishes the anatomical left and right sides, which appear reversed from the viewer's perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_model_table",
              "augmentation": "label_orientation_goal",
              "poi": "table_center_overlay"
            },
            {
              "target": "thing_heart_model",
              "augmentation": "audio_orientation_intro",
              "poi": "default"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_heart_model",
            "duration": 2,
            "type": "tangible",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "continue_to_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "continue_to_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_model_table",
        "predicate": "image_chamber_map",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Locate the right atrium, right ventricle, left atrium, and left ventricle on the heart model. Remember: anatomical right is the patient's right side, not necessarily your visual right when facing the model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
