  "activity": {
    "id": "act_vectors_projectile_motion_lab",
    "name": "Vectors and Projectile Motion AR Training",
    "description": "A hands-on AR learning sequence for a 100-level algebra-based General Physics I course. Learners first represent vectors by magnitude/direction and by x-y components, then add vectors graphically, decompose an initial velocity vector, and apply component reasoning to two-dimensional projectile motion. The experience emphasizes that horizontal velocity remains constant while vertical velocity changes under gravity, producing a parabolic path.",
    "language": "en",
    "workplace": "wp_vectors_projectile_mechanics_lab",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_vector_table",
        "predicate": "pred_label_vector_overview",
        "instruction": {
          "title": "Orient to Vectors",
          "description": "Stand at the Vector Analysis Table. Notice that a vector is represented by both a length and a direction. In this lab you will connect this representation to projectile motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
