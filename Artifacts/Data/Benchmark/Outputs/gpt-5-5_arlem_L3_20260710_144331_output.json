        "type": "actions",
        "device": "ar_headset_01",
        "location": "geometry_table",
        "predicate": "animation_lone_pair_repulsion_angle_compression",
        "instruction": {
          "title": "Explain Bond-Angle Deviations",
          "description": "Use the Lone Pair Repulsion Demonstrator. Lone pairs are held closer to the central atom and occupy more angular space than bonding pairs, so they compress bond angles between atoms. Compare CH4 at 109.5\u00b0 with H2O at about 104.5\u00b0. Learning objective: predict the direction of angle deviations caused by lone pairs."
        },
