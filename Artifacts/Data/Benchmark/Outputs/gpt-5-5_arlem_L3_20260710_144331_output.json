          }
        ]
      },
      {
        "id": "step_03_build_ideal_geometries",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "geometry_table",
        "predicate": "animation_electron_domains_minimize_repulsion",
        "instruction": {
          "title": "Build the Five Electron-Domain Geometries",
          "description": "Use the Electron-Domain Kit to add 2, 3, 4, 5, and 6 domains around a central atom. Watch the domains settle into linear, trigonal planar, tetrahedral, trigonal bipyramidal, and octahedral arrangements. Learning objective: predict electron-domain geometry from steric number."
        },
