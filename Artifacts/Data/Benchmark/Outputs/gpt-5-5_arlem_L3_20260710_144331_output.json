  "activity": {
    "id": "vsepr_geometry_training_activity",
    "name": "Predicting Molecular Shape with VSEPR Theory",
    "description": "A hands-on augmented reality training activity for General Chemistry I students. Learners begin with Lewis structures, count electron domains to determine steric number, map steric number to electron-domain geometry, distinguish electron-domain geometry from molecular geometry, evaluate lone-pair effects on bond angles, and compare predictions against common real molecules.",
    "language": "en",
    "workplace": "vsepr_ar_lab_workplace",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "geometry_table",
        "predicate": "label_welcome_vsepr",
        "instruction": {
          "title": "Orient to the VSEPR Lab",
          "description": "Stand at the VSEPR Geometry Construction Table. VSEPR theory predicts 3D molecular shape by arranging electron domains around a central atom to minimize repulsion. Learning objective: state the central idea of VSEPR before using it to build shapes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geometry_table",
              "augmentation": "label_welcome_vsepr",
              "poi": "table_center"
            },
            {
              "target": "geometry_table",
              "augmentation": "audio_welcome_vsepr_overview",
              "poi": "left_reference_panel"
            },
            {
              "target": "geometry_table",
              "augmentation": "warning_spatial_awareness",
              "poi": "default"
            }
          ],
          "messages": [],
          "if_logic": []
        },
