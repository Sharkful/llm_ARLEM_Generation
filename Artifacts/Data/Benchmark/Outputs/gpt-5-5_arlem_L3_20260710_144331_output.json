          {
            "mode": "click",
            "id": "begin_counting",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "begin counting",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "geometry_table",
        "predicate": "image_lewis_steric_number_guide",
        "instruction": {
          "title": "Count Electron Domains from a Lewis Structure",
          "description": "Place or view the Lewis Structure Card Deck. Count each bonding region and each lone pair around the central atom. Multiple bonds count as one electron domain. Learning objective: determine steric number from bonding pairs plus lone pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
