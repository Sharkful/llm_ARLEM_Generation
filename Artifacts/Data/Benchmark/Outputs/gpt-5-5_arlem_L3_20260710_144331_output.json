              "augmentation": "image_lewis_steric_number_guide",
              "poi": "card_surface"
            },
            {
              "target": "lewis_structure_cards",
              "augmentation": "audio_steric_number_prompt",
              "poi": "default"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "lewis_structure_cards",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "domains counted",
            "type": "action",
