        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "geometry_table",
        "predicate": "animation_lone_pair_shape_changes",
        "instruction": {
          "title": "Separate Electron-Domain Geometry from Molecular Geometry",
          "description": "Convert selected bonding domains into lone pairs. The electron-domain geometry still counts all domains, but the molecular geometry shows only atom positions. Observe bent, trigonal pyramidal, seesaw, T-shaped, square pyramidal, and square planar shapes. Learning objective: distinguish electron-domain geometry from molecular geometry."
        },
