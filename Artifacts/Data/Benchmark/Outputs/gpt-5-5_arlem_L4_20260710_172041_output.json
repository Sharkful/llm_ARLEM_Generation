  "activity": {
    "id": "act_apparent_retrograde_motion",
    "name": "Apparent Retrograde Motion: From Mars's Loop to Heliocentric Geometry",
    "description": "A hands-on AR astronomy lab for 100-level undergraduate non-majors. Learners observe Mars's apparent retrograde loop in the night sky, test the geocentric epicycle explanation, connect the heliocentric overtaking model to the Earth-based sky view, embody the parallax-like effect by walking an orbit, compare Mars with Jupiter and Saturn, and complete a prediction challenge near opposition.",
    "language": "en",
    "workplace": "wp_retrograde_motion_lab",
    "start": "step_01_observe_mars_loop",
    "actions": [
      {
        "id": "step_01_observe_mars_loop",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_night_sky_dome",
        "predicate": "pred_night_sky_mars_loop_animation",
        "instruction": {
          "title": "Observe Mars's apparent loop",
          "description": "Learning objective: describe the observed retrograde pattern. Face the ecliptic constellations and watch six months of Mars positions. Notice the normal eastward drift, the halt, the westward retrograde loop of about 15 degrees, and the return to eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_night_sky_dome",
              "augmentation": "pred_night_sky_mars_loop_animation",
              "poi": "sky_mars_path"
            },
            {
