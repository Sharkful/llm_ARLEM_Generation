  "activity": {
    "id": "act_dna_structure_semiconservative_replication",
    "name": "DNA Structure and Semiconservative Replication AR Training",
    "description": "A hands-on AR laboratory sequence for 200-level biology and biochemistry students. Learners first map DNA from a simplified ladder representation to a three-dimensional B-form double helix, identify sugar-phosphate backbones, nitrogenous bases, and hydrogen bonds, then apply complementary base pairing. The activity then builds a replication fork step by step: helicase unwinds DNA, single-strand binding proteins stabilize templates, DNA polymerase synthesizes the leading and lagging strands, and ligase seals Okazaki fragments. The session ends with a semiconservative replication prediction challenge and concept recap.",
    "language": "en",
    "workplace": "wp_dna_replication_ar_lab",
    "start": "a01_orient_and_detect",
    "actions": [
      {
        "id": "a01_orient_and_detect",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "structure_bench",
        "predicate": "label_lab_welcome",
        "instruction": {
          "title": "Orient to the DNA Structure Workstation",
          "description": "Stand at the DNA Structure Workstation and look at the flat DNA ladder marker. Learning objective: prepare the workspace and distinguish the simplified ladder view from later three-dimensional models."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "structure_bench",
              "augmentation": "label_lab_welcome",
              "poi": "front_display"
            },
            {
              "target": "structure_bench",
              "augmentation": "audio_lab_welcome",
              "poi": "front_display"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "dna_schematic_model",
            "duration": 2,
            "type": "tangible",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
