  "activity": {
    "id": "heart_anatomy_blood_flow_activity",
    "name": "Structural Heart Anatomy and Blood Flow AR Lab",
    "description": "A guided AR lab for undergraduate Human Anatomy and Physiology I students. Learners inspect intact and cutaway heart models, identify chambers, valves, and vessels, trace the dual circulation pathway, compare ventricular wall thickness, examine valve states, and complete identification and blood-flow sequence quizzes.",
    "language": "en",
    "workplace": "heart_anatomy_workplace",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "central_table",
        "predicate": "heart_orientation_audio",
        "instruction": {
          "title": "Orient the Heart Models",
          "description": "Two anatomically oriented heart models appear: the intact exterior model on the left and the cutaway model on the right. Note that anatomical right and left are defined from the patient's perspective, so the heart's right side appears on your left as you face it. Learning objective: establish anatomical orientation and relate exterior and cutaway views."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "intact_heart_model",
              "augmentation": "gross_orientation_labels",
              "poi": "default"
            },
            {
              "target": "cutaway_heart_model",
              "augmentation": "heart_orientation_audio",
              "poi": "default"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_02_structural_tour",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next structural tour",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_structural_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "central_table",
        "predicate": "structural_tour_audio",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Follow the highlights on the cutaway heart and matching exterior landmarks. Identify the four chambers, four valves, and major vessels in sequence. Learning objective: name heart chambers, valves, and vessels and locate each on the model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "cutaway_heart_model",
              "augmentation": "structure_highlight_animation",
              "poi": "right_atrium_poi"
            },
            {
              "target": "cutaway_heart_model",
              "augmentation": "chambers_valves_vessels_labels",
              "poi": "default"
            },
            {
              "target": "intact_heart_model",
              "augmentation": "structure_highlight_animation",
              "poi": "pulmonary_vessels_poi"
            },
            {
              "target": "cutaway_heart_model",
              "augmentation": "structural_tour_audio",
              "poi": "default"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_03_dual_circuits",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next circulation",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_03_dual_circuits",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_01",
        "location": "central_table",
        "predicate": "dual_circuit_audio",
        "instruction": {
          "title": "Visualize Pulmonary and Systemic Circuits",
          "description": "Blue flow represents deoxygenated blood returning to and leaving the right heart for the lungs. Red flow represents oxygenated blood returning to and leaving the left heart for the body. Learning objective: distinguish pulmonary and systemic circulation and connect each with the correct side of the heart."
        },
