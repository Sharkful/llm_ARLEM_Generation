            "id": "step_02_done_click",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_02_done_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_03_decompose_vector",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens_learner",
        "location": "place_vector_workbench",
        "predicate": "pred_decomposition_audio",
        "instruction": {
          "title": "3. Decompose a vector into components",
          "description": "The neutral resultant vector is now broken into x, y, and z component arrows. Resize the x and y components along their axes and observe that the original vector reconstructs itself from the component sum."
        },
