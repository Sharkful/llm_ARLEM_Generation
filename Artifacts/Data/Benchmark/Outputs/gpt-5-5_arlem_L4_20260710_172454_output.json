  "activity": {
    "id": "act_vector_projectile_lab",
    "name": "Vectors and Two-Dimensional Projectile Motion AR Training",
    "description": "A room-scale AR lab for algebra-based General Physics I in which learners manipulate vectors, add and decompose them, and apply component reasoning to projectile motion. The activity progresses from abstract vector representation to tip-to-tail addition, component decomposition, projectile independence, maximum range discovery, targeting, sandbox exploration, and recap.",
    "language": "en",
    "workplace": "wp_vector_projectile_lab",
    "start": "step_01_intro_vectors",
    "actions": [
      {
        "id": "step_01_intro_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens_learner",
        "location": "place_vector_workbench",
        "predicate": "pred_vector_definition_audio",
        "instruction": {
          "title": "1. Vectors: magnitude and direction",
          "description": "Look at the floating arrow. Drag the arrow head to change its length and direction. Observe how the magnitude and direction labels update while the x, y, and z reference axes remain fixed."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "person_learner",
              "augmentation": "pred_lab_intro_audio"
            },
            {
              "target": "person_learner",
              "augmentation": "pred_vector_definition_audio"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "pred_vector_magnitude_direction_labels"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_01_done_click",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_01_done_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_tip_to_tail_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens_learner",
        "location": "place_vector_workbench",
        "predicate": "pred_tip_tail_audio",
        "instruction": {
          "title": "2. Add vectors tip-to-tail",
          "description": "Two arrows appear: blue vector A and green vector B. Reorient one of them and watch the red resultant update from the original tail to the final head. Then use the swap control to confirm that A + B and B + A give the same resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
