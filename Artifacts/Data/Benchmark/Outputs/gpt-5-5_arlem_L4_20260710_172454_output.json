              "augmentation": "pred_tip_tail_vectors_animation"
            },
            {
              "target": "place_vector_workbench",
              "augmentation": "pred_resultant_label"
            },
            {
              "target": "person_learner",
              "augmentation": "pred_tip_tail_audio"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "pred_vector_arrow_animation"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
