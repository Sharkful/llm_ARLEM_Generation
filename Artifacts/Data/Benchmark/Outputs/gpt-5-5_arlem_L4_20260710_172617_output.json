  "activity": {
    "id": "act_vsepr_theory_training",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Shapes",
    "description": "A hands-on AR training lab for General Chemistry I students. Learners start with a Lewis structure, count electron domains, observe repulsions that produce the five electron-domain geometries, distinguish electron-domain geometry from molecular geometry, explain lone-pair bond-angle compression, compare predictions with real molecules, and complete two prediction challenges.",
    "language": "en",
    "workplace": "wp_vsepr_ar_lab",
    "start": "a01_setup_core_idea",
    "actions": [
      {
        "id": "a01_setup_core_idea",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_main_model_table",
        "predicate": "pred_audio_intro_vsepr",
        "instruction": {
          "title": "1. Start with the VSEPR core idea",
          "description": "Look at the central atom and the water Lewis structure reference. Count electron domains: each single, double, or triple bond counts as one domain, and each lone pair counts as one domain. Learning objective: determine steric number from a Lewis structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom_model",
              "augmentation": "pred_label_vsepr_core_idea"
            },
            {
              "target": "place_side_reference_panel",
              "augmentation": "pred_image_water_lewis_counting"
            },
            {
              "target": "person_learner_01",
              "augmentation": "pred_audio_intro_vsepr"
