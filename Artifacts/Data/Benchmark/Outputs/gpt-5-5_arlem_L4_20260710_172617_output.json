            "operator": "equal"
          }
        ]
      },
      {
        "id": "a02_minimum_repulsion_2_to_4",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_main_model_table",
        "predicate": "pred_anim_domains_2_to_4",
        "instruction": {
          "title": "2. Watch electron domains minimize repulsion",
          "description": "Observe two, then three, then four electron domains drift apart around the central atom. Note the settled geometries: linear at 180\u00b0, trigonal planar at 120\u00b0, and tetrahedral at 109.5\u00b0. Learning objective: predict electron-domain geometry from steric number 2, 3, and 4."
        },
        "enter": {
