  "activity": {
    "id": "act_retrograde_motion_linear_lab",
    "name": "Apparent Retrograde Motion: From Sky Loop to Heliocentric Explanation",
    "description": "A simplified linear AR activity for an introductory astronomy course. Students first observe Mars's apparent eastward drift and retrograde loop against background stars, then compare geocentric and heliocentric explanations, and finally contrast Mars with Jupiter and Saturn. The activity emphasizes relative motion: Earth, on an inner faster orbit, overtakes slower outer planets, causing temporary apparent westward motion.",
    "workplace": "wp_retrograde_motion_intro_ast101",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "instruction": {
          "title": "1. Set the Scene: Apparent Motion in the Night Sky",
          "description": "Detect the Earth-surface sky viewing marker. In this lab, you will track Mars night after night as it appears to move against fixed background constellations. Learning objective: identify that retrograde motion is an apparent motion seen from Earth."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_sky_view",
              "augmentation": "lbl_lab_title",
              "poi": "default"
            },
            {
              "target": "place_sky_view",
              "augmentation": "img_mars_sky_eastward",
              "poi": "sky_panel"
            },
            {
              "target": "place_sky_view",
              "augmentation": "aud_intro_apparent_motion",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_sky_view"
          }
        ]
      },
      {
        "id": "step_02_sky_loop",
        "instruction": {
          "title": "2. Observe Mars's Retrograde Loop",
          "description": "Watch Mars drift eastward, slow, reverse westward for several weeks, and then resume eastward motion. Learning objective: describe the sequence of a Mars retrograde episode: normal eastward drift, westward loop, and return to eastward drift."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_sky_view",
              "augmentation": "anim_mars_retrograde_loop_sky",
              "poi": "sky_panel"
            },
            {
              "target": "thing_mars",
              "augmentation": "lbl_mars",
              "poi": "mars_label_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_geocentric"
          }
        ]
      },
      {
        "id": "step_03_geocentric_model",
        "instruction": {
          "title": "3. Historical Puzzle: The Geocentric Explanation",
          "description": "View a simplified geocentric epicycle model. In Earth-centered astronomy, Mars's loop required an added circular motion called an epicycle. Learning objective: contrast the geocentric explanation with the observation it was designed to reproduce."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_sky_view",
              "augmentation": "vid_geocentric_epicycle",
              "poi": "sky_panel"
            },
            {
              "target": "thing_earth",
              "augmentation": "lbl_lab_title",
              "poi": "observer_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_heliocentric"
          }
        ]
      },
      {
        "id": "step_04_heliocentric_orbits",
        "instruction": {
          "title": "4. Outside View: Earth Overtakes Mars",
          "description": "Detect the solar-system orbit station. From above the solar system, Earth and Mars both move smoothly around the Sun. Earth is closer to the Sun, orbits faster, and periodically passes Mars. Learning objective: explain retrograde motion as a consequence of Earth overtaking a slower outer planet."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_orbit_view",
              "augmentation": "anim_heliocentric_orbits",
              "poi": "orbit_plane"
            },
            {
              "target": "thing_sun",
              "augmentation": "lbl_sun",
              "poi": "sun_label_poi"
            },
            {
              "target": "place_orbit_view",
              "augmentation": "lbl_overtaking_explanation",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_orbit_view"
          }
        ]
      },
      {
        "id": "step_05_relative_motion_analogy",
        "instruction": {
          "title": "5. Relative Motion Analogy",
          "description": "Compare the orbit animation to a passing-car analogy: a slower car can appear to move backward relative to distant scenery as you pass it. Learning objective: use an everyday relative-motion analogy to explain why Mars only appears to reverse direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_orbit_view",
              "augmentation": "img_relative_motion_car_analogy",
              "poi": "orbit_plane"
            },
            {
              "target": "place_orbit_view",
              "augmentation": "lbl_overtaking_explanation",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_comparison"
          }
        ]
      },
      {
        "id": "step_06_compare_outer_planets",
        "instruction": {
          "title": "6. Compare Mars, Jupiter, and Saturn",
          "description": "Detect the outer-planet comparison station. Mars shows a larger apparent retrograde loop than Jupiter or Saturn because it is closer to Earth during opposition and the relative-motion geometry changes more quickly. Learning objective: compare loop sizes for outer planets and explain why more distant planets produce smaller loops."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_comparison_view",
              "augmentation": "anim_mars_jupiter_saturn_loops",
              "poi": "comparison_panel"
            },
            {
              "target": "thing_jupiter_saturn_card",
              "augmentation": "lbl_outer_planets",
              "poi": "outer_planets_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_comparison_view"
          }
        ]
      },
      {
        "id": "step_07_prediction_wrapup",
        "instruction": {
          "title": "7. Predict the Next Retrograde Event",
          "description": "Retrograde motion for an outer planet occurs near opposition, when Earth lies between the Sun and that planet and is overtaking it. Learning objective: predict retrograde timing from relative orbital positions and summarize why the heliocentric explanation is more parsimonious than epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_comparison_view",
              "augmentation": "lbl_outer_planets",
              "poi": "comparison_panel"
            },
            {
              "target": "place_comparison_view",
              "augmentation": "aud_wrapup_prediction",
              "poi": "default"
            },
            {
              "target": "thing_sun",
              "augmentation": "lbl_sun",
              "poi": "sun_label_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
