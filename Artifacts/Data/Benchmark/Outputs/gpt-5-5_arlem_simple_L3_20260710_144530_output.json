  "activity": {
    "id": "act_dna_structure_replication_linear",
    "name": "DNA Double Helix and Semiconservative Replication",
    "description": "A simplified linear AR learning activity for 200-level molecular biology students. Students inspect DNA structure, complementary base pairing, antiparallel strand orientation, replication-fork enzymes, leading and lagging strand synthesis, and semiconservative daughter-molecule composition.",
    "workplace": "wp_dna_replication_lab",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "instruction": {
          "title": "Orient to the DNA Structure Station",
          "description": "Scan the DNA Structure Station marker. The lab begins by placing a color-coded double helix model in front of you and previewing the relationship between DNA structure and replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "structure_station",
              "augmentation": "lbl_lab_intro",
              "poi": "header_above"
            },
            {
              "target": "structure_station",
              "augmentation": "aud_lab_intro_overview",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_structure_station"
          }
        ]
      },
      {
        "id": "step_02_double_helix_components",
        "instruction": {
          "title": "Identify the Components of the Double Helix",
          "description": "Examine the double helix model. Locate the two sugar-phosphate backbones, the inward-facing bases, and the common helical axis. Notice that the backbones are on the outside while base pairs form the interior rungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_double_helix_model",
              "augmentation": "anim_double_helix_prefab",
              "poi": "default"
            },
            {
              "target": "dna_double_helix_model",
              "augmentation": "lbl_backbone_components",
              "poi": "helix_axis"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_base_pairs"
          }
        ]
      },
      {
        "id": "step_03_base_pairing_rules",
        "instruction": {
          "title": "Apply Complementary Base-Pairing Rules",
          "description": "Use the base-pairing card to match bases. Adenine pairs with thymine through two hydrogen bonds, and guanine pairs with cytosine through three hydrogen bonds. Given a template sequence, infer its complementary sequence by these rules."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "base_pair_rules_card",
              "augmentation": "img_base_pair_rules",
              "poi": "pairing_overlay"
            },
            {
              "target": "base_pair_rules_card",
              "augmentation": "lbl_pairing_practice",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_antiparallel"
          }
        ]
      },
      {
        "id": "step_04_antiparallel_orientation",
        "instruction": {
          "title": "Explain Antiparallel Directionality",
          "description": "Compare the 5\u2032 and 3\u2032 labels on the two backbones. The complementary strands run in opposite directions: one 5\u2032 to 3\u2032, the other 3\u2032 to 5\u2032. This orientation is essential for understanding why replication is asymmetric."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_double_helix_model",
              "augmentation": "img_antiparallel_directionality",
              "poi": "backbone_left"
            },
            {
              "target": "dna_double_helix_model",
              "augmentation": "lbl_antiparallel",
              "poi": "backbone_right"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_replication_fork"
          }
        ]
      },
      {
        "id": "step_05_helicase_and_ssb",
        "instruction": {
          "title": "Trace Helicase and Single-Strand Binding Proteins",
          "description": "Scan the replication fork model. Helicase opens the parental double helix at the fork, while single-strand binding proteins keep the separated templates from reannealing."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "anim_helicase_unwinds_fork",
              "poi": "fork_center"
            },
            {
              "target": "replication_enzyme_set",
              "augmentation": "lbl_helicase_ssb",
              "poi": "helicase_spot"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_replication_fork"
          }
        ]
      },
      {
        "id": "step_06_polymerase_leading_lagging",
        "instruction": {
          "title": "Connect DNA Polymerase Directionality to Leading and Lagging Strands",
          "description": "Watch how DNA polymerase extends only from a free 3\u2032 end, synthesizing new DNA in the 5\u2032 to 3\u2032 direction. On one template, synthesis follows the fork continuously as the leading strand; on the other, synthesis occurs discontinuously as lagging-strand Okazaki fragments."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "video_polymerase_leading_lagging",
              "poi": "leading_arm"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "lbl_leading_lagging",
              "poi": "lagging_arm"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_ligase"
          }
        ]
      },
      {
        "id": "step_07_ligase_and_semiconservative",
        "instruction": {
          "title": "Finish Replication and Explain Semiconservative Inheritance",
          "description": "DNA ligase joins Okazaki fragments, producing continuous daughter strands. The semiconservative outcome means each daughter molecule contains one original parental strand and one newly synthesized strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_enzyme_set",
              "augmentation": "anim_ligase_joins_fragments",
              "poi": "ligase_spot"
            },
            {
              "target": "replication_enzyme_set",
              "augmentation": "lbl_ligase_function",
              "poi": "polymerase_spot"
            },
            {
              "target": "replication_station",
              "augmentation": "img_semiconservative_outcome",
              "poi": "summary_panel"
            },
            {
              "target": "replication_station",
              "augmentation": "lbl_semiconservative",
              "poi": "default"
            },
            {
              "target": "replication_station",
              "augmentation": "aud_replication_summary",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
  }
