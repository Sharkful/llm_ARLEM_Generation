  "activity": {
    "id": "act_heart_structure_blood_flow_linear",
    "name": "Heart Structure and Dual Circulation Walkthrough",
    "description": "A simplified linear AR lab for 200-level Human Anatomy and Physiology I students. Learners identify the heart chambers, valves, and major vessels, then trace blood through pulmonary and systemic circuits while relating ventricular wall thickness to pressure demands and valve structure to backflow prevention.",
    "workplace": "wp_heart_anatomy_lab",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Detect the heart model marker, then note the anterior view and the lab goal: identify structures and trace the complete path of blood through the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lab_table",
              "augmentation": "lbl_lab_title_heart_flow",
              "poi": "overview_display_poi"
            },
            {
              "target": "lab_table",
              "augmentation": "img_external_heart_orientation",
              "poi": "overview_display_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "aud_intro_heart_orientation",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_heart_model"
          }
        ]
      },
      {
        "id": "step_02_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Locate the right atrium, right ventricle, left atrium, and left ventricle. Associate each chamber with its main receiving or pumping role."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "lbl_right_atrium",
              "poi": "right_atrium_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "lbl_right_ventricle",
              "poi": "right_ventricle_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "lbl_left_atrium",
              "poi": "left_atrium_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "lbl_left_ventricle",
              "poi": "left_ventricle_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "aud_chambers_identification",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_valves"
          }
        ]
      },
      {
        "id": "step_03_valves",
        "instruction": {
          "title": "Identify Valves and Backflow Prevention",
          "description": "Review the atrioventricular valves and semilunar valves. Connect each valve to the chamber or vessel pair it separates and observe how valves maintain one-way flow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "valve_panel",
              "augmentation": "lbl_tricuspid_valve",
              "poi": "tricuspid_poi"
            },
            {
              "target": "valve_panel",
              "augmentation": "lbl_pulmonary_valve",
              "poi": "pulmonary_poi"
            },
            {
              "target": "valve_panel",
              "augmentation": "lbl_mitral_valve",
              "poi": "mitral_poi"
            },
            {
              "target": "valve_panel",
              "augmentation": "lbl_aortic_valve",
              "poi": "aortic_poi"
            },
            {
              "target": "valve_panel",
              "augmentation": "vid_valves_prevent_backflow",
              "poi": "video_poi"
            },
            {
              "target": "valve_panel",
              "augmentation": "aud_valve_function",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_valve_panel"
          }
        ]
      },
      {
        "id": "step_04_major_vessels",
        "instruction": {
          "title": "Identify Major Vessels",
          "description": "Name the vessels entering and leaving the heart: superior and inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Note which vessels carry oxygenated versus deoxygenated blood."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vessel_panel",
              "augmentation": "lbl_vena_cavae",
              "poi": "vena_cavae_poi"
            },
            {
              "target": "vessel_panel",
              "augmentation": "lbl_pulmonary_arteries",
              "poi": "pulmonary_arteries_poi"
            },
            {
              "target": "vessel_panel",
              "augmentation": "lbl_pulmonary_veins",
              "poi": "pulmonary_veins_poi"
            },
            {
              "target": "vessel_panel",
              "augmentation": "lbl_aorta",
              "poi": "aorta_poi"
            },
            {
              "target": "vessel_panel",
              "augmentation": "aud_major_vessels",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_vessel_panel"
          }
        ]
      },
      {
        "id": "step_05_pulmonary_circuit",
        "instruction": {
          "title": "Trace Deoxygenated Blood Through the Pulmonary Circuit",
          "description": "Follow the blue pathway: body \u2192 vena cavae \u2192 right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary arteries \u2192 lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "anim_deoxygenated_path",
              "poi": "flow_animation_poi"
            },
            {
              "target": "circulation_floor_zone",
              "augmentation": "lbl_pulmonary_circuit",
              "poi": "pulmonary_circuit_poi"
            },
            {
              "target": "heart_model",
              "augmentation": "aud_pulmonary_circuit",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_systemic"
          }
        ]
      },
      {
        "id": "step_06_systemic_circuit",
        "instruction": {
          "title": "Trace Oxygenated Blood Through the Systemic Circuit",
