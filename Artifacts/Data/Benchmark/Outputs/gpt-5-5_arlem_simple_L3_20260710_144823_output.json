  "activity": {
    "id": "act_vectors_projectile_motion_linear",
    "name": "Vectors and Two-Dimensional Projectile Motion",
    "description": "A simplified linear AR lab for General Physics I students. Learners first visualize vectors as quantities with magnitude and direction, then add vectors graphically, decompose vectors into x and y components, and apply those operations to projectile motion. The activity emphasizes independence of horizontal and vertical motion, the changing velocity components during flight, maximum height, and qualitative predictions for changes in launch angle and speed.",
    "workplace": "wp_vector_projectile_lab",
    "start": "step_01_intro",
    "actions": [
      {
        "id": "step_01_intro",
        "instruction": {
          "title": "1. Recognize vectors in projectile motion",
          "description": "Scan or view the lab origin. Vectors represent quantities that have both magnitude and direction. In this lab, velocity will be treated as a vector, and projectile motion will be analyzed using horizontal and vertical components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_field",
              "augmentation": "lbl_intro_vectors_projectiles",
              "poi": "default"
            },
            {
              "target": "place_projectile_field",
              "augmentation": "aud_intro_vectors_projectiles",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_intro"
          }
        ]
      },
      {
        "id": "step_02_tip_to_tail",
        "instruction": {
          "title": "2. Add vectors tip-to-tail",
          "description": "At the Vector Addition Station, observe two displacement vectors. Vector B is translated so its tail starts at the tip of vector A. The resultant vector runs from the starting tail to the final tip, representing the vector sum A + B."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_station",
              "augmentation": "anim_tip_to_tail_vectors",
              "poi": "default"
            },
            {
              "target": "place_vector_station",
              "augmentation": "lbl_tip_to_tail_resultant",
              "poi": "upper_label"
            },
            {
              "target": "place_vector_station",
              "augmentation": "img_resultant_triangle",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_vector_board"
          },
          {
            "mode": "click",
            "id": "continue_tip_to_tail"
          }
        ]
      },
      {
        "id": "step_03_components",
        "instruction": {
          "title": "3. Decompose a vector into x and y components",
          "description": "At the XY Component Grid, compare a single angled vector with its horizontal and vertical component vectors. The original vector can be reconstructed from these perpendicular components using right-triangle relationships."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_grid",
              "augmentation": "anim_vector_components",
              "poi": "default"
            },
            {
              "target": "thing_component_grid",
              "augmentation": "lbl_components_trig",
              "poi": "right_triangle_zone"
            },
            {
              "target": "thing_component_grid",
              "augmentation": "img_right_triangle_components",
              "poi": "right_triangle_zone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_component_grid"
          },
          {
            "mode": "click",
            "id": "continue_components"
          }
        ]
      },
      {
        "id": "step_04_launch_decomposition",
        "instruction": {
          "title": "4. Apply components to launch velocity",
          "description": "At the projectile launcher, the initial velocity vector is split into horizontal and vertical components. The launch speed sets the vector magnitude, while the launch angle determines how much of that speed is horizontal and how much is vertical."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_projectile_launcher",
              "augmentation": "anim_launch_velocity_decomposition",
              "poi": "velocity_vector_origin"
            },
            {
              "target": "thing_projectile_launcher",
              "augmentation": "lbl_launch_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_launcher"
          },
          {
            "mode": "click",
            "id": "continue_launch_decomposition"
          }
        ]
      },
      {
        "id": "step_05_independent_motion",
        "instruction": {
          "title": "5. Observe independent horizontal and vertical motion",
          "description": "On the Projectile Trajectory Field, watch the projectile trace a parabolic path. With no air resistance, no horizontal force acts after launch, so horizontal velocity remains constant. Gravity acts vertically, causing the vertical velocity to change steadily."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_field",
              "augmentation": "anim_independent_motion",
              "poi": "arc_center"
            },
            {
              "target": "place_projectile_field",
              "augmentation": "lbl_independent_motion",
              "poi": "default"
            },
            {
              "target": "place_projectile_field",
              "augmentation": "vid_projectile_velocity_evolution",
              "poi": "arc_center"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_trajectory_field"
          },
          {
            "mode": "click",
            "id": "continue_independent_motion"
          }
        ]
      },
      {
        "id": "step_06_max_height",
        "instruction": {
          "title": "6. Identify velocity at maximum height",
          "description": "Focus on the top of the trajectory. At maximum height, the vertical component of velocity is momentarily zero, but the horizontal component remains nonzero. The projectile continues forward while gravity begins increasing its downward vertical velocity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_field",
              "augmentation": "lbl_max_height",
              "poi": "arc_center"
            },
            {
              "target": "place_projectile_field",
              "augmentation": "vid_projectile_velocity_evolution",
              "poi": "arc_center"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_max_height"
          }
        ]
      },
      {
        "id": "step_07_angle_speed",
        "instruction": {
          "title": "7. Predict effects of launch angle and speed",
          "description": "At the Angle and Speed Control Card, compare trajectories. Increasing launch speed generally increases both range and maximum height. For level launch and landing with no air resistance, a 45\u00b0 launch angle produces maximum range for a fixed speed."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_angle_speed_control",
              "augmentation": "anim_angle_speed_comparison",
              "poi": "comparison_zone"
            },
            {
              "target": "thing_angle_speed_control",
              "augmentation": "lbl_angle_speed_prediction",
              "poi": "default"
            },
            {
              "target": "thing_data_table",
              "augmentation": "img_range_height_table",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_angle_control"
          },
          {
            "mode": "click",
            "id": "continue_angle_speed"
          }
        ]
      },
      {
        "id": "step_08_summary",
        "instruction": {
          "title": "8. Summarize the vector model of projectile motion",
          "description": "Use the data table to review the key model: vectors may be added and decomposed into components; projectile motion combines constant horizontal velocity with uniformly accelerated vertical motion; the visible parabola comes from these independent motions occurring at the same time."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_data_table",
              "augmentation": "img_range_height_table",
              "poi": "summary_panel"
            },
            {
              "target": "thing_data_table",
              "augmentation": "aud_summary_projectile_motion",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
