  "activity": {
    "id": "act_vsepr_intro_linear",
    "name": "VSEPR Theory: From Lewis Structures to Molecular Shape",
    "description": "A simplified linear AR activity for General Chemistry I students. Learners count bonding and lone-pair domains from Lewis structures, map steric number to electron-domain geometry, distinguish electron-domain geometry from molecular geometry, examine lone-pair effects on bond angles, and compare VSEPR predictions with observed structures for common molecules.",
    "workplace": "wp_vsepr_intro_lab",
    "start": "step1_count_domains",
    "actions": [
      {
        "id": "step1_count_domains",
        "instruction": {
          "title": "1. Count Electron Domains from a Lewis Structure",
          "description": "Learning objective: determine steric number by counting bonding pairs and lone pairs around the central atom. Inspect the Lewis examples for H2O, NH3, and CH4. Multiple bonds count as one electron domain in VSEPR."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_lewis_station",
              "augmentation": "lbl_step1_steric_number",
              "poi": "overlay"
            },
            {
              "target": "place_lewis_station",
              "augmentation": "img_lewis_counting_examples",
              "poi": "overlay"
            },
            {
              "target": "place_lewis_station",
              "augmentation": "aud_steric_number_intro",
              "poi": "default"
            },
            {
              "target": "thing_central_atom_kit",
              "augmentation": "lbl_step1_steric_number",
              "poi": "atom_mount"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_geometries"
          }
        ]
      },
      {
        "id": "step2_map_steric_to_domain",
        "instruction": {
          "title": "2. Map Steric Number to Electron-Domain Geometry",
          "description": "Learning objective: predict the electron-domain geometry from steric number. Review the five fundamental arrangements: SN 2 linear, SN 3 trigonal planar, SN 4 tetrahedral, SN 5 trigonal bipyramidal, and SN 6 octahedral."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_geometry_table",
              "augmentation": "lbl_step2_domain_geometries",
              "poi": "display"
            },
            {
              "target": "place_geometry_table",
              "augmentation": "img_domain_geometry_chart",
              "poi": "display"
            },
            {
              "target": "place_geometry_table",
              "augmentation": "aud_domain_geometry_overview",
              "poi": "default"
            },
            {
              "target": "place_model_build_area",
              "augmentation": "anim_domains_minimize_repulsion",
              "poi": "model_center"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_shape_card"
          }
        ]
      },
      {
        "id": "step3_lone_pairs_shapes",
        "instruction": {
          "title": "3. Distinguish Electron-Domain Geometry from Molecular Geometry",
          "description": "Learning objective: identify how lone pairs change the named molecular shape while the electron-domain arrangement remains based on all domains. Compare bent, trigonal pyramidal, seesaw, T-shaped, square planar, and square pyramidal shapes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_model_build_area",
              "augmentation": "lbl_step3_molecular_geometry",
              "poi": "model_center"
            },
            {
              "target": "place_model_build_area",
              "augmentation": "anim_lone_pair_shapes",
              "poi": "model_center"
            },
            {
              "target": "thing_vsepr_shape_card",
              "augmentation": "img_lone_pair_shape_matrix",
              "poi": "card_face"
            },
            {
              "target": "thing_lone_pair_token",
              "augmentation": "aud_molecular_geometry_lone_pairs",
              "poi": "token_top"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_angles"
          }
        ]
      },
      {
        "id": "step4_lone_pair_angle_effects",
        "instruction": {
          "title": "4. Explain Lone-Pair Repulsion and Bond-Angle Deviations",
          "description": "Learning objective: explain why lone pairs occupy more angular space than bonding pairs and predict that lone pairs compress adjacent bond angles. Compare methane at 109.5\u00b0 with water at about 104.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_angle_reference",
              "augmentation": "lbl_step4_angle_deviation",
              "poi": "angle_arc"
            },
            {
              "target": "place_angle_reference",
              "augmentation": "img_water_methane_angle_compare",
              "poi": "angle_arc"
            },
            {
              "target": "place_angle_reference",
              "augmentation": "aud_lone_pair_repulsion",
              "poi": "default"
            },
            {
              "target": "place_model_build_area",
              "augmentation": "anim_bond_angle_compression",
              "poi": "model_center"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_bonding_token"
          }
        ]
      },
      {
        "id": "step5_compare_real_molecules",
        "instruction": {
          "title": "5. Apply VSEPR to Real Molecules",
          "description": "Learning objective: apply VSEPR predictions to H2O, NH3, CH4, PF5, SF6, and XeF4, then compare the predicted molecular geometries with observed structures."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_molecule_comparison",
              "augmentation": "lbl_step5_real_molecules",
              "poi": "comparison_row"
            },
            {
              "target": "place_molecule_comparison",
              "augmentation": "img_real_molecule_panel",
              "poi": "comparison_row"
            },
            {
              "target": "place_molecule_comparison",
              "augmentation": "aud_real_molecule_comparison",
              "poi": "default"
            },
            {
              "target": "thing_vsepr_shape_card",
              "augmentation": "vid_vsepr_summary",
              "poi": "card_face"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_finish"
          }
        ]
      },
      {
        "id": "step6_prediction_checklist",
        "instruction": {
          "title": "6. VSEPR Prediction Checklist",
          "description": "Learning objective: summarize the full method: draw or inspect the Lewis structure, count electron domains, assign electron-domain geometry, hide lone pairs to name molecular geometry, estimate angle deviations, and compare to molecular evidence."
        },
        "enter": {
