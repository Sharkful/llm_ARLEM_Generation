  "activity": {
    "id": "act_retrograde_motion_linear_lab",
    "name": "Apparent Retrograde Motion: From Sky Loop to Heliocentric Overtaking",
    "description": "A simplified linear AR lab for an introductory astronomy course. Students observe Mars's apparent retrograde loop, compare geocentric and heliocentric explanations, connect line-of-sight geometry to the sky view, embody the overtaking effect, and compare Mars with Jupiter and Saturn.",
    "workplace": "wp_retrograde_motion_intro_astronomy",
    "start": "step_01_observe_mars_loop",
    "actions": [
      {
        "id": "step_01_observe_mars_loop",
        "instruction": {
          "title": "1. Observe the puzzle in the night sky",
          "description": "Learning objective: describe Mars's apparent path across the stars. Watch the red point of Mars drift eastward, reverse westward into a loop, and then resume eastward motion over a simulated six-month interval."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_night_sky_dome",
              "augmentation": "pred_image_ecliptic_constellations",
              "poi": "zenith_view"
            },
            {
              "target": "thing_mars_observation_point",
              "augmentation": "pred_anim_mars_six_month_sky_trail",
              "poi": "trail_overlay"
            },
            {
              "target": "thing_mars_observation_point",
              "augmentation": "pred_label_mars_east_west_loop",
              "poi": "default"
            },
            {
              "target": "place_night_sky_dome",
              "augmentation": "pred_audio_intro_mars_retrograde_puzzle",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_geocentric"
          }
        ]
      },
      {
        "id": "step_02_geocentric_epicycle",
        "instruction": {
          "title": "2. Test the geocentric epicycle explanation",
          "description": "Learning objective: contrast a geocentric explanation with later heliocentric reasoning. In this model, Earth is central and Mars rides on an epicycle carried around a deferent, producing backward apparent motion only with extra circular machinery."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_geocentric_epicycle_model",
              "augmentation": "pred_anim_geocentric_deferent_epicycle",
              "poi": "default"
            },
            {
              "target": "thing_geocentric_epicycle_model",
              "augmentation": "pred_label_epicycle_deferent",
              "poi": "epicycle_label_point"
            },
            {
              "target": "thing_geocentric_epicycle_model",
              "augmentation": "pred_audio_geocentric_epicycle_explanation",
              "poi": "deferent_label_point"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_geocentric_model_done"
          }
        ]
      },
      {
        "id": "step_03_heliocentric_overtaking",
        "instruction": {
          "title": "3. View Earth overtaking Mars from above the solar system",
          "description": "Learning objective: explain apparent retrograde motion as a consequence of heliocentric relative motion. Earth moves faster on the inner orbit and overtakes slower Mars, naturally creating the retrograde interval without epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_floor",
              "augmentation": "pred_anim_heliocentric_earth_mars_orbits",
              "poi": "above_ecliptic_view"
            },
            {
              "target": "thing_sun_earth_mars_orbits",
              "augmentation": "pred_label_earth_mars_periods",
              "poi": "earth_orbit_poi"
            },
            {
              "target": "thing_sun_earth_mars_orbits",
              "augmentation": "pred_audio_heliocentric_overtaking",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_line_of_sight"
          }
        ]
      },
      {
        "id": "step_04_line_of_sight_geometry",
        "instruction": {
          "title": "4. Link the orbit view to the night-sky loop",
          "description": "Learning objective: predict retrograde motion from relative orbital positions. Follow the Earth-to-Mars line of sight as it projects onto the starfield: it sweeps eastward, reverses westward during overtaking, and then resumes eastward."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_floor",
              "augmentation": "pred_anim_line_of_sight_projection",
              "poi": "default"
            },
            {
              "target": "place_night_sky_dome",
              "augmentation": "pred_video_side_by_side_sky_orbit",
              "poi": "zenith_view"
            },
            {
              "target": "place_solar_system_floor",
              "augmentation": "pred_audio_line_of_sight_link",
              "poi": "above_ecliptic_view"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_sun_orbit_model"
          }
        ]
      },
      {
        "id": "step_05_embodied_overtaking",
        "instruction": {
          "title": "5. Generate retrograde motion with your own viewpoint",
          "description": "Learning objective: explain the effect using an everyday overtaking analogy. Walk around the Earth-orbit circle while looking toward the virtual Mars marker against the distant starfield. Near closest approach, Mars appears to drift backward."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_earth_walk_orbit",
              "augmentation": "pred_anim_walk_orbit_guides",
              "poi": "default"
            },
            {
              "target": "thing_earth_walk_orbit",
              "augmentation": "pred_label_closest_approach_retrograde",
              "poi": "closest_approach_point"
            },
            {
              "target": "thing_earth_walk_orbit",
              "augmentation": "pred_audio_embodied_overtaking",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_after_walk"
          }
        ]
      },
      {
        "id": "step_06_compare_outer_planets",
        "instruction": {
          "title": "6. Compare Mars, Jupiter, and Saturn loops",
          "description": "Learning objective: compare retrograde loops for outer planets. More distant planets produce smaller apparent loops because Earth's motion subtends a smaller angle at greater distance."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_comparison_wall",
              "augmentation": "pred_image_mars_jupiter_saturn_loops",
              "poi": "planet_loop_panel"
            },
            {
              "target": "place_comparison_wall",
              "augmentation": "pred_label_loop_sizes",
              "poi": "default"
            },
            {
              "target": "place_comparison_wall",
              "augmentation": "pred_audio_outer_planet_comparison",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_comparison_wall"
          }
        ]
      },
      {
        "id": "step_07_recap",
        "instruction": {
          "title": "7. Recap: why Mars seems to reverse",
          "description": "Learning objective: synthesize the lab. Summarize the observed loop, the epicycle explanation, the simpler heliocentric overtaking explanation, line-of-sight geometry, prediction near opposition, and smaller loops for farther planets."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_comparison_wall",
              "augmentation": "pred_image_recap_five_concepts",
              "poi": "planet_loop_panel"
            },
            {
              "target": "place_comparison_wall",
              "augmentation": "pred_audio_recap",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
