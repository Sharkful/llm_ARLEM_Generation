  "activity": {
    "id": "heart_anatomy_linear_activity",
    "name": "Human Heart Structure and Blood Flow: Simplified AR Lab",
    "description": "A reduced ARLEM linear activity for 200-level Human Anatomy and Physiology students. Learners identify the chambers, valves, and major vessels of the heart; trace blood through pulmonary and systemic circuits; compare ventricular wall thickness; and explain valve function in preventing backflow.",
    "workplace": "heart_anatomy_workplace",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "instruction": {
          "title": "1. Orient to the Anatomical Heart",
          "description": "Observe the intact heart on the left and cutaway heart on the right. The apex points inferiorly and slightly to the patient's left. Remember that anatomical right and left are named from the patient's perspective, so they appear reversed when facing the model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_left_display",
              "augmentation": "label_orientation_patient_right_left",
              "poi": "label_above"
            },
            {
              "target": "thing_intact_heart",
              "augmentation": "audio_01_orientation_overview",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_structures"
          }
        ]
      },
      {
        "id": "step_02_structural_tour",
        "instruction": {
          "title": "2. Identify Chambers, Valves, and Major Vessels",
          "description": "Use the cutaway model to locate the right atrium, right ventricle, left atrium, and left ventricle. Then identify the tricuspid, pulmonary, mitral/bicuspid, and aortic valves, followed by the venae cavae, pulmonary arteries, pulmonary veins, and aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_cutaway_heart",
              "augmentation": "label_chambers_valves_vessels",
              "poi": "chamber_label_poi"
            },
            {
              "target": "thing_intact_heart",
              "augmentation": "image_structure_highlight_map",
              "poi": "vessel_label_poi"
            },
            {
              "target": "thing_cutaway_heart",
              "augmentation": "audio_02_structural_tour",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_flow_marker"
          }
        ]
      },
      {
        "id": "step_03_dual_circuit_flow",
        "instruction": {
          "title": "3. Distinguish Pulmonary and Systemic Circuits",
          "description": "Watch the color-coded flow. Blue indicates deoxygenated blood returning from the body and traveling to the lungs. Red indicates oxygenated blood returning from the lungs and leaving through the aorta to the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_blood_flow_path",
              "augmentation": "anim_dual_circuit_flow",
              "poi": "default"
            },
            {
              "target": "thing_blood_flow_path",
              "augmentation": "label_pulmonary_systemic_circuits",
              "poi": "default"
            },
            {
              "target": "thing_blood_flow_path",
              "augmentation": "audio_03_dual_circuit_flow",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_rbc_trace"
          }
        ]
      },
      {
        "id": "step_04_rbc_trace",
        "instruction": {
          "title": "4. Trace One Red Blood Cell Through the Full Circuit",
          "description": "Follow the enlarged blood cell from the superior vena cava through the right heart, lungs, left heart, aorta, and systemic circulation. Name each chamber, valve, and vessel in order as the cell moves."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_blood_flow_path",
              "augmentation": "anim_rbc_trace_sequence",
              "poi": "rbc_start_poi"
            },
            {
              "target": "place_right_display",
              "augmentation": "label_rbc_path_order",
              "poi": "label_above"
            },
            {
              "target": "thing_blood_flow_path",
              "augmentation": "audio_04_rbc_trace",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_ventricle_section"
          }
        ]
      },
      {
        "id": "step_05_wall_thickness",
        "instruction": {
          "title": "5. Compare Right and Left Ventricular Myocardium",
          "description": "Compare the ventricular cross-sections. The right ventricle has a thinner wall because it pumps to the low-pressure pulmonary circuit. The left ventricle has a thicker wall because it generates pressure for systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_ventricle_cross_section",
              "augmentation": "anim_ventricle_wall_comparison",
              "poi": "default"
            },
            {
              "target": "thing_ventricle_cross_section",
              "augmentation": "label_wall_thickness_ratio",
              "poi": "lv_wall_poi"
            },
            {
              "target": "thing_ventricle_cross_section",
              "augmentation": "audio_05_wall_thickness",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_valve_station"
          }
        ]
      },
      {
        "id": "step_06_valve_function",
        "instruction": {
          "title": "6. Explain How Valves Prevent Backflow",
          "description": "Inspect valve opening and closing. Atrioventricular valves prevent backflow into the atria during ventricular contraction. Semilunar valves prevent backflow into the ventricles during ventricular relaxation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_valve_function",
              "augmentation": "anim_valves_open_closed",
              "poi": "default"
            },
            {
              "target": "thing_valve_function",
              "augmentation": "label_valve_backflow_summary",
              "poi": "av_valves_poi"
            },
            {
              "target": "thing_valve_function",
              "augmentation": "audio_06_valve_function",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_recap"
          }
        ]
      },
      {
        "id": "step_07_recap",
        "instruction": {
          "title": "7. Recap: Heart Structures and Circulation",
          "description": "Review the five core concepts: structural inventory, pulmonary versus systemic circuits, full blood-flow sequence, ventricular wall thickness, and valve function. Use this summary to prepare for structure identification and flow-tracing practice."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_right_display",
              "augmentation": "image_recap_summary",
              "poi": "default"
            },
            {
              "target": "place_right_display",
              "augmentation": "audio_07_recap",
              "poi": "label_above"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
  }
