          "description": "A ground target appears at a fixed distance. Use the idea of velocity components to predict an angle and speed that will land the projectile on the target."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_target_zone",
              "augmentation": "pred_target_challenge_animation",
              "poi": "target_marker_poi"
            },
            {
              "target": "place_target_zone",
              "augmentation": "pred_audio_targeting",
              "poi": "default"
            },
            {
              "target": "thing_launch_controls",
              "augmentation": "pred_projectile_initial_velocity_animation",
              "poi": "slider_panel"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_recap"
          }
        ]
      },
      {
        "id": "step_08_recap",
        "instruction": {
          "title": "8. Recap: Vectors to Projectiles",
          "description": "Review the key ideas: vectors have magnitude and direction, components add to reconstruct vectors, gravity affects only vertical motion, and 45 degrees maximizes range for equal-height launches at fixed speed."
        },
        "enter": {
