  "activity": {
    "id": "act_vectors_projectile_linear",
    "name": "Vectors and Projectile Motion: Linear AR Lab",
    "description": "A simplified linear ARLEM activity for a 100-level algebra-based mechanics course. Students progress from vectors as magnitude-and-direction arrows, to tip-to-tail addition, to component decomposition, and then apply these ideas to two-dimensional projectile motion, independence of horizontal and vertical motion, maximum range near 45 degrees, and a short targeting challenge recap.",
    "workplace": "wp_vectors_projectile_mechanics",
    "start": "step_01_vector_intro",
    "actions": [
      {
        "id": "step_01_vector_intro",
        "instruction": {
          "title": "1. Vector Magnitude and Direction",
          "description": "Observe the arrow anchored at the vector table. A vector represents both magnitude, shown by arrow length, and direction, shown by its orientation relative to the colored axes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_table",
              "augmentation": "pred_axes_xyz_animation",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "pred_single_vector_animation",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "pred_vector_intro_labels",
              "poi": "arrow_head"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_audio_vector_intro",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_addition"
          }
        ]
      },
      {
        "id": "step_02_vector_addition",
        "instruction": {
          "title": "2. Add Vectors Tip-to-Tail",
          "description": "Two vectors are placed tip-to-tail. The red resultant runs from the first tail to the second head, showing the graphical sum of the blue and green vectors."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_table",
              "augmentation": "pred_axes_xyz_animation",
              "poi": "axis_overlay"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_tip_to_tail_animation",
              "poi": "default"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_tip_to_tail_label",
              "poi": "default"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_audio_vector_addition",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_components"
          }
        ]
      },
      {
        "id": "step_03_components",
        "instruction": {
          "title": "3. Decompose a Vector into Components",
          "description": "See one vector broken into horizontal and vertical components. In two dimensions, the component arrows form a right triangle with the original vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_table",
              "augmentation": "pred_decomposition_animation",
              "poi": "default"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_decomposition_label",
              "poi": "axis_overlay"
            },
            {
              "target": "place_vector_table",
              "augmentation": "pred_audio_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_projectiles"
          }
        ]
      },
      {
        "id": "step_04_projectile_setup",
        "instruction": {
          "title": "4. Apply Components to Projectile Motion",
          "description": "Move to the vertical projectile plane. The launch velocity vector is drawn from the ball and decomposed into horizontal and vertical components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_projectile_plane_image",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_projectile_initial_velocity_animation",
              "poi": "launch_point"
            },
            {
              "target": "thing_projectile_ball",
              "augmentation": "pred_decomposition_label",
              "poi": "velocity_attach"
            },
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_audio_projectile_setup",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_projectile_plane_ready"
          }
        ]
      },
      {
        "id": "step_05_motion_independence",
        "instruction": {
          "title": "5. Watch Independent Horizontal and Vertical Motion",
          "description": "During flight, the horizontal velocity arrow remains constant while the vertical velocity changes because gravity acts downward. Their combination produces the parabolic path."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_projectile_motion_animation",
              "poi": "trajectory_center"
            },
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_independence_label",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "augmentation": "pred_audio_independence",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_range"
          }
        ]
      },
      {
        "id": "step_06_range_exploration",
        "instruction": {
          "title": "6. Explore Launch Angle, Speed, and Range",
          "description": "Compare trajectories for different launch angles at the same speed. For equal launch and landing heights, the range is largest near 45 degrees."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launch_controls",
              "augmentation": "pred_range_exploration_animation",
              "poi": "slider_panel"
            },
            {
              "target": "thing_launch_controls",
              "augmentation": "pred_range_label",
              "poi": "default"
            },
            {
              "target": "thing_launch_controls",
              "augmentation": "pred_audio_range_45",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_targeting"
          }
        ]
      },
      {
        "id": "step_07_target_challenge",
        "instruction": {
