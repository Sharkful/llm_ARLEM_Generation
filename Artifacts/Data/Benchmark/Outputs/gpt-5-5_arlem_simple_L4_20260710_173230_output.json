            },
            {
              "target": "central_atom_stage",
              "augmentation": "lbl_lone_pair_angles",
              "poi": "angle_label_zone"
            },
            {
              "target": "vsepr_lab_table",
              "augmentation": "aud_lone_pair_spread_compresses_bonds",
              "poi": "left_comparison_zone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_06_real_molecules"
          }
        ]
      },
      {
        "id": "step_06_real_molecules",
        "instruction": {
          "title": "Match VSEPR predictions to real molecules",
          "description": "Explore example structures: CO2, BF3, CH4, PF5, SF6, NH3, H2O, and XeF4. For each, compare the Lewis structure with the 3D structure, identify the steric number, count lone pairs, and name the electron-domain and molecular geometries."
        },
        "enter": {
          "remove_self": false,
