  "activity": {
    "id": "act_vsepr_simplified_linear",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Geometry",
    "description": "A simplified linear AR lab for General Chemistry I. Students use VSEPR theory to count electron domains, predict electron-domain geometries for steric numbers 2 through 6, distinguish electron-domain geometry from molecular geometry, explain lone-pair bond-angle compression, and compare predictions with real molecular examples.",
    "workplace": "wp_vsepr_ar_lab",
    "start": "step_01_intro",
    "actions": [
      {
        "id": "step_01_intro",
        "instruction": {
          "title": "Start with a Lewis structure",
          "description": "View water as a flat Lewis structure. Count electron domains around the central atom: each bond group and each lone pair counts as one domain. VSEPR uses this count to predict the three-dimensional arrangement that minimizes repulsions."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_stage",
              "augmentation": "lbl_vsepr_core_idea",
              "poi": "atom_center"
            },
            {
              "target": "lewis_structure_panel",
              "augmentation": "img_water_lewis_counting",
              "poi": "flat_structure_view"
            },
            {
              "target": "vsepr_lab_table",
              "augmentation": "aud_intro_vsepr_domains",
              "poi": "center_workspace"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_02_minimum_repulsion"
          }
        ]
      },
      {
        "id": "step_02_minimum_repulsion",
        "instruction": {
          "title": "Watch domains move apart",
          "description": "Two, three, and four electron domains appear around a central atom and settle into linear, trigonal planar, and tetrahedral arrangements. Notice the ideal angles: 180\u00b0, 120\u00b0, and 109.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_stage",
              "augmentation": "anim_linear_trigonal_tetrahedral",
              "poi": "atom_center"
            },
            {
              "target": "central_atom_stage",
              "augmentation": "lbl_minimum_repulsion_angles",
              "poi": "angle_label_zone"
            },
            {
              "target": "vsepr_lab_table",
              "augmentation": "aud_minimum_repulsion_demo",
              "poi": "center_workspace"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_03_geometry_catalog"
          }
        ]
      },
      {
        "id": "step_03_geometry_catalog",
        "instruction": {
          "title": "Complete the five electron-domain geometries",
          "description": "Add a fifth and sixth domain. Five domains form trigonal bipyramidal geometry with axial and equatorial positions; six domains form octahedral geometry. Use the summary panel to connect steric number with geometry and characteristic angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_stage",
              "augmentation": "anim_trig_bipyramidal_octahedral",
              "poi": "atom_center"
            },
            {
              "target": "geometry_gallery_wall",
              "augmentation": "img_five_ed_geometries_summary",
              "poi": "panel_upper"
            },
            {
              "target": "geometry_gallery_wall",
              "augmentation": "aud_geometry_catalog_5_6",
              "poi": "panel_lower"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_04_electron_vs_molecular"
          }
        ]
      },
      {
        "id": "step_04_electron_vs_molecular",
        "instruction": {
          "title": "Separate electron-domain geometry from molecular geometry",
          "description": "Compare CH4, NH3, and H2O within a tetrahedral electron-domain arrangement. When bonding domains are replaced by lone pairs, the electron-domain geometry remains tetrahedral, but the molecular geometry changes to trigonal pyramidal or bent."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom_stage",
              "augmentation": "anim_tetrahedral_ch4_nh3_h2o",
              "poi": "atom_center"
            },
            {
              "target": "central_atom_stage",
              "augmentation": "lbl_ed_vs_molecular_geometry",
              "poi": "angle_label_zone"
            },
            {
              "target": "vsepr_lab_table",
              "augmentation": "aud_electron_vs_molecular_geometry",
              "poi": "left_comparison_zone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_05_lone_pair_angles"
          }
        ]
      },
      {
        "id": "step_05_lone_pair_angles",
        "instruction": {
          "title": "Explain lone-pair angle compression",
          "description": "Study CH4, NH3, and H2O side by side. Lone pairs are drawn as larger clouds because they are held by only one nucleus and occupy more angular space, compressing adjacent bond angles from 109.5\u00b0 to about 107\u00b0 and then 104.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vsepr_lab_table",
              "augmentation": "anim_lone_pair_angle_comparison",
