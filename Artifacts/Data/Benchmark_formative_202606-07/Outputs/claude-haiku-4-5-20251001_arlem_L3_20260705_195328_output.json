      {
        "id": "step_02_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_hololens",
        "location": "main_workstation",
        "predicate": "chamber_identification_animation",
        "instruction": {
          "title": "Identifying the Four Chambers",
          "description": "The heart is divided into four chambers: two upper atria and two lower ventricles. The RIGHT ATRIUM (upper right) receives deoxygenated blood from the body via the superior and inferior vena cava. The RIGHT VENTRICLE (lower right) pumps this deoxygenated blood to the lungs via the pulmonary arteries. The LEFT ATRIUM (upper left) receives oxygenated blood from the lungs via the pulmonary veins. The LEFT VENTRICLE (lower left) is the most muscular chamber and pumps oxygenated blood to the entire body via the aorta. Notice that the left ventricle has a much thicker myocardium than the right\u2014this is because it must generate significantly higher pressure to perfuse the systemic circulation, while the right ventricle only needs to perfuse the lungs, which are much closer and require lower pressure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_3d_model",
              "type": "predicate",
              "augmentation": "chamber_identification_animation",
