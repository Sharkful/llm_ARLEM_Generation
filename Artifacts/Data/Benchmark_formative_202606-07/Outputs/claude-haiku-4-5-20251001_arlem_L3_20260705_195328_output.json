  "activity": {
    "id": "cardiac_anatomy_activity",
    "name": "Cardiac Anatomy and Circulation Lab Activity",
    "description": "A comprehensive AR-guided exploration of human heart anatomy covering the four chambers, four valves, major blood vessels, and the dual circulation pathways (pulmonary and systemic circuits). Students will identify and name key anatomical structures, trace blood flow through the heart and lungs, explain functional differences between the right and left sides of the heart, and understand why the left ventricle has thicker myocardium. This activity emphasizes the integration of structure and function in cardiovascular physiology, appropriate for 200-level nursing, kinesiology, and pre-health students.",
    "language": "en",
    "workplace": "anatomy_heart_lab",
    "start": "step_01_overview",
    "actions": [
      {
        "id": "step_01_overview",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_hololens",
        "location": "main_workstation",
        "predicate": "heart_anatomy_overview_video",
        "instruction": {
          "title": "Welcome to Cardiac Anatomy Lab",
          "description": "In this lab, you will explore the structural anatomy of the human heart and understand how blood flows through it. You will identify the four chambers (right and left atria and ventricles), the four valves (tricuspid, pulmonary, mitral, and aortic), and the major vessels entering and leaving the heart. By the end, you will understand how the heart pumps deoxygenated blood to the lungs and oxygenated blood to the entire body. Let's begin with a brief overview of the heart's basic anatomy."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_3d_model",
              "type": "predicate",
              "augmentation": "heart_anatomy_overview_video",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_3d_model",
