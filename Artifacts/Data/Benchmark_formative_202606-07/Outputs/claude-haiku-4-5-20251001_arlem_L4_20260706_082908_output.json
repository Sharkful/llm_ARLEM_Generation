  "activity": {
    "id": "dna_structure_replication_activity",
    "name": "DNA Structure and Replication Lab: Complete Learning Module",
    "description": "A comprehensive AR learning experience exploring DNA's three-dimensional double-helix structure, the complementary base-pairing rules, the antiparallel orientation of strands, and the semiconservative mechanism of DNA replication. Students progress through schematic representations, interactive base-pairing, enzyme action at the replication fork, and predictive assessment of replication outcomes. The experience builds from simple ladder models to complex molecular visualization with hands-on interactive components.",
    "language": "en",
    "workplace": "dna_replication_lab_workplace",
    "start": "step_01_dna_schematic_intro",
    "actions": [
      {
        "id": "step_01_dna_schematic_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_1",
        "location": "central_visualization_zone",
        "predicate": "narration_intro_dna_structure",
        "instruction": {
          "title": "DNA: The Ladder Schematic",
          "description": "Welcome to the DNA Structure and Replication Lab! You will explore how DNA is built and how it replicates inside cells. We begin with a simplified ladder model that shows the fundamental parts of DNA: two vertical rails (sugar-phosphate backbones) with rungs between them (base pairs). Each rung consists of two colored bases that link together. Watch as the narration introduces the polymer nature of DNA."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_ladder_schematic_model",
              "type": "predicate",
              "augmentation": "narration_intro_dna_structure"
            },
            {
              "target": "dna_ladder_schematic_model",
              "type": "predicate",
              "augmentation": "label_sugar_phosphate_backbone",
              "poi": "left_backbone"
            },
            {
              "target": "dna_ladder_schematic_model",
              "type": "predicate",
              "augmentation": "label_sugar_phosphate_backbone",
              "poi": "right_backbone"
            },
            {
              "target": "dna_ladder_schematic_model",
              "type": "predicate",
              "augmentation": "label_nitrogenous_bases",
              "poi": "base_pair_rungs"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_ladder_schematic_model",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_01_dna_schematic_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_helix_twist_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_1",
        "location": "central_visualization_zone",
        "predicate": "animation_ladder_to_helix_twist",
        "instruction": {
          "title": "From Ladder to Double Helix",
          "description": "The ladder begins to twist! As you watch, the two vertical backbones spiral around a common central axis, and the base pairs stack neatly inside the helix. This is the iconic double-helix shape of DNA discovered by Watson and Crick. Notice how the helix completes one full turn about every ten base pairs. You can click the toggle to switch between the ladder and helix views at any time to compare the two representations."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_ladder_schematic_model",
              "type": "predicate",
              "augmentation": "animation_ladder_to_helix_twist"
            },
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "narration_helix_geometry"
            },
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "label_turn_10_base_pairs",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_ladder_schematic_model",
              "type": "*"
            },
            {
              "target": "dna_double_helix_model",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_02_helix_twist_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_03_antiparallel_directionality",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_1",
        "location": "central_visualization_zone",
        "predicate": "narration_antiparallel_directionality",
        "instruction": {
          "title": "Antiparallel Orientation and 5' to 3' Direction",
          "description": "Now we focus on the directionality of the DNA strands. Look closely at the arrows painted along each sugar-phosphate backbone. One strand runs upward from 5' to 3', while its complementary partner runs downward from 3' to 5'. This antiparallel arrangement is not random\u2014it is a fundamental consequence of the chemistry of the sugar-phosphate backbone itself. The 5' and 3' labels refer to the carbon atoms of the sugar rings at each end of the strand. You can rotate the helix to view this from different angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "narration_antiparallel_directionality"
            },
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "arrow_overlay_strand_direction",
              "poi": "strand_5_to_3"
            },
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "arrow_overlay_strand_direction",
              "poi": "strand_3_to_5"
            },
            {
              "target": "dna_double_helix_model",
              "type": "predicate",
              "augmentation": "label_5_prime_terminus",
              "poi": "strand_5_to_3"
            },
            {
              "target": "dna_double_helix_model",
