  "activity": {
    "id": "projectile_motion_activity",
    "name": "Vectors and Projectile Motion Exploration",
    "description": "Students explore the mathematical foundations of vectors and apply vector operations to understand two-dimensional projectile motion. The activity progresses from abstract vector concepts to concrete applications in predicting projectile trajectories.",
    "workplace": "projectile_motion_lab",
    "start": "step_1_introduction",
    "actions": [
      {
        "id": "step_1_introduction",
        "instruction": {
          "title": "Welcome to the Projectile Motion Lab",
          "description": "In this lab, you will explore vectors as mathematical tools for representing quantities with both magnitude and direction. You will learn how vectors add, how they decompose into components, and how these principles explain the motion of projectiles launched at various angles. Let's begin by understanding the fundamental properties of vectors."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "instruction_station",
              "type": "predicate",
              "augmentation": "introduction_audio"
            },
            {
              "target": "instruction_station",
              "type": "predicate",
              "augmentation": "vector_magnitude_direction_label",
              "text": "A vector is defined by magnitude (length) and direction (angle)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "instruction_station",
              "type": "predicate",
              "augmentation": "introduction_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_introduction"
          }
        ]
      },
      {
        "id": "step_2_vector_addition",
        "instruction": {
          "title": "Vector Addition: Tip-to-Tail Method",
          "description": "Two vectors can be added graphically by placing the tail of the second vector at the tip of the first vector. The resultant vector is drawn from the tail of the first vector to the tip of the second. Observe the diagram on the Vector Board to see how Vector A and Vector B combine to produce a resultant vector with a new magnitude and direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_addition_diagram",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_operations_audio"
            },
            {
              "target": "analysis_grid",
              "type": "predicate",
              "augmentation": "vector_magnitude_direction_label",
              "text": "Resultant = Vector A + Vector B (tip-to-tail)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_addition_diagram"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_operations_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_vector_addition"
          }
        ]
      },
      {
        "id": "step_3_vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition: Breaking into Components",
          "description": "Any vector can be decomposed into horizontal (x) and vertical (y) components along perpendicular axes. Using right-triangle trigonometry, the horizontal component equals magnitude \u00d7 cos(angle), and the vertical component equals magnitude \u00d7 sin(angle). The original vector can be reconstructed from these components using the Pythagorean theorem."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_decomposition_diagram",
              "poi": "default"
            },
            {
              "target": "analysis_grid",
              "type": "predicate",
              "augmentation": "projectile_velocity_components_label",
              "text": "v_x = v \u00d7 cos(\u03b8)   |   v_y = v \u00d7 sin(\u03b8)"
            },
            {
              "target": "analysis_grid",
              "type": "predicate",
              "augmentation": "vector_operations_audio"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_decomposition_diagram"
            },
            {
              "target": "analysis_grid",
              "type": "predicate",
              "augmentation": "vector_operations_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_vector_decomposition"
          }
        ]
      },
      {
        "id": "step_4_projectile_independence",
        "instruction": {
          "title": "Independence of Horizontal and Vertical Motion",
          "description": "A projectile's motion can be analyzed as two independent one-dimensional motions: horizontal motion (constant velocity, no acceleration) and vertical motion (uniformly accelerated by gravity). The horizontal component of velocity remains constant throughout flight because gravity acts only vertically. The vertical component changes steadily: decreasing during ascent, becoming zero at maximum height, then increasing downward during descent. This separation into independent components is the key insight for understanding projectile trajectories."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "independence_of_motion_audio"
            },
            {
              "target": "trajectory_display",
              "type": "predicate",
              "augmentation": "projectile_trajectory_animation",
              "poi": "default"
            },
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "projectile_velocity_components_label",
              "text": "Horizontal: constant velocity   |   Vertical: uniformly accelerated"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "trajectory_display",
              "type": "predicate",
              "augmentation": "projectile_trajectory_animation"
            },
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "independence_of_motion_audio"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_projectile_independence"
          }
        ]
      },
      {
        "id": "step_5_trajectory_analysis",
        "instruction": {
          "title": "Trajectory, Range, and Maximum Height",
          "description": "The parabolic trajectory of a projectile emerges from the combination of constant horizontal velocity and uniformly accelerated vertical motion. The range (horizontal distance traveled) and maximum height depend on the initial launch angle and speed. For a given speed, the launch angle of 45\u00b0 produces the maximum range. At the angle that gives maximum height, the vertical velocity at the apex is zero. Observe how changing the launch angle and initial speed affects the trajectory, range, and maximum height in the visualization."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_display",
              "type": "predicate",
              "augmentation": "trajectory_comparison_video",
              "poi": "default"
            },
            {
              "target": "trajectory_display",
              "type": "predicate",
              "augmentation": "range_height_diagram",
              "poi": "landing_point"
            },
            {
              "target": "trajectory_display",
              "type": "predicate",
              "augmentation": "projectile_velocity_components_label",
              "poi": "apex_marker",
              "text": "At maximum height: v_y = 0"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "trajectory_display",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trajectory_display"
          }
        ]
      }
    ]
  }
