  "activity": {
    "id": "retrograde_motion_activity",
    "name": "Apparent Retrograde Motion of Mars and Outer Planets",
    "description": "A comprehensive AR lab exploring why outer planets like Mars appear to periodically reverse direction in the night sky. Students observe retrograde motion from Earth's surface, learn the geocentric epicycle explanation, examine the heliocentric model, compare perspectives, and investigate retrograde loops of multiple planets. Through these activities, students develop deep understanding of why the heliocentric model is superior in explaining planetary motion.",
    "workplace": "retrograde_lab_workplace",
    "start": "step1_night_sky_observation",
    "actions": [
      {
        "id": "step1_night_sky_observation",
        "instruction": {
          "title": "Night Sky Observation: Mars's Retrograde Loop",
          "description": "Stand on virtual Earth at night and observe Mars against the background constellations (Leo, Virgo, Libra, Scorpio). Watch as time accelerates: Mars drifts slowly eastward for two months, then slows, reverses into a westward loop for about two months, and finally resumes eastward motion. A trail behind Mars marks the complete path. This is the central puzzle of pre-modern astronomy: why would a planet move backward?"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_retrograde",
              "type": "predicate",
              "augmentation": "mars_retrograde_trail",
              "poi": "default"
            },
            {
              "target": "mars_retrograde",
              "type": "predicate",
              "augmentation": "retrograde_narration",
              "poi": "default"
            },
            {
              "target": "ecliptic_zone",
              "type": "predicate",
              "augmentation": "epicycle_label",
              "poi": "leo_region",
              "text": "Leo"
            },
            {
              "target": "ecliptic_zone",
              "type": "predicate",
              "augmentation": "deferent_label",
              "poi": "virgo_region",
              "text": "Virgo"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_advance"
          }
        ]
      },
      {
        "id": "step2_geocentric_explanation",
        "instruction": {
          "title": "The Geocentric Model: Epicycles",
          "description": "Earth sits at the center. Mars rides on a small circle (the epicycle) that itself orbits on a larger circle (the deferent) centered on Earth. Watch the machinery run: when Mars reaches the inner part of its epicycle\u2014the side closest to Earth\u2014its combined motion makes it appear to move backward. This model produces the observed loop, but requires increasingly complex tuning and stacked epicycles as observational data improved."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "geocentric_epicycle_model",
              "type": "predicate",
              "augmentation": "geocentric_epicycle_animation",
              "poi": "default"
            },
            {
              "target": "geocentric_epicycle_model",
              "type": "predicate",
              "augmentation": "epicycle_label",
              "poi": "epicycle_point",
              "text": "Epicycle"
            },
            {
              "target": "geocentric_epicycle_model",
              "type": "predicate",
              "augmentation": "deferent_label",
              "poi": "deferent_point",
              "text": "Deferent"
            },
            {
              "target": "geocentric_epicycle_model",
              "type": "predicate",
              "augmentation": "geocentric_explanation_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_advance"
          }
        ]
      },
      {
        "id": "step3_heliocentric_model",
        "instruction": {
          "title": "The Heliocentric Model: Smooth Orbits",
          "description": "Viewpoint lifts above the ecliptic plane. The Sun sits at the center; Earth orbits at 1 AU with a one-year period, and Mars orbits at 1.52 AU with a 1.88-year period. Watch the two planets run their orbits at correct relative speeds. Every 26 months Earth catches up to and overtakes Mars. Replay the retrograde event from this outside vantage point: see Earth swing past Mars on its inner, faster orbit. No epicycles needed\u2014just two smooth ellipses."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_solar_system",
              "type": "predicate",
              "augmentation": "heliocentric_orbit_animation",
              "poi": "default"
            },
            {
              "target": "heliocentric_solar_system",
              "type": "predicate",
              "augmentation": "epicycle_label",
              "poi": "sun_center",
              "text": "Sun"
            },
            {
              "target": "heliocentric_solar_system",
              "type": "predicate",
              "augmentation": "deferent_label",
              "poi": "earth_position",
              "text": "Earth (1 AU)"
            },
            {
              "target": "heliocentric_solar_system",
              "type": "predicate",
              "augmentation": "heliocentric_explanation_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_advance"
          }
        ]
      },
      {
        "id": "step4_linking_perspectives",
        "instruction": {
          "title": "Linking the Two Perspectives",
          "description": "A side-by-side view shows both the heliocentric model (left) and Earth's night sky (right) simultaneously. A line is drawn from Earth through Mars and extended to the starfield. Watch this line-of-sight sweep eastward during Mars's normal motion. As Earth begins to overtake Mars, the line reverses and sweeps westward\u2014at that moment, Mars's apparent position retraces its path in the night-sky view. After Earth passes Mars, the line resumes its eastward sweep. The retrograde loop is real apparent motion, not an illusion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dual_perspective_scene",
              "type": "predicate",
              "augmentation": "line_of_sight_animation",
              "poi": "heliocentric_panel"
            },
            {
              "target": "dual_perspective_scene",
              "type": "predicate",
              "augmentation": "line_of_sight_animation",
              "poi": "night_sky_panel"
            },
            {
              "target": "dual_perspective_scene",
              "type": "predicate",
              "augmentation": "dual_perspective_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_advance"
          }
        ]
      },
      {
        "id": "step5_planet_comparison",
        "instruction": {
          "title": "Comparing Retrograde Loops: Mars, Jupiter, and Saturn",
          "description": "The heliocentric view returns, now showing Earth, Mars (at 1.52 AU), Jupiter (at 5.2 AU), and Saturn (at 9.5 AU). Observe a retrograde event for each planet: Mars's loop is about 15 degrees across, Jupiter's about 10 degrees, and Saturn's about 7 degrees. More distant planets show smaller loops because Earth's orbital motion subtends a smaller angle when viewed from farther away\u2014the same parallax-style geometry that makes nearby objects shift more than distant ones when you move your head."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "comparison_planets",
              "type": "predicate",
              "augmentation": "heliocentric_orbit_animation",
              "poi": "default"
            },
            {
              "target": "comparison_planets",
              "type": "predicate",
              "augmentation": "mars_retrograde_loop_diagram",
              "poi": "mars_comparison"
            },
            {
              "target": "comparison_planets",
              "type": "predicate",
              "augmentation": "jupiter_retrograde_loop_diagram",
              "poi": "jupiter_comparison"
            },
            {
              "target": "comparison_planets",
              "type": "predicate",
              "augmentation": "saturn_retrograde_loop_diagram",
              "poi": "saturn_comparison"
            },
            {
              "target": "comparison_planets",
              "type": "predicate",
              "augmentation": "planet_comparison_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_advance"
          }
        ]
      },
      {
        "id": "step6_concept_summary",
        "instruction": {
          "title": "Concept Summary: Five Pillars of Retrograde Motion",
          "description": "Review the five concept areas covered in this lab: (1) The observed phenomenon\u2014Mars's retrograde loop across the constellations; (2) The geocentric explanation with epicycles\u2014complex but explains the loop; (3) The heliocentric resolution\u2014simpler, no epicycles needed; (4) The linkage between perspectives\u2014how the geometry produces the apparent motion; and (5) Comparison across outer planets\u2014why distant planets show smaller loops. Retrograde motion is the central puzzle that drove the shift from geocentrism to heliocentrism."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_retrograde",
              "type": "predicate",
              "augmentation": "summary_recap_video",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6_end"
          }
        ]
      }
    ]
  }
