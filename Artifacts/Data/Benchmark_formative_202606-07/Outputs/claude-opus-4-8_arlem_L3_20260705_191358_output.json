      },
      {
        "id": "action_heliocentric",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens_01",
        "location": "place_orrery_table",
        "predicate": "pred_heliocentric_orbits",
        "instruction": {
          "title": "Step Outside the Solar System",
          "description": "Now view the same event from OUTSIDE the solar system on the orrery table. Place the Sun, Earth, and Mars models on the table. Earth moves faster on its inner orbit and OVERTAKES the slower Mars. The loop is just an illusion of relative motion \u2014 like passing a slower car that seems to drift backward. Detect the models to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits",
              "poi": "poi_orbit_plane",
              "viewport": "reactions"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_label_east",
              "poi": "poi_top",
              "text": "Earth (inner, faster)"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_west",
              "poi": "poi_top",
              "text": "Mars (outer, slower)"
            },
            {
              "target": "place_orrery_table",
              "type": "primitive",
              "augmentation": "video",
              "poi": "poi_outside_view",
              "url": "https://assets.example.com/video/passing_car_analogy.mp4",
              "viewport": "reactions"
            },
