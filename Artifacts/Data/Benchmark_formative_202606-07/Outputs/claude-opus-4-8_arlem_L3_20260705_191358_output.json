  "activity": {
    "id": "act_retrograde_motion",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A hands-on AR lab in which non-majors observe a Mars retrograde episode from Earth's surface, then step outside the solar system to see that the loop is produced by Earth overtaking Mars. Students contrast geocentric and heliocentric explanations, predict when retrograde occurs, and compare the loops of Mars, Jupiter, and Saturn.",
    "language": "en",
    "workplace": "wp_retrograde_motion",
    "start": "action_intro_sky",
    "actions": [
      {
        "id": "action_intro_sky",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "place_sky_dome",
        "predicate": "pred_eastward_drift",
        "instruction": {
          "title": "Watch Mars Drift Eastward",
          "description": "Look up at the night sky dome. Over several weeks, Mars normally drifts slowly EASTWARD against the background constellations. Watch the animated path and note the direction of its normal motion. When you are ready, say 'next' or tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_sky_dome",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/img/constellation_backdrop.png"
            },
            {
              "target": "place_sky_dome",
              "type": "predicate",
              "augmentation": "pred_eastward_drift",
              "poi": "poi_ecliptic_east"
            },
            {
              "target": "place_sky_dome",
              "type": "predicate",
              "augmentation": "pred_label_east",
              "poi": "poi_ecliptic_east",
              "text": "Normal motion: EASTWARD"
            },
            {
              "target": "place_sky_dome",
              "type": "predicate",
              "augmentation": "pred_narration_intro"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_sky_dome",
              "augmentation": "pred_eastward_drift"
            },
            {
              "target": "place_sky_dome",
              "augmentation": "pred_narration_intro"
            },
            {
              "target": "place_sky_dome",
              "augmentation": "pred_label_east"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "action_observe_loop",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_observe_loop",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_observe_loop",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "place_sky_dome",
        "predicate": "pred_mars_retrograde_path",
        "instruction": {
          "title": "The Westward Loop",
          "description": "Now speed up time. Roughly every 26 months Mars slows, reverses into a WESTWARD loop for about two months, then resumes eastward motion. Trace the full loop against the stars. Notice the eastward drift, the westward reversal, and the return. Tap Continue when you have followed the whole path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_sky_dome",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_path",
              "poi": "poi_loop_center"
            },
            {
              "target": "place_sky_dome",
              "type": "predicate",
              "augmentation": "pred_label_west",
              "poi": "poi_ecliptic_west",
              "text": "Retrograde: WESTWARD loop"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_east",
              "poi": "poi_top",
              "text": "Mars"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_sky_dome",
              "augmentation": "pred_mars_retrograde_path"
            },
            {
              "target": "place_sky_dome",
              "augmentation": "pred_label_west"
            },
            {
              "target": "thing_mars",
              "augmentation": "*"
            },
            {
              "target": "place_sky_dome",
              "augmentation": "image"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "action_geocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_geocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_geocentric",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens_01",
        "location": "place_orrery_table",
        "predicate": "pred_geocentric_epicycle",
        "instruction": {
          "title": "The Geocentric Puzzle",
          "description": "How did ancient astronomers explain the loop? In the GEOCENTRIC model, Earth sits at the center and Mars must ride a small circle (an epicycle) on top of its main circle just to produce the loop. Watch how awkward this machinery is. Say 'next' to see a simpler explanation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_orrery_table",
              "type": "predicate",
              "augmentation": "pred_geocentric_epicycle",
              "poi": "default",
              "viewport": "reactions"
            },
            {
              "target": "place_orrery_table",
              "type": "predicate",
              "augmentation": "pred_label_west",
              "poi": "poi_outside_view",
              "text": "Geocentric: epicycles required"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
