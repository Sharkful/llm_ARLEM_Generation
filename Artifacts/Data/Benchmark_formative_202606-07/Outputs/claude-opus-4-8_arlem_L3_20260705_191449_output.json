            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "step_antiparallel",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_antiparallel",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_assembly_bench",
        "predicate": "pred_narration_antiparallel",
        "instruction": {
          "title": "4. Antiparallel Orientation & 5'-to-3' Directionality",
          "description": "Directional arrows now trace each backbone. One strand runs 5' to 3' while its partner runs 3' to 5' \u2014 the strands are antiparallel. This directionality of the sugar-phosphate backbone is what forces the two strands to run in opposite directions. Tap Continue when you can point to each 5' and 3' end."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_antiparallel_arrows",
              "poi": "helix_axis"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_narration_antiparallel"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "backbone_left",
              "text": "5' end"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "backbone_right",
              "text": "3' end"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_enzymes",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_enzymes",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_replication_zone",
        "predicate": "pred_narration_enzymes",
        "instruction": {
          "title": "5. Enzymes at the Replication Fork",
          "description": "Move to the Replication Fork Zone and detect the Enzyme Set. Watch as helicase unwinds the helix, single-strand binding proteins stabilize the exposed strands, and DNA polymerase synthesizes new strands 5' to 3'. The leading strand is made continuously; the lagging strand is made in Okazaki fragments that DNA ligase joins. Detect the enzyme kit to play the animation, then continue."
        },
        "enter": {
          "remove_self": false,
