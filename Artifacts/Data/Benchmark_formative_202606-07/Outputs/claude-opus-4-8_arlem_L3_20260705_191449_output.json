      {
        "id": "step_semiconservative",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_replication_zone",
        "predicate": "pred_narration_semicon",
        "instruction": {
          "title": "6. Why Replication Is Semiconservative",
          "description": "The final animation splits the parental helix into two daughter molecules \u2014 each keeps ONE original parental strand and gains ONE newly-synthesized strand. That is why replication is called semiconservative. Predict: after two rounds of replication, of four molecules, two retain an original strand. Say 'finish' or tap Done to complete the module."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_replication_zone",
              "type": "predicate",
              "augmentation": "pred_semiconservative",
              "poi": "zone_center"
            },
            {
              "target": "place_replication_zone",
              "type": "predicate",
              "augmentation": "pred_narration_semicon"
            },
            {
