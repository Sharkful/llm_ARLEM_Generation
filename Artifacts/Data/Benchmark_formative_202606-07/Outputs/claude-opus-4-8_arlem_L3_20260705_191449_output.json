  "activity": {
    "id": "act_dna_replication",
    "name": "DNA Structure & Semiconservative Replication",
    "description": "A hands-on AR module in which learners examine the DNA double helix, apply complementary base-pairing rules, reason about antiparallel 5'-to-3' directionality, trace the enzymes of the replication fork, and explain why replication is semiconservative. Aligned to introductory molecular biology (200-level) learning objectives.",
    "language": "en",
    "workplace": "wp_dna_replication",
    "start": "step_intro_helix",
    "actions": [
      {
        "id": "step_intro_helix",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_assembly_bench",
        "predicate": "pred_narration_intro",
        "instruction": {
          "title": "1. Meet the Double Helix",
          "description": "Look at the 3D DNA model on the Assembly Bench. Notice the two sugar-phosphate backbones spiraling around a common central axis with nitrogenous bases projecting inward. Rotate your view to appreciate the helical geometry, then tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_helix_spin",
              "poi": "helix_axis"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_narration_intro"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "helix_top",
              "text": "Double Helix: two backbones + inward bases"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_backbone",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_backbone",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_assembly_bench",
        "predicate": "pred_backbone_highlight",
        "instruction": {
          "title": "2. Identify the Sugar-Phosphate Backbones",
          "description": "The two highlighted outer strands are the sugar-phosphate backbones \u2014 the structural rails of DNA. The four bases (A, T, G, C) attach to these backbones and point toward the center. Say 'next' or tap Continue when you can locate both backbones."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_backbone_highlight",
              "poi": "helix_axis"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "backbone_left",
              "text": "Sugar-phosphate backbone (strand 1)"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_label_backbone",
              "poi": "backbone_right",
              "text": "Sugar-phosphate backbone (strand 2)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_basepairing",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_basepairing",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_basepairing",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_assembly_bench",
        "predicate": "pred_narration_pairing",
        "instruction": {
          "title": "3. Apply Base-Pairing Rules",
          "description": "Bring the Base-Pair Tiles into view. Adenine pairs with Thymine via TWO hydrogen bonds; Guanine pairs with Cytosine via THREE hydrogen bonds. Given one strand 5'-ATGC-3', its complement must be 3'-TACG-5'. Detect the base-pair tile marker to confirm you understand, then continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_basepair_AT",
              "poi": "base_slot_upper"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_basepair_GC",
              "poi": "base_slot_lower"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_hbond_pulse",
              "poi": "hbond_gap"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_narration_pairing"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_label_base",
              "poi": "base_slot_upper",
              "text": "A = T (2 H-bonds)"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_label_base",
              "poi": "base_slot_lower",
              "text": "G \u2261 C (3 H-bonds)"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
