  "activity": {
    "id": "act_heart_circulation",
    "name": "The Human Heart: Structure and the Path of Blood Flow",
    "description": "A five-part hands-on AR lab for Human Anatomy and Physiology I. Students orient to a 3D heart model, identify the four chambers, the four valves, and the major vessels, then trace the dual-loop circulation and reason about why the left ventricle wall is thicker than the right. Augmentations label structures, animate blood flow, and compare myocardial wall thickness so learners connect structure to function.",
    "language": "en",
    "workplace": "wp_heart_anatomy",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection",
        "instruction": {
          "title": "1. Orient to the Heart Model",
          "description": "Welcome to the cardiac anatomy lab. Look at the 3D heart model on the dissection anchor until it is tracked. Note the orientation: the apex points down and to the patient's left. The right side of the heart faces you on the model's anatomical right. When you are ready, say 'next' or tap Continue to begin identifying the chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_chambers",
              "poi": "default",
              "text": "Human Heart \u2014 anterior view"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection",
        "instruction": {
          "title": "2. Identify the Four Chambers",
          "description": "The heart has four chambers: two upper atria that receive blood and two lower ventricles that pump it out. Read each floating label: RIGHT ATRIUM and RIGHT VENTRICLE handle deoxygenated blood; LEFT ATRIUM and LEFT VENTRICLE handle oxygenated blood. Gaze at each highlighted chamber, then tap Continue to study the valves."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_narration_chambers",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_highlight_chambers",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_chambers",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_chambers",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_chambers",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_chambers",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
