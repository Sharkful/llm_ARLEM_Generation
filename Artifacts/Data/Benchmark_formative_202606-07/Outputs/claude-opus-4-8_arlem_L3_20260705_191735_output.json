      {
        "id": "step_bloodflow",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_review",
        "instruction": {
          "title": "4. Trace the Path of Blood (Dual Circulation)",
          "description": "Follow the animated blood flow on the pump model. PULMONARY CIRCUIT: deoxygenated blood enters the right atrium (from the vena cavae) \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary arteries \u2192 lungs. SYSTEMIC CIRCUIT: oxygenated blood returns via the pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta \u2192 body. Aim the pointer at the pulmonary loop, then the systemic loop, and detect the circulation chart to confirm the order. Tap Continue when you can recite the full path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_pump_model",
              "type": "predicate",
              "augmentation": "pred_narration_flow",
              "poi": "default"
            },
            {
