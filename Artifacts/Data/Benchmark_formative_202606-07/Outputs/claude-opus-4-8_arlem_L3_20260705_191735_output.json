              "type": "predicate",
              "augmentation": "pred_label_vessels",
              "poi": "default",
              "text": "RA \u2192 tricuspid \u2192 RV \u2192 pulmonary valve \u2192 lungs \u2192 LA \u2192 mitral \u2192 LV \u2192 aortic valve \u2192 aorta"
            },
