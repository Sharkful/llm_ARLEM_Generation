        ]
      },
      {
        "id": "step_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_dissection",
        "instruction": {
          "title": "3. Identify the Four Valves and Major Vessels",
          "description": "Valves keep blood moving in one direction. The two atrioventricular valves \u2014 TRICUSPID (right) and MITRAL/BICUSPID (left) \u2014 sit between the atria and ventricles. The two semilunar valves \u2014 PULMONARY and AORTIC \u2014 guard the exits into the great vessels. Trace the vessels too: superior and inferior vena cava return blood to the right atrium; the pulmonary arteries carry blood to the lungs; the pulmonary veins return it; the aorta carries it to the body. Watch the valves open and close, then tap Continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_narration_valves",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_highlight_valves",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_valve_backflow_anim",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_valves",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_valves",
              "poi": "poi_mitral",
              "text": "Mitral / Bicuspid Valve (AV)"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_valves",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve (semilunar)"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_valves",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve (semilunar)"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessels",
