          }
        ]
      },
      {
        "id": "step_optimize_range",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_01",
        "location": "launch_pad",
        "instruction": {
          "title": "6. Angle, Speed, Range & Height",
          "description": "Turn the Launch Speed Dial and adjust the launcher angle. Compare trajectories: higher speed extends range and height; steeper angles raise maximum height but shorten range for a fixed speed. Find that a 45-degree launch angle produces the maximum range on level ground. Detect the speed dial to run the comparison and complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "launch_pad",
              "type": "predicate",
              "augmentation": "range_comparison_anim",
              "poi": "default"
            },
            {
              "target": "speed_dial",
              "type": "predicate",
              "augmentation": "info_label",
              "poi": "readout",
              "text": "Try angles 30, 45, 60 - which gives max range?"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "parabola_trajectory",
              "poi": "landing"
            },
            {
              "target": "launcher_tool",
              "type": "predicate",
              "augmentation": "info_label",
              "poi": "angle_readout",
              "text": "45 deg = maximum range for a given speed"
            }
          ],
          "deactivate": [],
