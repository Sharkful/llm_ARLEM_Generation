          }
        ]
      },
      {
        "id": "action_compare_real",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_compare_zone",
        "predicate": "pred_water_molecule",
        "instruction": {
          "title": "Step 5: Test VSEPR Against Real Molecules",
          "description": "Move to the Comparison Zone. Here your VSEPR predictions meet reality: water (bent), ammonia (trigonal pyramidal), methane (tetrahedral), PF5 (trigonal bipyramidal), SF6 (octahedral), and XeF4 (square planar). Rotate each 3D molecule and confirm its measured geometry matches the shape you predicted from its steric number and lone pairs. Say or tap 'Finish' to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_compare_zone",
              "type": "predicate",
              "augmentation": "pred_water_molecule",
              "poi": "shelf"
            },
            {
              "target": "place_compare_zone",
              "type": "predicate",
              "augmentation": "pred_methane_molecule",
              "poi": "default"
            },
            {
              "target": "place_compare_zone",
              "type": "predicate",
              "augmentation": "pred_angle_label",
              "poi": "shelf",
              "text": "Predicted shape == Observed structure"
            }
          ],
