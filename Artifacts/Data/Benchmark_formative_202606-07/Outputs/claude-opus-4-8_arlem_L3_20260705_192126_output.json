  "activity": {
    "id": "act_vsepr",
    "name": "Predicting Molecular Shape with VSEPR Theory",
    "description": "A hands-on AR lab for General Chemistry I students. Beginning from a Lewis structure, learners count electron domains to determine steric number, predict the electron-domain geometry, distinguish it from molecular geometry when lone pairs are present, explain lone-pair repulsion effects on bond angles, and finally validate their VSEPR predictions against the real experimentally observed structures of water, ammonia, methane, PF5, SF6, and XeF4.",
    "language": "en",
    "workplace": "wp_vsepr_lab",
    "start": "action_intro",
    "actions": [
      {
        "id": "action_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_narration_intro",
        "instruction": {
          "title": "Welcome to the VSEPR Lab",
          "description": "The shape of a molecule is set by a simple idea: electron pairs (domains) around a central atom push apart to get as far from one another as possible. In this lab you will start from a Lewis structure and predict a molecule's 3D geometry. Place the Central Atom Model in the Build Zone, then say or tap 'Start' to begin."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "center"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "top",
              "text": "Central Atom"
            }
          ],
          "deactivate": [],
          "messages": [
            {
              "target": "person_learner",
              "type": "person",
              "text": "Welcome! Place the central atom in the build zone to begin.",
              "viewport": "actions"
            }
          ],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_build_zone",
              "type": "*"
            },
            {
              "target": "thing_central_atom",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_count_domains",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_count_domains",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_steric_number_label",
        "instruction": {
          "title": "Step 1: Count Domains, Find the Steric Number",
          "description": "Look at the Lewis structure card for water (H2O). Count the electron domains on the central oxygen: each bond (single, double, or triple) counts as ONE domain, and each lone pair counts as one domain. Oxygen has 2 bonding pairs + 2 lone pairs = steric number 4. Tap 'Next' once you can read the steric number from the structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_lewis_card",
              "type": "predicate",
              "augmentation": "pred_lewis_water",
              "poi": "default"
            },
            {
              "target": "thing_lewis_card",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "label_spot",
              "text": "Steric Number = 4 (2 bonds + 2 lone pairs)"
            },
            {
              "target": "thing_lewis_card",
              "type": "predicate",
              "augmentation": "pred_pointer",
              "poi": "label_spot",
              "option": "down"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_card",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_electron_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_electron_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_electron_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_electron_geometry_anim",
        "instruction": {
          "title": "Step 2: Predict the Electron-Domain Geometry",
          "description": "The steric number maps directly to one of five electron-domain geometries: 2=linear, 3=trigonal planar, 4=tetrahedral, 5=trigonal bipyramidal, 6=octahedral. Watch the four domains around oxygen repel and settle into a tetrahedral arrangement (ideal 109.5 degrees). Attach the Electron Domain Balloons to the central atom, then tap 'Next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_electron_geometry_anim",
              "poi": "default",
              "state": "tetrahedral"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "top",
              "text": "Electron Geometry: Tetrahedral (109.5 deg)"
            },
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_five_geometries_video",
              "viewport": "reactions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "type": "*"
            },
            {
              "target": "place_build_zone",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_molecular_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_molecular_geometry",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_molecular_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_lone_pair_anim",
        "instruction": {
          "title": "Step 3: Electron Geometry vs. Molecular Geometry",
          "description": "Molecular geometry describes only the positions of the ATOMS, not the invisible lone pairs. Water's electron geometry is tetrahedral, but with 2 lone pairs the two hydrogen atoms describe a BENT shape. Watch the lone pairs fade to reveal the molecular shape. Detect the water molecule model to confirm, or tap 'Next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_lone_pair_anim",
              "poi": "default",
              "state": "reveal_bent"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_steric_number_label",
              "poi": "top",
              "text": "Molecular Geometry: Bent"
            },
            {
              "target": "thing_electron_domains",
              "type": "predicate",
              "augmentation": "pred_pointer",
              "poi": "apex",
              "option": "down"
            }
          ],
          "deactivate": [],
          "messages": [
            {
              "target": "person_learner",
              "type": "person",
              "text": "Two lone pairs remain invisible - the atoms alone define a BENT shape.",
              "viewport": "actions"
            }
          ],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "type": "*"
            },
            {
              "target": "thing_electron_domains",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_central_atom",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "action_lone_pair_angles",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "action_lone_pair_angles",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_lone_pair_angles",
        "viewport": "reactions",
        "type": "reactions",
        "device": "dev_hololens",
        "location": "place_build_zone",
        "predicate": "pred_narration_lonepair",
        "instruction": {
          "title": "Step 4: Why Lone Pairs Bend the Angles",
          "description": "A lone pair is held by only one nucleus, so its electron cloud spreads wider and pushes harder than a bonding pair. This extra repulsion squeezes the bonding pairs closer together. That is why water's H-O-H angle is 104.5 degrees instead of the ideal 109.5 degrees found in methane, where all four domains are identical bonds. Compare the two side by side, then tap 'Next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_bond_angle_image",
              "poi": "center"
            },
            {
              "target": "place_build_zone",
              "type": "predicate",
              "augmentation": "pred_narration_lonepair",
              "poi": "center"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "pred_angle_label",
              "poi": "top",
              "text": "Water 104.5 deg  <  Methane 109.5 deg"
            }
          ],
          "deactivate": [],
          "messages": [
            {
              "target": "person_learner",
              "type": "person",
              "text": "Lone pairs occupy more angular space, shrinking bond angles below the ideal value.",
              "viewport": "reactions"
            }
          ],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_build_zone",
              "type": "*"
            },
            {
              "target": "thing_central_atom",
              "type": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
