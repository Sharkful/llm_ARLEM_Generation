            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_linkage",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_linkage",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_solar_platform",
        "instruction": {
          "title": "4. Linking the Two Perspectives",
          "description": "A side-by-side view shows the heliocentric model and Earth's night sky together. A line drawn from Earth through Mars extends to the background stars. Watch it sweep eastward during Mars's normal motion; then, as Earth overtakes Mars, the line reverses and sweeps westward, and in the sky view Mars retraces its path. After Earth passes, the sweep resumes eastward. The loop is a real apparent motion from geometry, not an illusion. Click or say 'next' to try it yourself."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_solar_system",
              "type": "predicate",
              "augmentation": "pred_narration_linkage"
            },
