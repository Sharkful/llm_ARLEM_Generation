        "type": "actions",
        "device": "dev_hololens",
        "location": "place_orbit_walk",
        "instruction": {
          "title": "5. Walk the Orbit: Embody the Effect",
          "description": "Stand at the center of the starfield with a stationary virtual Mars several feet in front of you. Walk slowly around the small circle on the floor representing Earth's orbit, keeping your gaze on Mars against the distant stars. As you move, Mars's apparent position drifts across the constellations. When you pass the point of closest approach, Mars appears to move backward, retrograde produced by your own motion. Complete a full loop, then say or click 'next'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
