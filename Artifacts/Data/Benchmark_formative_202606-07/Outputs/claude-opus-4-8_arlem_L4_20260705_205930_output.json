      {
        "id": "step_circuits",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_study_bench",
        "instruction": {
          "title": "Scene 3 \u2014 Dual-Circuit Color-Coded Blood Flow",
          "description": "The cutaway chambers and vessels fill with flowing color: blue marks deoxygenated blood (right heart, pulmonary arteries) and red marks oxygenated blood (left heart, pulmonary veins). The pulmonary circuit highlights first (heart \u2192 lungs \u2192 heart), then the systemic circuit (heart \u2192 body \u2192 heart). Observe how the right side serves the lungs and the left side serves the body. Click 'next' to begin the red blood cell trace."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_narration_circuits"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_bloodflow_blue",
              "poi": "poi_right_ventricle"
            },
            {
