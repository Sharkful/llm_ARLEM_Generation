  "activity": {
    "id": "act_heart_circulation",
    "name": "The Human Heart & the Path of Blood",
    "description": "A guided AR lab for Human Anatomy & Physiology I. Learners explore the exterior and cutaway anatomy of the heart, identify the four chambers, four valves, and major vessels, trace a red blood cell through the pulmonary and systemic circuits, compare left vs. right ventricular wall thickness, examine valve function, and complete identification and blood-flow quizzes before a closing recap.",
    "language": "en",
    "workplace": "wp_heart_anatomy",
    "start": "step_orientation",
    "actions": [
      {
        "id": "step_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_study_bench",
        "instruction": {
          "title": "Scene 1 \u2014 Gross Orientation of the Heart",
          "description": "Two full-size hearts appear side by side: an intact model on the left showing the exterior and great vessels, and a cutaway model on the right exposing the chambers and valves. Note the apex points down and slightly left. Remember that right and left are described from the patient's perspective, so they appear reversed to you. Rotate the models to view from any angle, then say or click 'next' to begin the structural tour."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_narration_orientation"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_highlight_glow",
              "poi": "default"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_highlight_glow",
              "poi": "default"
            },
            {
              "target": "thing_intact_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Intact Heart \u2014 Anterior View"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Cutaway Heart \u2014 Anterior Wall Removed"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_intact_heart",
              "augmentation": "*"
            },
            {
              "target": "thing_cutaway_heart",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_tour",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_tour",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_tour",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_study_bench",
        "instruction": {
          "title": "Scene 2 \u2014 Guided Structural Tour",
          "description": "Working with the cutaway view, each structure is highlighted and labeled in sequence: the four chambers (right atrium, right ventricle, left atrium, left ventricle), the four valves (tricuspid, pulmonary, mitral/bicuspid, aortic), and the major vessels (superior & inferior vena cava, pulmonary arteries, pulmonary veins, aorta). Watch the matching landmark glow on the intact heart. Note the mitral valve is also called the bicuspid valve. Click 'next' when the tour completes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_narration_tour"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve (RA \u2192 RV)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve (RV \u2192 Pulmonary Trunk)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mitral",
              "text": "Mitral / Bicuspid Valve (LA \u2192 LV)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve (LV \u2192 Aorta)"
            },
            {
              "target": "thing_intact_heart",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "thing_intact_heart",
              "type": "primitive",
              "augmentation": "label",
