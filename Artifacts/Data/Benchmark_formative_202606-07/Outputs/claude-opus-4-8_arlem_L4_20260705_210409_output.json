  "activity": {
    "id": "act_vectors_projectile",
    "name": "Vectors & Two-Dimensional Projectile Motion",
    "description": "A hands-on AR lab for algebra-based General Physics I. Learners first manipulate abstract vectors (a single vector's magnitude and direction, tip-to-tail addition, and component decomposition), then apply vector decomposition to projectile motion: observing the independence of horizontal and vertical motion, discovering the 45-degree maximum-range result, completing a targeting challenge, and exploring a free sandbox before a closing recap.",
    "language": "en",
    "workplace": "wp_vectors_projectile",
    "start": "step_intro_vectors",
    "actions": [
      {
        "id": "step_intro_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_vector_workspace",
        "instruction": {
          "title": "1. What Is a Vector?",
          "description": "A single arrow floats at the origin with its tail fixed and head extending outward. Grab the arrow's head and drag it in 3D space \u2014 watch the magnitude (length) and direction (angles to the X, Y, Z axes) update in real time. A vector has both a size AND a direction, unlike scalars such as temperature or mass. Walk around it: your viewpoint changes, but the vector does not. Say or click 'Next' when ready."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_workspace",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/images/xyz_axes_reference.png"
            },
            {
              "target": "thing_axes_frame",
              "type": "predicate",
              "augmentation": "img_axes_reference",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "anim_single_vector",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "label_magnitude",
              "poi": "head",
              "text": "Magnitude: 36.1 units"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "label_direction",
              "poi": "midshaft",
              "text": "Direction: 56 deg from X, 34 deg from Y"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "narr_intro_vectors",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_arrow",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "narr_intro_vectors"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_addition",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "step_addition",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_vector_workspace",
        "instruction": {
          "title": "2. Adding Vectors Tip-to-Tail",
          "description": "Two vectors appear: a blue vector from the origin and a green vector placed tip-to-tail at the blue vector's head. A red resultant is drawn from the origin to the green vector's head. Grab and reorient either the blue or green arrow \u2014 the resultant updates continuously. Now swap their order (green first, then blue) and confirm the resultant points to the same place: vector addition is commutative. Click 'Next' to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_axes_frame",
              "type": "predicate",
              "augmentation": "img_axes_reference",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "anim_tip_to_tail",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "label_direction",
              "poi": "label_slot",
              "text": "Resultant R = A + B = B + A"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "narr_addition",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_arrow",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "label_direction"
            },
            {
