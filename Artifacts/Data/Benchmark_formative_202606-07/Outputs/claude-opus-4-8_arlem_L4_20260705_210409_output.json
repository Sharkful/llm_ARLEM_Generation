          }
        ]
      },
      {
        "id": "step_decomposition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_vector_workspace",
        "instruction": {
          "title": "3. Decomposition = Addition Reversed",
          "description": "A single neutral vector appears. Three component arrows emerge from the origin \u2014 X (red), Y (green), Z (blue) \u2014 laid tip-to-tail so they add back to the original. Grab and resize each component along its axis; the original vector updates to the new sum. This is decomposition: breaking a vector into pieces along chosen axes. The components and magnitude form a right triangle (Pythagorean theorem). Click 'Next' to move on to projectiles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_axes_frame",
              "type": "predicate",
              "augmentation": "img_axes_reference",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "anim_decomposition",
              "poi": "default"
            },
            {
              "target": "thing_axes_frame",
              "type": "predicate",
              "augmentation": "label_component_x",
              "poi": "x_tip",
              "text": "Vx = 20"
            },
            {
              "target": "thing_axes_frame",
              "type": "predicate",
              "augmentation": "label_component_y",
              "poi": "y_tip",
              "text": "Vy = 30"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "img_right_triangle",
              "poi": "label_slot"
            },
            {
              "target": "person_learner",
              "type": "predicate",
              "augmentation": "narr_decomposition",
              "poi": "default"
            }
          ],
          "deactivate": [],
