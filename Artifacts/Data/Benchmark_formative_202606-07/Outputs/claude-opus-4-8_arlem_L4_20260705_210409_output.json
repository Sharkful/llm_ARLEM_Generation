      {
        "id": "step_transition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens",
        "location": "place_projectile_plane",
        "instruction": {
          "title": "4. From Vectors to Projectiles",
          "description": "The 3D workspace gives way to a 2D vertical plane with labeled horizontal and vertical axes. Because gravity acts only downward and no horizontal force acts, the whole motion stays in one vertical plane containing the initial velocity \u2014 so this is genuinely a 2D problem. A ball rests at the launch point on the left with a velocity vector pointing up and to the right. Look at the ball, then click 'Next' to decompose its velocity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "img_axes_reference",
