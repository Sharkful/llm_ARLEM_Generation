  "activity": {
    "id": "act_dna_structure_replication",
    "name": "The Double Helix and Semiconservative Replication",
    "description": "A six-step AR lab for introductory molecular biology students. Learners first examine the three-dimensional structure of the DNA double helix, identify its sugar-phosphate backbones and nitrogenous bases, apply complementary base-pairing rules, reason about antiparallel 5'-to-3' orientation, and then trace the enzymatic events of semiconservative replication at the replication fork \u2014 including the leading/lagging strand asymmetry and the composition of daughter molecules.",
    "workplace": "wp_dna_structure_replication",
    "start": "step1_explore_helix",
    "actions": [
      {
        "id": "step1_explore_helix",
        "instruction": {
          "title": "1. Explore the Double Helix",
          "description": "Scan the Double Helix marker to bring up the rotating 3D model. Observe the two sugar-phosphate backbones spiraling around a common central axis, with the nitrogenous bases projecting inward. Identify the left and right backbones highlighted on the model. Click Next when you are ready to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_helix_animation",
              "poi": "default",
              "state": "rotate"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_backbone_label",
              "poi": "backbone_left",
              "text": "Sugar-phosphate backbone (strand 1)"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_backbone_label",
              "poi": "backbone_right",
              "text": "Sugar-phosphate backbone (strand 2)"
            },
            {
              "target": "place_info_panel",
              "type": "predicate",
              "augmentation": "pred_narration_intro",
              "poi": "panel_face"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "augmentation": "*"
            },
            {
              "target": "place_info_panel",
              "augmentation": "pred_narration_intro"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_double_helix",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step1_explore_helix"
          }
        ]
      },
      {
        "id": "step2_base_pairing",
        "instruction": {
          "title": "2. Complementary Base Pairing",
          "description": "Scan the Base Pair marker. Watch the animation form hydrogen bonds between paired bases. Note that adenine pairs with thymine via two hydrogen bonds, while guanine pairs with cytosine via three. Use these rules to determine that a template reading 5'-ATGC-3' pairs with 3'-TACG-5'. Click Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_basepair_animation",
              "poi": "hbond_center",
              "state": "form_bonds"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_at_gc_label",
              "poi": "purine_side",
              "text": "Purine (A / G)"
            },
            {
              "target": "thing_base_pair",
              "type": "predicate",
              "augmentation": "pred_at_gc_label",
              "poi": "pyrimidine_side",
              "text": "Pyrimidine (T / C): A=T (2 H-bonds), G\u2261C (3 H-bonds)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_base_pair",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_base_pair",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step2_base_pairing"
          }
        ]
      },
      {
        "id": "step3_antiparallel",
        "instruction": {
          "title": "3. Antiparallel Orientation",
          "description": "Return to the Double Helix model. Study the directionality diagram showing one strand running 5' to 3' and its complement running 3' to 5'. Notice how the directionality of the sugar-phosphate backbone forces the two strands into an antiparallel arrangement. Click Next to move on to replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_antiparallel_image",
              "poi": "axis_top"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_backbone_label",
              "poi": "backbone_left",
              "text": "5' \u2192 3'"
            },
            {
              "target": "thing_double_helix",
              "type": "predicate",
              "augmentation": "pred_backbone_label",
              "poi": "backbone_right",
              "text": "3' \u2190 5'"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_double_helix",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_antiparallel"
          }
        ]
      },
      {
        "id": "step4_replication_fork",
        "instruction": {
          "title": "4. Enzymes at the Replication Fork",
          "description": "Scan the Replication Fork marker. Watch the video: helicase unwinds the double helix at the fork, single-strand binding proteins stabilize the exposed strands, and DNA polymerase synthesizes new DNA using each parental strand as a template. Identify the fork junction and the two template strands. Click Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_replication_video",
              "poi": "fork_junction"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "leading_template",
              "text": "Template strand (leading)"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "lagging_template",
              "text": "Template strand (lagging)"
            },
            {
              "target": "place_info_panel",
              "type": "predicate",
              "augmentation": "pred_narration_replication",
              "poi": "panel_face"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "*"
            },
            {
              "target": "place_info_panel",
              "augmentation": "pred_narration_replication"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_replication_fork",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step4_replication_fork"
          }
        ]
      },
      {
        "id": "step5_leading_lagging",
        "instruction": {
          "title": "5. Leading vs. Lagging Strand",
          "description": "Observe how DNA polymerase, which only extends a strand 5' to 3', synthesizes the leading strand continuously toward the fork, while the lagging strand is built discontinuously as Okazaki fragments that DNA ligase later joins. Relate this asymmetry directly to the antiparallel templates. Click Next to conclude."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_leading_lagging_animation",
              "poi": "fork_junction",
              "state": "synthesize"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "leading_template",
              "text": "Leading strand: continuous 5'\u21923'"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "lagging_template",
              "text": "Lagging strand: Okazaki fragments joined by ligase"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_leading_lagging"
          }
        ]
      },
      {
        "id": "step6_semiconservative",
        "instruction": {
          "title": "6. Semiconservative Replication",
          "description": "In the Model Build Zone, review the summary diagram: each daughter molecule contains one original parental strand and one newly-synthesized strand \u2014 this is why replication is semiconservative. Predict that after one round two hybrid molecules form, and after two rounds four molecules result, two of them fully new. Click Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_model_zone",
              "type": "predicate",
              "augmentation": "pred_semiconservative_image",
              "poi": "center_stage"
            },
            {
              "target": "place_model_zone",
              "type": "predicate",
              "augmentation": "pred_step_label",
              "poi": "center_stage",
              "text": "Each daughter = 1 parental + 1 new strand"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "place_model_zone",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6_semiconservative"
          }
        ]
      }
    ]
  }
