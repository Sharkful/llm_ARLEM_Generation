  "activity": {
    "id": "act_heart_trace",
    "name": "The Human Heart: Chambers, Valves, and the Path of Blood",
    "description": "A guided AR lab for Human Anatomy and Physiology I. Students identify the four chambers, four valves, and major vessels of the heart, then trace deoxygenated and oxygenated blood through the pulmonary and systemic circuits. The lab concludes by comparing right and left ventricular wall thickness to reinforce why the left ventricle must generate higher pressure. Learning objectives: identify cardiac chambers/valves/vessels; trace dual circulation in order; distinguish pulmonary from systemic circuits; explain differential myocardial thickness; and describe valve function in preventing backflow.",
    "workplace": "wp_heart_anatomy",
    "start": "step_chambers",
    "actions": [
      {
        "id": "step_chambers",
        "instruction": {
          "title": "Step 1: Identify the Four Chambers",
          "description": "Point your device at the heart model marker. The heart has four chambers: two upper atria that receive blood, and two lower ventricles that pump it. Locate the right atrium, right ventricle, left atrium, and left ventricle. Note that 'right' and 'left' refer to the patient's own sides. Tap Next when you have identified all four labeled chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_intro_audio",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_chambers_overview",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_ra",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_rv",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_la",
              "poi": "poi_left_atrium",
              "text": "Left Atrium"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_lv",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_chambers"
          }
        ]
      },
      {
        "id": "step_vessels",
        "instruction": {
          "title": "Step 2: Identify the Major Vessels",
          "description": "Now identify the great vessels. The superior and inferior vena cavae return deoxygenated blood from the body to the right atrium. The pulmonary arteries carry blood to the lungs, the pulmonary veins return it to the left atrium, and the aorta delivers oxygenated blood to the body. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_svc",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_ivc",
              "poi": "poi_ivc",
              "text": "Inferior Vena Cava"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_pulm_artery",
              "poi": "poi_pulm_artery",
              "text": "Pulmonary Artery"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_pulm_veins",
              "poi": "poi_pulm_veins",
              "text": "Pulmonary Veins"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_label_aorta",
              "poi": "poi_aorta",
              "text": "Aorta"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_vessels"
          }
        ]
      },
      {
        "id": "step_valves",
        "instruction": {
          "title": "Step 3: Identify the Four Valves",
          "description": "Aim your device at the valve cutaway model to detect it. The atrioventricular valves (tricuspid on the right, mitral/bicuspid on the left) sit between atria and ventricles. The semilunar valves (pulmonary and aortic) guard the exits into the great arteries. Watch the animation showing how each valve opens and closes to prevent backflow. The step advances automatically once the valve model is detected."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_valves",
              "type": "predicate",
              "augmentation": "pred_valve_animation",
              "poi": "default"
            },
            {
              "target": "thing_valves",
              "type": "predicate",
              "augmentation": "pred_label_tricuspid",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "thing_valves",
              "type": "predicate",
              "augmentation": "pred_label_pulmonary_valve",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve (Semilunar)"
            },
            {
              "target": "thing_valves",
              "type": "predicate",
              "augmentation": "pred_label_mitral",
              "poi": "poi_mitral",
              "text": "Mitral/Bicuspid Valve (AV)"
            },
            {
              "target": "thing_valves",
              "type": "predicate",
              "augmentation": "pred_label_aortic_valve",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve (Semilunar)"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_valves",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_valves",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step_pulmonary_circuit",
        "instruction": {
          "title": "Step 4: Trace the Pulmonary Circuit",
          "description": "Follow the blue (deoxygenated) blood path. Blood returns from the body via the vena cavae into the RIGHT ATRIUM, through the TRICUSPID valve into the RIGHT VENTRICLE, out through the PULMONARY valve and PULMONARY ARTERIES to the lungs. Point your device at the Lungs Station to confirm gas exchange and advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_deoxy_flow_anim",
              "poi": "default"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_circuit_audio",
              "poi": "default"
            },
            {
              "target": "place_lungs",
              "type": "predicate",
              "augmentation": "pred_bloodflow_animation",
              "poi": "poi_gas_exchange"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_lungs",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_lungs",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step_systemic_circuit",
        "instruction": {
          "title": "Step 5: Trace the Systemic Circuit",
          "description": "Now follow the red (oxygenated) blood path. Oxygenated blood returns from the lungs via the PULMONARY VEINS into the LEFT ATRIUM, through the MITRAL valve into the LEFT VENTRICLE, and out through the AORTIC valve and AORTA to the entire body. Point your device at the Body Station to deliver oxygen to the tissues and advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_oxy_flow_anim",
              "poi": "default"
            },
            {
              "target": "place_body",
              "type": "predicate",
              "augmentation": "pred_bloodflow_animation",
              "poi": "poi_tissue_delivery"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_body",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_body",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step_wall_thickness",
        "instruction": {
          "title": "Step 6: Compare Ventricular Wall Thickness",
          "description": "Aim at the ventricular wall cross-section. Notice the left ventricle's myocardium is substantially thicker than the right ventricle's. The right ventricle pumps only to the nearby low-pressure pulmonary circuit, while the left ventricle must generate high pressure to perfuse the entire systemic circuit. Review the comparison image and watch the full dual-loop summary, then tap Finish."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_wall_cross_section",
              "type": "predicate",
              "augmentation": "pred_wall_compare_image",
              "poi": "default"
            },
            {
              "target": "thing_wall_cross_section",
              "type": "predicate",
              "augmentation": "pred_label_rv",
              "poi": "poi_thin_wall",
              "text": "Right Ventricle: Thin Wall (Pulmonary Circuit)"
            },
            {
              "target": "thing_wall_cross_section",
              "type": "predicate",
              "augmentation": "pred_label_lv",
              "poi": "poi_thick_wall",
              "text": "Left Ventricle: Thick Wall (Systemic Circuit)"
            },
            {
              "target": "thing_heart",
              "type": "predicate",
              "augmentation": "pred_summary_video",
              "poi": "default"
            }
          ]
        },
        "exit": {
          "remove_self": true,
          "deactivate": [
            {
              "target": "thing_wall_cross_section",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_wall_thickness"
          }
        ]
      }
    ]
  }
