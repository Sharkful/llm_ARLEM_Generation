  "activity": {
    "id": "act_vectors_projectile",
    "name": "From Vectors to Projectile Motion",
    "description": "A guided AR lab for algebra-based General Physics I. Students first manipulate abstract vectors (tip-to-tail addition and component decomposition via right-triangle trigonometry), then apply these tools to two-dimensional projectile motion, exploring the independence of horizontal and vertical motion and how launch angle and speed shape the trajectory, range, and maximum height.",
    "workplace": "wp_vectors_projectile",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "instruction": {
          "title": "1. What Is a Vector?",
          "description": "A vector represents a quantity with both magnitude and direction. Scan the Vector Addition Pad. Listen to the introduction, then tap Next to see how vectors combine."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_pad",
              "type": "predicate",
              "augmentation": "pred_intro_audio",
              "poi": "default"
            },
            {
              "target": "thing_vector_pad",
              "type": "predicate",
              "augmentation": "pred_resultant_arrow",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_pad",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_intro"
          }
        ]
      },
      {
        "id": "step_tip_to_tail",
        "instruction": {
          "title": "2. Adding Vectors Tip-to-Tail",
          "description": "Watch two vectors placed tip-to-tail. The resultant runs from the tail of the first to the tip of the second. Observe how order does not change the resultant. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_pad",
              "type": "predicate",
              "augmentation": "pred_tip_to_tail_anim",
              "poi": "tail"
            },
            {
              "target": "thing_vector_pad",
              "type": "predicate",
              "augmentation": "pred_resultant_arrow",
              "poi": "resultant"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_pad",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_tip_to_tail"
          }
        ]
      },
      {
        "id": "step_components",
        "instruction": {
          "title": "3. Decomposing Into Components",
          "description": "Scan the Component Decomposition Grid. A single vector is split into its horizontal (x) and vertical (y) components. Use right-triangle trigonometry (cos for x, sin for y) to relate magnitude and direction to components. Detect the grid to advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_component_anim",
              "poi": "default"
            },
            {
              "target": "thing_component_grid",
              "type": "predicate",
              "augmentation": "pred_trig_triangle",
              "poi": "x_axis"
            },
            {
              "target": "thing_component_grid",
              "type": "primitive",
              "augmentation": "label",
              "poi": "y_axis",
              "text": "Vy = |V| sin(theta)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_grid",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_component_grid"
          }
        ]
      },
      {
        "id": "step_launch",
        "instruction": {
          "title": "4. Launching a Projectile",
          "description": "Scan the Adjustable Projectile Launcher. The initial velocity vector is decomposed into a constant horizontal component and a gravity-affected vertical component. Watch the parabolic trajectory emerge in the Launch Zone. Detect the launcher to fire."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_component_anim",
              "poi": "muzzle"
            },
            {
              "target": "place_launch_zone",
              "type": "predicate",
              "augmentation": "pred_projectile_traj",
              "poi": "default"
            },
            {
              "target": "place_launch_zone",
              "type": "primitive",
              "augmentation": "label",
              "poi": "apex",
              "text": "Max height: Vy = 0"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_launcher",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_launch_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_launcher"
          }
        ]
      },
      {
        "id": "step_independence",
        "instruction": {
          "title": "5. Independence of Motions",
          "description": "The horizontal velocity stays constant while the vertical velocity changes uniformly under gravity. These two motions are independent. Watch the side-by-side comparison in the Launch Zone, then tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_launch_zone",
              "type": "predicate",
              "augmentation": "pred_velocity_components_anim",
              "poi": "default"
            },
            {
              "target": "place_launch_zone",
              "type": "predicate",
              "augmentation": "pred_independence_video",
              "poi": "apex"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_launch_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_independence"
          }
        ]
      },
      {
        "id": "step_angle_range",
        "instruction": {
          "title": "6. Angle, Speed, Range & Max Height",
          "description": "Scan the Target Landing Field. Sweep the launch angle and speed to see how range and maximum height change. Confirm that 45 degrees gives the maximum range for a fixed speed. Detect the field to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_target_field",
              "type": "predicate",
              "augmentation": "pred_angle_sweep_anim",
              "poi": "default"
            },
            {
              "target": "place_target_field",
              "type": "primitive",
              "augmentation": "label",
              "poi": "range_marker",
              "text": "Max range at 45 degrees"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_target_field",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_target_field"
          }
        ]
      }
    ]
  }
