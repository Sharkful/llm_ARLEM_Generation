  "activity": {
    "id": "act_vsepr",
    "name": "VSEPR: Predicting Molecular Geometry",
    "description": "A five-step guided AR lab where students start from a Lewis structure, count electron domains to find the steric number, build the electron-domain geometry, watch how lone pairs modify the molecular shape and bond angles, and finally compare their VSEPR predictions to real molecules like water, ammonia, methane, PF5, SF6, and XeF4.",
    "workplace": "wp_vsepr_lab",
    "start": "step_lewis",
    "actions": [
      {
        "id": "step_lewis",
        "instruction": {
          "title": "Read the Lewis Structure",
          "description": "Point your device at the Lewis Structure Board. Examine the displayed Lewis structure of the molecule, noting the central atom, each bonding pair, and each lone pair. When you have identified all electron domains around the central atom, tap Next."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "lewis_board",
              "type": "predicate",
              "augmentation": "lewis_structure_image",
              "poi": "structure_display"
            },
            {
              "target": "lewis_board",
              "type": "predicate",
              "augmentation": "narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "lewis_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lewis"
          }
        ]
      },
      {
        "id": "step_steric",
        "instruction": {
          "title": "Determine the Steric Number",
          "description": "Detect the Central Atom Sphere to bring it onto the bench. Count the total number of bonding pairs and lone pairs around the central atom \u2014 this sum is the steric number. The steric number label will confirm your count and set the electron-domain geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "steric_number_label",
              "poi": "default",
              "text": "Steric Number = bonding pairs + lone pairs"
            },
            {
              "target": "domain_tray",
              "type": "predicate",
              "augmentation": "narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "domain_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "central_atom"
          }
        ]
      },
      {
        "id": "step_domain_geometry",
        "instruction": {
          "title": "Build the Electron-Domain Geometry",
          "description": "Place electron domains from the tray around the central atom and watch them settle into the minimum-repulsion arrangement: linear, trigonal planar, tetrahedral, trigonal bipyramidal, or octahedral. Detect the Electron-Domain Tray to load the domains, then observe the geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "domain_geometry_animation",
              "poi": "default",
              "state": "settle_min_repulsion"
            },
            {
              "target": "domain_tray",
              "type": "predicate",
              "augmentation": "steric_number_label",
              "poi": "lone_pair_slot",
              "text": "Electron-domain geometry set by steric number"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "domain_tray",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "domain_tray"
          }
        ]
      },
      {
        "id": "step_molecular_shape",
        "instruction": {
          "title": "Lone Pairs Shape the Molecule",
          "description": "Now hide the lone pairs to reveal the molecular geometry \u2014 bent, trigonal pyramidal, seesaw, T-shaped, square planar, or square pyramidal. Notice how lone pairs occupy more angular space, compressing bond angles (104.5\u00b0 in water vs 109.5\u00b0 in methane). Tap Next when you understand the deviation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "molecular_shape_animation",
              "poi": "default",
              "state": "reveal_molecular_shape"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "lone_pair_repulsion_animation",
              "poi": "top_domain"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "bond_angle_label",
              "poi": "equatorial_domain",
              "text": "Lone pairs compress bond angles below ideal"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_molecular_shape"
          }
        ]
      },
      {
        "id": "step_compare_real",
        "instruction": {
          "title": "Compare to Real Molecules",
          "description": "Detect the Molecular Model Kit to display real molecules on the Reference Shelf \u2014 water, ammonia, methane, PF5, SF6, and XeF4. Compare each observed structure against your VSEPR prediction and confirm the shapes match. Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "reference_shelf",
              "type": "predicate",
              "augmentation": "real_molecule_animation",
              "poi": "molecule_showcase"
            },
            {
              "target": "reference_shelf",
              "type": "predicate",
              "augmentation": "comparison_video",
              "poi": "default"
            },
            {
              "target": "model_kit",
              "type": "predicate",
              "augmentation": "bond_angle_label",
              "poi": "assembly_point",
              "text": "Predicted geometry vs observed structure"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "reference_shelf",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "model_kit",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "model_kit"
          }
        ]
      }
    ]
  }
}