  "activity": {
    "id": "act_retrograde_motion",
    "name": "Apparent Retrograde Motion of the Outer Planets",
    "description": "A guided AR exploration of why Mars and the outer planets appear to reverse direction in the night sky. Students observe Mars's retrograde loop from Earth, examine the geocentric epicycle explanation, view the heliocentric resolution, embody the overtaking geometry, and compare loops of Mars, Jupiter, and Saturn.",
    "workplace": "wp_retrograde_motion",
    "start": "step_observe",
    "actions": [
      {
        "id": "step_observe",
        "instruction": {
          "title": "1. Observe the Retrograde Loop",
          "description": "Stand on the virtual Earth at night and look up at the ecliptic constellations Leo, Virgo, Libra, and Scorpio. Watch the red point of Mars over six simulated months: it drifts eastward, slows, loops westward for two months, then resumes eastward motion. Follow the trail marking its full ~15 degree loop. Tap Next when you have seen the complete path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_constellation_labels",
              "poi": "poi_ecliptic_band"
            },
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_trail",
              "poi": "poi_mars_track"
            },
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_narration_observation",
              "poi": "default"
            },
            {
              "target": "place_nightsky",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mars_track",
              "text": "Mars traces a westward loop"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_nightsky",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_geocentric"
          }
        ]
      },
      {
        "id": "step_geocentric",
        "instruction": {
          "title": "2. The Geocentric Explanation",
          "description": "Earth sits at the center. Mars rides on a small circle, the epicycle, which itself rides on a larger circle, the deferent. Watch the machinery run: when Mars reaches the inner part of its epicycle it appears to move backward as seen from Earth. This reproduces the loop, but requires carefully tuned circles and speeds for every planet. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_geocentric_model",
              "type": "predicate",
              "augmentation": "pred_epicycle_animation",
              "poi": "default"
            },
            {
              "target": "thing_geocentric_model",
              "type": "predicate",
              "augmentation": "pred_narration_geocentric",
              "poi": "default"
            },
            {
              "target": "thing_geocentric_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_epicycle",
              "text": "Epicycle"
            },
            {
              "target": "thing_geocentric_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_deferent",
              "text": "Deferent"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_geocentric_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_heliocentric"
          }
        ]
      },
      {
        "id": "step_heliocentric",
        "instruction": {
          "title": "3. The Heliocentric Resolution",
          "description": "Rise up above the solar system. The Sun sits at the center; Earth orbits at 1 AU in one year, Mars at 1.52 AU in 1.88 years. Watch Earth catch up to and overtake the slower Mars roughly every 26 months. The retrograde loop disappears completely, replaced by two smooth ellipses. Point your device at the heliocentric model marker to lock the view and advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heliocentric_model",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits",
              "poi": "default"
            },
            {
              "target": "thing_heliocentric_model",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric",
              "poi": "default"
            },
            {
              "target": "thing_heliocentric_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_earth_orbit",
              "text": "Earth 1 AU, 1 yr"
            },
            {
              "target": "thing_heliocentric_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mars_orbit",
              "text": "Mars 1.52 AU, 1.88 yr"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heliocentric_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_heliocentric_model"
          }
        ]
      },
      {
        "id": "step_linkage",
        "instruction": {
          "title": "4. Link the Two Viewpoints",
          "description": "A line of sight is drawn from Earth through Mars out to the background stars. Watch it sweep eastward during normal motion. As Earth begins to overtake Mars, the line reverses and sweeps westward, and Mars's apparent position retraces its path in the night sky. After Earth passes, eastward motion resumes. The loop is real geometry, not an illusion of the eye. Tap Next to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heliocentric_model",
              "type": "predicate",
              "augmentation": "pred_sightline_sweep",
              "poi": "poi_sight_line"
            },
            {
              "target": "place_nightsky",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_trail",
              "poi": "poi_mars_track"
            },
            {
              "target": "thing_heliocentric_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_sight_line",
              "text": "Line of sight to Mars"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heliocentric_model",
              "augmentation": "*"
            },
            {
              "target": "place_nightsky",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_embodied"
          }
        ]
      },
      {
        "id": "step_embodied",
        "instruction": {
          "title": "5. Walk the Overtaking Yourself",
          "description": "Stand at the center of the starfield with a stationary Mars several feet ahead of you. Walk slowly around the small circle on the floor representing Earth's inner orbit while keeping your gaze on Mars. As you pass the point of closest approach, Mars appears to move backward against the stars, the retrograde effect produced by your own motion. Step onto the orbit floor circle to begin, then advance when you have completed a full loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_orbit_floor",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/img/orbit_circle_floor.png"
            },
            {
              "target": "place_orbit_floor",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_mars_ahead",
              "text": "Keep your eyes on Mars"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_orbit_floor",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_orbit_floor"
          }
        ]
      },
      {
        "id": "step_compare",
        "instruction": {
          "title": "6. Compare the Outer Planets",
          "description": "The heliocentric view now includes Jupiter at 5.2 AU and Saturn at 9.5 AU alongside Earth and Mars. Step through a retrograde event for each and compare the loops: Mars about 15 degrees, Jupiter about 10 degrees, Saturn about 7 degrees. More distant planets show smaller loops because Earth's orbital motion subtends a smaller angle when viewed from farther away. Tap Next for the recap."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_outer_planet_loops",
              "poi": "default"
            },
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_narration_comparison",
              "poi": "default"
            },
            {
              "target": "thing_outer_planets",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_jupiter_loop",
              "text": "Jupiter ~10 deg"
            },
            {
              "target": "thing_outer_planets",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_saturn_loop",
              "text": "Saturn ~7 deg"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_outer_planets",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_recap"
          }
        ]
      },
      {
        "id": "step_recap",
        "instruction": {
          "title": "7. Recap",
          "description": "Review the five concept areas covered in this lab: the observed retrograde phenomenon, the geocentric epicycle explanation, the heliocentric resolution, the linkage between the two viewpoints, and the comparison across the outer planets. The heliocentric model is preferred because it explains the loop naturally, with no tuned epicycles required. Tap Finish to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_outer_planets",
              "type": "predicate",
              "augmentation": "pred_summary_panel",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_outer_planets",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_recap"
          }
        ]
      }
    ]
  }
