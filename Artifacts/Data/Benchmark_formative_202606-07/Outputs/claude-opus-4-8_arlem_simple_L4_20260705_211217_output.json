  "activity": {
    "id": "act_dna_replication",
    "name": "The Double Helix & Semiconservative Replication",
    "description": "A ten-step guided AR exploration of DNA's three-dimensional structure and its semiconservative replication. Students first examine the schematic ladder and realistic double helix, learn the complementary base-pairing rules through an interactive activity, understand antiparallel 5'-to-3' directionality, then build up the replication fork enzyme by enzyme (helicase, SSBs, DNA polymerase, DNA ligase) before predicting the outcome of semiconservative replication over multiple rounds.",
    "workplace": "wp_dna_replication",
    "start": "step_structure",
    "actions": [
      {
        "id": "step_structure",
        "instruction": {
          "title": "1. The Double Helix Structure",
          "description": "A schematic ladder of DNA appears: two vertical sugar-phosphate backbones with color-coded base-pair rungs (A=red, T=blue, G=yellow, C=green). The ladder then twists into the realistic double helix, backbones spiraling around a common axis roughly once every ten base pairs. Identify the sugar-phosphate backbones and the bases projecting inward. Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "ladder_schematic",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "double_helix",
              "poi": "default",
              "state": "twist_transition"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "narration_structure",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_structure"
          }
        ]
      },
      {
        "id": "step_directionality",
        "instruction": {
          "title": "2. Antiparallel 5'-to-3' Orientation",
          "description": "The realistic helix reappears with directional arrows along each backbone \u2014 one strand pointing up, the other down. Labels mark the 5' and 3' termini at the ends of each strand. The two strands always run in opposite directions; this antiparallel arrangement is forced by the directional chemistry of the sugar-phosphate backbone. Rotate the helix to confirm the arrows from any angle, then tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "double_helix",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "directionality_arrows",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "label_5prime",
              "poi": "top_terminus",
              "text": "5' end"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "label_3prime",
              "poi": "bottom_terminus",
              "text": "3' end"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "narration_directionality",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_directionality"
          }
        ]
      },
      {
        "id": "step_base_pairing",
        "instruction": {
          "title": "3. Complementary Base Pairing",
          "description": "A partial ladder appears with a complete template strand (5'-ATGCCAGT-3') on the left and an empty backbone on the right. Drag loose bases from the palette to complete the complementary strand. Correct pairings (A-T, G-C) snap into place and form hydrogen bonds \u2014 two dashed lines for A-T, three for G-C. Note that your new strand runs 3'-to-5', opposite the template. Point your device at the pairing bench marker to complete the activity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_pairing_bench",
              "type": "predicate",
              "augmentation": "base_pairing_activity",
              "poi": "default"
            },
            {
              "target": "thing_base_palette",
              "type": "predicate",
              "augmentation": "base_pairing_activity",
              "poi": "default"
            },
            {
              "target": "place_pairing_bench",
              "type": "predicate",
              "augmentation": "narration_pairing",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_pairing_bench",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_base_palette",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_pairing_bench",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_base_pairing"
          }
        ]
      },
      {
        "id": "step_helicase",
        "instruction": {
          "title": "4. Helicase Unwinds the Helix",
          "description": "A section of the realistic double helix appears with helicase, the first enzyme, positioned at one end. Watch helicase move along the DNA and break the hydrogen bonds between paired bases, unwinding the two strands to expose the bases at the replication fork. Behind it the strands are separated but no other proteins are present yet. Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "helicase_anim",
              "poi": "fork_front"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "narration_enzymes",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "narration_enzymes"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_helicase"
          }
        ]
      },
      {
        "id": "step_ssb",
        "instruction": {
          "title": "5. Single-Strand Binding Proteins",
          "description": "As the two strands separate behind helicase, single-strand binding proteins (SSBs) \u2014 small labeled spheres \u2014 attach to each exposed strand. Single strands are unstable and tend to re-pair or fold; the SSBs hold the strands open and accessible so replication can proceed. Notice how without them the exposed strands would collapse back together. Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "ssb_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_ssb"
          }
        ]
      },
      {
        "id": "step_leading",
        "instruction": {
          "title": "6. DNA Polymerase & the Leading Strand",
          "description": "DNA polymerase appears on the template strand oriented so synthesis follows the moving fork. Polymerase can only add nucleotides to the 3' end, so it travels 3'-to-5' along the template, building the new strand 5'-to-3'. On this leading-strand template it moves continuously, synthesizing an uninterrupted complementary strand as free nucleotides pair and are added. (A primer provides the starting point.) Watch the leading strand grow, then tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "leading_strand_anim",
              "poi": "leading_template"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_leading"
          }
        ]
      },
      {
        "id": "step_lagging",
        "instruction": {
          "title": "7. Lagging Strand & Okazaki Fragments",
          "description": "On the other template strand \u2014 whose 3' end points away from the fork \u2014 synthesis cannot be continuous. Polymerase is forced to work backward away from the fork, producing a short fragment, then jumps back and starts another. This yields a series of Okazaki fragments. Then DNA ligase appears and seals the fragments into a continuous strand at their junctions. Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "lagging_strand_anim",
              "poi": "lagging_template"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_lagging"
          }
        ]
      },
      {
        "id": "step_full_fork",
        "instruction": {
          "title": "8. The Complete Replication Fork",
          "description": "All five components are now active together: helicase at the front, SSBs holding the strands open, leading-strand polymerase moving continuously, lagging-strand polymerase working in fragments, and ligase sealing behind it. Rotate the full fork and identify each component using the enzyme-function panel. The leading/lagging asymmetry arises because the antiparallel template strands run in opposite directions while polymerase works in only one direction. Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "full_fork_anim",
              "poi": "default"
            },
            {
              "target": "thing_replication_fork",
              "type": "predicate",
              "augmentation": "enzyme_function_panel",
              "poi": "fork_front"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_replication_fork",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_full_fork"
          }
        ]
      },
      {
        "id": "step_semiconservative",
        "instruction": {
          "title": "9. Semiconservative Replication",
          "description": "A parental DNA molecule with both strands in gold marks the original material. It replicates once: strands separate, new silver strands are synthesized, yielding two daughter molecules each with one gold and one silver strand \u2014 hence 'semiconservative.' Now predict the composition after a SECOND round from these two daughters: (a) all four half gold/half silver; (b) two half gold/half silver and two fully silver; (c) all four fully silver. The animation confirms the answer (two hybrid, two fully silver). Tap to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "semiconservative_anim",
              "poi": "default"
            },
            {
              "target": "thing_dna_helix",
              "type": "predicate",
              "augmentation": "narration_semiconservative",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_dna_helix",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_semiconservative"
          }
        ]
      },
      {
        "id": "step_recap",
        "instruction": {
          "title": "10. Recap & Review",
          "description": "A summary screen reviews the six concept areas covered: the double-helix structure with its sugar-phosphate backbones and bases; the complementary base-pairing rules and hydrogen-bond counts; the antiparallel 5'-to-3' arrangement; the replication enzymes at the fork; the leading/lagging asymmetry with Okazaki fragments; and the semiconservative nature of replication. Point your device at the summary wall to view the recap."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_summary_wall",
              "type": "predicate",
              "augmentation": "summary_panel",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_summary_wall",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "anchor_summary_wall",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step_recap"
          }
        ]
      }
    ]
  }
