                0.05,
                0.05,
                0.05
              ]
            }
          ],
          "changeMeaning": "Mars's epicycle is highlighted, showing the small circle riding on the large deferent that produces the loop.",
          "narration": "But a single circle cannot produce a backward loop. So Mars was placed on a small circle, an epicycle, which itself rides along the larger circle, the deferent. As Mars swings around the epicycle, it can briefly appear to move backward as seen from Earth."
        },
        {
          "clipName": "clip2",
          "audioClip": "retro_scene2_awkward",
          "autoAdvance": false,
