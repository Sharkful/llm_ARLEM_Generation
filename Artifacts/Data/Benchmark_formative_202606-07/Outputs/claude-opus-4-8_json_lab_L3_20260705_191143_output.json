                1.05,
                0.42
              ]
            }
          ],
          "changeMeaning": "The four electron domains snap into a symmetric tetrahedral arrangement to visually demonstrate that domains reposition to maximize their separation and minimize repulsion.",
          "narration": "Electrons are negatively charged, so electron domains repel one another. To minimize this repulsion, the domains push as far apart as possible. Watch them settle into the arrangement that maximizes the angles between them."
        },
        {
          "clipName": "clip2",
          "audioClip": "scene1_steric_number",
          "autoAdvance": false,
          "changes": [
            {
              "target": "titleLabel",
