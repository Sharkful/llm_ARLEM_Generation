      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "helio_intro_solar_system_topdown",
          "autoAdvance": false,
          "changes": [
            {
              "target": "HelioNarratorPanel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Top-Down View: Earth (inner) orbits faster than Mars (outer).",
                  "color": [
                    255,
                    230,
                    150,
                    255
                  ],
                  "fontSize": 28,
                  "wrapText": true
                }
              ]
            }
          ],
          "changeMeaning": "The top-down heliocentric scene activates: Sun at center with Earth and Mars on their respective orbital rings. Labels appear for all three bodies. Orbits begin animating at a slow, visible rate.",
          "narration": "Now let's zoom out and look down at the solar system from above. At the center is the Sun. Earth traces a smaller, faster orbit close in, while Mars follows a larger, slower orbit farther out. Both planets move counterclockwise \u2014 but Earth completes its orbit in just one year, while Mars takes about 1.9 years."
        },
        {
          "clipName": "clip1",
          "audioClip": "helio_sightline_opposition_explained",
          "autoAdvance": false,
          "changes": [
            {
              "target": "EarthMarsSightline",
              "enabled": true
            },
            {
              "target": "HelioNarratorPanel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Yellow line = line of sight from Earth through Mars to distant stars.",
                  "color": [
                    255,
                    255,
                    120,
                    255
                  ],
                  "fontSize": 28,
                  "wrapText": true
                }
              ]
            }
          ],
          "changeMeaning": "The sightline object activates, stretching from Earth through Mars outward. This visually demonstrates how the direction to Mars changes as both planets orbit, setting up the opposition geometry.",
          "narration": "The yellow line represents your line of sight from Earth out to Mars and beyond, projected onto the distant stars. Watch what happens as Earth \u2014 on its faster inner track \u2014 begins to catch up with Mars. The sightline shifts eastward as both planets move, but notice the moment Earth draws nearly level with Mars."
        },
        {
          "clipName": "clip2",
          "audioClip": "helio_opposition_earth_overtakes_mars",
          "autoAdvance": false,
          "changes": [
            {
              "target": "EarthOrbit",
              "position": [
                -0.55,
                1.0,
                0
              ]
            },
            {
              "target": "MarsOrbit",
              "position": [
                -0.87,
                1.0,
                0
              ]
            },
            {
              "target": "HelioNarratorPanel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Opposition! Earth overtakes Mars \u2014 like a faster car passing a slower one. Mars appears to move backward!",
                  "color": [
                    255,
                    150,
                    80,
                    255
                  ],
                  "fontSize": 26,
                  "wrapText": true
                }
              ]
            }
          ],
          "changeMeaning": "Both planets animate to near-opposition geometry. The sightline sweeps noticeably westward illustrating the overtaking effect. The narrator panel updates with the 'passing car' analogy and highlights opposition.",
          "narration": "Here \u2014 at opposition \u2014 Earth is directly between the Sun and Mars. Earth is moving faster, so it overtakes Mars just as a car in the fast lane overtakes a slower car. From Earth, the sightline to Mars swings sharply westward, even though Mars is still moving eastward in its orbit. That westward swing is exactly what we see as retrograde motion from the ground."
        },
        {
          "clipName": "clip3",
          "audioClip": "helio_retrograde_geometry_sightline_arc",
          "autoAdvance": false,
          "changes": [
            {
              "target": "EarthOrbit",
              "position": [
                -0.3,
                1.0,
                0.45
              ]
            },
            {
              "target": "MarsOrbit",
              "position": [
                -0.7,
                1.0,
                0.52
              ]
            },
            {
              "target": "HelioNarratorPanel",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "As Earth pulls ahead, the sightline swings back east \u2014 retrograde ends. It's a perspective effect, not a real reversal!",
                  "color": [
                    180,
                    255,
                    180,
                    255
                  ],
                  "fontSize": 26,
                  "wrapText": true
                }
              ]
            }
          ],
          "changeMeaning": "Earth continues advancing past Mars in the animation. The sightline swings back eastward, showing the full arc of apparent retrograde from start to end. The narrator panel emphasizes that retrograde is a perspective effect.",
          "narration": "As Earth continues past Mars, the line of sight first swings westward and then swings back eastward once Earth has pulled far enough ahead. This produces the arc \u2014 the retrograde loop \u2014 we saw in the night sky. No actual reversal of Mars's orbit occurs. It's entirely a perspective effect caused by relative motion."
        },
