  "activity": {
    "id": "retrograde_motion_activity",
    "name": "Why Does Mars Move Backward? Exploring Apparent Retrograde Motion",
    "description": "A 5-part AR lab in which students observe Mars's apparent retrograde loop from Earth's surface, then step outside the solar system to see the heliocentric explanation, compare geocentric vs heliocentric models, predict future retrograde events, and compare Mars's loop to Jupiter's and Saturn's.",
    "language": "en",
    "workplace": "retrograde_motion_workplace",
    "start": "step1_earth_view",
    "actions": [
      {
        "id": "step1_earth_view",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "earth_view_station",
        "predicate": "observed",
        "instruction": {
          "title": "Observe Mars from Earth's Surface",
          "description": "Look at the star chart panel showing Mars's position against the background constellations over several weeks. Notice how Mars normally drifts slowly eastward night after night. Tap 'Start' when ready to watch the full sequence including the retrograde loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "narration_intro_audio",
              "poi": "default"
            },
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "mars_eastward_drift_anim",
              "poi": "default"
            },
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "label_eastward",
              "poi": "default",
              "text": "Mars drifting eastward against the stars"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "star_chart_panel",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_retrograde_loop",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "earth_view_station",
        "predicate": "observed",
        "instruction": {
          "title": "Watch the Retrograde Loop",
          "description": "Mars slows down, reverses, and traces a westward loop across the sky for about two months before resuming its eastward path. This loop was the great puzzle for ancient astronomers. Say 'continue' when you have traced the full loop with your finger in the air."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "mars_retrograde_loop_anim",
              "poi": "default"
            },
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "label_retrograde",
              "poi": "default",
              "text": "Retrograde loop: westward motion for ~2 months"
            },
            {
              "target": "star_chart_panel",
              "type": "predicate",
              "augmentation": "mars_resume_eastward_anim",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "star_chart_panel",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "loop_traced",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "continue",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_heliocentric_view",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens1",
        "location": "solar_system_station",
        "predicate": "explained",
        "instruction": {
          "title": "Step Outside the Solar System",
          "description": "Now view the orrery model from outside the solar system. Watch Earth and Mars move in smooth heliocentric orbits. Notice that Earth, on its faster inner orbit, overtakes Mars \u2014 like a car passing a slower car in the next lane. This relative motion, projected onto the background stars, produces the apparent loop you saw from Earth. Tap 'Start' to see the sightline projection overlay."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "solar_system_station",
              "type": "predicate",
              "augmentation": "narration_helio_audio",
              "poi": "default"
            },
            {
              "target": "earth_orbit_model",
              "type": "predicate",
              "augmentation": "heliocentric_orbits_anim",
              "poi": "earth_current_pos"
            },
            {
              "target": "mars_orbit_model",
              "type": "predicate",
              "augmentation": "heliocentric_orbits_anim",
              "poi": "mars_current_pos"
            },
            {
              "target": "earth_orbit_model",
              "type": "predicate",
              "augmentation": "overtaking_carlane_anim",
              "poi": "default"
            },
            {
              "target": "mars_orbit_model",
              "type": "predicate",
              "augmentation": "sightline_projection_anim",
              "poi": "mars_current_pos"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "earth_orbit_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "mars_orbit_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "solar_system_station",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "reactions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start",
            "type": "action",
            "viewport": "reactions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_geocentric_vs_heliocentric",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens1",
        "location": "solar_system_station",
        "predicate": "compared",
        "instruction": {
          "title": "Geocentric Epicycles vs Heliocentric Simplicity",
          "description": "Compare the two historical explanations side by side: the geocentric model required Mars to travel on an awkward small circle (epicycle) riding along a larger circle just to reproduce the loop. The heliocentric model produces the same loop naturally from two planets orbiting the Sun at different speeds. Consider why scientists ultimately preferred the heliocentric explanation. Tap 'Next' when ready to make a prediction."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_orbit_model",
              "type": "predicate",
              "augmentation": "geocentric_epicycle_anim",
              "poi": "default"
            },
            {
              "target": "earth_orbit_model",
              "type": "predicate",
              "augmentation": "heliocentric_orbits_anim",
              "poi": "default"
            },
            {
              "target": "solar_system_station",
              "type": "predicate",
              "augmentation": "label_geocentric_vs_helio",
              "poi": "default",
              "text": "Geocentric: awkward epicycles | Heliocentric: natural consequence of relative motion"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "mars_orbit_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "earth_orbit_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "solar_system_station",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "reactions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step5_predict_and_compare",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens1",
        "location": "solar_system_station",
        "predicate": "compared",
        "instruction": {
          "title": "Predict Retrograde Events and Compare Outer Planets",
          "description": "Using the current positions of Earth and Mars on the orbit models, predict roughly when the next retrograde episode will occur (every ~26 months for Mars). Then examine the comparison tray showing Jupiter's and Saturn's retrograde loops \u2014 notice they are smaller and less dramatic because these planets are farther from the Sun, reducing the relative-motion effect. Say 'complete' to finish the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "mars_orbit_model",
              "type": "predicate",
              "augmentation": "period_diagram_image",
              "poi": "default"
            },
            {
              "target": "mars_orbit_model",
              "type": "predicate",
              "augmentation": "label_prediction_prompt",
              "poi": "default",
              "text": "When will Earth next overtake Mars? (~26 month synodic period)"
            },
            {
              "target": "outer_planet_comparison_tray",
              "type": "predicate",
              "augmentation": "jupiter_loop_anim",
              "poi": "jupiter_slot"
            },
            {
              "target": "outer_planet_comparison_tray",
              "type": "predicate",
              "augmentation": "saturn_loop_anim",
              "poi": "saturn_slot"
            },
            {
              "target": "outer_planet_comparison_tray",
              "type": "predicate",
              "augmentation": "narration_compare_audio",
              "poi": "default"
            },
            {
              "target": "outer_planet_comparison_tray",
              "type": "predicate",
              "augmentation": "label_comparison_summary",
              "poi": "default",
              "text": "Farther planets = smaller apparent loops"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
