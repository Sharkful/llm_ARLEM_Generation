  "activity": {
    "id": "heart_anatomy_activity",
    "name": "The Heart: Chambers, Valves, and the Path of Blood",
    "description": "A hands-on AR lab where nursing, kinesiology, and pre-health students explore a life-size anatomical heart model to identify the four chambers, four valves, and major vessels, then trace the dual-loop pulmonary and systemic circulation, and finally compare ventricular wall thickness and valve function relative to circulatory demands.",
    "language": "en",
    "workplace": "heart_anatomy_workplace",
    "start": "intro_chambers",
    "actions": [
      {
        "id": "intro_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "dissection_station",
        "predicate": "launched",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Look at the life-size heart model in front of you. Four labels will appear highlighting the right atrium, right ventricle, left atrium, and left ventricle. Walk around the model and read each label aloud before continuing."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_right_atrium",
              "poi": "right_atrium_poi",
              "text": "Right Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_right_ventricle",
              "poi": "right_ventricle_poi",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_left_atrium",
              "poi": "left_atrium_poi",
              "text": "Left Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_left_ventricle",
              "poi": "left_ventricle_poi",
              "text": "Left Ventricle"
            },
            {
              "target": "learner1",
              "type": "predicate",
              "augmentation": "audio_narration_chambers",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start_valves_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "identify_valves",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "dissection_station",
        "predicate": "identified",
        "instruction": {
          "title": "Locate the Four Valves",
          "description": "Now labels for the tricuspid, pulmonary, mitral (bicuspid), and aortic valves will appear on the model, along with a short animation of each valve opening and closing. Note which valves are atrioventricular (AV) and which are semilunar."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_tricuspid_valve",
              "poi": "tricuspid_poi",
              "text": "Tricuspid Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_pulmonary_valve",
              "poi": "pulmonary_valve_poi",
              "text": "Pulmonary Valve (Semilunar)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_mitral_valve",
              "poi": "mitral_valve_poi",
              "text": "Mitral Valve (AV)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_aortic_valve",
              "poi": "aortic_valve_poi",
              "text": "Aortic Valve (Semilunar)"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_valve_open_close",
              "poi": "septum_poi"
            },
            {
              "target": "learner1",
              "type": "predicate",
              "augmentation": "audio_narration_valves",
              "viewport": "actions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_vessels",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start_vessels_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "identify_vessels",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "dissection_station",
        "predicate": "identified",
        "instruction": {
          "title": "Locate the Major Vessels",
          "description": "Labels now appear for the superior/inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Note which vessels carry deoxygenated blood (blue) versus oxygenated blood (red) using the color overlays."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vena_cava",
              "poi": "vena_cava_poi",
              "text": "Superior/Inferior Vena Cava"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_pulmonary_artery",
              "poi": "pulmonary_artery_poi",
              "text": "Pulmonary Arteries"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_pulmonary_vein",
              "poi": "pulmonary_vein_poi",
              "text": "Pulmonary Veins"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_aorta",
              "poi": "aorta_poi",
              "text": "Aorta"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "img_deoxy_blood_color",
              "poi": "vena_cava_poi"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "img_oxy_blood_color",
              "poi": "aorta_poi"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_bloodpath",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "marker_circulation_mat",
            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "trace_blood_path",
        "viewport": "reactions",
        "type": "reactions",
        "device": "hololens1",
        "location": "circulation_floor_mat",
        "predicate": "traced",
        "instruction": {
          "title": "Trace the Dual-Loop Circulation",
          "description": "Step onto the circulation floor mat. Follow the animated blood flow arrow as it moves: right atrium to right ventricle through the tricuspid valve, then through the pulmonary valve to the lungs (pulmonary circuit), back to the left atrium via pulmonary veins, through the mitral valve to the left ventricle, then out the aortic valve and aorta to the body (systemic circuit). Narrate each stop as you point to it."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_blood_flow_arrow",
              "poi": "right_atrium_poi",
              "state": "loop_start"
            },
            {
              "target": "circulation_floor_mat",
              "type": "predicate",
              "augmentation": "img_pulmonary_systemic_diagram",
              "poi": "default"
            },
            {
              "target": "learner1",
              "type": "predicate",
              "augmentation": "audio_narration_bloodpath",
              "viewport": "reactions"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "circulation_floor_mat",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_wallthickness",
            "type": "action",
            "viewport": "reactions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "start_wallthickness_voice",
            "type": "action",
            "viewport": "reactions",
            "operator": "equal"
          }
        ]
