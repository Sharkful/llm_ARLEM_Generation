        "device": "tablet_companion",
        "location": "helix_station",
        "predicate": "narration_base_pairing_intro",
        "instruction": {
          "title": "Interactive Base-Pairing Exercise",
          "description": "A partial ladder is shown: the left strand reads 5'-ATGCCAGT-3', the right strand's backbone is empty. Drag bases from the palette below to complete the complementary strand. Correct pairings (A-T, G-C) snap into place with visible hydrogen bonds: two dashed lines for A-T, three for G-C. Incorrect pairings are rejected with an explanation."
        },
        "enter": {
