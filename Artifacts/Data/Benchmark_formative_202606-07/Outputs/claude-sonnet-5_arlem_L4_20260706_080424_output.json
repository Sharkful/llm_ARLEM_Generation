  "activity": {
    "id": "dna_replication_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A ten-step AR lab guiding students from the schematic ladder representation of DNA through the realistic double helix, antiparallel 5'-to-3' directionality, an interactive base-pairing exercise, the assembly of the replication fork enzyme-by-enzyme, leading/lagging strand synthesis, and a semiconservative replication prediction activity, concluding with a recap of all six concept areas.",
    "language": "en",
    "workplace": "dna_replication_workplace",
    "start": "step1_ladder_intro",
    "actions": [
      {
        "id": "step1_ladder_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "helix_station",
        "predicate": "narration_intro_ladder",
        "instruction": {
          "title": "The DNA Ladder: Backbones and Bases",
          "description": "Examine the schematic ladder model of DNA. Two vertical lines represent the sugar-phosphate backbones; the horizontal rungs are base pairs, color-coded by base identity (A=red, T=blue, G=yellow, C=green). Notice how bases project inward from each backbone to pair with their complement."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "ladder_model",
              "type": "predicate",
              "augmentation": "anim_ladder_schematic",
              "poi": "default"
            },
            {
              "target": "ladder_model",
              "type": "predicate",
              "augmentation": "narration_intro_ladder"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "ladder_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_helix_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "helix_station",
        "predicate": "narration_helix_twist",
        "instruction": {
          "title": "From Ladder to Helix",
          "description": "Watch the flat ladder twist into the realistic double-helix shape. The backbones spiral around a common axis, completing one full turn roughly every ten base pairs. Toggle between the schematic and realistic views to build a mental map between the two representations."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "anim_ladder_to_helix",
              "poi": "default"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "anim_realistic_helix",
              "poi": "default",
              "state": "toggle_ready"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "narration_helix_twist"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "helix_geometry_confirmed",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_antiparallel_direction",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "helix_station",
        "predicate": "narration_antiparallel",
        "instruction": {
          "title": "Antiparallel Strands: 5' to 3'",
          "description": "Observe the arrows along each backbone: one strand points up, the other down. Labels mark the 5' and 3' ends of each strand. This antiparallel arrangement is forced by the directional chemistry of the sugar-phosphate backbone, not a matter of choice. Rotate the helix to confirm the arrows from any angle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "anim_direction_arrows",
              "poi": "default"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "label_5prime",
              "poi": "strand_5prime_end",
              "text": "5'"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "label_3prime",
              "poi": "strand_3prime_end",
              "text": "3'"
            },
            {
              "target": "helix_model",
              "type": "predicate",
              "augmentation": "narration_antiparallel"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
