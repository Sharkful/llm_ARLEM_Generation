  "activity": {
    "id": "act_heart_anatomy_lab",
    "name": "The Human Heart: Structure and Blood Flow AR Lab",
    "description": "A progressive AR lab guiding nursing, kinesiology, and pre-health students through the gross anatomy of the human heart and the dual-circuit path of blood flow. Students explore chambers, valves, and vessels; trace a red blood cell through pulmonary and systemic circulation; compare ventricular wall thickness; examine valve mechanics; and complete identification and blood-flow tracing quizzes before a final recap.",
    "language": "en",
    "workplace": "wp_heart_anatomy",
    "start": "step1_orientation",
    "actions": [
      {
        "id": "step1_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "place_intact_station",
        "predicate": "launched",
        "instruction": {
          "title": "Heart Orientation Overview",
          "description": "Two full-size heart models appear side by side: an intact exterior view on the left and a cutaway interior view on the right. Rotate both models together to explore the heart from any angle. Note that anatomical left/right is from the patient's perspective, not yours."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_intact_heart_model",
              "type": "predicate",
              "augmentation": "pred_anim_intro_rotate",
              "poi": "default"
            },
            {
              "target": "thing_intact_heart_model",
              "type": "predicate",
              "augmentation": "pred_audio_narration_intro",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_intact_heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_cutaway_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
