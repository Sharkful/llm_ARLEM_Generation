          }
        ]
      },
      {
        "id": "step2_vector_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_vector_space",
        "predicate": "narration_addition",
        "instruction": {
          "title": "Vector Addition: Tip-to-Tail",
          "description": "Vector A (blue) starts at the origin; Vector B (green) is placed tip-to-tail at A's head. The red resultant vector runs from A's tail to B's head. Grab and reorient either A or B - watch the resultant update. Swap the order of A and B and confirm the resultant points to the same place: addition order doesn't matter."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "anim_vector_addition",
              "poi": "default"
            },
            {
              "target": "vector_arrow_b",
              "type": "predicate",
              "augmentation": "anim_vector_addition",
              "poi": "head"
            },
            {
              "target": "vector_arrow_b",
              "type": "predicate",
              "augmentation": "label_resultant",
              "poi": "head",
              "text": "Resultant R = A + B"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_addition"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
