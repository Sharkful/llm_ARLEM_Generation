  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion",
    "description": "An AR lab guiding students from the abstract concept of vectors (magnitude, direction, addition, decomposition) through to applied two-dimensional projectile motion, including exploration of the 45-degree maximum range result and a free sandbox for consolidating intuition.",
    "language": "en",
    "workplace": "wp_vectors_projectile",
    "start": "step1_intro_vectors",
    "actions": [
      {
        "id": "step1_intro_vectors",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_vector_space",
        "predicate": "narration_intro_vectors",
        "instruction": {
          "title": "Introducing Vectors",
          "description": "A single arrow floats before you, tail fixed at the origin. Grab the head and drag it around in 3D space. Notice the magnitude (length) and direction labels update in real time. Unlike scalars (mass, temperature), vectors have both size and direction. Rotate around the arrow to confirm it doesn't change - only your viewpoint does."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "anim_single_vector",
              "poi": "default"
            },
            {
              "target": "place_vector_space",
              "type": "predicate",
              "augmentation": "anim_axes_ground_lines",
              "poi": "default"
            },
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "label_magnitude",
              "poi": "head",
              "text": "Magnitude: -- units"
            },
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "label_direction",
              "poi": "axis_label_spot",
              "text": "Direction: -- deg"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_intro_vectors"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
