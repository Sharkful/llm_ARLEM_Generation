        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_launch_plane",
        "predicate": "narration_transition_projectile",
        "instruction": {
          "title": "From Vectors to Projectile Motion",
          "description": "The 3D vector workspace gives way to a 2D vertical plane with labeled horizontal and vertical axes. Because gravity acts only downward and no horizontal force acts on the projectile, the motion stays within a single vertical plane. A ball rests at the left of the plane with an initial velocity vector pointing up and to the right."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_launch_plane",
              "type": "predicate",
