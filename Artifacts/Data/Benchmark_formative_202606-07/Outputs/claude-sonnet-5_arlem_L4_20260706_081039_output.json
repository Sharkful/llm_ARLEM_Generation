      {
        "id": "step3_vector_decomposition",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens_1",
        "location": "place_vector_space",
        "predicate": "narration_decomposition",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "The neutral vector is broken into x, y, and z components, laid tip-to-tail: x from origin, y from x's tip, z from y's tip, ending at the original vector's head. Grab and resize each component - watch the original vector update to match the new sum. Decomposition is just addition in reverse. In 2D, magnitude and components form a right triangle via the Pythagorean theorem."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "anim_vector_decomposition",
              "poi": "default"
            },
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "label_component_x",
              "poi": "tail",
              "text": "X component"
            },
            {
              "target": "vector_arrow_a",
              "type": "predicate",
              "augmentation": "label_component_y",
              "poi": "head",
              "text": "Y component"
            },
            {
              "target": "learner_1",
              "type": "predicate",
              "augmentation": "narration_decomposition"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
