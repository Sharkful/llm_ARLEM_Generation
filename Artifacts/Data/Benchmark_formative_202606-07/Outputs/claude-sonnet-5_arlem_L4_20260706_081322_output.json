            "duration": 2000,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_edg_vs_molecular_geometry",
        "viewport": "actions",
        "type": "actions",
        "device": "hololens1",
        "location": "central_workspace",
        "predicate": "narration_edg_vs_mg",
        "instruction": {
          "title": "Electron-Domain Geometry vs. Molecular Geometry",
          "description": "The tetrahedral arrangement returns with four bonding domains shown as solid bonds (methane, CH4) \u2014 electron-domain geometry and molecular geometry both read tetrahedral. Watch as one bonded atom is replaced by a lone pair (ammonia, NH3): the molecular geometry becomes trigonal pyramidal while the electron-domain geometry stays tetrahedral. A second replacement (water, H2O) yields a bent molecular geometry. Click Continue when you can explain the difference."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "anim_lone_pair_swap",
              "poi": "default"
            },
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "narration_edg_vs_mg",
              "poi": "default"
            },
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "label_edg_name",
              "poi": "slot_a",
              "text": "Electron-Domain Geometry: Tetrahedral"
            },
            {
              "target": "molecule_kit",
              "type": "predicate",
              "augmentation": "label_mg_name",
              "poi": "slot_b",
              "text": "Molecular Geometry: Tetrahedral \u2192 Trigonal Pyramidal \u2192 Bent"
            }
          ],
          "deactivate": [],
