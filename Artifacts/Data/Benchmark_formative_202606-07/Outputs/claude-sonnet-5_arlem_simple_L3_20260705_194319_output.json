  "activity": {
    "id": "act_retrograde_motion_lab",
    "name": "Why Does Mars Go Backward? Exploring Apparent Retrograde Motion",
    "description": "A guided AR exploration in which students observe Mars's apparent retrograde loop from Earth's surface, then shift to a heliocentric outside view to understand the relative-motion explanation, compare geocentric vs heliocentric models, practice predicting retrograde episodes, and compare Mars's loop to those of Jupiter and Saturn.",
    "workplace": "wp_retrograde_motion",
    "start": "step1_earth_view",
    "actions": [
      {
        "id": "step1_earth_view",
        "instruction": {
          "title": "Watch Mars from Earth's Surface",
          "description": "Stand at the Earth-Based Sky Observation Station and observe the star chart. Over the simulated weeks, track Mars's position against the background stars. Notice how it normally drifts eastward, then slows, loops westward, and resumes eastward motion. Click 'Next' when you have observed a full loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_star_chart",
              "type": "predicate",
              "augmentation": "pred_mars_night_sky_path",
              "poi": "default"
            },
            {
              "target": "thing_star_chart",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "default"
            },
            {
              "target": "thing_star_chart",
              "type": "predicate",
              "augmentation": "pred_loop_label",
              "poi": "constellation_zone",
              "text": "Retrograde Loop Region"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_star_chart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step1"
          }
        ]
      },
      {
        "id": "step2_geocentric_explanation",
        "instruction": {
          "title": "The Geocentric Puzzle: Epicycles",
          "description": "Before exploring the modern explanation, examine how ancient astronomers accounted for this loop using the geocentric model. Observe the epicycle animation showing Mars looping on a small circle while orbiting Earth on a larger circle. Consider how complex this explanation must become to match observations."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_geocentric_epicycle_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_mars",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step2"
          }
        ]
      },
      {
        "id": "step3_heliocentric_outside_view",
        "instruction": {
          "title": "Step Outside the Solar System",
          "description": "Move to the Outside Solar System Overview Platform. Watch Earth and Mars both orbit the Sun smoothly. Notice that Earth, on its faster inner orbit, catches up to and passes Mars. Observe how this overtaking motion, viewed from Earth, produces the illusion of Mars moving backward -- just like a car in the next lane appears to drift backward when you pass it."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_heliocentric_overview",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_anim",
              "poi": "wide_view"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_overtake_carpass_anim",
              "poi": "overtake_point"
            },
            {
              "target": "place_heliocentric_overview",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_heliocentric_overview",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_platform_confirm"
          },
          {
            "mode": "click",
            "id": "next_step3"
          }
        ]
      },
      {
        "id": "step4_compare_models",
        "instruction": {
          "title": "Geocentric vs. Heliocentric: Which Model Wins?",
          "description": "Compare the two explanations you just observed side by side. The geocentric model requires an extra small loop (epicycle) bolted onto Mars's main orbit to match observations. The heliocentric model produces the same loop naturally from simple relative motion. Reflect on why scientists favor the simpler, more parsimonious explanation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_geocentric_epicycle_anim",
              "poi": "default"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbit_anim",
              "poi": "default"
            },
            {
              "target": "place_heliocentric_overview",
              "type": "predicate",
              "augmentation": "pred_parsimony_label",
              "poi": "default",
              "text": "Simpler Model = Fewer Assumptions Needed"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step4"
          }
        ]
      },
      {
        "id": "step5_predict_retrograde",
        "instruction": {
          "title": "Predict the Next Retrograde Episode",
          "description": "Using the orbital alignment diagram, examine the relative positions of Earth and Mars along their orbits. Identify the alignment configuration where Earth is about to overtake Mars, and predict approximately when the next retrograde episode will begin. Click when you have identified the correct alignment."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_heliocentric_overview",
              "type": "predicate",
              "augmentation": "pred_prediction_diagram",
              "poi": "default"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_heliocentric_overview",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_earth",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step5"
          }
        ]
      },
      {
        "id": "step6_compare_jupiter_saturn",
        "instruction": {
          "title": "Comparing Mars, Jupiter, and Saturn",
          "description": "Examine the comparison panel showing the retrograde loops of Mars, Jupiter, and Saturn side by side. Notice that Jupiter's loop is smaller than Mars's, and Saturn's is smaller still. Consider how increasing distance from the Sun reduces the relative-motion effect between Earth and the outer planet, producing a smaller apparent loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_jupiter_saturn",
              "type": "predicate",
              "augmentation": "pred_jupiter_saturn_compare_anim",
              "poi": "default"
            },
            {
              "target": "thing_jupiter_saturn",
              "type": "predicate",
              "augmentation": "pred_narration_audio",
              "poi": "default"
            },
            {
              "target": "thing_jupiter_saturn",
              "type": "predicate",
              "augmentation": "pred_loop_label",
              "poi": "default",
              "text": "Smaller Loops at Greater Distance"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_jupiter_saturn",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
