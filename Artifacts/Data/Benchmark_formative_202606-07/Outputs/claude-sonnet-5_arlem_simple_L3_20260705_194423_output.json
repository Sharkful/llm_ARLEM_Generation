  "activity": {
    "id": "activity_dna_structure_replication",
    "name": "DNA Double Helix Structure and Semiconservative Replication",
    "description": "A guided AR lab in which students examine the 3D structure of the DNA double helix, learn complementary base-pairing rules, understand antiparallel strand orientation, and trace the enzymatic steps of semiconservative DNA replication including leading/lagging strand synthesis.",
    "workplace": "wp_dna_structure_replication",
    "start": "step1_intro_helix",
    "actions": [
      {
        "id": "step1_intro_helix",
        "instruction": {
          "title": "The Double Helix",
          "description": "Observe the 3D model of DNA. Notice the two sugar-phosphate backbones spiraling around a common axis, forming the iconic double helix shape. Rotate around the model to appreciate its three-dimensional structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "anim_helix_rotate",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "narration_intro_helix",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand1",
              "text": "Sugar-Phosphate Backbone"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_backbone",
              "poi": "backbone_strand2",
              "text": "Sugar-Phosphate Backbone"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_base_pairing"
          }
        ]
      },
      {
        "id": "step2_base_pairing",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Examine how the four nitrogenous bases\u2014adenine, thymine, guanine, cytosine\u2014project inward from each backbone and pair across the helix. Adenine pairs with thymine via two hydrogen bonds; guanine pairs with cytosine via three hydrogen bonds. Tap or scan the base-pairing panel to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "base_pair_panel",
              "type": "predicate",
              "augmentation": "img_at_pairing",
              "poi": "at_pair"
            },
            {
              "target": "base_pair_panel",
              "type": "predicate",
              "augmentation": "img_gc_pairing",
              "poi": "gc_pair"
            },
            {
              "target": "base_pair_panel",
              "type": "predicate",
              "augmentation": "label_bases",
              "poi": "at_pair",
              "text": "A=T (2 H-bonds)"
            },
            {
              "target": "base_pair_panel",
              "type": "predicate",
              "augmentation": "label_bases",
              "poi": "gc_pair",
              "text": "G\u2261C (3 H-bonds)"
            },
            {
              "target": "base_pair_panel",
              "type": "predicate",
              "augmentation": "narration_base_pairing",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "base_pair_panel",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_base_pair_panel",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "next_to_antiparallel"
          }
        ]
      },
      {
        "id": "step3_antiparallel_orientation",
        "instruction": {
          "title": "Antiparallel Strand Orientation",
          "description": "Trace the directionality of each backbone. One strand runs 5' to 3', while the complementary strand runs 3' to 5' in the opposite direction. This antiparallel arrangement is essential to the helix's structure and to how replication proceeds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "anim_antiparallel_flow",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_antiparallel_5to3",
              "poi": "backbone_strand1",
              "text": "5' \u2192 3'"
            },
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "label_antiparallel_3to5",
              "poi": "backbone_strand2",
              "text": "3' \u2192 5'"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_fork_unwinding"
          }
        ]
      },
      {
        "id": "step4_fork_unwinding",
        "instruction": {
          "title": "Unwinding the Helix at the Replication Fork",
          "description": "Scan the replication fork diagram. Helicase unwinds the double helix at the replication fork, separating the two parental strands. Single-strand binding proteins (SSB) attach to the exposed single strands to keep them stable and prevent re-annealing."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_helicase_unwind",
              "poi": "fork_point"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "narration_unwinding",
              "poi": "default"
            },
            {
              "target": "enzyme_toolkit",
              "type": "predicate",
              "augmentation": "label_helicase",
              "poi": "helicase_slot",
              "text": "Helicase"
            },
            {
              "target": "enzyme_toolkit",
              "type": "predicate",
              "augmentation": "label_ssb",
              "poi": "ssb_slot",
              "text": "Single-Strand Binding Proteins"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "enzyme_toolkit",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_replication_fork",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "next_to_leading_lagging"
          }
        ]
      },
      {
        "id": "step5_leading_lagging_strands",
        "instruction": {
          "title": "Leading and Lagging Strand Synthesis",
          "description": "DNA polymerase synthesizes new strands only in the 5' to 3' direction. Because the template strands are antiparallel, the leading strand is synthesized continuously toward the fork, while the lagging strand is synthesized discontinuously away from the fork as Okazaki fragments, later joined together by DNA ligase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_leading_strand_synthesis",
              "poi": "leading_strand_site"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "anim_lagging_strand_synthesis",
              "poi": "lagging_strand_site"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "label_okazaki_fragments",
              "poi": "lagging_strand_site",
              "text": "Okazaki Fragments"
            },
            {
              "target": "enzyme_toolkit",
              "type": "predicate",
              "augmentation": "label_polymerase",
              "poi": "polymerase_slot",
              "text": "DNA Polymerase"
            },
            {
              "target": "enzyme_toolkit",
              "type": "predicate",
              "augmentation": "label_ligase",
              "poi": "ligase_slot",
              "text": "DNA Ligase"
            },
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "narration_leading_lagging",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "enzyme_toolkit",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_semiconservative"
          }
        ]
      },
      {
        "id": "step6_semiconservative_summary",
        "instruction": {
          "title": "Semiconservative Replication: The Result",
          "description": "Move to the daughter molecule display. Each daughter DNA molecule is composed of one original parental strand (conserved) and one newly-synthesized strand\u2014this is why replication is called semiconservative. Compare the two daughter molecules and review the full replication process."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "img_semiconservative_diagram",
              "poi": "default"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "label_daughter_original",
              "poi": "daughter1_slot",
              "text": "Original Parental Strand"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "label_daughter_new",
              "poi": "daughter1_slot",
              "text": "Newly Synthesized Strand"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "label_daughter_original",
              "poi": "daughter2_slot",
              "text": "Original Parental Strand"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "label_daughter_new",
              "poi": "daughter2_slot",
              "text": "Newly Synthesized Strand"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "narration_semiconservative",
              "poi": "default"
            },
            {
              "target": "daughter_molecule_display",
              "type": "predicate",
              "augmentation": "video_replication_overview",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "daughter_molecule_display",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "anchor_daughter_zone",
            "duration": 2000
          },
          {
