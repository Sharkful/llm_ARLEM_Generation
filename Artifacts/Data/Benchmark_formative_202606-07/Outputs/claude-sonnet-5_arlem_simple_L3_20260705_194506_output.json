  "activity": {
    "id": "act_heart_circulation_lab",
    "name": "Heart Structure and Blood Flow Lab",
    "description": "An AR-guided exploration of the four heart chambers, four valves, and major vessels, followed by tracing the dual-loop pulmonary and systemic circulation and comparing right vs. left ventricular wall thickness.",
    "workplace": "wp_heart_anatomy",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "Introduction to the Heart",
          "description": "Point your device at the heart model on the table. Listen to the overview narration describing the heart as a dual-pump organ, then tap Start to begin identifying its chambers."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_intro_heart",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/images/heart_overview_labeled.png"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_next"
          },
          {
            "mode": "detect",
            "id": "marker_heart_model",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step2_chambers_valves",
        "instruction": {
          "title": "Four Chambers and Four Valves",
          "description": "Identify the right atrium, right ventricle, left atrium, and left ventricle, along with the tricuspid, pulmonary, mitral, and aortic valves. Labels will appear at each structure on the heart model as the narration explains their roles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "audio_chambers_valves",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_ra",
              "poi": "poi_ra",
              "text": "Right Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_rv",
              "poi": "poi_rv",
              "text": "Right Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_la",
              "poi": "poi_la",
              "text": "Left Atrium"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_chamber_lv",
              "poi": "poi_lv",
              "text": "Left Ventricle"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve_tricuspid",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve_pulmonary",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve_mitral",
              "poi": "poi_mitral",
              "text": "Mitral Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_valve_aortic",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_valve_open_close",
              "poi": "poi_tricuspid"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_next"
          }
        ]
      },
      {
        "id": "step3_major_vessels",
        "instruction": {
          "title": "Major Vessels Entering and Leaving the Heart",
          "description": "Examine the superior and inferior vena cava, pulmonary arteries and veins, and the aorta. These vessels carry blood into and out of the heart's chambers. Labels appear at each vessel's attachment point."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_svc",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_ivc",
              "poi": "poi_ivc",
              "text": "Inferior Vena Cava"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_pulm_artery",
              "poi": "poi_pulm_artery",
              "text": "Pulmonary Arteries"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_pulm_vein",
              "poi": "poi_pulm_vein",
              "text": "Pulmonary Veins"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "label_vessel_aorta",
              "poi": "poi_aorta",
              "text": "Aorta"
            },
            {
              "target": "vessel_diagram_board",
              "type": "predicate",
              "augmentation": "img_circulation_diagram",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "vessel_diagram_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_next"
          },
          {
            "mode": "detect",
            "id": "marker_vessel_board",
            "duration": 1500
          }
        ]
      },
      {
        "id": "step4_pulmonary_circuit",
        "instruction": {
          "title": "Tracing the Pulmonary Circuit",
          "description": "Move to the Right Heart station. Watch the animation trace deoxygenated blood entering the right atrium, passing through the tricuspid valve into the right ventricle, then through the pulmonary valve and pulmonary arteries to the lungs, returning oxygenated via the pulmonary veins to the left atrium."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "right_heart_zone",
              "type": "predicate",
              "augmentation": "audio_pulmonary_circuit",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_blood_flow_pulmonary",
              "poi": "default"
            },
            {
              "target": "vessel_diagram_board",
              "type": "predicate",
              "augmentation": "img_circulation_diagram",
              "poi": "poi_pulmonary_loop"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "right_heart_zone",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "vessel_diagram_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_atrium_zone",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step4_next"
          }
        ]
      },
      {
        "id": "step5_systemic_circuit",
        "instruction": {
          "title": "Tracing the Systemic Circuit",
          "description": "Move to the Left Heart station. Watch the animation trace oxygenated blood from the left atrium through the mitral valve into the left ventricle, then through the aortic valve and aorta out to systemic circulation, delivering oxygen throughout the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "left_heart_zone",
              "type": "predicate",
              "augmentation": "audio_systemic_circuit",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "anim_blood_flow_systemic",
              "poi": "default"
            },
            {
              "target": "vessel_diagram_board",
              "type": "predicate",
              "augmentation": "img_circulation_diagram",
              "poi": "poi_systemic_loop"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "left_heart_zone",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "heart_model",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "vessel_diagram_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_left_zone",
            "duration": 2000
          },
          {
            "mode": "click",
            "id": "step5_next"
          }
        ]
      },
      {
        "id": "step6_wall_thickness",
        "instruction": {
          "title": "Why the Left Ventricle Wall is Thicker",
          "description": "Examine the sectioned heart model. Compare the myocardial wall thickness of the left ventricle to the right ventricle. The left ventricle must generate enough pressure to pump blood through the entire systemic circulation, while the right ventricle only pumps to the nearby lungs, so the left wall is substantially thicker."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cross_section_model",
              "type": "predicate",
              "augmentation": "audio_wall_thickness",
              "poi": "default"
            },
            {
              "target": "cross_section_model",
              "type": "predicate",
              "augmentation": "img_wall_thickness_compare",
              "poi": "poi_lv_wall"
            },
            {
              "target": "cross_section_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_lv_wall",
              "text": "Left Ventricle Wall (thick)"
            },
            {
              "target": "cross_section_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_rv_wall",
              "text": "Right Ventricle Wall (thin)"
            }
          ],
          "deactivate": []
        },
