  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion",
    "description": "A guided AR lab where students explore vector addition and decomposition using an interactive vector board and axis grid, then apply these vector concepts to analyze the independent horizontal and vertical motions of a launched projectile, observing how launch angle and speed affect trajectory, range, and maximum height.",
    "workplace": "wp_vectors_projectile",
    "start": "step1_intro_vectors",
    "actions": [
      {
        "id": "step1_intro_vectors",
        "instruction": {
          "title": "Introducing Vectors",
          "description": "Look at the Vector Board. Two vectors, A (red) and B (blue), are displayed. Notice each has both a magnitude (length) and a direction (arrow orientation). Tap 'Next' when ready to add these vectors together."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_vector_arrow_A",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_vector_arrow_B",
              "poi": "tipA"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_narration_audio"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next1"
          }
        ]
      },
      {
        "id": "step2_tip_to_tail",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Watch as vector B slides so its tail meets the tip of vector A. The resultant vector (green) is drawn from the tail of A to the tip of B. This is the tip-to-tail method of vector addition. Tap 'Next' to move to vector components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_tip_to_tail_anim",
              "poi": "tipA"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_resultant_arrow",
              "poi": "default"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "tipB"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_board",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next2"
          }
        ]
      },
      {
        "id": "step3_components",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "Move to the Axis Grid. A single vector is shown with a right-triangle overlay. The horizontal component lies along the x-axis and the vertical component lies along the y-axis. Use trigonometry (cosine for x, sine for y) to relate the vector's magnitude and angle to its components. Tap 'Next' to begin the projectile motion module."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "axis_grid",
              "type": "predicate",
              "augmentation": "pred_right_triangle",
              "poi": "default"
            },
            {
              "target": "axis_grid",
              "type": "predicate",
              "augmentation": "pred_component_x_arrow",
              "poi": "x_axis_point"
            },
            {
              "target": "axis_grid",
              "type": "predicate",
              "augmentation": "pred_component_y_arrow",
              "poi": "y_axis_point"
            },
            {
              "target": "axis_grid",
              "type": "predicate",
              "augmentation": "pred_angle_arc_label",
              "poi": "default",
              "text": "\u03b8"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "axis_grid",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next3"
          },
          {
            "mode": "detect",
            "id": "marker_launcher",
            "duration": 2000
          }
        ]
      },
      {
        "id": "step4_launch_setup",
        "instruction": {
          "title": "Setting Up the Projectile Launch",
          "description": "Point your device at the Projectile Launcher. The initial velocity vector at the muzzle is decomposed into a constant horizontal component and a changing vertical component. Tap 'Launch' to fire the projectile and observe its motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "pred_velocity_vector_h",
              "poi": "muzzle"
            },
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "pred_velocity_vector_v",
              "poi": "muzzle"
            },
            {
              "target": "projectile_launcher",
              "type": "predicate",
              "augmentation": "pred_launch_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "launch"
          }
        ]
      },
      {
        "id": "step5_flight_independence",
        "instruction": {
          "title": "Independent Horizontal and Vertical Motion",
          "description": "Watch the projectile follow its parabolic path in the Trajectory Landing Zone. Notice the horizontal velocity arrow stays constant in length while the vertical velocity arrow shrinks to zero at the apex, then grows again pointing downward. This demonstrates that gravity affects only the vertical motion, leaving horizontal motion unchanged. Tap 'Next' to explore the point of maximum height."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_trajectory_path",
              "poi": "default"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_velocity_vector_h",
              "poi": "apex_marker"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_velocity_vector_v",
              "poi": "apex_marker"
            },
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_independence_narration"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_velocity_vector_v"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next5"
          }
        ]
      },
      {
        "id": "step6_max_height_apex",
        "instruction": {
          "title": "Maximum Height: Where Vertical Velocity is Zero",
          "description": "At the apex of the trajectory, the vertical velocity component momentarily equals zero while the horizontal velocity remains unchanged. This is the moment of maximum height. Tap 'Next' to experiment with changing launch angle and speed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_apex_label",
              "poi": "apex_marker",
              "text": "Max Height: v_y = 0"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "pred_magnitude_label",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "trajectory_zone",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "projectile_ball",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next6"
          }
        ]
      },
      {
        "id": "step7_angle_speed_exploration",
        "instruction": {
          "title": "Exploring Launch Angle and Speed",
          "description": "Watch the comparison video showing how changing the launch angle and initial speed affects the projectile's range and maximum height. Notice that for a fixed speed, a 45-degree launch angle produces the maximum range. Tap 'Finish' to complete the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "trajectory_zone",
              "type": "predicate",
              "augmentation": "pred_range_height_video",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish"
          }
        ]
      }
    ]
  }
