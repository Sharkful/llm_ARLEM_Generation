  "activity": {
    "id": "vsepr_activity",
    "name": "VSEPR Theory: Predicting Molecular Geometry",
    "description": "A guided AR lab in which students derive steric numbers from Lewis structures, explore the five fundamental electron-domain geometries, observe how lone pairs distort molecular geometry, and compare VSEPR predictions to real molecules like water, ammonia, methane, PF5, SF6, and XeF4.",
    "workplace": "vsepr_workplace",
    "start": "step1_steric_number",
    "actions": [
      {
        "id": "step1_steric_number",
        "instruction": {
          "title": "Determine the Steric Number",
          "description": "Examine the Lewis structure projected above the central atom model. Count the number of bonding pairs and lone pairs surrounding the central atom to determine its steric number. This number is the key input for predicting geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "lewis_structure_image",
              "poi": "above",
              "url": "https://assets.example.com/images/lewis_structure.png"
            },
            {
              "target": "central_atom",
              "type": "predicate",
              "augmentation": "narration_audio",
              "poi": "default",
              "url": "https://assets.example.com/audio/intro_steric_number.mp3"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "central_atom",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step1"
          }
        ]
      },
      {
        "id": "step2_electron_domain_geometry",
        "instruction": {
          "title": "Explore Electron-Domain Geometries",
          "description": "Place the electron domain cluster on the geometry workspace. Watch as the domains repel one another and settle into one of the five fundamental arrangements: linear, trigonal planar, tetrahedral, trigonal bipyramidal, or octahedral, based on the steric number you determined."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "electron_domain_set",
              "type": "predicate",
              "augmentation": "electron_repulsion_animation",
              "poi": "default"
            },
            {
              "target": "geometry_zone",
              "type": "predicate",
              "augmentation": "geometry_settle_animation",
              "poi": "default"
            },
            {
              "target": "geometry_zone",
              "type": "predicate",
              "augmentation": "geometry_name_label",
              "poi": "default",
              "text": "Electron-Domain Geometry"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "electron_domain_set",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "geometry_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "geometry_zone",
            "duration": 3
          },
          {
            "mode": "click",
            "id": "next_step2"
          }
        ]
      },
      {
        "id": "step3_lone_pair_effect",
        "instruction": {
          "title": "Lone Pairs and Molecular Geometry",
          "description": "Replace one or more bonding pairs with lone pairs on the electron domain cluster. Observe how the lone pairs occupy more angular space than bonding pairs, pushing bonding pairs closer together and changing the molecular geometry (e.g., bent, trigonal pyramidal, seesaw, T-shaped, square planar, square pyramidal)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "electron_domain_set",
              "type": "predicate",
              "augmentation": "lone_pair_space_animation",
              "poi": "above"
            },
            {
              "target": "geometry_zone",
              "type": "predicate",
              "augmentation": "bond_angle_label",
              "poi": "default",
              "text": "Bond angle deviates from ideal due to lone pair repulsion"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "electron_domain_set",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "geometry_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step3"
          }
        ]
      },
      {
        "id": "step4_bond_angle_deviation",
        "instruction": {
          "title": "Why Bond Angles Deviate",
          "description": "Compare the idealized tetrahedral angle of 109.5 degrees in methane to the compressed 104.5 degree angle in water. Because lone pairs are held closer to the nucleus and spread out more than bonding pairs, they compress the angles between bonding pairs, producing these characteristic deviations."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "molecule_shape_video",
              "poi": "default",
              "url": "https://assets.example.com/videos/bond_angle_comparison.mp4"
            },
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "bond_angle_label",
              "poi": "label_spot",
              "text": "H2O: 104.5 deg | CH4: 109.5 deg"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "molecule_gallery",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step4"
          }
        ]
      },
      {
        "id": "step5_real_molecule_comparison",
        "instruction": {
          "title": "Compare Predictions to Real Molecules",
          "description": "Move to the comparison zone and view the gallery of real molecules: water, ammonia, methane, PF5, SF6, and XeF4. For each, match the VSEPR-predicted geometry to its experimentally observed structure, reinforcing the predictive power of the model."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "comparison_zone",
              "type": "predicate",
              "augmentation": "comparison_table_image",
              "poi": "default",
              "url": "https://assets.example.com/images/vsepr_comparison_table.png"
            },
            {
              "target": "molecule_gallery",
              "type": "predicate",
              "augmentation": "steric_number_label",
              "poi": "label_spot",
              "text": "Predicted vs Observed Geometries"
            },
            {
              "target": "comparison_zone",
              "type": "predicate",
              "augmentation": "narration_audio",
              "poi": "default",
              "url": "https://assets.example.com/audio/summary_comparison.mp3"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "comparison_zone",
            "duration": 2
          },
          {
            "mode": "click",
            "id": "finish"
          }
        ]
      }
    ]
  }
}