      {
        "id": "molecule_gallery_marker",
        "type": "marker",
        "url": "https://assets.example.com/markers/molecule_gallery.bundle"
      },
      {
        "id": "geometry_zone_anchor",
        "type": "anchor",
        "url": "https://assets.example.com/anchors/geometry_zone.bundle"
      },
      {
