  "activity": {
    "id": "activity_retrograde_motion_lab",
    "name": "Apparent Retrograde Motion of Mars: From Puzzle to Resolution",
    "description": "A 7-step AR lab guiding students from the observed puzzle of Mars's apparent retrograde loop, through the geocentric epicycle explanation, to the heliocentric resolution, an embodied overtaking demonstration, comparison with Jupiter and Saturn, a prediction challenge, and a closing recap.",
    "workplace": "wp_retrograde_motion",
    "start": "step_night_sky_observation",
    "actions": [
      {
        "id": "step_night_sky_observation",
        "instruction": {
          "title": "The Puzzle: Mars Reverses Course",
          "description": "Stand on virtual Earth at night and watch the ecliptic constellations Leo, Virgo, Libra, and Scorpio. Observe Mars as a red point drifting eastward, then slowing, looping westward for about two months, and finally resuming eastward motion. Watch the trail mark its full path."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_starfield_ecliptic",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_mars_retrograde_trail",
              "poi": "default"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_narration_puzzle",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step"
          },
          {
            "mode": "detect",
            "id": "anchor_earth_sky",
            "duration": 3
          }
        ]
      },
      {
        "id": "step_geocentric_epicycles",
        "instruction": {
          "title": "The Geocentric Explanation: Epicycles",
          "description": "Earth sits at the center. Watch Mars ride a small epicycle that itself rides a larger deferent circle. When Mars reaches the inner part of its epicycle closest to Earth, its combined motion produces the apparent backward loop. Note how this model requires carefully tuned circle sizes and speeds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_epicycle_deferent",
              "type": "predicate",
              "augmentation": "pred_epicycle_deferent_anim",
              "poi": "default"
            },
            {
              "target": "thing_epicycle_deferent",
              "type": "predicate",
              "augmentation": "pred_label_epicycle",
              "poi": "poi_epicycle_label",
              "text": "Epicycle"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_deferent",
              "poi": "poi_label_above",
              "text": "Deferent"
            },
            {
              "target": "thing_epicycle_deferent",
              "type": "predicate",
              "augmentation": "pred_narration_geocentric",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step"
          },
          {
            "mode": "detect",
            "id": "anchor_geocentric",
            "duration": 3
          }
        ]
      },
      {
        "id": "step_heliocentric_view",
        "instruction": {
          "title": "The Heliocentric Resolution",
          "description": "Rise above the ecliptic plane to view the Sun-centered solar system. Watch Earth orbit at 1 AU (1 year period) and Mars orbit at 1.52 AU (1.88 year period). See Earth catch up to and overtake Mars roughly every 26 months, reproducing the retrograde loop with no epicycles needed \u2014 just two smooth ellipses."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits_anim",
              "poi": "default"
            },
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_narration_heliocentric",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step"
          },
          {
            "mode": "detect",
            "id": "anchor_heliocentric",
            "duration": 3
          }
        ]
      },
      {
        "id": "step_linking_views",
        "instruction": {
          "title": "Linking the Two Perspectives",
          "description": "View the heliocentric model and Earth's night sky side by side. Watch a line of sight sweep from Earth through Mars to the background stars: eastward during normal motion, then reversing westward as Earth overtakes Mars, matching Mars's retrograde loop in the sky view. This is real apparent motion produced by geometry, not an illusion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_dual_view_video",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_sightline_sweep_anim",
              "poi": "default"
            },
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_narration_linkage",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step"
          },
          {
            "mode": "detect",
            "id": "anchor_heliocentric",
            "duration": 3
          }
        ]
      },
      {
        "id": "step_embodied_overtaking",
        "instruction": {
          "title": "Embodied Overtaking: Walk Earth's Orbit",
          "description": "Stand at the center of the starfield with a stationary Mars ahead of you. Walk slowly around the small floor circle representing Earth's orbit while keeping your gaze on Mars. Notice Mars drift across the constellations, then appear to move backward as you pass the point of closest approach \u2014 you have generated retrograde motion yourself."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_starfield_ecliptic",
              "poi": "default"
            },
            {
              "target": "thing_earth_model",
              "type": "predicate",
              "augmentation": "pred_walk_circle_marker",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_narration_embodied",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "anchor_walk_circle",
            "duration": 5
          },
          {
            "mode": "click",
            "id": "next_step"
          }
        ]
      },
      {
        "id": "step_outer_planet_comparison",
        "instruction": {
          "title": "Comparing Mars, Jupiter, and Saturn",
          "description": "Return to the heliocentric view, now including Jupiter (5.2 AU) and Saturn (9.5 AU). Step through a retrograde event for each planet: Mars loops about 15 degrees, Jupiter about 10 degrees, Saturn about 7 degrees. More distant planets show smaller loops because Earth's orbital motion subtends a smaller angle from farther away."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_outer_planets_compare_anim",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "pred_label_loop_degrees",
              "poi": "poi_label_above",
              "text": "~15\u00b0"
            },
            {
              "target": "thing_jupiter",
              "type": "predicate",
              "augmentation": "pred_label_loop_degrees",
              "poi": "default",
              "text": "~10\u00b0"
            },
            {
              "target": "thing_saturn",
              "type": "predicate",
              "augmentation": "pred_label_loop_degrees",
              "poi": "default",
              "text": "~7\u00b0"
            },
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_narration_comparison",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step"
          },
          {
            "mode": "detect",
            "id": "anchor_heliocentric",
            "duration": 3
          }
        ]
      },
      {
        "id": "step_prediction_challenge",
        "instruction": {
          "title": "Prediction Challenge: Where Will Retrograde Occur?",
          "description": "With Earth fixed on its orbit, drag Mars around its own orbit while watching the inset panel showing the corresponding Earth-observer view. Place Mars near opposition, where Earth is poised to overtake it, to trigger the retrograde loop in the inset. Repeat with Earth at a new position to confirm it's the relative geometry that matters."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_stage",
              "type": "predicate",
              "augmentation": "pred_heliocentric_orbits_anim",
              "poi": "default"
            },
            {
              "target": "thing_prediction_panel",
              "type": "predicate",
              "augmentation": "pred_prediction_inset_video",
              "poi": "default"
            },
            {
              "target": "thing_prediction_panel",
              "type": "predicate",
              "augmentation": "pred_narration_prediction",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_prediction_panel",
            "duration": 3
          },
          {
            "mode": "click",
            "id": "next_step"
          }
        ]
      },
      {
        "id": "step_recap_summary",
        "instruction": {
          "title": "Recap: Five Key Concepts",
          "description": "Review the five concept areas covered: the observed retrograde phenomenon, the geocentric epicycle explanation, the heliocentric resolution, the linkage between the two viewpoints, and the comparison across outer planets. Each area is highlighted in turn as the narration reviews the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "pred_recap_summary_image",
              "poi": "default"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
