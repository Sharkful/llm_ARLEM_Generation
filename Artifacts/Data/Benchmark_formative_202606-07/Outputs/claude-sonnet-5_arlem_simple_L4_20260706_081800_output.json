  "activity": {
    "id": "activity_heart_circulation_lab",
    "name": "Heart Structure and Blood Flow AR Lab",
    "description": "A guided AR exploration of the structural anatomy of the human heart and the dual-circuit path of blood flow, covering chambers, valves, vessels, wall thickness asymmetry, valve function, and quiz-based reinforcement.",
    "workplace": "wp_heart_anatomy",
    "start": "step1_exterior_overview",
    "actions": [
      {
        "id": "step1_exterior_overview",
        "instruction": {
          "title": "Exterior Heart Overview",
          "description": "Two heart models appear side by side: an intact exterior view and a cutaway view. Rotate both to observe overall anatomical orientation, noting the apex points down and slightly left, and that anatomical left/right are reversed from your viewing perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_heart_rotate_anim",
              "poi": "default"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_heart_rotate_anim",
              "poi": "default"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_intact_heart",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_tour"
          }
        ]
      },
      {
        "id": "step2_structural_tour",
        "instruction": {
          "title": "Guided Structural Tour",
          "description": "Tour the four chambers (right atrium, right ventricle, left atrium, left ventricle), four valves (tricuspid, pulmonary, mitral, aortic), and major vessels (superior/inferior vena cava, pulmonary arteries, pulmonary veins, aorta) on the cutaway model, mapped to landmarks on the intact model."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_ra",
              "text": "Right Atrium"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_rv",
              "text": "Right Ventricle"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_la",
              "text": "Left Atrium"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_lv",
              "text": "Left Ventricle"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Valve"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_mitral",
              "text": "Mitral (Bicuspid) Valve"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_aortic_valve",
              "text": "Aortic Valve"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_svc",
              "text": "Superior Vena Cava"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_ivc",
              "text": "Inferior Vena Cava"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_pulm_trunk",
              "text": "Pulmonary Arteries"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_pulm_veins",
              "text": "Pulmonary Veins"
            },
            {
              "target": "thing_intact_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_aorta",
              "text": "Aorta"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_cutaway_heart",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_intact_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_dual_circuit"
          }
        ]
      },
      {
        "id": "step3_dual_circuit_flow",
        "instruction": {
          "title": "Dual-Circuit Color-Coded Blood Flow",
          "description": "Observe blue (deoxygenated) blood flowing through the right heart and pulmonary arteries, and red (oxygenated) blood flowing through the left heart and pulmonary veins. The pulmonary circuit and systemic circuit are each highlighted in turn to show the two distinct loops of circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_blood_flow_anim",
              "poi": "default"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary Circuit"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_vessel",
              "poi": "poi_aortic_valve",
              "text": "Systemic Circuit"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_cutaway_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_rbc_trace"
          }
        ]
      },
      {
        "id": "step4_rbc_trace",
        "instruction": {
          "title": "Red Blood Cell Trace",
          "description": "Follow a single red blood cell as it travels from the superior vena cava through the right atrium, tricuspid valve, right ventricle, pulmonary valve, pulmonary arteries, lung capillaries (turning from blue to red), pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, aorta, and back through systemic veins. Press next to advance the cell one step at a time; replay as needed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_red_blood_cell",
              "type": "predicate",
              "augmentation": "pred_rbc_trace_anim",
              "poi": "default"
            },
            {
              "target": "thing_red_blood_cell",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_red_blood_cell",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "marker_rbc",
            "duration": 3
          },
          {
            "mode": "click",
            "id": "start_wall_thickness"
          }
        ]
      },
      {
        "id": "step5_wall_thickness",
        "instruction": {
          "title": "Ventricular Wall Thickness Comparison",
          "description": "Compare cross-sections of the right ventricle (thin myocardium, ~3-5mm) and left ventricle (thick myocardium, ~10-15mm) side by side with scale markers, illustrating why the left ventricle must generate much higher pressure to perfuse the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_ventricle_cross_section",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_rv_wall",
              "text": "Right Ventricle Wall (~3-5mm)"
            },
            {
              "target": "thing_ventricle_cross_section",
              "type": "predicate",
              "augmentation": "pred_label_chamber",
              "poi": "poi_lv_wall",
              "text": "Left Ventricle Wall (~10-15mm)"
            },
            {
              "target": "thing_ventricle_cross_section",
              "type": "predicate",
              "augmentation": "pred_scale_marker_image",
              "poi": "poi_rv_wall"
            },
            {
              "target": "thing_ventricle_cross_section",
              "type": "predicate",
              "augmentation": "pred_scale_marker_image",
              "poi": "poi_lv_wall"
            },
            {
              "target": "thing_ventricle_cross_section",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_ventricle_cross_section",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_valve_function"
          }
        ]
      },
      {
        "id": "step6_valve_function",
        "instruction": {
          "title": "Valve Function: Open and Closed States",
          "description": "Explore the atrioventricular valves (tricuspid, mitral) and semilunar valves (pulmonary, aortic) in open and closed states. During ventricular contraction the AV valves close and semilunar valves open; during relaxation the reverse occurs, preventing backflow at each stage."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_valve_models",
              "type": "predicate",
              "augmentation": "pred_valve_open_close_anim",
              "poi": "default"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_tricuspid",
              "text": "Tricuspid (AV Valve)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_mitral",
              "text": "Mitral (AV Valve)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_pulmonary_valve",
              "text": "Pulmonary (Semilunar Valve)"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "predicate",
              "augmentation": "pred_label_valve",
              "poi": "poi_aortic_valve",
              "text": "Aortic (Semilunar Valve)"
            },
            {
              "target": "thing_valve_models",
              "type": "predicate",
              "augmentation": "pred_narration",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_valve_models",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_cutaway_heart",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "start_structure_quiz"
          }
        ]
      },
      {
        "id": "step7_structure_quiz",
