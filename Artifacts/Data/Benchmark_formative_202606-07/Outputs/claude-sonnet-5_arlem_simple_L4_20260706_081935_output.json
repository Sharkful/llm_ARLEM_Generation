  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion",
    "description": "A guided AR lab that introduces vectors as magnitude-direction quantities, teaches vector addition and decomposition, and applies these tools to two-dimensional projectile motion, culminating in a targeting challenge and free-exploration sandbox.",
    "workplace": "wp_vectors_projectile",
    "start": "step1_intro_vector",
    "actions": [
      {
        "id": "step1_intro_vector",
        "instruction": {
          "title": "Introducing the Vector",
          "description": "A single arrow floats in the workspace with its tail at the origin. Grab the head and drag it around to see the magnitude and direction labels update in real time. Vectors have both a size and a direction, unlike scalars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow_single",
              "type": "predicate",
              "augmentation": "anim_single_vector",
              "poi": "default"
            },
            {
              "target": "vector_arrow_single",
              "type": "predicate",
              "augmentation": "label_magnitude",
              "poi": "head",
              "text": "Magnitude: 36.1"
            },
            {
              "target": "vector_arrow_single",
              "type": "predicate",
              "augmentation": "label_direction",
              "poi": "head",
              "text": "Direction: 33.7 deg"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_vectors_intro"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_arrow_single",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_vectors_intro"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step1"
          },
          {
            "mode": "detect",
            "id": "marker_vector_table",
            "duration": 3000
          }
        ]
      },
      {
        "id": "step2_vector_addition",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Two vectors, blue and green, are placed tip-to-tail. A red resultant vector runs from the origin to the head of the second vector. Try swapping the order of the vectors and confirm the resultant stays the same."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_pair",
              "type": "predicate",
              "augmentation": "anim_tip_to_tail",
              "poi": "default"
            },
            {
              "target": "vector_pair",
              "type": "predicate",
              "augmentation": "label_resultant",
              "poi": "resultant_head",
              "text": "Resultant"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_vector_addition"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_pair",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_vector_addition"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step2"
          }
        ]
      },
      {
        "id": "step3_vector_decomposition",
        "instruction": {
          "title": "Decomposing a Vector into Components",
          "description": "A single vector is broken into x, y, and z component arrows placed tip-to-tail, reproducing the original vector. Grab and resize each component to see the original vector update. Decomposition is addition in reverse."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_arrow_single",
              "type": "predicate",
              "augmentation": "anim_component_decomposition",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_decomposition"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_arrow_single",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_decomposition"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step3"
          }
        ]
      },
      {
        "id": "step4_2d_plane_transition",
        "instruction": {
          "title": "Entering the 2D Projectile Plane",
          "description": "The 3D vector workspace gives way to a vertical 2D plane with labeled horizontal and vertical axes. A ball rests at the left with a velocity vector pointing up and to the right. The projectile's motion is confined to this plane."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "image_axes_labels",
              "poi": "default"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_2d_plane_intro"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_2d_plane_intro"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step4"
          },
          {
            "mode": "detect",
            "id": "marker_plane_2d",
            "duration": 3000
          }
        ]
      },
      {
        "id": "step5_projectile_demo",
        "instruction": {
          "title": "Projectile Motion Demonstration",
          "description": "Watch the ball launch with horizontal and vertical velocity components displayed. The horizontal component stays constant while the vertical component shrinks to zero at the peak and grows downward during descent. Switch views to see the parabola from the side or straight down."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "anim_projectile_flight",
              "poi": "launch_point"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "label_horiz_component",
              "poi": "default",
              "text": "Vx (constant)"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "label_vert_component",
              "poi": "apex",
              "text": "Vy = 0 at apex"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_independence"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_ball",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_independence"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step5"
          }
        ]
      },
      {
        "id": "step6_max_range_discovery",
        "instruction": {
          "title": "Discovering the 45-Degree Maximum Range",
          "description": "Set launch angle and speed, then launch and observe the range. A history panel records each attempt. Explore several angles to discover that range is maximized at 45 degrees, and that complementary angles produce equal ranges."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "anim_projectile_flight",
              "poi": "launch_point"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "video_history_panel"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_max_range"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_ball",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "video_history_panel"
            },
            {
              "target": "place_2d_plane",
              "type": "predicate",
              "augmentation": "narration_max_range"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step6"
          }
        ]
      },
      {
        "id": "step7_targeting_challenge",
        "instruction": {
          "title": "Targeting Challenge",
          "description": "A target appears on the ground plane at a fixed distance. Set the launch angle and speed to hit it. Remember that two complementary angles can usually hit the same target. Hit the target to advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "target_marker",
              "type": "predicate",
              "augmentation": "narration_targeting"
            },
            {
              "target": "projectile_ball",
              "type": "predicate",
              "augmentation": "anim_projectile_flight",
              "poi": "launch_point"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "target_marker",
              "type": "predicate",
              "augmentation": "label_target_hit",
              "poi": "default",
              "text": "Target Hit!"
            }
          ],
          "deactivate": [
            {
              "target": "target_marker",
              "type": "predicate",
              "augmentation": "narration_targeting"
            },
            {
              "target": "projectile_ball",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "target_marker",
            "duration": 500
          }
        ]
      },
      {
        "id": "step8_sandbox",
        "instruction": {
          "title": "Free-Exploration Sandbox",
          "description": "Control launch angle, speed, initial height (up to 50m), and gravity strength (0 to 5x Earth gravity). Investigate: what happens to range when gravity is halved? What about launching from a 50m platform - does 45 degrees still maximize range?"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "sandbox_platform",
              "type": "predicate",
              "augmentation": "anim_projectile_flight",
              "poi": "platform_top"
            },
            {
              "target": "sandbox_platform",
              "type": "predicate",
              "augmentation": "narration_sandbox"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "sandbox_platform",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_step8"
          }
        ]
      },
      {
        "id": "step9_recap",
        "instruction": {
          "title": "Lab Recap: Six Key Concepts",
          "description": "Review the six concept areas covered: vectors as magnitude-and-direction quantities, tip-to-tail vector addition, vector decomposition as reversed addition, applying decomposition to projectile motion, independence of horizontal and vertical motion, and the 45-degree maximum range result."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "image_recap_summary",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "type": "predicate",
              "augmentation": "narration_recap"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": true,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_lab"
          }
        ]
      }
    ]
  }
