  "activity": {
    "id": "dna-replication-activity",
    "name": "DNA Replication Activity",
    "description": "Explore the structure and replication of DNA.",
    "workplace": "dna-replication-workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "DNA Double Helix Structure",
          "description": "Examine the DNA double helix. Identify the sugar-phosphate backbones and the nitrogenous bases."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "dna-structure-label",
              "poi": "default"
            },
            {
              "target": "dna-double-helix",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/dna-structure.glb"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1-next-button"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Observe the complementary base pairing: Adenine (A) with Thymine (T) via two hydrogen bonds, and Guanine (G) with Cytosine (C) via three hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "base-pairing-animation",
              "poi": "base-pair-poi"
            }
          ],
          "deactivate": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "dna-structure-label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2-next-button"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Antiparallel Strands",
          "description": "Understand the antiparallel orientation of the DNA strands, with one running 5' to 3' and the other 3' to 5'."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "antiparallel-animation",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "base-pairing-animation"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3-next-button"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Replication Fork Formation",
          "description": "See the replication fork form as helicase unwinds the DNA double helix. Stabilizing proteins bind to the exposed strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "helicase-action-video",
              "poi": "fork-center"
            },
            {
              "target": "dna-parental-strand",
              "type": "primitive",
              "augmentation": "animation",
              "poi": "default",
              "url": "https://assets.example.com/single-strand-binding.glb"
            }
          ],
          "deactivate": [
            {
              "target": "dna-double-helix",
              "type": "predicate",
              "augmentation": "antiparallel-animation"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "replication-fork"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Leading and Lagging Strand Synthesis",
          "description": "DNA polymerase synthesizes the new strands. Observe continuous synthesis on the leading strand and discontinuous synthesis (Okazaki fragments) on the lagging strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "polymerase-action-animation",
              "poi": "new-5-prime"
            },
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "lagging-strand-synthesis-animation",
              "poi": "new-3-prime"
            }
          ],
          "deactivate": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "helicase-action-video"
            },
            {
              "target": "dna-parental-strand",
              "type": "primitive",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5-next-button"
          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Joining Okazaki Fragments",
          "description": "DNA ligase joins the Okazaki fragments on the lagging strand to complete replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "ligase-action-animation",
              "poi": "new-3-prime"
            }
          ],
          "deactivate": [
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "lagging-strand-synthesis-animation"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6-next-button"
          }
        ]
      },
      {
        "id": "step7",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "Understand that each new DNA molecule consists of one parental strand and one newly synthesized strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "cytoplasm",
              "type": "predicate",
              "augmentation": "semiconservative-replication-animation",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "polymerase-action-animation"
            },
            {
              "target": "dna-new-strand",
              "type": "predicate",
              "augmentation": "ligase-action-animation"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step7-complete-button"
          }
        ]
      }
    ]
  }
}