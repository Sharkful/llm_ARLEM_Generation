  "activity": {
    "id": "heart_circulation_activity",
    "name": "Heart Circulation Activity",
    "description": "Trace the path of blood through the human heart.",
    "workplace": "heart_anatomy_workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Welcome to the Heart!",
          "description": "This activity will guide you through the anatomy and blood flow of the human heart. Start by identifying the major external structures. Place the Heart Model marker."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "major_vessels_label"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "heart_model_marker"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Heart Chambers",
          "description": "Now, let's identify the four chambers. Point to or scan the markers for the Aorta, Vena Cava, and Pulmonary Vessels as they are indicated."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "heart_chambers_label"
            },
            {
              "target": "aorta",
              "type": "predicate",
              "augmentation": "major_vessels_label"
            },
            {
              "target": "vena_cava",
              "type": "predicate",
              "augmentation": "major_vessels_label"
            },
            {
              "target": "pulmonary_vessels",
              "type": "predicate",
              "augmentation": "major_vessels_label"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "major_vessels_label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "heart_chambers_label"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Heart Valves",
          "description": "Next, we identify the four valves. Point to or scan the markers for the Heart Model and the Aorta."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "heart_valves_label"
            },
            {
              "target": "aorta",
              "type": "predicate",
              "augmentation": "major_vessels_label"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "heart_chambers_label"
            },
            {
              "target": "aorta",
              "augmentation": "major_vessels_label"
            },
            {
              "target": "vena_cava",
              "augmentation": "major_vessels_label"
            },
            {
              "target": "pulmonary_vessels",
              "augmentation": "major_vessels_label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "heart_valves_label"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Pulmonary Circulation",
          "description": "Follow the path of deoxygenated blood. Scan the Pulmonary Circuit marker."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "tricuspid_valve_closed_animation"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "pulmonary_valve_open_animation"
            },
            {
              "target": "pulmonary_circuit",
              "type": "predicate",
              "augmentation": "deoxygenated_blood_flow_path"
            }
          ],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "heart_valves_label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "pulmonary_circuit"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Systemic Circulation",
          "description": "Now follow the path of oxygenated blood. Scan the Systemic Circuit marker."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "mitral_valve_closed_animation"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "aortic_valve_open_animation"
            },
            {
              "target": "systemic_circuit",
              "type": "predicate",
              "augmentation": "oxygenated_blood_flow_path"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "left_ventricle_animation"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "right_ventricle_animation"
            },
            {
              "target": "heart_model",
              "type": "predicate",
              "augmentation": "ventricle_thickness_comparison"
            }
          ],
          "deactivate": [
            {
              "target": "pulmonary_circuit",
              "augmentation": "deoxygenated_blood_flow_path"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "systemic_circuit"
          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Conclusion",
          "description": "You have successfully traced the path of blood through the heart and understood the functions of its chambers and valves. This concludes the activity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "systemic_circuit",
              "augmentation": "oxygenated_blood_flow_path"
            },
            {
              "target": "heart_model",
              "augmentation": "left_ventricle_animation"
            },
            {
              "target": "heart_model",
              "augmentation": "right_ventricle_animation"
            },
            {
              "target": "heart_model",
              "augmentation": "ventricle_thickness_comparison"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "conclusion_button"
          }
        ]
      }
    ]
  }
}