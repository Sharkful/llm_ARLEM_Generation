  "activity": {
    "id": "activity_vectors_projectile",
    "name": "Vectors and Projectile Motion",
    "description": "An exploration of vectors and their application to projectile motion.",
    "workplace": "physics_workplace",
    "start": "step_1_define_vectors",
    "actions": [
      {
        "id": "step_1_define_vectors",
        "instruction": {
          "title": "Define Vectors",
          "description": "Observe the representations of Vector A and Vector B. Note their magnitudes and directions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_a",
              "type": "predicate",
              "augmentation": "pred_vector_a_anim",
              "poi": "default"
            },
            {
              "target": "thing_vector_b",
              "type": "predicate",
              "augmentation": "pred_vector_b_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_define_vectors"
          }
        ]
      },
      {
        "id": "step_2_vector_addition",
        "instruction": {
          "title": "Vector Addition",
          "description": "See how Vector A and Vector B are added tip-to-tail to form the resultant vector. Identify the resultant vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_resultant",
              "type": "predicate",
              "augmentation": "pred_resultant_anim",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_vector_a",
              "type": "predicate",
              "augmentation": "pred_vector_a_anim"
            },
            {
              "target": "thing_vector_b",
              "type": "predicate",
              "augmentation": "pred_vector_b_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_vector_addition"
          }
        ]
      },
      {
        "id": "step_3_vector_components",
        "instruction": {
          "title": "Vector Components",
          "description": "Observe how the resultant vector is decomposed into its horizontal (x) and vertical (y) components. Note the labels for each component."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_resultant",
              "type": "predicate",
              "augmentation": "pred_component_x_label",
              "poi": "default"
            },
            {
              "target": "thing_resultant",
              "type": "predicate",
              "augmentation": "pred_component_y_label",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_resultant",
              "type": "predicate",
              "augmentation": "pred_resultant_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_vector_components"
          }
        ]
      },
      {
        "id": "step_4_projectile_motion",
        "instruction": {
          "title": "Projectile Motion Introduction",
          "description": "Now we apply vector concepts to projectile motion. Observe the parabolic trajectory of a projectile launched with an initial velocity. Notice the independence of horizontal and vertical motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_projectile_trajectory_anim",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_resultant",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_projectile_area"
          }
        ]
      },
      {
        "id": "step_5_projectile_parameters",
        "instruction": {
          "title": "Projectile Parameters",
          "description": "Observe how changing the initial launch angle and speed affects the projectile's trajectory, range, and maximum height. Pay attention to the labels indicating launch angle, launch speed, horizontal velocity, and vertical velocity."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_launch_angle_label",
              "poi": "default"
            },
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_launch_speed_label",
              "poi": "default"
            },
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_horizontal_velocity_label",
              "poi": "default"
            },
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_vertical_velocity_label",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_projectile_area",
              "type": "predicate",
              "augmentation": "pred_projectile_trajectory_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_projectile_parameters"
          }
        ]
      }
    ]
  }
