  "activity": {
    "id": "VSEPR-Activity",
    "name": "VSEPR Theory Activity",
    "description": "Predicting molecular geometry using VSEPR theory.",
    "workplace": "VSEPR-Theory-Workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Introduction to VSEPR",
          "description": "VSEPR theory states that electron pairs around a central atom arrange themselves to minimize mutual repulsion. Let's start with the basics."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "ch4-label",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Linear Electron Domains",
          "description": "A steric number of 2 results in a linear electron domain geometry. Place the two electron domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "linear-animation",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "linear-label",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "central-atom",
              "augmentation": "ch4-label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "linear-domain"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Trigonal Planar Electron Domains",
          "description": "A steric number of 3 results in a trigonal planar electron domain geometry. Arrange the three electron domains."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "trigonal-planar-animation",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "trigonal-planar-label",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "central-atom",
              "augmentation": "linear-label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "trigonal-planar-domain"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Tetrahedral Electron Domains",
          "description": "A steric number of 4 results in a tetrahedral electron domain geometry. Visualize the tetrahedral arrangement."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "tetrahedral-animation",
              "poi": "default"
            },
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "tetrahedral-label",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "central-atom",
              "augmentation": "trigonal-planar-label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Molecular Geometry: Lone Pairs",
          "description": "Lone pairs occupy more space than bonding pairs, influencing molecular geometry. Observe the effect of lone pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "central-atom",
              "type": "predicate",
              "augmentation": "lone-pair-repulsion-image",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "central-atom",
              "augmentation": "tetrahedral-label"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5"
          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Molecular Shapes",
          "description": "Explore different molecular shapes derived from VSEPR theory."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "methane",
              "type": "predicate",
              "augmentation": "ch4-label"
            },
            {
              "target": "ammonia",
              "type": "predicate",
              "augmentation": "nh3-label"
            },
            {
              "target": "water",
              "type": "predicate",
              "augmentation": "h2o-label"
            },
            {
              "target": "phosphorus-pentachloride",
              "type": "predicate",
              "augmentation": "pf5-label"
            },
            {
              "target": "sulfur-hexafluoride",
              "type": "predicate",
              "augmentation": "sf6-label"
            },
            {
              "target": "xenon-tetrafluoride",
              "type": "predicate",
              "augmentation": "xeF4-label"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6"
          }
        ]
      }
    ]
  }
