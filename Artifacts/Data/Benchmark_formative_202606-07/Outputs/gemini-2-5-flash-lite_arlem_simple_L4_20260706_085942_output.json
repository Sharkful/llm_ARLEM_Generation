  "activity": {
    "id": "activity_retrograde_motion",
    "name": "Retrograde Motion Exploration",
    "description": "An exploration of apparent retrograde motion of planets.",
    "workplace": "workplace_astronomy",
    "start": "action_01_observe_mars",
    "actions": [
      {
        "id": "action_01_observe_mars",
        "instruction": {
          "title": "Observe Mars's Path",
          "description": "You are on Earth observing Mars over six months. Notice its apparent motion against the background stars. It drifts eastward, then reverses into a westward loop, and finally resumes eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "primitive",
              "augmentation": "animation",
              "url": "https://assets.example.com/animation_mars_path.glb"
            },
            {
              "target": "place_night_sky",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/image_constellations.png"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "predicate_audio_narration",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "predicate_label_mars",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_night_sky",
              "augmentation": "animation"
            },
            {
              "target": "place_night_sky",
              "augmentation": "image"
            },
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "predicate_audio_narration"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "predicate_label_mars"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button_1"
          }
        ]
      },
      {
        "id": "action_02_geocentric",
        "instruction": {
          "title": "Geocentric Explanation",
          "description": "See how the geocentric model uses epicycles and deferents to explain Mars's retrograde motion. Notice the complexity required."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_animation_geocentric",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_audio_narration",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_label_epicycle",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_label_deferent",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_overview",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button_2"
          }
        ]
      },
      {
        "id": "action_03_heliocentric",
        "instruction": {
          "title": "Heliocentric Explanation",
          "description": "View the solar system from outside. Watch Earth and Mars orbit the Sun. See how Earth's faster orbit causes it to overtake Mars, creating the apparent retrograde motion without epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_animation_heliocentric",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_audio_narration",
              "poi": "default"
            },
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "predicate_label_sun",
              "poi": "default"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "predicate_label_earth",
              "poi": "default"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "predicate_label_mars_orbit",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_solar_system_overview",
              "type": "*",
              "augmentation": "*"
            },
            {
              "target": "thing_sun",
              "type": "predicate",
              "augmentation": "predicate_label_sun"
            },
            {
              "target": "thing_earth",
              "type": "predicate",
              "augmentation": "predicate_label_earth"
            },
            {
              "target": "thing_mars",
              "type": "predicate",
              "augmentation": "predicate_label_mars_orbit"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button_3"
          }
        ]
      },
      {
        "id": "action_04_link_perspectives",
        "instruction": {
          "title": "Linking Perspectives",
          "description": "Compare the heliocentric view with the Earth-based night sky view side-by-side. Observe how Earth's overtaking of Mars directly corresponds to the westward loop seen from Earth."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_animation_side_by_side",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
