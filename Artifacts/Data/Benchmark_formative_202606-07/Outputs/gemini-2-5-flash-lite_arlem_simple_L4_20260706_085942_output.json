          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_button_4"
          }
        ]
      },
      {
        "id": "action_05_embodied_overtaking",
        "instruction": {
          "title": "Embodied Overtaking",
          "description": "You are at the center of a starfield. Walk around a small circle (Earth's orbit) while keeping your gaze on Mars. Experience firsthand how your own motion creates the apparent retrograde motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_night_sky",
              "type": "predicate",
              "augmentation": "predicate_animation_walk_around",
              "poi": "default"
            },
            {
              "target": "place_night_sky",
