              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "player_walked_full_circle",
            "duration": 1000
          }
        ]
      },
      {
        "id": "action_06_compare_outer_planets",
        "instruction": {
          "title": "Compare Outer Planets",
          "description": "Observe the retrograde loops of Mars, Jupiter, and Saturn from the heliocentric view. Note how the loops become smaller for planets farther from the Sun."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_solar_system_overview",
              "type": "predicate",
              "augmentation": "predicate_animation_outer_planets",
              "poi": "default"
            },
            {
              "target": "place_solar_system_overview",
