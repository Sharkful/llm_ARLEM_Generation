      },
      {
        "id": "action_07_prediction_challenge",
        "instruction": {
          "title": "Prediction Challenge",
          "description": "Given Earth's position, drag Mars to the correct orbital position where retrograde motion would be observed from Earth. An inset window shows the real-time view from Earth."
