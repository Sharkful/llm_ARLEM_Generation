  "activity": {
    "id": "dna-replication-activity",
    "name": "DNA Replication Activity",
    "description": "Explore the structure and replication of DNA.",
    "workplace": "dna-replication-workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "DNA Structure: The Ladder",
          "description": "Observe the schematic representation of DNA as a ladder."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "schematic-dna",
              "type": "predicate",
              "augmentation": "schematic-dna-ladder",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "DNA Structure: The Double Helix",
          "description": "Witness the DNA ladder twist into its iconic double helix structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "realistic-dna",
              "type": "predicate",
              "augmentation": "realistic-dna-helix",
              "poi": "default"
            },
            {
              "target": "schematic-dna",
              "type": "predicate",
              "augmentation": "schematic-dna-ladder",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "schematic-dna",
              "type": "predicate",
              "augmentation": "schematic-dna-ladder"
            }
          ]
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "realistic-dna",
              "type": "predicate",
              "augmentation": "realistic-dna-helix"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Antiparallel Strands and Directionality",
          "description": "Identify the 5' and 3' ends of each DNA strand and observe their antiparallel orientation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "realistic-dna",
              "type": "predicate",
              "augmentation": "dna-strand-arrows",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Assemble a DNA strand by correctly pairing bases according to the rules (A-T, G-C) and observe hydrogen bond formation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "base-palette",
              "type": "predicate",
              "augmentation": "base-pairing-activity",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "base-palette"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "DNA Replication: Unwinding the Helix",
          "description": "Observe the helicase enzyme unwinding the DNA double helix at the replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "replication-fork-animation",
              "poi": "default"
            },
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "helicase-model",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5"
          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Stabilizing Single Strands",
          "description": "See how single-strand binding proteins (SSBs) stabilize the unwound DNA strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "ssb-model",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step6"
          }
        ]
      },
      {
        "id": "step7",
        "instruction": {
          "title": "DNA Polymerase and Leading Strand Synthesis",
          "description": "Observe DNA polymerase synthesizing the leading strand continuously."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "dna-polymerase-model",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step7"
          }
        ]
      },
      {
        "id": "step8",
        "instruction": {
          "title": "Lagging Strand Synthesis and Okazaki Fragments",
          "description": "Understand the discontinuous synthesis of the lagging strand via Okazaki fragments, and DNA ligase sealing them."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "ligase-model",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step8"
          }
        ]
      },
      {
        "id": "step9",
        "instruction": {
          "title": "Replication Fork Overview",
          "description": "View the complete replication fork with all enzymes in action and review their functions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "replication-fork-animation",
              "poi": "default"
            },
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "helicase-model",
              "poi": "default"
            },
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "ssb-model",
              "poi": "default"
            },
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "dna-polymerase-model",
              "poi": "default"
            },
            {
              "target": "enzymes",
              "type": "predicate",
              "augmentation": "ligase-model",
              "poi": "default"
            },
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "replication-summary-panel",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step9"
          }
        ]
      },
      {
        "id": "step10",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "Observe one round of semiconservative replication and predict the outcome of a second round."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication-fork",
              "type": "predicate",
              "augmentation": "semiconservative-replication-animation",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step10"
          }
        ]
      }
    ]
  }
