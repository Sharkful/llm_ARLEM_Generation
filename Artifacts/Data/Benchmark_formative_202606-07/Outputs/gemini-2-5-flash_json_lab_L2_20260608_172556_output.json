{
  "version": "2.0",
  "labId": "HeartAnatomyLab",
  "author": "AR Anatomy Team",
  "courseName": "Human Anatomy and Physiology I",
  "estimatedLength": "45 minutes",
  "objectives": [
    "Identify the four chambers of the human heart and their functions.",
    "Locate and describe the function of the four major heart valves.",
    "Trace the path of deoxygenated and oxygenated blood through the pulmonary and systemic circulatory loops.",
    "Explain the structural differences between the left and right ventricles and their functional significance."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Structural Anatomy and Blood Flow of the Heart",
      "description": "Explore the structural components of the human heart and trace the dual-loop circulation of blood.",
      "author": "AR Anatomy Team",
      "institution": "University of Health Sciences",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Students will be able to identify the right atrium, right ventricle, left atrium, and left ventricle.",
        "Students will be able to name and locate the tricuspid, pulmonary, mitral, and aortic valves.",
        "Students will be able to identify the superior and inferior vena cava, pulmonary arteries, pulmonary veins, and aorta.",
        "Students will be able to describe the flow of deoxygenated blood from the body to the lungs.",
        "Students will be able to describe the flow of oxygenated blood from the lungs to the body.",
        "Students will be able to differentiate the myocardial thickness of the left and right ventricles and explain why."
      ],
      "instructions": [
        "Use the 'Next' button to advance through the guided tour.",
        "Observe the 3D heart model and listen to the narration.",
        "Pay attention to the highlighted structures and animated blood flow."
      ],
