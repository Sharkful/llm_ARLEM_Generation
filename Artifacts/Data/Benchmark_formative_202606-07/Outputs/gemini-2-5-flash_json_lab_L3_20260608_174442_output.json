{
  "version": "2.0",
  "labId": "humanHeartARLab",
  "author": "AR Anatomy Team",
  "courseName": "Human Anatomy and Physiology I",
  "estimatedLength": "25 minutes",
  "objectives": [
    "Identify and name the four chambers of the heart, the four heart valves, and the major vessels entering and leaving the heart.",
    "Trace the path of blood through the heart's dual circulation, naming each chamber, valve, and vessel in order.",
    "Distinguish the pulmonary circuit from the systemic circuit and explain why the right and left sides of the heart serve different circulatory functions.",
    "Explain why the left ventricle has a substantially thicker myocardium than the right ventricle, relating wall thickness to the pressure required to perfuse the systemic versus pulmonary circuits.",
    "Describe the function of the atrioventricular and semilunar valves in preventing backflow, and identify which valves separate which chambers or chamber-vessel pairs."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Human Heart: Structure and Circulation",
      "description": "Explore the structural anatomy of the human heart and trace the path of blood through its dual-loop circulation.",
      "author": "AR Anatomy Team",
      "institution": "University of AR",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Students will identify the four chambers, four valves, and major vessels of the human heart.",
        "Students will trace the complete pathway of blood through the pulmonary and systemic circuits.",
        "Students will understand the functional differences between the right and left sides of the heart, including ventricular wall thickness."
      ],
      "instructions": [
        "Position the heart model on a flat surface.",
        "Follow the narration to explore the heart's anatomy and blood flow."
      ],
