{
  "version": "2.0",
  "labId": "astronomy-retrograde-lab-001",
  "author": "Dr. Sarah Kepler",
  "courseName": "Introduction to Astronomy",
  "estimatedLength": "25 minutes",
  "objectives": [
    "Visualize apparent retrograde motion from both geocentric and heliocentric perspectives.",
    "Understand the geometric cause of retrograde motion as an overtaking effect.",
    "Compare the visual characteristics of loops for various outer planets."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "The Geocentric Observation",
      "description": "Observing the apparent path of Mars from the perspective of an Earth-based observer.",
      "author": "Dr. Sarah Kepler",
      "institution": "University of Science",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Track the eastward and westward motion of Mars across constellations."
      ],
      "instructions": [
        "Observe the glowing Mars point as it traces its path against the background stars."
      ],
      "objects": [
        {
          "prefab": "marsPrefab",
          "name": "marsPointer",
          "position": [
            0.0,
            0.5,
            1.0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "labelMars",
          "parent": "marsPointer",
          "position": [
            0.0,
            0.2,
            0.0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ],
          "components": [
            {
              "componentType": "textMeshPro",
              "text": "Mars Path",
              "fontSize": 12.0
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "intro_drift",
          "audioClip": "audio_mars_eastward",
          "autoAdvance": true,
          "changes": [
            {
              "target": "marsPointer",
              "position": [
                -0.5,
                0.5,
                1.0
              ]
            }
          ]
        },
        {
          "clipName": "retrograde_loop",
          "audioClip": "audio_mars_loop",
          "autoAdvance": true,
          "changes": [
            {
              "target": "marsPointer",
              "position": [
                0.0,
                0.7,
                1.0
              ]
            }
          ]
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "The Heliocentric Reality",
      "description": "Explaining the phenomenon using Earth and Mars orbital mechanics.",
      "author": "Dr. Sarah Kepler",
      "institution": "University of Science",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Explain retrograde motion as an overtaking effect of Earth passing an outer planet."
      ],
      "instructions": [
        "Watch Earth and Mars as they orbit the Sun."
      ],
      "objects": [
        {
          "prefab": "SunPrefab",
          "name": "sun",
          "position": [
            0.0,
            0.0,
            0.0
          ],
          "scale": [
            0.3,
            0.3,
            0.3
          ]
        },
        {
          "prefab": "earthPrefab",
          "name": "earth",
          "position": [
            0.5,
            0.0,
            0.0
          ],
          "scale": [
            0.15,
            0.15,
            0.15
          ],
          "components": [
            {
              "componentType": "simpleOrbit",
              "orbitalPeriod": 10.0,
              "orbitalScale": 0.5
            }
          ]
        },
        {
          "prefab": "marsPrefab",
          "name": "mars",
          "position": [
            1.5,
            0.0,
            0.0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ],
          "components": [
            {
              "componentType": "simpleOrbit",
              "orbitalPeriod": 20.0,
              "orbitalScale": 1.5
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "orbit_start",
          "audioClip": "audio_heliocentric_view",
          "autoAdvance": true
        },
        {
          "clipName": "overtake_moment",
          "audioClip": "audio_overtake_explanation",
          "autoAdvance": true,
          "changes": [
            {
              "target": "earth",
              "color": [
                255.0,
                255.0,
                0.0,
                255.0
              ]
            }
          ]
        },
        {
          "clipName": "comparison",
          "audioClip": "audio_jupiter_saturn_loops",
          "autoAdvance": true,
          "changes": [
            {
              "target": "mars",
              "scale": [
                0.05,
                0.05,
                0.05
              ]
            }
          ]
        }
      ]
    }
  ]
}