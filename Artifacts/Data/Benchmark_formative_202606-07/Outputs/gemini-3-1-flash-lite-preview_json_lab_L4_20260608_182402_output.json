{
  "version": "2.0",
  "labId": "anatomy_heart_001",
  "author": "Anatomy Education Lab Team",
  "courseName": "Human Anatomy and Physiology I",
  "estimatedLength": "60 minutes",
  "objectives": [
    "Identify heart chambers, valves, and major vessels.",
    "Trace blood flow through pulmonary and systemic circuits.",
    "Compare myocardial wall thickness between ventricles.",
    "Explain valve function in preventing backflow."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Gross Anatomy and Orientation",
      "description": "Exploration of intact and cutaway heart models to learn orientation.",
      "author": "Anatomy Education Lab Team",
      "institution": "University of Health Sciences",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Relate heart anatomy to patient-centered orientation.",
        "Differentiate internal versus external structural views."
      ],
      "objects": [
        {
          "prefab": "heartPrefab",
          "name": "intactHeart",
          "position": [
            -0.5,
            0.0,
            0.0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ]
        },
        {
          "prefab": "heartCutawayPrefab",
          "name": "cutawayHeart",
          "position": [
            0.5,
            0.0,
            0.0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "orientationLabel",
          "position": [
            0.0,
            1.2,
            0.0
          ],
          "scale": [
            1.0,
            1.0,
            1.0
          ],
          "components": [
            {
              "componentType": "textMeshPro",
              "text": "Heart Orientation: Patient's Perspective",
              "fontSize": 0.5
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "intro_orientation",
          "audioClip": "audio_orientation_intro",
          "autoAdvance": true,
          "changes": [
            {
              "target": "intactHeart",
              "eulerAngles": [
                0.0,
                -20.0,
                0.0
              ]
            }
          ]
        },
        {
          "clipName": "explain_perspective",
          "audioClip": "audio_patient_perspective",
          "autoAdvance": true
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Blood Flow Tracing",
      "description": "Interactive trace of a red blood cell through the circulatory loops.",
      "author": "Anatomy Education Lab Team",
      "institution": "University of Health Sciences",
      "dateCreated": "2023-10-27",
      "educationalObjectives": [
        "Trace path of blood from SVC to Systemic Circulation."
      ],
      "objects": [
        {
          "prefab": "tinySphere",
          "name": "redBloodCell",
          "position": [
            0.0,
            0.0,
            0.0
          ],
          "scale": [
            0.05,
            0.05,
            0.05
          ],
          "components": [
            {
              "componentType": "pointerReceiver",
              "draggable": true
            }
          ]
        }
      ],
      "clips": [
        {
          "clipName": "start_trace",
          "audioClip": "audio_svc_entry",
          "autoAdvance": false,
          "changes": [
            {
              "target": "redBloodCell",
              "position": [
                0.0,
                0.5,
                0.0
              ]
            }
          ]
        },
        {
          "clipName": "atrium_to_ventricle",
          "audioClip": "audio_atrium_ventricle",
          "autoAdvance": false,
          "changes": [
            {
              "target": "redBloodCell",
              "position": [
                0.0,
                0.2,
                0.0
              ]
            }
          ]
        },
        {
          "clipName": "pulmonary_circuit",
          "audioClip": "audio_pulmonary_loop",
          "autoAdvance": false,
          "changes": [
            {
              "target": "redBloodCell",
              "position": [
                0.0,
                -0.2,
                0.0
              ],
              "color": [
                255.0,
                0.0,
                0.0,
                255.0
              ]
            }
          ]
        }
      ]
    }
  ]
}