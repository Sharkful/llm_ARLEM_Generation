  "activity": {
    "id": "vsepr_lab_activity",
    "name": "VSEPR Geometry Lab",
    "description": "An interactive walk-through of VSEPR theory and molecular geometry.",
    "workplace": "vsepr_lab_workplace",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "Introduction to VSEPR",
          "description": "Welcome to the VSEPR Theory Lab. We will explore how electron pairs determine molecular geometry. Click on the central atom to begin."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "workbench",
              "type": "predicate",
              "augmentation": "label_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "workbench",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "central_atom_model"
          }
        ]
      },
      {
        "id": "step2_linear_co2",
        "instruction": {
          "title": "Linear Geometry: CO2",
          "description": "Observe the CO2 molecule. With 2 bonding pairs and 0 lone pairs, the domains adopt a linear geometry to minimize repulsion. Click the CO2 model to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "workbench",
              "type": "predicate",
              "augmentation": "label_linear",
