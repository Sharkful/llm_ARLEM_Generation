              "type": "predicate",
              "augmentation": "blood_stream_flow"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "scene_3_circulation"
          }
        ]
      },
      {
        "id": "scene_4_trace",
        "instruction": {
          "title": "Blood Flow Trace",
          "description": "Trace the path of a single red blood cell through the complete circulatory loop. Click to advance."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_station",
              "type": "predicate",
