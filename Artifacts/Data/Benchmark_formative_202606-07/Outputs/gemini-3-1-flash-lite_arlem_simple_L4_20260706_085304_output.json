              "target": "heart_station",
              "type": "predicate",
              "augmentation": "structural_labels"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "scene_2_tour"
          }
        ]
      },
      {
        "id": "scene_3_circulation",
        "instruction": {
          "title": "Dual-Circuit Circulation",
          "description": "Observe the dual-circuit blood flow. Blue represents deoxygenated blood in the pulmonary circuit, red represents oxygenated blood in the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_station",
              "type": "predicate",
              "augmentation": "blood_stream_flow"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
