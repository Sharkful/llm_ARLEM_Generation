  "activity": {
    "id": "heart_anatomy_lab_001",
    "name": "Human Heart Anatomy and Physiology Lab",
    "description": "An exploration of the structural anatomy of the human heart and the path that blood takes through it.",
    "workplace": "cardiology_lab_001",
    "start": "scene_1_intro",
    "actions": [
      {
        "id": "scene_1_intro",
        "instruction": {
          "title": "Introduction to Cardiac Anatomy",
          "description": "Observe the intact heart and the cutaway view. Notice the anatomical orientation: the heart is described from the patient's perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_station",
              "type": "predicate",
              "augmentation": "heart_models_display"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "scene_1_intro"
          }
        ]
      },
      {
        "id": "scene_2_tour",
        "instruction": {
          "title": "Structural Tour",
          "description": "Follow the tour of the four chambers, four valves, and major vessels. Mapping the interior structures to the exterior landmarks."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heart_station",
              "type": "predicate",
              "augmentation": "structural_labels"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
