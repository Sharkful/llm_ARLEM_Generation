  "activity": {
    "id": "physics_vectors_lab",
    "name": "Vector Physics and Projectile Motion",
    "description": "A lab exploring vectors, vector operations, and their application to 2D projectile motion.",
    "workplace": "physics_lab_workplace",
    "start": "intro_vectors",
    "actions": [
      {
        "id": "intro_vectors",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Observe the floating vector. Grab the head to change magnitude and direction. Note how the components update."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "vector_arrow"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_workbench"
          }
        ]
      },
      {
        "id": "vector_addition",
        "instruction": {
          "title": "Vector Addition",
          "description": "Observe the blue and green vectors added tip-to-tail. The red resultant vector shows the sum. Change the order to see the result remains constant."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "vector_a"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "vector_b"
            },
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "resultant_vector"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_workbench"
          }
        ]
      },
      {
        "id": "vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "See the vector broken into x, y, and z components. Notice how they add tip-to-tail to equal the original vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_workbench",
              "type": "predicate",
              "augmentation": "decomposition_viz"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_workbench"
          }
        ]
      },
      {
        "id": "projectile_intro",
        "instruction": {
          "title": "Projectile Motion Setup",
          "description": "We move to a 2D plane to study projectile motion. Gravity acts vertically, affecting only the vertical component."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "physics_plane",
              "type": "predicate",
              "augmentation": "projectile_plane_viz"
            }
          ],
          "deactivate": [
            {
              "target": "*",
              "type": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "physics_plane"
          }
        ]
      },
      {
        "id": "projectile_flight",
        "instruction": {
          "title": "Projectile Flight Demo",
          "description": "Watch the ball flight. Note the independent horizontal (constant) and vertical (changing) velocity components."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "physics_plane",
              "type": "predicate",
              "augmentation": "flight_path_viz"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "physics_plane"
          }
        ]
      }
    ]
  }
