{
  "version": "2.0",
  "labId": "dna_structure_replication_lab",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "Introductory Molecular Biology (BIOL200)",
  "objectives": [
    "Master the structural components of DNA and the semiconservative mechanism of its replication."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "DNA Structure and Pairing",
      "description": "Explore the 3D structure and complementary base-pairing rules of the DNA double helix.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-05",
      "educationalObjectives": [
        "Identify components of the DNA double helix.",
        "Apply complementary base-pairing rules."
      ],
      "instructions": [
        "Observe the DNA structure as it rotates."
      ],
      "objects": [
        {
          "prefab": "dnaStrandPrefab",
          "name": "dnaDoubleHelix",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ],
          "components": [
            {
              "componentType": "simpleRotation",
              "timeRate": 1.0,
              "rotationTime": 20
            }
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "basePairDetail",
          "position": [
            0.5,
            0.5,
            0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0_overview",
          "audioClip": "intro_dna_structure",
          "autoAdvance": true,
          "changes": [
            {
              "target": "dnaDoubleHelix"
            }
          ],
          "changeMeaning": "Highlight the double helix structure.",
          "narration": "DNA is a double helix with two antiparallel sugar-phosphate backbones and nitrogenous bases pairing inward."
        },
        {
          "clipName": "clip1_base_pairing",
          "audioClip": "base_pairing_details",
          "autoAdvance": true,
          "changes": [
            {
              "target": "basePairDetail"
            }
          ],
          "changeMeaning": "Highlight individual base pairs with bonds.",
          "narration": "Adenine pairs with Thymine via two hydrogen bonds, while Guanine pairs with Cytosine via three."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "DNA Replication Mechanism",
      "description": "Visualize the process of DNA replication at the replication fork.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-05",
      "educationalObjectives": [
        "Trace enzyme functions at the replication fork.",
        "Explain continuous vs. discontinuous strand synthesis.",
        "Articulate why the process is semiconservative."
      ],
      "instructions": [
        "Watch the replication fork animation closely."
      ],
      "objects": [
        {
          "prefab": "enzymePrefab",
          "name": "helicaseEnzyme",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        },
        {
          "prefab": "enzymePrefab",
          "name": "polymeraseEnzyme",
          "position": [
            0.2,
            0.2,
            0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        },
        {
          "prefab": "dnaStrandPrefab",
          "name": "daughterMolecules",
          "position": [
            -0.5,
            0,
            0
          ],
          "scale": [
            0.15,
            0.15,
            0.15
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip2_unwinding",
          "audioClip": "helicase_unwinding",
          "autoAdvance": true,
          "changes": [
            {
              "target": "helicaseEnzyme"
            }
          ],
          "changeMeaning": "Helicase appears and strands separate.",
          "narration": "Helicase unwinds the double helix, creating a replication fork stabilized by binding proteins."
        },
        {
          "clipName": "clip3_polymerization",
          "audioClip": "replication_process",
          "autoAdvance": true,
          "changes": [
            {
              "target": "polymeraseEnzyme"
            }
          ],
          "changeMeaning": "Polymerase starts synthesizing new strands.",
          "narration": "DNA polymerase synthesizes new strands in the 5' to 3' direction. The leading strand is continuous, while the lagging strand forms Okazaki fragments."
        },
        {
          "clipName": "clip4_semiconservative",
          "audioClip": "semiconservative_recap",
          "autoAdvance": true,
          "changes": [
            {
              "target": "daughterMolecules"
            }
          ],
          "changeMeaning": "Show the two new DNA molecules.",
          "narration": "Each new molecule contains one parental and one newly-synthesized strand, confirming semiconservative replication."
        }
      ]
    }
  ]
}