{
  "version": "2.0",
  "labId": "vectors_and_projectiles_lab_001",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "General Physics I (Mechanics)",
  "objectives": [
    "Master vector math fundamentals.",
    "Understand the mechanics of two-dimensional projectile motion."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Vector Basics",
      "description": "Understanding vector basics, addition, and decomposition.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-05",
      "educationalObjectives": [
        "Represent a two-dimensional vector by its magnitude and direction.",
        "Add vectors graphically using the tip-to-tail method.",
        "Decompose a vector into x and y components."
      ],
      "instructions": [
        "Observe the vector addition and decomposition."
      ],
      "objects": [
        {
          "prefab": "arrowPrefab",
          "name": "vectorA",
          "position": [
            0,
            0.5,
            0
          ],
          "scale": [
            0.01,
            0.01,
            0.01
          ]
        },
        {
          "prefab": "arrowPrefab",
          "name": "vectorB",
          "position": [
            0.3,
            0.5,
            0
          ],
          "scale": [
            0.01,
            0.01,
            0.01
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "labelText",
          "position": [
            0,
            1.2,
            0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip1",
          "audioClip": "intro_vectors",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorA",
              "scale": [
                0.3,
                0.3,
                0.3
              ]
            },
            {
              "target": "vectorB",
              "scale": [
                0.3,
                0.3,
                0.3
              ]
            },
            {
              "target": "labelText",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Vector A + Vector B = Resultant",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Introducing vector representation and addition.",
          "narration": "Vectors are defined by magnitude and direction. We can add them graphically using the tip-to-tail method."
        },
        {
          "clipName": "clip2",
          "audioClip": "vector_decomposition",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorA",
              "eulerAngles": [
                0,
                0,
                30
              ]
            },
            {
              "target": "labelText",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Decomposing into Ax and Ay components",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Visualizing vector components on axes.",
          "narration": "Any vector can be decomposed into horizontal x and vertical y components using trigonometry."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Projectile Motion Dynamics",
      "description": "Analyzing projectile motion by separating horizontal and vertical components.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-05",
      "educationalObjectives": [
        "Explain the independence of horizontal and vertical motion.",
        "Describe changes in velocity throughout a projectile's flight.",
        "Identify the apex of the trajectory."
      ],
      "instructions": [
        "Follow the ball's trajectory and observe the velocity changes."
      ],
      "objects": [
        {
          "prefab": "moveableSphere",
          "name": "projectileBall",
          "position": [
            -1,
            0,
            0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "labelText2",
          "position": [
            0,
            1.5,
            0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip3",
          "audioClip": "projectile_intro",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectileBall",
              "position": [
                0,
                0,
                0
              ]
            },
            {
              "target": "labelText2",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Projectile Motion: Independent x and y motion",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Showing the projectile launch.",
          "narration": "A projectile\u2019s motion is the combination of constant horizontal velocity and constant vertical acceleration due to gravity."
        },
        {
          "clipName": "clip4",
          "audioClip": "projectile_independence",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectileBall",
              "position": [
                1.5,
                0.5,
                0
              ]
            }
          ],
          "changeMeaning": "Visualizing velocity changes over time.",
          "narration": "Notice how the horizontal velocity remains constant, while the vertical velocity changes due to gravity."
        },
        {
          "clipName": "clip5",
          "audioClip": "max_height_analysis",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectileBall",
              "position": [
                0.75,
                1,
                0
              ]
            },
            {
              "target": "labelText2",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Apex: Vertical velocity is zero",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Highlighting the apex of the trajectory.",
          "narration": "At the apex, the vertical velocity is zero, while horizontal motion continues. This is the maximum height."
        }
      ]
    }
  ]
}