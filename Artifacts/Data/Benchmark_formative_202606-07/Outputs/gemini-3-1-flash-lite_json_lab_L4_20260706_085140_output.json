{
  "version": "2.0",
  "labId": "dna_structure_replication_001",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "Introductory Molecular Biology (BIO 200)",
  "objectives": [
    "Students will identify DNA structural components and describe the double helix.",
    "Students will explain the antiparallel nature and 5'-to-3' replication constraints.",
    "Students will identify the roles of core replication enzymes.",
    "Students will explain the semiconservative model of DNA replication."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "DNA Architecture",
      "description": "Introduction to DNA structure from schematic to double helix.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-06",
      "educationalObjectives": [
        "Identify structural components of DNA.",
        "Describe base-pairing rules and double helix formation."
      ],
      "instructions": [
        "Observe the transition from the ladder to the double helix."
      ],
      "objects": [
        {
          "prefab": "textPrefab",
          "name": "ladderObject",
          "position": [
            0,
            1,
            0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "intro_dna_schematic",
          "autoAdvance": true,
          "changes": [
            {
              "target": "ladderObject",
              "position": [
                0,
                1.5,
                0
              ],
              "scale": [
                0.5,
                0.5,
                0.5
              ],
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "DNA: The Schematic Ladder",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Spawns a schematic ladder-like representation of DNA with color-coded nitrogenous bases.",
          "narration": "DNA is a polymer with a repeating sugar-phosphate backbone and inward-projecting nitrogenous bases that pair with their complements."
        },
        {
          "clipName": "clip1",
          "audioClip": "transition_to_helix",
          "autoAdvance": true,
          "changes": [
            {
              "target": "ladderObject",
              "position": [
                0,
                1,
                0
              ],
              "eulerAngles": [
                0,
                0,
                0
              ],
              "scale": [
                0.3,
                0.3,
                0.3
              ]
            }
          ],
          "changeMeaning": "Transitions the ladder into a realistic 3D double helix shape.",
          "narration": "In cells, this structure twists into a double helix, completing a full turn every ten base pairs."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Strand Polarity and Pairing",
      "description": "Exploring antiparallel orientation and practicing base pairing.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-06",
      "educationalObjectives": [
        "Explain 5' to 3' directionality and antiparallel orientation.",
        "Apply complementary base-pairing rules."
      ],
      "instructions": [
        "Drag the correct bases from the palette to the empty DNA strand."
      ],
      "objects": [
        {
          "prefab": "clickableSphere",
          "name": "ladderObject",
          "position": [
            0,
            1,
            0
          ],
          "scale": [
            0.1,
            0.1,
            0.1
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip2",
          "audioClip": "explain_antiparallel",
          "autoAdvance": true,
          "changes": [
            {
              "target": "ladderObject",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Antiparallel: 5' to 3' and 3' to 5'",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Displays directional arrows on the strands to show 5'-to-3' orientation.",
          "narration": "The two strands run in opposite directions. This antiparallel arrangement is enforced by the chemistry of the backbone."
        },
        {
          "clipName": "clip3",
          "audioClip": "base_pairing_task",
          "autoAdvance": true,
          "changes": [
            {
              "target": "ladderObject",
              "components": [
                {
                  "componentType": "pointerReceiver",
                  "draggable": true,
                  "kinematicWhileIdle": true,
                  "faceWhileDragging": false,
                  "matchWallWhileDragging": false,
                  "invertForward": false
                }
              ]
            }
          ],
          "changeMeaning": "Activates interactive base-pairing mode.",
          "narration": "Now, drag the correct bases to the empty strand. A-T forms two hydrogen bonds, while G-C forms three."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "The Replication Fork",
      "description": "Initiating the replication fork and explaining enzyme functions.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-06",
      "educationalObjectives": [
        "Trace the action of replication enzymes (Helicase, SSBs, Polymerase, Ligase).",
