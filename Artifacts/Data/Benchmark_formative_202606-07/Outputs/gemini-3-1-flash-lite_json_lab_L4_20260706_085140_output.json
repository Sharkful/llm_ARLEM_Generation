      ],
      "instructions": [
        "Observe Helicase unwinding the DNA helix."
      ],
      "objects": [
        {
          "prefab": "robotIdle",
          "name": "helicaseProtein",
          "position": [
            1,
            1,
            0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ]
        },
        {
          "prefab": "clickableSphere",
          "name": "dnaStrand",
          "position": [
            -1,
            1,
            0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip4",
          "audioClip": "replication_start",
          "autoAdvance": true,
          "changes": [
            {
              "target": "helicaseProtein",
              "components": [
                {
                  "componentType": "simpleRotation",
                  "timeRate": 1.0,
                  "rotationTime": 10
                }
              ]
            }
          ],
          "changeMeaning": "Spawns Helicase protein to begin unwinding.",
          "narration": "Helicase unwinds the double helix, breaking hydrogen bonds to expose the templates."
        }
      ]
    }
  ]
}