{
  "version": "2.0",
  "labId": "physics_vectors_projectile_lab",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "General Physics I (Mechanics)",
  "objectives": [
    "Understand vectors and their role in 2D physics.",
    "Master vector decomposition and its application to projectile motion.",
    "Develop intuition for trajectory parameters like range and maximum height."
  ],
  "modules": [
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Vector Foundations",
      "description": "Introduction to the concept of vectors as mathematical objects with magnitude and direction.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-06",
      "educationalObjectives": [
        "Represent a 2D vector by its magnitude and direction."
      ],
      "instructions": [
        "Grab the head of the arrow and move it to see the values update."
      ],
      "objects": [
        {
          "prefab": "arrowPrefab",
          "name": "mainVectorArrow",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.5,
            0.5,
            0.5
          ],
          "components": [
            {
              "componentType": "pointerReceiver",
              "draggable": false,
              "kinematicWhileIdle": true,
              "faceWhileDragging": false,
              "matchWallWhileDragging": false,
              "invertForward": false
            }
          ]
        },
        {
          "prefab": "textPrefab",
          "name": "vectorLabelDisplay",
          "position": [
            0,
            2,
            0
          ],
          "scale": [
            0.2,
            0.2,
            0.2
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip0",
          "audioClip": "intro_to_vectors",
          "autoAdvance": true,
          "changes": [
            {
              "target": "mainVectorArrow",
              "position": [
                0,
                1,
                0
              ]
            }
          ],
          "changeMeaning": "Spawning the initial vector arrow at the origin for student exploration.",
          "narration": "A vector is a quantity with both a magnitude and a direction. Notice the arrow representing this quantity. Grab the head to change its length and orientation."
        },
        {
          "clipName": "clip1",
          "audioClip": "interact_with_vector",
          "autoAdvance": false,
          "changes": [
            {
              "target": "vectorLabelDisplay",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Magnitude: 5.0m, Angle: 45 deg",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Adding numerical indicators for magnitude and angle to the vector.",
          "narration": "As you manipulate the arrow, watch how the magnitude and direction values update in real-time. Vectors are distinct from scalars like mass."
        }
      ]
    },
    {
      "moduleType": "demo",
      "prefab": "demoPrefab",
      "moduleName": "Vector Addition",
      "description": "Exploring vector addition and the concept of a resultant vector.",
      "author": "A Robot",
      "institution": "MTSU",
      "dateCreated": "2026-07-06",
      "educationalObjectives": [
        "Add two or more vectors graphically using the tip-to-tail method."
      ],
      "instructions": [
        "Grab the blue or green vectors to observe how the resultant vector changes."
      ],
      "objects": [
        {
          "prefab": "arrowPrefab",
          "name": "vectorBlue",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.3,
            0.3,
            0.3
          ],
          "components": [
            {
              "componentType": "pointerReceiver",
              "draggable": true,
              "kinematicWhileIdle": true,
              "faceWhileDragging": false,
              "matchWallWhileDragging": false,
              "invertForward": false
            }
          ]
        },
        {
          "prefab": "arrowPrefab",
          "name": "vectorGreen",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.3,
            0.3,
            0.3
          ],
          "components": [
            {
              "componentType": "pointerReceiver",
              "draggable": true,
              "kinematicWhileIdle": true,
              "faceWhileDragging": false,
              "matchWallWhileDragging": false,
              "invertForward": false
            }
          ]
        },
        {
          "prefab": "arrowPrefab",
          "name": "resultantVectorRed",
          "position": [
            0,
            0,
            0
          ],
          "scale": [
            0.3,
            0.3,
            0.3
          ]
        }
      ],
      "clips": [
        {
          "clipName": "clip2",
          "audioClip": "vector_addition_intro",
          "autoAdvance": true,
          "changes": [
            {
              "target": "vectorBlue",
              "position": [
                0,
                0,
                0
              ]
            },
            {
              "target": "vectorGreen",
              "position": [
                0.5,
                0,
                0
              ]
            }
          ],
          "changeMeaning": "Spawning blue and green vectors in a tip-to-tail configuration.",
          "narration": "Vector addition uses the tip-to-tail method. The resultant vector, in red, represents the sum of the blue and green vectors."
        },
        {
          "clipName": "clip3",
          "audioClip": "resultant_explanation",
          "autoAdvance": false,
          "changes": [
            {
              "target": "resultantVectorRed",
              "position": [
                0,
                0,
                0
              ]
            }
          ],
          "changeMeaning": "Drawing the resultant vector from the origin to the tip of the second vector.",
          "narration": "Regardless of the order, the resultant vector remains the same. Try reorienting the vectors to see the resultant update."
        }
      ]
    },
    {
