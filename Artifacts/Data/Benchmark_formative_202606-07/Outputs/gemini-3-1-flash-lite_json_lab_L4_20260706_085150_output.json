          "clipName": "clip4",
          "audioClip": "projectile_motion_intro",
          "autoAdvance": true,
          "changes": [
            {
              "target": "projectilePlane",
              "position": [
                0,
                0,
                0
              ]
            }
          ],
          "changeMeaning": "Setting up the 2D plane for projectile motion simulation.",
          "narration": "We apply vector decomposition to projectiles. The horizontal motion remains constant, while gravity accelerates the vertical motion. Notice the components of the initial velocity."
        }
