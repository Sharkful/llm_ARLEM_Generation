      "author": "Astrodynamics Education Team",
      "institution": "University Observatory",
      "dateCreated": "2023-10-15",
      "educationalObjectives": [
        "Identify the normal eastward drift of planets against background stars.",
        "Recognize a retrograde loop as a temporary westward reversal in apparent motion."
      ],
      "instructions": [
        "Look at the starfield before you.",
        "Watch the red dot representing Mars as time accelerates over several months."
