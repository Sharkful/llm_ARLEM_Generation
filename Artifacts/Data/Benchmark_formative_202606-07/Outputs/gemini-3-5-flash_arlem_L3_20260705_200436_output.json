  "activity": {
    "id": "act_vector_projectile_lab",
    "name": "Vectors and 2D Projectile Motion AR Lab",
    "description": "A comprehensive Mixed Reality training module exploring 2D vectors and kinematic projectile independence for introductory mechanics students.",
    "language": "en",
    "workplace": "wp_physics_vectors",
    "start": "action_step_1",
    "actions": [
      {
        "id": "action_step_1",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "math_station",
        "predicate": "interacted",
        "instruction": {
          "title": "Vector Decomposition Basics",
          "description": "Focus on the desk in front of you. An interactive vector 'A' is projected onto the coordinate grid. Use the displayed trigonometric formulas to decompose this vector into its horizontal (Ax) and vertical (Ay) components. Observe how the lengths of the component projections change dynamically as you examine the vector. Tap the virtual 'Next' button to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "math_station",
              "type": "predicate",
              "augmentation": "math_formula_image",
              "poi": "poi_desk_surface"
            },
            {
              "target": "math_station",
              "type": "predicate",
              "augmentation": "vector_components_x_y",
              "poi": "poi_desk_surface"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "math_station",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_step_1",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_step_2",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "math_station",
        "predicate": "measured",
        "instruction": {
          "title": "Tip-to-Tail Vector Addition",
          "description": "Look at the physical Vector Board. Two holographic force vectors, A and B, are shown. Align them tip-to-tail to form the resultant vector R. Verify that R starts at the tail of vector A and ends at the tip of vector B, representing the vector sum (R = A + B). Say 'Vectors Aligned' to verify."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_a_arrow",
              "poi": "poi_vector_a"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "vector_b_arrow",
              "poi": "poi_vector_b"
            },
            {
              "target": "vector_board",
              "type": "predicate",
              "augmentation": "resultant_arrow",
              "poi": "default"
            }
          ],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [
            {
              "target": "learner",
              "type": "predicate",
              "augmentation": "success_chime",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "vector_board",
              "augmentation": "*"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "action_step_2",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_step_3",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "launch_zone",
        "predicate": "launched",
        "instruction": {
          "title": "Initial Velocity Decomposition",
          "description": "Move to the Launch Zone. Configure the projectile launcher to an angle of 45 degrees. Note how the initial velocity vector (V0) splits into equal horizontal (V0x) and vertical (V0y) component arrows at the muzzle. Tap 'Next' once the components are balanced."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "launcher",
              "type": "predicate",
              "augmentation": "angle_helper_label",
              "poi": "poi_angle_dial",
              "text": "Set launch angle to 45 degrees"
            },
            {
              "target": "launcher",
              "type": "predicate",
              "augmentation": "vector_components_x_y",
              "poi": "poi_muzzle"
            }
          ],
          "deactivate": [],
