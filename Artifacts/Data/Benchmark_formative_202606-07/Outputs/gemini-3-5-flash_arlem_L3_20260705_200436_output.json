      {
        "id": "action_step_4",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "launch_zone",
        "predicate": "analyzed",
        "instruction": {
          "title": "Independence of x and y Motion",
          "description": "Launch the projectile and trace its trajectory. Observe that the horizontal velocity vector remains completely constant in magnitude and direction throughout flight. In contrast, the vertical velocity vector decreases steadily, reaching zero at the trajectory apex, and reverses direction as gravity pulls the projectile downward. Say 'Launch Complete' to proceed."
        },
        "enter": {
