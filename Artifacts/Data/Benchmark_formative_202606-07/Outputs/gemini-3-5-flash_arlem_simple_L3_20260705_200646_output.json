  "activity": {
    "id": "act_dna_replication",
    "name": "DNA Structure & Semiconservative Replication Lab",
    "description": "An interactive AR lab detailing the 3D structure of DNA and the semiconservative mechanism of its replication, covering antiparallel directionality, base pairing, and key enzymatic actions at the replication fork.",
    "workplace": "wp_dna_replication",
    "start": "step_dna_structure",
    "actions": [
      {
        "id": "step_dna_structure",
        "instruction": {
          "title": "The DNA Double Helix Structure",
          "description": "Examine the physical 3D model of the DNA double helix on your bench. Observe the antiparallel sugar-phosphate backbones spiraling around a common axis. Look for the 5' and 3' directionality labels on the strands, showing how they run in opposite directions."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "default",
              "text": "5' End (Sugar-Phosphate Backbone)"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "default",
              "text": "3' End (Sugar-Phosphate Backbone)"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_audio_intro",
              "poi": "default",
              "url": "https://assets.example.com/audio/dna_intro.mp3"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_model"
          }
        ]
      },
      {
        "id": "step_base_pairing",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Observe the nitrogenous bases pointing inward. Identify the complementary base-pairing rules: Adenine (A) always pairs with Thymine (T) via two hydrogen bonds, and Guanine (G) pairs with Cytosine (C) via three. Look at the reference poster chart to analyze the hydrogen bonding patterns."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_wall",
              "type": "predicate",
              "augmentation": "pred_img_basepairing",
              "poi": "default",
              "url": "https://assets.example.com/images/dna_basepairing.png"
            },
            {
              "target": "thing_dna_model",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "poi_base_pairs",
              "text": "A-T (2 H-Bonds) | G-C (3 H-Bonds)"
            }
          ],
          "deactivate": [
            {
              "target": "thing_dna_model",
              "augmentation": "*"
            }
          ]
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_reference_wall",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_dna_model"
          }
        ]
      },
      {
        "id": "step_unwinding",
        "instruction": {
          "title": "Unwinding: Helicase & SSB Proteins",
          "description": "Move to the interactive replication board. Helicase binds to the double helix and unwinds it, creating a replication fork. Single-strand binding proteins (SSBs) coat the single strands to prevent them from snapping back together. Pick up the Helicase enzyme from the tray to begin."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_board",
              "type": "predicate",
              "augmentation": "pred_anim_helicase",
              "poi": "poi_fork",
              "url": "https://assets.example.com/models/helicase_unwind.glb"
            },
            {
              "target": "thing_nucleotide_tray",
              "type": "predicate",
              "augmentation": "pred_label_3prime",
              "poi": "poi_enzymes",
              "text": "Select Helicase Enzyme Model"
            }
          ],
          "deactivate": [
            {
              "target": "thing_dna_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_replication_board"
          }
        ]
      },
      {
        "id": "step_synthesis",
        "instruction": {
          "title": "Leading vs. Lagging Strand Synthesis",
          "description": "Because DNA Polymerase can only synthesize DNA in a 5' to 3' direction, the two new strands are made differently. The leading strand is synthesized continuously toward the replication fork. The lagging strand is synthesized discontinuously away from the fork in short Okazaki fragments, which are later stitched together by DNA ligase."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_replication_board",
              "type": "predicate",
              "augmentation": "pred_anim_replication",
              "poi": "poi_lagging",
              "url": "https://assets.example.com/models/replication_fork_dynamics.glb"
            },
            {
              "target": "thing_replication_board",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "poi_lagging",
              "text": "Okazaki Fragments (Discontinuous)"
            },
            {
              "target": "thing_replication_board",
              "type": "predicate",
              "augmentation": "pred_audio_replication",
              "poi": "poi_fork",
              "url": "https://assets.example.com/audio/replication_fork.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "thing_replication_board",
              "augmentation": "*"
            },
            {
              "target": "thing_nucleotide_tray",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_replication_board"
          }
        ]
      },
      {
        "id": "step_semiconservative",
        "instruction": {
          "title": "Semiconservative Replication Complete",
          "description": "Analyze the two finished DNA double-stranded molecules. Notice that each new helix contains exactly one original parental strand (template) and one newly-synthesized strand. This is why replication is called semiconservative. You have successfully mapped the replication fork!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_main_bench",
              "type": "predicate",
              "augmentation": "pred_label_5prime",
              "poi": "default",
              "text": "Each copy has 1 template strand + 1 new strand. Semiconservative replication confirmed!"
            }
          ],
          "deactivate": [
            {
              "target": "thing_replication_board",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_main_bench"
          }
        ]
      }
    ]
  }
}