  "activity": {
    "id": "act_heart_anatomy",
    "name": "Human Heart Anatomy and Blood Flow Journey",
    "description": "An exploration of the structural anatomy of the human heart and the path that blood takes through it, tracing chambers, valves, vessels, and comparing myocardial thickness.",
    "workplace": "wp_anatomy_lab",
    "start": "action_intro",
    "actions": [
      {
        "id": "action_intro",
        "instruction": {
          "title": "Chamber Identification & Normal Rhythm",
          "description": "Welcome to the cardiovascular anatomy lab. Locate the anatomical heart model. Observe the rhythmic contraction of the four chambers. Locate the Right Atrium and Left Ventricle highlighted on the model, and click the Heart Model to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_heart_animation",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_heart_sound",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_atrium",
              "text": "Right Atrium"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Left Ventricle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_right_side",
        "instruction": {
          "title": "The Pulmonary Loop (Right Heart)",
          "description": "Notice the blue flow lines representing deoxygenated blood. It enters the Right Atrium from the systemic circuit, passes through the Tricuspid Valve into the Right Ventricle, and is then pumped to the lungs. Click the model to trace the oxygenated return."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_blood_flow_blue",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_tricuspid",
              "text": "Tricuspid Valve"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_ventricle",
              "text": "Right Ventricle (To Lungs)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_left_side",
        "instruction": {
          "title": "The Systemic Loop (Left Heart)",
          "description": "Now look at the red flow. Oxygenated blood returns from the lungs into the Left Atrium, crosses the Mitral (Bicuspid) Valve, and fills the Left Ventricle. From here, it is driven out through the Aorta to nourish tissues. Click the model to compare chamber wall sizes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "predicate",
              "augmentation": "pred_blood_flow_red",
              "poi": "default"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_atrium",
              "text": "Left Atrium (From Lungs)"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Mitral Valve & Left Ventricle"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_myocardium_comparison",
        "instruction": {
          "title": "Myocardium Thickness and Pressure",
          "description": "Observe the physical differences between the ventricles. The Left Ventricle features a much thicker myocardium because it must generate high pressure to perfuse the entire systemic body. The Right Ventricle wall is thinner, requiring only low pressure to send blood to the nearby lungs. Now, face the Blood Flow Indicator board to continue."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_right_ventricle",
              "text": "Thin Myocardium (Low Pressure)"
            },
            {
              "target": "thing_heart_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "poi_left_ventricle",
              "text": "Thick Myocardium (High Pressure)"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_blood_flow_indicator"
          }
        ]
      },
      {
        "id": "action_circuits_summary",
        "instruction": {
          "title": "Dual Circuitry & Valve Summary",
          "description": "Examine the comprehensive dual-loop diagram projected onto the Reference Wall. Note how the atrioventricular and semilunar valves prevent backward flow during contraction, maintaining unidirectional circulation. Click on the poster area to finish the lab."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_wall",
              "type": "predicate",
              "augmentation": "pred_diagram_pulmonary",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "*",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_reference_wall"
          }
        ]
      }
    ]
