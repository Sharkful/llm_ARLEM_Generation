  "activity": {
    "id": "activity_vsepr_theory_lab",
    "name": "VSEPR Theory & Molecular Geometry Lab",
    "description": "An interactive laboratory introducing university chemistry students to VSEPR theory, steric numbers, and molecular geometries using the water molecule as a primary case study.",
    "workplace": "workplace_vsepr_lab",
    "start": "action_intro_lewis",
    "actions": [
      {
        "id": "action_intro_lewis",
        "instruction": {
          "title": "Determine Lewis Structure & Steric Number",
          "description": "We will use the water molecule (H2O) to understand VSEPR theory. First, determine the Lewis structure of water on the Lewis Builder. Count the single bonds and lone pairs on the central Oxygen atom to find its steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_lewis_builder",
              "type": "predicate",
              "augmentation": "pred_label_lewis",
              "poi": "default"
            },
            {
              "target": "place_vsepr_chart",
              "type": "predicate",
              "augmentation": "pred_vsepr_chart_img",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_lewis_builder"
          }
        ]
      },
      {
        "id": "action_electron_domain",
        "instruction": {
          "title": "Observe Electron-Domain Geometry",
          "description": "Based on Oxygen's steric number of 4 (2 bonding pairs + 2 lone pairs), look at the molecule model station. Observe how the four electron domains repel each other to form an idealized tetrahedral arrangement with angles of 109.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_molecule_model",
              "type": "predicate",
              "augmentation": "pred_label_geometry",
              "poi": "default"
            },
            {
              "target": "thing_molecule_model",
              "type": "predicate",
              "augmentation": "pred_tetrahedral_anim",
              "poi": "above_model"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_builder",
              "augmentation": "pred_label_lewis"
            },
            {
              "target": "thing_molecule_model",
              "augmentation": "pred_label_geometry"
            },
            {
              "target": "thing_molecule_model",
              "augmentation": "pred_tetrahedral_anim"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_molecule_model"
          }
        ]
      },
      {
        "id": "action_lone_pair_repulsion",
        "instruction": {
          "title": "Analyze Lone Pair Repulsion",
          "description": "Why is the actual bond angle in water 104.5\u00b0 instead of 109.5\u00b0? Review the comparison chart. Non-bonding lone pairs are attracted to only one nucleus, causing them to spread out and exert stronger repulsion on adjacent bonding pairs, compressing the H-O-H bond angle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vsepr_chart",
              "type": "predicate",
              "augmentation": "pred_lone_pair_vs_bonding_img",
              "poi": "default"
            },
            {
              "target": "thing_molecule_model",
              "type": "predicate",
              "augmentation": "pred_label_lonepair",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vsepr_chart",
              "augmentation": "pred_lone_pair_vs_bonding_img"
            },
            {
              "target": "thing_molecule_model",
              "augmentation": "pred_label_lonepair"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_vsepr_chart"
          }
        ]
      },
      {
        "id": "action_molecular_geometry",
        "instruction": {
          "title": "Molecular Geometry: Bent Shape",
          "description": "When describing molecular geometry, we ignore the visual presence of lone pairs but still account for their physical repulsion. Observe how the tetrahedral electron-domain geometry collapses into a 'bent' molecular geometry. Confirm this experimentally observed shape at the comparison station."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_molecule_model",
              "type": "predicate",
              "augmentation": "pred_water_bent_anim",
              "poi": "above_model"
            },
            {
              "target": "thing_comparison_station",
              "type": "predicate",
              "augmentation": "pred_label_comparison",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_molecule_model",
              "augmentation": "pred_water_bent_anim"
            },
            {
              "target": "thing_comparison_station",
              "augmentation": "pred_label_comparison"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_comparison_station"
          }
        ]
      },
      {
        "id": "action_real_world_comp",
        "instruction": {
          "title": "Lab Exploration Completed",
          "description": "Congratulations! You have successfully completed the VSEPR lab exploration. You have learned how to predict steric numbers, determine electron-domain versus molecular geometries, and explain how lone pair repulsions deviate actual bond angles from idealized shapes."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_main_desk",
              "type": "predicate",
              "augmentation": "pred_label_complete",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vsepr_chart",
              "augmentation": "pred_vsepr_chart_img"
            },
            {
              "target": "place_main_desk",
              "augmentation": "pred_label_complete"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_main_desk"
          }
        ]
      }
    ]
  }
