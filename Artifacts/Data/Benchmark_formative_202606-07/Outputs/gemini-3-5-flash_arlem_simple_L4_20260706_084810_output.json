  "activity": {
    "id": "retrograde_motion_exploration",
    "name": "Apparent Retrograde Motion Exploration",
    "description": "An interactive, multi-view AR lab exploring how the heliocentric model naturally explains the apparent retrograde loops of Mars and other outer planets without complex epicycles.",
    "workplace": "wp_astronomy_retrograde",
    "start": "step_1_night_sky",
    "actions": [
      {
        "id": "step_1_night_sky",
        "instruction": {
          "title": "The Retrograde Puzzle",
          "description": "Look up at the night sky. Watch Mars drift eastward against the background stars, slow down, loop backward (retrograde), and then resume its eastward motion. Listen to the introduction explaining this historical cosmic puzzle."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "observing_deck",
              "type": "predicate",
              "augmentation": "p_constellations_sky",
              "poi": "default"
            },
            {
              "target": "mars_model",
              "type": "predicate",
              "augmentation": "p_retrograde_anim",
              "poi": "default"
            },
            {
              "target": "observing_deck",
              "type": "predicate",
              "augmentation": "p_audio_intro",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "observing_deck"
          }
        ]
      },
      {
        "id": "step_2_geocentric",
        "instruction": {
          "title": "The Geocentric Epicycle",
          "description": "Examine the geocentric model around Earth. Mars travels along a small circle called an epicycle, which itself moves along a larger orbit (the deferent). Notice how this mechanical loop mimics retrograde motion but requires overly complex engineering."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "earth_globe",
              "type": "predicate",
              "augmentation": "p_geocentric_anim",
              "poi": "default"
            },
            {
              "target": "earth_globe",
              "type": "predicate",
              "augmentation": "p_audio_geo",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "observing_deck",
              "augmentation": "*"
            },
            {
              "target": "mars_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "earth_globe"
          }
        ]
      },
      {
        "id": "step_3_heliocentric",
        "instruction": {
          "title": "Heliocentric Orbit Reality",
          "description": "Walk to the heliocentric tabletop projection. Watch Earth and Mars orbit smoothly around the Sun. Notice how Earth, orbiting faster on the inside track, naturally catches up to and passes Mars every 26 months."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_table",
              "type": "predicate",
              "augmentation": "p_heliocentric_anim",
              "poi": "default"
            },
            {
              "target": "heliocentric_table",
              "type": "predicate",
              "augmentation": "p_audio_helio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "earth_globe",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "heliocentric_table"
          }
        ]
      },
      {
        "id": "step_4_linking",
        "instruction": {
          "title": "Linking the Perspectives",
          "description": "Observe how the sightline from Earth to Mars projects onto the distant constellations. As Earth overtakes Mars, this line of sight naturally sweeps backward across the night sky, creating the illusion of a loop without any physical backtracking."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_table",
              "type": "predicate",
              "augmentation": "p_sidebyside_anim",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_table",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "heliocentric_table"
          }
        ]
      },
      {
        "id": "step_5_comparison",
        "instruction": {
          "title": "Comparing Outer Planets",
          "description": "Compare the retrograde loops of Mars (15 deg), Jupiter (10 deg), and Saturn (7 deg). Notice that planets further from the Sun produce smaller loops because the relative angle subtended by Earth's orbit is much smaller."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "heliocentric_table",
              "type": "predicate",
              "augmentation": "p_comparison_img",
              "poi": "default"
            },
            {
              "target": "heliocentric_table",
              "type": "predicate",
              "augmentation": "p_audio_comparison",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_table",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "heliocentric_table"
          }
        ]
      },
      {
        "id": "step_6_recap",
        "instruction": {
          "title": "Retrograde Motion Recapped",
          "description": "Review the completed lab concepts: the apparent motion loop, the geocentric epicycles, the heliocentric overtaking geometry, and how loop size scales with planetary distance. You have completed the laboratory!"
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
