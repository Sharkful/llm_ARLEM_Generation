  "activity": {
    "id": "activity_dna_replication",
    "name": "DNA Structure & Replication AR Lab",
    "description": "An interactive 3D laboratory exploring DNA double-helix structures, complementary pairing, directionality, and the molecular mechanics of semiconservative replication.",
    "workplace": "workplace_dna_replication",
    "start": "step_1_ladder_schematic",
    "actions": [
      {
        "id": "step_1_ladder_schematic",
        "instruction": {
          "title": "DNA Structure: The Ladder Schematic",
          "description": "Observe the flat, ladder-like schematic representation of DNA. Note the two vertical sugar-phosphate backbones running on the sides, and the horizontal rungs representing complementary nitrogenous base pairs (A with T, G with C) projecting inward. Listen to the narration describing DNA as a polymer."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_dna_ladder",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_ladder_schematic.mp3"
            },
            {
              "target": "dna_helix_model",
              "type": "primitive",
              "augmentation": "label",
              "poi": "default",
              "text": "Sugar-Phosphate Backbone"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_2_helix_twist"
          }
        ]
      },
      {
        "id": "step_2_helix_twist",
        "instruction": {
          "title": "The Double Helix Twist",
          "description": "Watch as the flat ladder structure twists into a three-dimensional double helix. The backbones spiral around a common axis, and the base pairs stack along the interior. Real DNA completes a full helical turn approximately every 10 base pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_dna_twist",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_helical_twist.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "pred_dna_ladder"
            },
            {
              "target": "dna_helix_model",
              "type": "primitive",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_3_antiparallel"
          }
        ]
      },
      {
        "id": "step_3_antiparallel",
        "instruction": {
          "title": "Antiparallel Orientation",
          "description": "Examine the directionality of the two strands. Note the arrows: one strand runs 5' to 3' (pointing up), and the other runs 3' to 5' (pointing down). This antiparallel arrangement is a consequence of the directional chemistry of the deoxyribose sugars."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "dna_helix_model",
              "type": "predicate",
              "augmentation": "pred_antiparallel_arrows",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_antiparallel.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "pred_dna_twist"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_4_base_pairing"
          }
        ]
      },
      {
        "id": "step_4_base_pairing",
        "instruction": {
          "title": "Complementary Base Pairing",
          "description": "Drag nitrogenous bases from the palette to build the complementary sequence on the empty strand. Notice how Adenine (A) always pairs with Thymine (T) via 2 hydrogen bonds, and Guanine (G) pairs with Cytosine (C) via 3 hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "display_zone",
              "type": "predicate",
              "augmentation": "pred_interactive_pairing",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_base_pairing.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_5_helicase"
          }
        ]
      },
      {
        "id": "step_5_helicase",
        "instruction": {
          "title": "Helicase Unwinding",
          "description": "Look at the replication fork model. The enzyme Helicase binds to the double helix, breaking the hydrogen bonds between base pairs and unwinding the double helix to expose the template strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_helicase_unwind",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_helicase.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "display_zone",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_6_ssb"
          }
        ]
      },
      {
        "id": "step_6_ssb",
        "instruction": {
          "title": "Single-Strand Binding Proteins",
          "description": "Observe how Single-Strand Binding Proteins (SSBs) coat the newly separated template strands. SSBs stabilize the unstable single strands, preventing them from re-annealing or folding back on themselves."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_ssb_binding",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_ssb.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "pred_helicase_unwind"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_7_polymerase_leading"
          }
        ]
      },
      {
        "id": "step_7_polymerase_leading",
        "instruction": {
          "title": "Leading Strand Synthesis",
          "description": "DNA Polymerase can only synthesize DNA in the 5' to 3' direction. On the leading strand template, synthesis proceeds continuously in the same direction as the moving replication fork, following a short primer."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_leading_strand",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_leading.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "pred_ssb_binding"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_8_lagging_strand"
          }
        ]
      },
      {
        "id": "step_8_lagging_strand",
        "instruction": {
          "title": "Lagging Strand & Okazaki Fragments",
          "description": "Because of the antiparallel structure, the other strand is synthesized discontinuously away from the fork in short Okazaki fragments. These fragments are later joined together by DNA Ligase to form a complete continuous strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_lagging_strand",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_lagging.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "pred_leading_strand"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_9_full_fork"
          }
        ]
      },
      {
        "id": "step_9_full_fork",
        "instruction": {
          "title": "The Complete Replication Fork",
          "description": "Examine the entire replication fork operating simultaneously: Helicase unwinding, SSBs protecting, leading-strand polymerase moving continuously, lagging-strand polymerase forming Okazaki fragments, and Ligase sealing them."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "replication_fork_model",
              "type": "predicate",
              "augmentation": "pred_full_fork",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_full_fork.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "pred_lagging_strand"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_10_semiconservative"
          }
        ]
      },
      {
        "id": "step_10_semiconservative",
        "instruction": {
          "title": "Semiconservative Replication",
          "description": "Observe how DNA replication produces two daughter molecules, each containing one original parental strand (gold) and one newly-synthesized strand (silver). Semiconservative replication ensures high-fidelity transmission of genetic material."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "semicon_experiment_model",
              "type": "predicate",
              "augmentation": "pred_semicon_round1",
              "poi": "default"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_semicon.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_11_recap"
          }
        ]
      },
      {
        "id": "step_11_recap",
        "instruction": {
          "title": "Lab Review & Summary",
          "description": "Review the six core concepts of the lab: double-helix structure, base-pairing rules, antiparallel directionality, enzymatic actions at the fork, asymmetric replication (leading vs. lagging strands), and semiconservative replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "display_zone",
              "type": "primitive",
              "augmentation": "image",
              "poi": "default",
              "url": "https://assets.example.com/recap_summary_sheet.png"
            },
            {
              "target": "lab_bench",
              "type": "primitive",
              "augmentation": "audio",
              "poi": "default",
              "url": "https://assets.example.com/narration_recap.mp3"
            }
          ],
          "deactivate": [
            {
              "target": "semicon_experiment_model",
              "type": "*",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step_1_ladder_schematic"
          }
        ]
      }
    ]
  }
}