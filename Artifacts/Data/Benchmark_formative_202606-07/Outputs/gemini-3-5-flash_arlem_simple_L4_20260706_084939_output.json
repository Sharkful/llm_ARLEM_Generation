  "activity": {
    "id": "heart_anatomy_lab_act",
    "name": "Anatomy of the Human Heart and Blood Flow Tracing AR Lab",
    "description": "An interactive AR educational exploration of the structures of the human heart, its internal valves, and the systematic tracing of the dual-loop cardiovascular circulatory system.",
    "workplace": "heart_anatomy_lab_wp",
    "start": "act_step_1_orientation",
    "actions": [
      {
        "id": "act_step_1_orientation",
        "instruction": {
          "title": "Scene 1: Gross Anatomical Orientation",
          "description": "Examine the side-by-side intact and cutaway heart models. Locate the apex at the bottom pointing slightly left. Note that Left and Right sides are reversed relative to your view, as they match the patient's anatomical perspective. Listen to the introductory orientation narration."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_intact",
              "type": "predicate",
              "augmentation": "pred_heart_intact_model",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_heart_cutaway_model",
              "poi": "default"
            },
            {
              "target": "place_anatomy_bench",
              "type": "predicate",
              "augmentation": "pred_audio_scene1",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_step_2_structural_tour"
          }
        ]
      },
      {
        "id": "act_step_2_structural_tour",
        "instruction": {
          "title": "Scene 2: Heart Structural Tour",
          "description": "Study the highlighted structures on the cutaway view. Locate the four chambers (Right Atrium, Right Ventricle, Left Atrium, Left Ventricle) and the four valves regulating flow between chambers and outflow vessels (Tricuspid, Pulmonary, Mitral/Bicuspid, and Aortic)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_heart_cutaway_model",
              "poi": "default"
            },
            {
              "target": "place_anatomy_bench",
              "type": "predicate",
              "augmentation": "pred_audio_scene2",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_ra",
              "poi": "right_atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_rv",
              "poi": "right_ventricle"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_la",
              "poi": "left_atrium"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_lv",
              "poi": "left_ventricle"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_tricuspid",
              "poi": "tricuspid_valve"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_pulmonary_v",
              "poi": "pulmonary_valve"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_mitral",
              "poi": "mitral_valve"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_label_aortic_v",
              "poi": "aortic_valve"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_heart_cutaway",
              "augmentation": "*"
