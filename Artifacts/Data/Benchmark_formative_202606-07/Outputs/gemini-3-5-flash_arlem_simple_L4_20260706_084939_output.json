          }
        ]
      },
      {
        "id": "act_step_5_ventricular_myocardium",
        "instruction": {
          "title": "Scene 5: Ventricular Myocardial Wall Asymmetry",
          "description": "Observe the horizontal cross-section of the ventricles. Note the 3:1 thickness ratio of the left ventricular myocardium (10-15mm) compared to the right (3-5mm). The left ventricle must exert far greater pressure to drive blood through the systemic circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cross_section",
              "type": "predicate",
              "augmentation": "pred_cross_section_model",
