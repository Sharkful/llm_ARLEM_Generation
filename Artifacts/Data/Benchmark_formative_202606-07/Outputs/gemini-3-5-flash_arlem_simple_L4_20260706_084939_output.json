            {
              "target": "place_anatomy_bench",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "act_step_3_dual_circulation"
          }
        ]
      },
      {
        "id": "act_step_3_dual_circulation",
        "instruction": {
          "title": "Scene 3: Dual-Circuit Circulation Dynamics",
          "description": "Watch the flowing dual circulation streams: blue indicates deoxygenated blood traveling through the right heart towards the pulmonary circuit (lungs), while red indicates oxygenated blood returning to the left heart and heading into the systemic circuit (body)."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_heart_cutaway_model",
              "poi": "default"
            },
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
