      },
      {
        "id": "act_step_4_rbc_trace",
        "instruction": {
          "title": "Scene 4: Red Blood Cell Flow Pathway",
          "description": "Follow the interactive red blood cell as it travels from the Superior Vena Cava through the right atrium, tricuspid valve, right ventricle, pulmonary valve, and lung capillaries (where it turns from blue to red). Continue through the left side of the heart and out into systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_heart_cutaway",
              "type": "predicate",
              "augmentation": "pred_heart_cutaway_model",
              "poi": "default"
            },
            {
