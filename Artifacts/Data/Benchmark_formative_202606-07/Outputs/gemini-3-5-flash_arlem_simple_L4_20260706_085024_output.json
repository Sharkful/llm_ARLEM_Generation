  "activity": {
    "id": "act_vectors_and_projectile_motion",
    "name": "Vectors and 2D Projectile Motion Laboratory",
    "description": "An interactive undergraduate mechanics lab exploring vectors, vector mathematics, addition, decomposition, and their direct application to physical 2D projectile motion.",
    "workplace": "wp_physics_vectors",
    "start": "act_vector_intro",
    "actions": [
      {
        "id": "act_vector_intro",
        "instruction": {
          "title": "Introduction to Vectors",
          "description": "Observe the 3D vector arrow floating in the workspace. Grab the tip to change its magnitude and direction, observing the live readout updates. Rotate your view to confirm that the physical vector remains unchanged, regardless of perspective."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_vector_3d_model",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "type": "predicate",
              "augmentation": "pred_vector_math_labels",
              "poi": "poi_arrow_tip",
              "text": "3D Vector: Drag to update Magnitude and Direction"
            },
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_vector_intro_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_vector_arrow",
              "augmentation": "*"
            },
            {
              "target": "place_vector_sandbox",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_vector_addition",
        "instruction": {
          "title": "Vector Addition (Tip-to-Tail)",
          "description": "Observe how the blue and green vectors add tip-to-tail to form the red resultant vector. Manipulate either input vector to see how the resultant dynamically updates, demonstrating that vector addition is commutative."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_vector_addition_model",
              "poi": "default"
            },
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_addition_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_sandbox",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_vector_decomposition",
        "instruction": {
          "title": "Vector Decomposition",
          "description": "Decompose a single vector into its constituent x, y, and z component vectors aligned along the axes. Drag the component arrows to see how they continuously sum up to reconstruct the original vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_vector_decomposition_model",
              "poi": "default"
            },
            {
              "target": "place_vector_sandbox",
              "type": "predicate",
              "augmentation": "pred_decomp_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_sandbox",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_projectile_intro",
        "instruction": {
          "title": "2D Projectile Motion Plane",
          "description": "Observe the 2D vertical launch plane. Because gravity acts only downwards, projectile motion is strictly two-dimensional. Study the initial launch vector before firing the projectile."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_projectile_intro_audio",
              "poi": "default"
            },
            {
              "target": "thing_launcher",
              "type": "predicate",
              "augmentation": "pred_vector_math_labels",
              "poi": "poi_launch_nozzle",
              "text": "2D Projectile Launcher Plane"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "*"
            },
            {
              "target": "thing_launcher",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_projectile_flight",
        "instruction": {
          "title": "Independence of Components",
          "description": "Launch the ball. Watch the components in real-time: the horizontal component remains completely constant, while the vertical component changes linearly, reaching zero at the absolute peak of the flight."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_projectile_model",
              "poi": "poi_graph_plane"
            },
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_flight_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_max_range",
        "instruction": {
          "title": "Determining Maximum Range",
          "description": "Vary the initial launch angle and initial speed using the dials. Find the optimal angle that yields the absolute maximum range for any given speed, and verify the symmetry of complementary launch angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_projectile_plane",
              "type": "predicate",
              "augmentation": "pred_range_audio",
              "poi": "default"
            },
            {
              "target": "thing_control_board",
              "type": "predicate",
              "augmentation": "pred_vector_math_labels",
              "poi": "poi_dial_angle",
              "text": "Dial launch angle to 45\u00b0 for maximum range"
            }
          ],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "*"
            },
            {
              "target": "thing_control_board",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_control_board"
          }
        ]
      },
      {
        "id": "act_recap",
        "instruction": {
          "title": "Laboratory Recap and Summary",
          "description": "Fantastic job! You have completed the laboratory on vectors and 2D projectile motion. Review the core concepts before concluding."
        },
        "enter": {
