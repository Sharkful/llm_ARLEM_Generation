  "activity": {
    "id": "vsepr_theory_activity",
    "name": "Predicting Molecular Geometry via VSEPR Theory",
    "description": "Interactive 3D exploration of Valence Shell Electron Pair Repulsion (VSEPR) theory to predict molecular structures from Lewis dot configurations.",
    "workplace": "chem_vsepr_lab_workplace",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "instruction": {
          "title": "VSEPR: The Core Principle",
          "description": "Look at the Reference Panel. A flat Lewis structure of water is displayed. VSEPR theory predicts the 3D geometry of a molecule based on the repulsion of electron domains around a central atom. Click the screen to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_panel",
              "type": "predicate",
              "augmentation": "lewis_water_image",
              "poi": "screen"
            },
            {
              "target": "place_reference_panel",
              "type": "predicate",
              "augmentation": "vsepr_intro_audio",
              "poi": "default"
            }
          ],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_reference_panel"
          }
        ]
      },
      {
        "id": "step2_repulsion_demo",
        "instruction": {
          "title": "Minimum Repulsion in Action",
          "description": "Watch the Sandbox Table. Multiple electron domains (clouds) extend from the central atom and dynamically repel each other to establish standard linear, trigonal planar, and tetrahedral arrangements. Click the sandbox to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_vsepr_sandbox",
              "type": "predicate",
              "augmentation": "vsepr_repulsion_anim",
              "poi": "display_area"
            }
          ],
          "deactivate": [
            {
              "target": "place_reference_panel",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_vsepr_sandbox"
          }
        ]
      },
      {
        "id": "step3_geometry_catalog",
        "instruction": {
          "title": "The Domain Catalog",
          "description": "Observe the Central Atom model. A 3D shift showcases the transition into a tetrahedral geometry. Notice the steric number 4 label above. Click the model to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "tetrahedral_shift_anim",
              "poi": "default"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "label_steric_4",
              "poi": "top",
              "text": "Steric Number: 4 (Tetrahedral)"
            }
          ],
          "deactivate": [
            {
              "target": "place_vsepr_sandbox",
              "augmentation": "vsepr_repulsion_anim",
              "poi": "display_area"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_central_atom"
          }
        ]
      },
      {
        "id": "step4_bonding_vs_lone_pairs",
        "instruction": {
          "title": "Electron Domains vs Molecular Shapes",
          "description": "Hold up the physical Electron Domain Helper model. In this step, one of the hydrogen atoms of ammonia is substituted with a translucent lone-pair cloud, altering the visible molecular geometry. Click the physical helper model to proceed."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "thing_domain_model",
              "type": "predicate",
              "augmentation": "lone_pair_effect_anim",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "thing_central_atom",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "thing_domain_model"
          }
        ]
      },
      {
        "id": "step5_lone_pair_asymmetry",
        "instruction": {
          "title": "Angular Asymmetry and Deviances",
          "description": "Look back at the Reference Display. A comparative overlay shows how the larger size of lone pairs forces bonded atoms closer together (reducing H-X-H angles from 109.5 to 104.5 degrees). Click the display to wrap up the session."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_panel",
              "type": "predicate",
              "augmentation": "comparison_image",
              "poi": "screen"
            },
            {
              "target": "thing_central_atom",
              "type": "predicate",
              "augmentation": "label_bent_geometry",
              "poi": "top",
              "text": "Bent Geometry: 104.5 degrees"
            }
          ],
          "deactivate": [
            {
              "target": "thing_domain_model",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "place_reference_panel"
          }
        ]
      },
      {
        "id": "step6_recap",
        "instruction": {
          "title": "Lab Complete & Recap",
          "description": "You have explored the basic tenets of VSEPR theory, learned to calculate steric numbers, differentiated electron-domain from molecular geometry, and visualized lone pair repulsive asymmetry. Point the camera at the gallery card to exit."
        },
        "enter": {
          "remove_self": false,
          "activates": [
            {
              "target": "place_reference_panel",
              "type": "predicate",
              "augmentation": "vsepr_summary_audio",
              "poi": "default"
            }
          ],
          "deactivate": [
            {
              "target": "place_reference_panel",
              "augmentation": "*"
            },
            {
              "target": "thing_central_atom",
              "augmentation": "*"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_molecule_gallery"
          }
        ]
      }
    ]
  }
}