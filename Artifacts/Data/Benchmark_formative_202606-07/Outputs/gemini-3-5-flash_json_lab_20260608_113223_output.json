  "courseName": "General Chemistry I",
  "estimatedLength": "30 minutes",
  "objectives": [
    "Understand the core principle of Valence Shell Electron Pair Repulsion (VSEPR) theory",
    "Distinguish between electron-domain geometry and molecular geometry",
    "Predict three-dimensional shapes of covalent molecules based on electron domain counts",
    "Explain how lone pairs compress bond angles relative to idealized geometries"
  ],
