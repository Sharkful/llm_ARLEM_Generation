            {
              "target": "module1_description",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Methane (CH4) has 4 single bonding pairs and 0 lone pairs (Steric Number 4). The optimal 3D angle to minimize repulsion is exactly 109.5 degrees."
                }
              ]
