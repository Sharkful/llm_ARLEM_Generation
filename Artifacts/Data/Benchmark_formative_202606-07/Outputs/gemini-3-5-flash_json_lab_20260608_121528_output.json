              "target": "module1_description",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Valence Shell Electron Pair Repulsion theory states that electron pairs around a central atom repel each other, pushing themselves as far apart as possible."
                }
              ]
            }
          ]
        },
