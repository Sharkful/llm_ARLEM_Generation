          "clipName": "clip1_the_loop",
          "audioClip": "retrograde_looping_event",
          "autoAdvance": false,
          "changes": [
            {
              "target": "mars_sky_dot",
              "components": [
                {
                  "componentType": "newscript",
                  "scriptName": "retrogradepathanimator",
                  "scriptDescription": "Interpolates the target object position over time to trace a looping S-curve backward (westward) across the sky panel."
                }
              ]
            },
            {
              "target": "sky_label",
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Mars Loops Westward (Retrograde)",
                  "color": [
                    1,
                    0.5,
                    0.5,
                    1
                  ],
                  "fontSize": 32,
                  "wrapText": true
                }
              ]
            }
          ],
          "changeMeaning": "Animate Mars executing its westward loop, shifting its path temporarily backward.",
          "narration": "However, roughly every 26 months, Mars slows to a stop, reverses direction to travel westward for about two months, and then loops back to resume its eastward journey. This is retrograde motion."
        },
        {
          "clipName": "clip1_geocentric_epicycle",
          "audioClip": "retrograde_geocentric_epicycle",
          "autoAdvance": false,
          "changes": [
