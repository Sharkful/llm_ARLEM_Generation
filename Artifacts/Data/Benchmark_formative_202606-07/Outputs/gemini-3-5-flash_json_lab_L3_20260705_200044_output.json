                  "fontSize": 30
                }
              ]
            },
            {
              "target": "text_label_R",
              "enabled": true,
              "components": [
                {
                  "componentType": "textMeshPro",
                  "text": "Resultant R = A + B",
                  "fontSize": 30
                }
              ]
            }
          ],
          "changeMeaning": "Bring in Vector B and place it tip-to-tail with Vector A to visually construct Resultant Vector R.",
          "narration": "When multiple forces or velocities act on an object, we sum them. Graphically, we use the tip-to-tail method: place the tail of Vector B at the tip of Vector A. The combined effect is represented by the Resultant Vector, R, which connects the starting tail of A directly to the final tip of B."
        }
