  "activity": {
    "id": "astro_retrograde_activity",
    "name": "Apparent Retrograde Motion in the Solar System",
    "description": "A guided AR lab for introductory astronomy students exploring why Mars, Jupiter, and Saturn sometimes appear to move backward against the stars. Learners first observe the phenomenon from Earth's surface, then switch to a heliocentric viewpoint to see how Earth's faster orbit overtakes Mars and produces the apparent loop. The activity concludes with a comparison of outer planets and a synthesis of geocentric versus heliocentric explanations.",
    "language": "en",
    "workplace": "astro_retrograde_lab",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_1",
        "location": "earth_view_station",
        "predicate": "step_prompt_label",
        "instruction": {
          "title": "Orientation: what is retrograde motion?",
          "description": "Look at the night-sky dome and the Mars track overlay. Retrograde motion is the temporary westward loop Mars appears to make against the background stars, interrupting its usual slow eastward drift."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "sky_dome",
              "augmentation": "earth_surface_time_lapse"
            }
          ],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_earth_view",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset_1",
        "location": "earth_view_station",
        "predicate": "step_prompt_label",
        "instruction": {
          "title": "Earth-view observation: follow Mars night by night",
          "description": "Use the timeline on the sky dome to watch Mars drift eastward, slow, reverse into a westward loop for about two months, and then resume eastward motion. Notice that the loop is an apparent path on the celestial sphere, not a physical reversal of Mars's orbit."
        },
        "enter": {
