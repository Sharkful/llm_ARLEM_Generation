  "activity": {
    "id": "astro_retrograde_activity",
    "name": "Apparent Retrograde Motion: Mars, Earth, and the Outer Planets",
    "description": "A hands-on AR lab for introductory astronomy students exploring the apparent retrograde motion of Mars and comparing geocentric and heliocentric explanations. Learners observe the motion from Earth's surface, then from an outside solar-system perspective, and finish by predicting retrograde windows and comparing Mars with Jupiter and Saturn.",
    "language": "en",
    "workplace": "astro_retrograde_lab",
    "start": "step1_observe",
    "actions": [
      {
        "id": "step1_observe",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "night_sky_station",
        "predicate": "intro_mars_path",
        "instruction": {
          "title": "Observe Mars in the night sky",
          "description": "Start from Earth's surface. Watch Mars drift eastward against the background stars, then slow, reverse into a westward loop, and finally resume eastward motion. Notice the labeled constellations along the ecliptic and the trail that traces the full apparent path."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step1_observe",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_geocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "night_sky_station",
        "predicate": "geocentric_epicycle_animation",
        "instruction": {
          "title": "Test the geocentric explanation",
          "description": "Examine Earth-centered motion. Turn on the deferent and epicycle labels and watch how Mars can appear to reverse direction when it reaches the near side of the epicycle. This model matches the observation, but only by adding tuned circular motions."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step2_geocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step3_heliocentric",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "solar_system_overview",
        "predicate": "heliocentric_orbits_animation",
        "instruction": {
          "title": "Switch to the heliocentric model",
          "description": "Move up above the solar system and compare Earth's inner, faster orbit with Mars's slower outer orbit. Watch Earth catch and overtake Mars about every 26 months. In this view, the retrograde loop disappears as a natural consequence of relative motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "step3_heliocentric",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step4_link_views",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "solar_system_overview",
        "predicate": "line_of_sight_label",
        "instruction": {
          "title": "Link the two viewpoints",
          "description": "Follow the line of sight from Earth to Mars as the geometry changes. When Earth overtakes Mars, the projected direction against the stars reverses, producing the apparent backward loop seen from the ground. This connects the outside view to the night-sky observation."
        },
        "enter": {
