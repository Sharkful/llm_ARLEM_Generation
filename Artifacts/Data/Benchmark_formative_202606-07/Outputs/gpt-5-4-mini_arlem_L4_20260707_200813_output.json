        "type": "actions",
        "device": "hololens_2",
        "location": "main_bench",
        "predicate": "dna_helix_intro",
        "instruction": {
          "title": "DNA as a ladder-like polymer",
          "description": "Observe the schematic DNA ladder on the bench. Identify the sugar-phosphate backbones as the two outer rails and the nitrogenous bases as the inward-facing rungs. Focus on how complementary bases pair across the middle."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_model",
              "augmentation": "antiparallel_arrows"
            },
            {
              "target": "dna_model",
              "augmentation": "helicase_action"
            },
            {
              "target": "dna_model",
              "augmentation": "ssb_action"
            },
            {
              "target": "dna_model",
              "augmentation": "polymerase_leading"
            },
            {
              "target": "dna_model",
              "augmentation": "polymerase_lagging"
