  "activity": {
    "id": "dna_replication_intro_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An introductory AR molecular biology lab in which students explore the 3D structure of DNA, identify complementary base pairing and antiparallel orientation, and then trace semiconservative replication through the actions of helicase, single-strand binding proteins, DNA polymerase, and DNA ligase.",
