  "activity": {
    "id": "physics_vectors_projectiles_activity",
    "name": "Vectors and Projectile Motion in 2D",
    "description": "A guided AR lab for exploring vectors as quantities with magnitude and direction, vector addition and decomposition, and the application of those ideas to two-dimensional projectile motion. Students manipulate arrows, compare components, observe independence of horizontal and vertical motion, and investigate how launch angle and speed affect trajectory, range, and maximum height.",
    "language": "en",
    "workplace": "physics_vectors_projectiles_lab",
    "start": "step1_vector_intro",
    "actions": [
      {
        "id": "step1_vector_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "holoheadset_01",
        "location": "vector_staging_zone",
        "predicate": "show_vector_intro_label",
        "instruction": {
          "title": "1. Inspect a single vector",
          "description": "Observe the arrow at the origin. Notice its tail, head, magnitude, and direction. Grab the head and drag it to see how changing the arrow changes both size and angle in real time."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "vector_arrow",
            "type": "tangible",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step2_vector_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "holoheadset_01",
        "location": "vector_staging_zone",
        "predicate": "show_tip_to_tail_label",
        "instruction": {
          "title": "2. Build a resultant with tip-to-tail addition",
          "description": "Move the blue and green vectors so the second starts at the tip of the first. Compare the red resultant from the first tail to the final tip. Confirm that the same resultant appears when the vectors are arranged in the opposite order."
        },
        "enter": {
          "remove_self": false,
