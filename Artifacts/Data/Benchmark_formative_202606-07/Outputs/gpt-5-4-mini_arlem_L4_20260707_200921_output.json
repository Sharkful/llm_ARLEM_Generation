        ]
      },
      {
        "id": "step3_vector_components",
        "viewport": "actions",
        "type": "actions",
        "device": "holoheadset_01",
        "location": "vector_staging_zone",
        "predicate": "show_component_triangulation_image",
        "instruction": {
          "title": "3. Decompose the vector into components",
          "description": "Break the vector into x and y components. Use the right-triangle guide to connect magnitude, angle, and component lengths. Rebuild the original vector by adding the component arrows tip-to-tail."
        },
        "enter": {
