  "activity": {
    "id": "vsepr_chem101_lab",
    "name": "VSEPR Theory and Molecular Geometry",
    "description": "An AR laboratory sequence for introductory general chemistry students exploring VSEPR theory. Learners start from a Lewis structure, count electron domains, observe how repulsion determines electron-domain geometry, distinguish electron-domain geometry from molecular geometry, compare lone pair effects on bond angles, and apply VSEPR to representative molecules.",
    "language": "en",
    "workplace": "chem_vsepr_workshop",
    "start": "step1_intro",
    "actions": [
      {
        "id": "step1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "ar_headset",
        "location": "main_bench",
        "predicate": "intro_vsepr_audio",
        "instruction": {
          "title": "Introduce VSEPR",
          "description": "Listen to the overview and inspect the central atom setup. VSEPR predicts 3D geometry by arranging electron domains as far apart as possible."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
