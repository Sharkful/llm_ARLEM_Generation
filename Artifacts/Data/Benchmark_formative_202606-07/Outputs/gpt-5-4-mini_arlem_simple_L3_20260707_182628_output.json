  "activity": {
    "id": "astro_retrograde_activity",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A simplified AR lab for introductory astronomy students exploring why Mars appears to reverse direction in the sky, comparing geocentric and heliocentric explanations and extending the idea to Jupiter and Saturn.",
    "workplace": "astro_retrograde_lab",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Step 1: Locate Mars in the night sky",
          "description": "Begin at the Earth-surface viewpoint and observe Mars drifting eastward against the star field. This establishes the normal background motion before retrograde begins."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
