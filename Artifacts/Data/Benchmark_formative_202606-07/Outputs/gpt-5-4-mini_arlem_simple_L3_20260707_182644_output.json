  "activity": {
    "id": "dna_replication_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR lab that introduces DNA double-helix structure, complementary base pairing, antiparallel strand orientation, and the semiconservative mechanics of DNA replication with helicase, polymerase, and ligase.",
