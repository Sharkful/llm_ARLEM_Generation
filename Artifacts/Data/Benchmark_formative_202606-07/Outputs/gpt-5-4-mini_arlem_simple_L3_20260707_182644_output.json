    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Step 1: Inspect the DNA double helix",
          "description": "Observe the 3D DNA model and identify the sugar-phosphate backbones, inward-facing bases, and the helical axis."
