          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "3. Resolve a vector into components",
          "description": "Examine the right triangle formed by a vector and its x- and y-components. Use the axes label and decomposition image to connect vector magnitude with trigonometric components."
        },
        "enter": {
