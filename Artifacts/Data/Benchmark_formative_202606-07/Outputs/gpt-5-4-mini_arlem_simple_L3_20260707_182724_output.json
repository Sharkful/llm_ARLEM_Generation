  "activity": {
    "id": "phys_vectors_projectiles_act",
    "name": "Vectors to Projectile Motion",
    "description": "A linear AR lab that introduces vectors as magnitude-direction quantities, then applies vector decomposition to two-dimensional projectile motion. Students build a resultant by tip-to-tail addition, resolve a vector into x- and y-components, and connect those components to launch angle, range, and maximum height in projectile flight.",
    "workplace": "phys_vectors_projectiles_wk",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "1. Vector as magnitude and direction",
          "description": "Observe the vector board and identify a single vector by its length and angle. Notice that the same vector can be described with components along the horizontal x-axis and vertical y-axis."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_done"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "2. Add vectors tip-to-tail",
          "description": "Use the vector board to place two vectors tip-to-tail and identify the resultant vector that runs from the tail of the first vector to the tip of the second."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
