  "activity": {
    "id": "chem_vsepr_activity",
    "name": "VSEPR Theory: From Electron Domains to Molecular Shape",
    "description": "A simplified AR lab for General Chemistry I that introduces VSEPR theory, electron-domain geometry, molecular geometry, lone-pair effects, and comparisons with common molecules.",
    "workplace": "chem_vsepr_workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Start with the Lewis structure",
          "description": "Examine the Lewis structure and count bonding pairs and lone pairs around the central atom to determine the steric number."
