  "activity": {
    "id": "astro_retrograde_activity",
    "name": "Apparent Retrograde Motion",
    "description": "A linear AR lab exploring why Mars appears to reverse direction in the night sky, comparing geocentric and heliocentric explanations and extending the idea to Jupiter and Saturn.",
    "workplace": "astro_retrograde_wp",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "1. Observe Mars in the night sky",
          "description": "View Mars drifting eastward against the constellations, then slowing and reversing into a retrograde loop."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
