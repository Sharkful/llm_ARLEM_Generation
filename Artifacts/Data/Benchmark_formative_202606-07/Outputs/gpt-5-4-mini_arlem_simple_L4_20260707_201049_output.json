  "activity": {
    "id": "dna_replication_intro_activity",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear introductory AR lab that moves from DNA structure to base pairing, antiparallel strand orientation, replication fork enzymes, leading and lagging strand synthesis, and semiconservative replication outcomes.",
