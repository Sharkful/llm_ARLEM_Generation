  "activity": {
    "id": "heart_activity",
    "name": "Human Heart Structure and Blood Flow",
    "description": "A linear AR lab introducing the gross anatomy of the human heart, the major chambers, valves, and vessels, and the directional path of blood through pulmonary and systemic circulation.",
    "workplace": "heart_workplace",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "Orientation to the Heart Models",
          "description": "Observe the intact and cutaway heart side by side. Identify anatomical right and left from the patient's perspective and note the apex, base, and major vessel openings."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1_next"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Chambers of the Heart",
          "description": "Study the four chambers in sequence: right atrium, right ventricle, left atrium, and left ventricle. Compare the relative wall thickness of the ventricles while locating each chamber on the cutaway model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_cutaway_heart"
          }
        ]
      },
      {
        "id": "step3",
        "instruction": {
          "title": "Valves and Directional Flow",
          "description": "Identify the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Focus on how each valve separates chambers or chamber-vessel pairs and prevents backflow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step3_next"
          }
        ]
      },
      {
        "id": "step4",
        "instruction": {
          "title": "Major Vessels and Blood Entry/Exit",
          "description": "Locate the superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Trace where each vessel enters or leaves the heart on the intact model."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step4_next"
          }
        ]
      },
      {
        "id": "step5",
        "instruction": {
          "title": "Dual Circulation Pathway",
          "description": "Follow the movement of blood through the pulmonary circuit and then the systemic circuit. Blue indicates deoxygenated blood returning to the right heart, and red indicates oxygenated blood returning to the left heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step5_next"
          }
        ]
      },
      {
        "id": "step6",
        "instruction": {
          "title": "Ventricle Thickness and Cardiac Work",
          "description": "Compare the ventricular walls using the cross-sectional illustration. The left ventricle has a thicker myocardium because it must generate higher pressure to perfuse the systemic circulation."
        },
        "enter": {
