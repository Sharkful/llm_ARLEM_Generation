  "activity": {
    "id": "chem_vsepr_activity",
    "name": "VSEPR Theory: From Lewis Structures to 3D Shape",
    "description": "A linear AR lab for General Chemistry I that guides students from Lewis structures to electron-domain geometry, molecular geometry, lone-pair effects, and molecule prediction using VSEPR theory.",
    "workplace": "chem_vsepr_lab",
    "start": "step1",
    "actions": [
      {
        "id": "step1",
        "instruction": {
          "title": "VSEPR Setup",
          "description": "Observe how a flat Lewis structure leads to a 3D prediction. Identify the central atom and count each bond or lone pair as one electron domain."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "step1"
          }
        ]
      },
      {
        "id": "step2",
        "instruction": {
          "title": "Minimum Repulsion",
          "description": "Watch electron domains move apart until they are maximally separated. Compare the settled arrangement to the ideal linear, trigonal planar, and tetrahedral cases."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
