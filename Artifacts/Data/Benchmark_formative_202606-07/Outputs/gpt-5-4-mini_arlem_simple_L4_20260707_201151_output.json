      {
        "id": "step4",
        "instruction": {
          "title": "Electron Geometry vs Molecular Shape",
          "description": "Compare methane, ammonia, and water to see how lone pairs change the visible molecular geometry while preserving the underlying electron-domain geometry."
        },
        "enter": {
