  "activity": {
    "id": "activity_intro-retrograde_mars_lab_01",
    "name": "AR Lab: Apparent Retrograde Motion (Mars \u2022 Earth overtaking \u2022 Jupiter & Saturn)",
    "description": "Students observe Mars\u2019s apparent retrograde loop from Earth, then explain it using a heliocentric outside-solar-system view (Earth overtakes Mars in relative longitude). The lab compares geocentric vs heliocentric explanations, practices prediction, and contrasts retrograde loop sizes for Mars, Jupiter, and Saturn.",
    "language": "en",
    "workplace": "astro-lab-retrograde-wp",
    "start": "action_step1_setup",
    "actions": [
      {
        "id": "action_step1_setup",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hmd_1",
        "location": "place_earth_view_station",
        "predicate": "pred_mars_loop_overview",
        "instruction": {
          "title": "Set Up: The Retrograde Puzzle",
          "description": "You will track Mars\u2019s sky position over time: first it drifts eastward, then it slows and moves westward in a loop (retrograde), and finally it resumes eastward motion. Use the Earth station to observe the pattern."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
