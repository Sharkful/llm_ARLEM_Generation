  "activity": {
    "id": "act_heart_dual_loop_01",
    "name": "Trace the Heart: Chambers, Valves, Vessels & Dual-Loop Circulation",
    "description": "Guided AR lab session for Human Anatomy & Physiology I focused on structural heart anatomy and dual-loop circulation. Learners identify four chambers, four valves, and major entering/leaving vessels, then trace the pulmonary and systemic circuits and explain left-vs-right functional differences including ventricular wall thickness and valve backflow prevention.",
    "language": "en",
    "workplace": "heart_lab_ws_01",
    "start": "step_intro",
    "actions": [
      {
        "id": "step_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_bench_zone",
        "predicate": "pred_audio_intro_welcome",
        "instruction": {
          "title": "Welcome to the Heart Lab",
          "description": "On the bench, you\u2019ll see a 3D heart model. Follow the prompts to identify chambers, valves, and major vessels\u2014then trace the dual-loop path blood takes through the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "tr_step_intro_click",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_heart_viewer",
        "predicate": "pred_show_chambers_highlight",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Locate and name: right atrium (RA), right ventricle (RV), left atrium (LA), and left ventricle (LV). Pay attention to left vs. right positioning on the model."
        },
        "enter": {
