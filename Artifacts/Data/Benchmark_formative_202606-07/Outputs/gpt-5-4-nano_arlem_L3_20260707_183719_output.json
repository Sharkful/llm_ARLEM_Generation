        "id": "step_vessels",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_heart_viewer",
        "predicate": "pred_show_vessels_highlight",
        "instruction": {
          "title": "Major Vessels Entering & Leaving the Heart",
          "description": "Identify endpoints: superior vena cava (SVC) and inferior vena cava (IVC) enter the heart; pulmonary arteries and pulmonary veins are involved in the pulmonary circuit; the aorta leaves the heart for systemic circulation."
