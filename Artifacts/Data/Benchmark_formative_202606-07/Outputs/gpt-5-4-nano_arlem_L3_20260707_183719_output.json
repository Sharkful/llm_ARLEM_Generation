      {
        "id": "step_trace_dual_loop",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_dual_loop_board",
        "predicate": "pred_trace_dual_loop_path",
        "instruction": {
          "title": "Trace the Dual-Loop Blood Flow",
