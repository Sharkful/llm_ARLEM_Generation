            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_4_link_viewpoints",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_night_sky_observing_wall",
        "predicate": "pred_link_line_of_sight_sweep",
        "instruction": {
          "title": "Link outside geometry to the sky view",
          "description": "A line of sight extends from Earth through Mars to the background starfield. As Earth approaches Mars, the line sweeps eastward; when Earth overtakes Mars, it sweeps westward\u2014so Mars appears to retrace its path. Then the line resumes eastward sweeping."
        },
