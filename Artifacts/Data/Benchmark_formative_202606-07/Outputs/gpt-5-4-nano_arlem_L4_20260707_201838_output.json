            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_3_heliocentric_orbits",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_heliocentric_pedestal",
        "predicate": "pred_heliocentric_orbits_earth_mars",
        "instruction": {
          "title": "Heliocentric resolution: Earth overtakes Mars",
          "description": "Now switch to the outside view. Earth orbits closer to the Sun, so it moves faster; Mars orbits farther, so it moves slower. When Earth gains on Mars, the projection onto the sky produces the same retrograde loop\u2014without epicycles."
        },
        "enter": {
