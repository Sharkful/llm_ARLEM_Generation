  "activity": {
    "id": "astro_retrograde_lab_activity_v1",
    "name": "Apparent Retrograde Motion: Mars & Why it Loops",
    "description": "Guided AR lab for non-majors exploring apparent retrograde motion. Students first observe Mars\u2019s eastward drift, westward loop, and return. Then they compare a geocentric epicycle/deferent explanation to the heliocentric explanation (Earth overtaking an outer planet). The lab links both viewpoints via a changing line of sight, includes an embodied overtaking activity, compares Mars vs Jupiter vs Saturn loop sizes, and finishes with a prediction challenge and recap.",
    "language": "en",
    "workplace": "astro_retrograde_lab_ws_v1",
    "start": "action_1_night_sky_observation",
    "actions": [
      {
        "id": "action_1_night_sky_observation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_night_sky_observing_wall",
        "predicate": "pred_obs_scene_constellation_labels",
        "instruction": {
          "title": "Observe the puzzle in the sky",
          "description": "Look at the night-sky view. Follow the red point for Mars as time fast-forwards: it drifts east, slows, halts, reverses into a westward loop, and then resumes eastward motion. These are apparent retrograde changes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
