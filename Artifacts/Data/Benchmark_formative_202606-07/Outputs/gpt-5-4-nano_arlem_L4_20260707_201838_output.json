            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_2_geocentric_epicycle",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_orbit_diorama_table",
        "predicate": "pred_geocentric_epicycle_mechanism",
        "instruction": {
          "title": "Geocentric explanation: epicycles create the loop",
          "description": "In the epicycle/deferent model, Earth is at the center. Mars rides on a small epicycle that moves on a larger deferent. At specific epicycle positions, the combined circular motions make Mars appear to move backward from Earth."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
