        "device": "device_headset_01",
        "location": "place_vector_staging_plane",
        "predicate": "pred_vector_intro_arrow",
        "instruction": {
          "title": "Vectors are arrows: magnitude + direction",
          "description": "Look at the floating arrow. Drag the arrow\u2019s head to change its direction and length. Notice how the magnitude label (length) and direction angles update relative to the x, y, z reference lines."
