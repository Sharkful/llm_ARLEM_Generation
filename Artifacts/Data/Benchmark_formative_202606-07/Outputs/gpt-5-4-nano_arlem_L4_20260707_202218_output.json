  "activity": {
    "id": "act_vectors_projectile_arlem",
    "name": "AR Lab: Vectors \u2192 Components \u2192 Projectile Motion",
    "description": "Guided AR session to build intuition about vectors (magnitude & direction), tip-to-tail vector addition, and vector decomposition into x/y components, then apply these ideas to 2D projectile motion under gravity. Learner interacts with draggable arrows and observes live component behavior during projectile launches, then explores max-range and targeting.",
    "language": "en",
    "workplace": "wp_mech_vectors_projectile_lab",
    "start": "action_01_vector_intro",
