          }
        ]
      },
      {
        "id": "action_2",
        "instruction": {
          "title": "Follow the Loop: Slowdown \u2192 Reverse \u2192 Resume",
          "description": "Watch the retrograde loop trace that connects eastward drift to a westward loop and back to eastward motion."
        },
        "enter": {
          "remove_self": false,
