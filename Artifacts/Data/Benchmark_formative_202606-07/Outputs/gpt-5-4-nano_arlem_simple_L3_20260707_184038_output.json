  "activity": {
    "id": "act-astro-retrograde-reduced1",
    "name": "Reduced AR: Why Mars Appears to Move Backward",
    "description": "Linear, simplified AR sequence for intro astronomy non-majors. Students first observe the eastward drift and westward loop of Mars, then switch to a heliocentric explanation where Earth overtakes the slower outer planet, and finally compare the added geocentric epicycle complexity with the natural heliocentric outcome and the smaller retrograde loops for more distant planets.",
    "workplace": "astro-retrograde-lab-wp1",
    "start": "action_1",
    "actions": [
      {
        "id": "action_1",
        "instruction": {
          "title": "Observe Mars Retrograde on the Night Sky",
          "description": "Start at the Mars sky card and identify the overall pattern: Mars normally drifts eastward, then during retrograde it slows, reverses into a westward loop, and later resumes its eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
