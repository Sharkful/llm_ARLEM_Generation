  "activity": {
    "id": "dna_structure_replication_reduced_01",
    "name": "DNA Double Helix & Semiconservative Replication (Reduced ARLEM)",
    "description": "A linear AR lab that highlights DNA\u2019s 3D structure (double helix, sugar-phosphate backbones, bases, hydrogen bonds) and connects that structure to semiconservative replication (antiparallel directionality, leading vs lagging synthesis, and daughter molecules containing one parental strand each). This reduced version uses only click/detect triggers and simple enter/exit augmentation control.",
    "workplace": "dna_lab_reduced_wp_01",
    "start": "action_step_1",
    "actions": [
      {
        "id": "action_step_1",
        "instruction": {
          "title": "Step 1 \u2014 DNA as a Double Helix",
          "description": "Locate the double helix model. Observe two intertwined strands around a common axis and note that each strand has a sugar-phosphate backbone with bases projecting inward."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_step_1"
          }
        ]
      },
      {
        "id": "action_step_2",
        "instruction": {
