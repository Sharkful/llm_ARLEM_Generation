  "activity": {
    "id": "arlem_heart_dualloop_reduced_linear_01",
    "name": "Reduced AR: Heart Chambers, Valves, Vessels & Dual-Loop Path",
    "description": "Linear reduced AR experience (no persons/devices). Learners identify four heart chambers, four valves, major vessels, then trace dual-loop circulation on a pulmonary vs systemic panel. Each step activates/deactivates augmentations on a single workplace target.",
    "workplace": "heart_anatomy_lab_reduced_01",
    "start": "action_01",
    "actions": [
      {
        "id": "action_01",
        "instruction": {
          "title": "Step 1 \u2014 Locate the Four Heart Chambers",
          "description": "Find and name the right atrium, right ventricle, left atrium, and left ventricle on the 3D heart. Focus on right vs left and upper (atria) vs lower (ventricles)."
        },
        "enter": {
          "remove_self": false,
