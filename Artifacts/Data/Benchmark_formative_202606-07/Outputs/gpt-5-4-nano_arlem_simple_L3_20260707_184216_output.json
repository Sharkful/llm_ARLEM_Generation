  "activity": {
    "id": "act_vectors_projectile_linear_reduced",
    "name": "Vectors to Projectile Motion (Reduced ARLEM)",
    "description": "A simplified, linear AR experience that uses click-to-advance steps to guide students from vector representation (magnitude/direction) to tip-to-tail addition, then to x-y component decomposition using right-triangle trigonometry, and finally to 2D projectile motion where horizontal and vertical motions are independent and maximum height occurs when vertical velocity is zero.",
    "workplace": "wp_physics_vectors_projectile_reduced",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Represent a 2D Vector",
          "description": "In AR, view the Vector Arrow. Notice that a vector has both magnitude (length) and direction (angle)."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
