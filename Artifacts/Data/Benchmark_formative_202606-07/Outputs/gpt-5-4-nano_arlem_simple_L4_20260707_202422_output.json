            "mode": "click",
            "id": "next_click_2"
          }
        ]
      },
      {
        "id": "action_3_switch_to_heliocentric",
        "instruction": {
          "title": "Heliocentric Resolution: Relative Orbits",
          "description": "From outside the solar system, Earth and Mars move on smooth orbits around the Sun at different speeds. Retrograde appears when Earth overtakes Mars on the inside track\u2014no epicycles needed."
        },
        "enter": {
          "remove_self": false,
