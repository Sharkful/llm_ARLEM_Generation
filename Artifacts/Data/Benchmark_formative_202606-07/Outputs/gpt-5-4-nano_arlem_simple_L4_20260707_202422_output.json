  "activity": {
    "id": "astro_retrograde_lab_reduced_v1",
    "name": "Reduced ARLEM: Mars Retrograde Motion (Linear)",
    "description": "A simplified, click-through ARLEM lab for Introduction to Astronomy. Students observe Mars\u2019s apparent retrograde loop from Earth\u2019s perspective, then compare geocentric (epicycle/deferent) and heliocentric (relative orbital motion) explanations. Linear sequence uses only click and detect triggers.",
    "workplace": "astro_retrograde_lab_reduced_ws",
    "start": "action_1_observe_intro",
    "actions": [
      {
        "id": "action_1_observe_intro",
        "instruction": {
          "title": "Observe the Retrograde Puzzle (Earth\u2019s View)",
          "description": "Look up at Mars against the labeled starfield. As time fast-forwards, Mars slows, halts, moves westward in a loop, then resumes its eastward drift\u2014an apparent reversal that early astronomers had to explain."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_click_1"
          }
        ]
      },
      {
        "id": "action_2_geocentric_explanation",
        "instruction": {
          "title": "Geocentric Explanation: Epicycle + Deferent",
          "description": "Mars rides on an epicycle while the deferent carries that epicycle on a larger circle centered on Earth. Their combined motion produces the apparent westward loop during retrograde."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
