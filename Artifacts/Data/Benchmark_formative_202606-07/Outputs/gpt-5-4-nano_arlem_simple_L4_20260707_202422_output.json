      {
        "id": "action_4_link_two_views",
        "instruction": {
          "title": "Link the Views with a Line of Sight",
          "description": "A line is drawn from Earth through Mars and into the starfield. As Earth approaches, the line sweeps eastward; during overtaking it sweeps westward\u2014matching the apparent retrograde loop."
        },
        "enter": {
