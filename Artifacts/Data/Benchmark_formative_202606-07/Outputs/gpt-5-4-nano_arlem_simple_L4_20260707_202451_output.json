  "activity": {
    "id": "arlem_dna_reduced_01",
    "name": "Reduced AR DNA: Structure \u2192 Replication (6-step Click Flow)",
    "description": "Simplified, linear ARLEM-style walkthrough of DNA structure (double helix, antiparallel direction, complementary base pairing) and the core replication fork logic (helicase, SSBs, DNA polymerase leading/lagging behavior, ligase), ending with semiconservative replication. Progression is strictly linear with click/detect triggers; no branching logic.",
    "workplace": "dna_lab_world_01",
    "start": "step1_open",
    "actions": [
      {
        "id": "step1_open",
        "instruction": {
          "title": "DNA as a repeating polymer (ladder schematic)",
          "description": "Scan the schematic ladder target and focus on DNA as a repeating structure: two sugar\u2011phosphate backbones with base pairs projected inward between them. Consider the backbone as the scaffold and the bases as the pairing units."
        },
        "enter": {
          "remove_self": false,
