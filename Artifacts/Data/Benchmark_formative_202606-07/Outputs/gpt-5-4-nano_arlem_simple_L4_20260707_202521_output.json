  "activity": {
    "id": "arlem-heart-structural-reduced-001",
    "name": "Reduced AR: Heart Chambers, Valves, and Dual-Loop Path",
    "description": "Linear reduced AR learning flow for identifying the four heart chambers, four valves, and tracing dual-loop circulation. Triggers are limited to mode 'click' and 'detect'. No branching, messaging, or conditional quiz logic is included.",
    "workplace": "heart-structure-workplace-001",
    "start": "step-1-intro-exterior",
    "actions": [
      {
        "id": "step-1-intro-exterior",
        "instruction": {
          "title": "Exterior orientation: chambers & major vessels",
          "description": "A full-size heart appears. Use this orientation to remember that the heart is described from the patient\u2019s perspective: your viewer-left corresponds to the patient\u2019s right, and vice versa."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
