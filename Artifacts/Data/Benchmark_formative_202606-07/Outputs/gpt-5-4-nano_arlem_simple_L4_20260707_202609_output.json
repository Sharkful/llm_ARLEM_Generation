      },
      {
        "id": "step_5_independent_motion_and_trail",
        "instruction": {
          "title": "Independence: horizontal vs vertical",
          "description": "Watch the trail as the horizontal component stays constant while the vertical component changes under gravity. The combined motion produces the parabolic path."
        },
