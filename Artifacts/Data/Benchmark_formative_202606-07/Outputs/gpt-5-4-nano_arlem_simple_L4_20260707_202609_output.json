  "activity": {
    "id": "act_reduced_vectors_projectile_6step_linear",
    "name": "Reduced AR: Vectors \u2192 Components \u2192 Projectile Independence \u2192 45\u00b0 Max Range",
    "description": "Simplified linear ARLEM sequence for General Physics I: observe vectors (magnitude/direction), add vectors tip-to-tail, decompose into components, then connect vector components to 2D projectile motion and the 45\u00b0 maximum-range result. Reduced surface: no persons/devices, no warnings, and no conditional logic. Navigation uses only click and detect triggers.",
    "workplace": "wp_physics_vectors_projectile_reduced",
    "start": "step_1_vector_intro",
    "actions": [
      {
        "id": "step_1_vector_intro",
        "instruction": {
          "title": "Vectors: magnitude and direction",
          "description": "Use the single arrow to connect size (magnitude) with direction. The tail is the reference position and the head points along the vector\u2019s direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trig1"
          }
        ]
      },
      {
        "id": "step_2_tip_to_tail_add",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Two vectors (blue and green) are laid head-to-tail. The red arrow shows the resultant: it starts where the first starts and ends where the second ends."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "trig2"
          }
        ]
      },
      {
        "id": "step_3_decompose_components",
        "instruction": {
          "title": "Decompose into components",
          "description": "Represent the original vector using component arrows. Components add tip-to-tail to recreate the original vector, showing decomposition as \u2018reverse addition\u2019 along chosen axes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
