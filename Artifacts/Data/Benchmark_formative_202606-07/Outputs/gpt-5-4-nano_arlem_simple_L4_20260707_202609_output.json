      },
      {
        "id": "step_4_projectile_plane_setup",
        "instruction": {
          "title": "Projectiles are 2D (vertical plane)",
          "description": "Switch attention to the projectile plane. Gravity acts vertically, so the projectile\u2019s motion can be analyzed using horizontal and vertical component ideas within this plane."
        },
        "enter": {
          "remove_self": false,
