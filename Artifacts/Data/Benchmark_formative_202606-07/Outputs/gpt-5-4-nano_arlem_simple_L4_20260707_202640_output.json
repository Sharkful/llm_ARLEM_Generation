  "activity": {
    "id": "vsepr_arlem_reduced_001",
    "name": "VSEPR Theory\u2014Reduced ARLEM Lab (Electron Domains to Molecular Shapes)",
    "description": "Reduced linear ARLEM lab: click-to-advance steps activate/deactivate labels, images, audio, and animations anchored to distinct detectable targets. Students connect Lewis structures to electron-domain geometries and molecular shapes using lone pairs.",
    "workplace": "vsepr_lab_workplace_001",
    "start": "step_1_setup",
    "actions": [
      {
        "id": "step_1_setup",
        "instruction": {
          "title": "VSEPR Setup: Electrons repel, shape forms",
          "description": "Observe the labeled central atom and the Lewis-structure reference. VSEPR treats bonding pairs and lone pairs as electron domains, which arrange in 3D to minimize mutual repulsion."
        },
        "enter": {
