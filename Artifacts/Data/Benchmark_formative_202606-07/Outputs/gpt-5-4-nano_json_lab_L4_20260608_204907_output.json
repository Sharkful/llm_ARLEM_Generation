{
  "version": "2.0",
  "labId": "intro-astro-retrograde-01",
  "author": "A Robot",
  "institution": "MTSU",
  "courseName": "Introduction to Astronomy, 100-level undergraduate non-majors course",
  "estimatedLength": "45 minutes",
  "objectives": [
    "Describe Mars's apparent retrograde loop (eastward drift \u2192 slowdown/halting \u2192 westward loop \u2192 resumption) as seen against background stars.",
    "Explain why apparent retrograde motion occurs in the heliocentric model as a consequence of Earth overtaking a slower-moving outer planet.",
    "Contrast geocentric and heliocentric explanations and articulate why heliocentrism is preferred on grounds of parsimony.",
    "Predict when retrograde motion will occur for a given outer planet based on relative orbital geometry (near opposition / inside-track overtaking).",
    "Compare loop magnitudes for Mars, Jupiter, and Saturn and explain why more distant planets produce smaller loops."
  ],
