  "activity": {
    "id": "act_retrograde_motion_astronomy",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A guided AR lab for introductory astronomy students exploring why Mars appears to reverse direction in the night sky, contrasting geocentric and heliocentric explanations, and comparing Mars with Jupiter and Saturn.",
    "language": "en",
    "workplace": "wp_astronomy_retrograde_lab",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_observation_station",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the retrograde puzzle",
          "description": "Look at the observation station. You will first examine Mars from Earth's sky view, where it usually drifts eastward against the stars, then briefly loops westward before returning eastward."
        },
