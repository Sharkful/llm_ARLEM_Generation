  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An introductory molecular biology AR lab in which undergraduate students examine the three-dimensional structure of DNA, apply complementary base-pairing rules, interpret antiparallel strand directionality, and trace the enzyme-driven steps of semiconservative DNA replication at a replication fork.",
    "language": "en",
    "workplace": "wp_bio_dna_replication_lab",
    "start": "step_1_orient",
    "actions": [
      {
        "id": "step_1_orient",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens_1",
        "location": "place_lab_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the DNA lab bench",
          "description": "Look at the main bench and the physical DNA model. This step introduces the lab setup and the learning goals: DNA structure, complementary base pairing, strand directionality, and semiconservative replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_structure",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "thing_dna_model",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_structure",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens_1",
        "location": "place_dna_station",
        "predicate": "pred_basepair_overlay",
        "instruction": {
          "title": "Identify the structural components of the double helix",
          "description": "Inspect the DNA model to locate the two sugar-phosphate backbones, the inward-facing nitrogenous bases, and the hydrogen bonds linking paired bases across the helix."
        },
        "enter": {
