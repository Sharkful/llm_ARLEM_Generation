            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "say_antiparallel",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_antiparallel",
        "viewport": "actions",
        "type": "actions",
        "device": "device_hololens_1",
        "location": "place_dna_station",
        "predicate": "pred_antiparallel_label",
        "instruction": {
          "title": "Trace antiparallel strand orientation",
          "description": "Follow the directional arrows to compare the two strands. One backbone runs 5' to 3', while the complementary strand runs 3' to 5'. Notice that antiparallel orientation results from the chemistry and directionality of the sugar-phosphate backbone."
        },
        "enter": {
