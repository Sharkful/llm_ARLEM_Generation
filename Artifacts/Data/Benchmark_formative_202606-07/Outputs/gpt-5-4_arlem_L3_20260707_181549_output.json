  "activity": {
    "id": "act_heart_blood_flow_training",
    "name": "Heart Structure and Blood Flow AR Training",
    "description": "A guided AR anatomy lab in which undergraduate health science students identify the chambers, valves, and major vessels of the human heart, then trace blood through pulmonary and systemic circulation while relating structure to function.",
    "language": "en",
    "workplace": "wp_heart_anatomy_lab",
    "start": "step_01_orientation",
    "actions": [
      {
        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the heart lab",
          "description": "Look at the heart model on the anatomy bench. This module introduces the external orientation of the heart and the learning goals: identify chambers, valves, and vessels, then trace blood through pulmonary and systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_orientation",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_02_chambers",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_chambers_labels",
        "instruction": {
          "title": "Identify the four chambers",
          "description": "Examine the AR overlay on the heart model and identify the right atrium, right ventricle, left atrium, and left ventricle. Note that the atria receive blood, whereas the ventricles pump blood out of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "heart_model_seen",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "next_chambers",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_03_valves_vessels",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_valves_labels",
        "instruction": {
          "title": "Locate valves and major vessels",
          "description": "Inspect the heart and valve cutaway overlays to identify the tricuspid, pulmonary, mitral, and aortic valves, along with the superior vena cava, inferior vena cava, pulmonary arteries, pulmonary veins, and aorta. Pay attention to which valves separate chambers and which connect chambers to outflow vessels."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "show_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "next_valves",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_04_deoxygenated_path",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_study_zone",
        "predicate": "pred_flow_deoxygenated",
        "instruction": {
          "title": "Trace deoxygenated blood to the lungs",
          "description": "Follow the animated pathway for deoxygenated blood: body to superior and inferior vena cava, into the right atrium, through the tricuspid valve to the right ventricle, then through the pulmonary valve into the pulmonary arteries toward the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "circulation_board_seen",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          },
          {
            "mode": "click",
            "id": "next_deoxygenated",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_05_oxygenated_path",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_study_zone",
        "predicate": "pred_flow_oxygenated",
        "instruction": {
          "title": "Trace oxygenated blood to the body",
          "description": "Now follow oxygenated blood returning from the lungs in the pulmonary veins to the left atrium, passing through the mitral valve into the left ventricle, and exiting through the aortic valve into the aorta for systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_oxygenated",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "say_systemic",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_06_structure_function",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_wall_thickness_anim",
        "instruction": {
          "title": "Compare ventricular wall thickness and valve function",
          "description": "Observe the side-by-side comparison of the right and left ventricles. The left ventricle has a substantially thicker myocardium because it must generate higher pressure to propel blood through the entire systemic circuit. Review also how atrioventricular and semilunar valves prevent backflow during the cardiac cycle."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_structure_function",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_07_summary",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_bench",
        "predicate": "pred_summary_label",
        "instruction": {
          "title": "Summarize the complete flow through the heart",
          "description": "Review the complete sequence aloud: venae cavae, right atrium, tricuspid valve, right ventricle, pulmonary valve, pulmonary arteries, lungs, pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, aorta, and body. Confirm which side of the heart serves the pulmonary circuit and which serves the systemic circuit."
        },
        "enter": {
