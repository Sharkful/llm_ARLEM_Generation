          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_addition",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "vector_board_seen",
            "duration": 2,
            "type": "tangible",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_3_components",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_vector_station",
        "predicate": "pred_components_anim",
        "instruction": {
          "title": "Resolve a vector into x and y components",
          "description": "At the component frame, study how a single vector can be decomposed into horizontal and vertical components. Use the right-triangle graphic to connect the angle to cosine and sine relationships."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "voice",
            "id": "next_components",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_4_projectile_setup",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_projectile_zone",
        "predicate": "pred_projectile_overview_video",
        "instruction": {
          "title": "Connect vectors to a launched projectile",
          "description": "Move to the projectile test zone. Watch the launch overview and note that the initial velocity vector can be decomposed into a constant horizontal part and a changing vertical part."
        },
        "enter": {
