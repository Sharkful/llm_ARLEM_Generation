  "activity": {
    "id": "act_vectors_projectile_mechanics",
    "name": "Vectors and 2D Projectile Motion",
    "description": "A university-level AR training session in which learners first explore vectors as magnitude-direction objects and as x-y components, then apply those ideas to two-dimensional projectile motion. The experience emphasizes graphical addition, trigonometric decomposition, independence of horizontal and vertical motion, and the effects of launch angle and speed on trajectory, range, and maximum height.",
    "language": "en",
    "workplace": "wp_physics_vectors_projectile",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_vector_station",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the vector workstation",
          "description": "Look at the vector board to begin. In this lab, you will represent vectors by magnitude and direction, then connect vector components to projectile motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_vector_station",
        "predicate": "pred_vector_add_anim",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Observe two displacement vectors placed head-to-tail on the board. Identify the single resultant vector that runs from the start of the first vector to the tip of the second."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
