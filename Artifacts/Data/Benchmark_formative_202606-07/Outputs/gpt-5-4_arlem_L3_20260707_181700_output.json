  "activity": {
    "id": "chem_vsepr_activity_01",
    "name": "VSEPR Theory and Molecular Geometry AR Lab",
    "description": "Students use AR overlays on a chemistry lab table to move from Lewis structures to steric number, electron-domain geometry, molecular geometry, lone-pair effects, and real-molecule examples. The session emphasizes the five fundamental electron-domain arrangements and the way lone pairs alter bond angles and observed shapes.",
    "language": "en",
    "workplace": "chem_vsepr_lab_wp_01",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lab_table",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Welcome to the VSEPR lab",
          "description": "Look at the main lab table. This activity will guide you from a Lewis structure to a 3D molecular geometry by applying the VSEPR principle that electron domains arrange to minimize repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
