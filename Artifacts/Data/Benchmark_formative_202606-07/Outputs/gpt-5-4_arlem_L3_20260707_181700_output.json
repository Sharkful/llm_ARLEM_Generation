          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "next_intro_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "action_02_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_lewis_station",
        "predicate": "pred_count_domains_label",
        "instruction": {
          "title": "Determine the steric number",
          "description": "Focus on the Lewis structure reference board. Count all electron domains around the central atom: each bond counts as one domain, and each lone pair counts as one domain. Use this count to determine the steric number."
        },
        "enter": {
