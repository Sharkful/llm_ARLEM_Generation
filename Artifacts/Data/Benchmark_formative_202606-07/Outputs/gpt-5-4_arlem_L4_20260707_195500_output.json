        "predicate": "pred_orbit_data_label",
        "instruction": {
          "title": "Shift to the heliocentric view",
          "description": "Move above the ecliptic plane and watch Earth on its 1 AU orbit overtake slower Mars on its 1.52 AU orbit. Learning objective: explain retrograde motion as a natural consequence of relative orbital motion in the heliocentric model."
        },
        "enter": {
