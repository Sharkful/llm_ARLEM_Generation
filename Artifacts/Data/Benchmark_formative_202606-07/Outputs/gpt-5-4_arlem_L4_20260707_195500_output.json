  "activity": {
    "id": "act_astronomy_retrograde_001",
    "name": "Apparent Retrograde Motion of Outer Planets",
    "description": "An AR lab for introductory astronomy students exploring why Mars appears to reverse direction in the night sky, contrasting geocentric epicycles with the heliocentric explanation, and extending the idea to Jupiter and Saturn.",
    "language": "en",
    "workplace": "wp_astronomy_retrograde_001",
    "start": "action_01_observe_mars",
    "actions": [
      {
        "id": "action_01_observe_mars",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_observation_zone",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Observe Mars in the night sky",
          "description": "Watch Mars drift eastward, reverse into a westward loop, and then resume eastward motion against the labeled constellations. Learning objective: describe the full apparent path of Mars during a retrograde episode."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
