        "type": "actions",
        "device": "device_headset_01",
        "location": "place_modeling_zone",
        "predicate": "pred_epicycle_label",
        "instruction": {
          "title": "Test the geocentric explanation",
          "description": "Inspect a geocentric model in which Mars rides on an epicycle moving along a deferent around Earth. Learning objective: contrast the observed loop with the geocentric explanation and note its dependence on tuned circular motions."
        },
        "enter": {
          "remove_self": false,
