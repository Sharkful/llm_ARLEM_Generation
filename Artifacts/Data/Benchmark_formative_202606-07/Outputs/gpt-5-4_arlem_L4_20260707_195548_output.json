  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "An AR-guided introductory molecular biology lab in which learners examine DNA structure, test complementary base pairing, and trace the enzyme-mediated steps of semiconservative DNA replication from fork formation to daughter molecule outcomes.",
    "language": "en",
    "workplace": "wp_dna_replication_lab",
    "start": "action_01_intro_ladder",
    "actions": [
      {
        "id": "action_01_intro_ladder",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_bench",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Inspect the DNA ladder schematic",
          "description": "A simplified ladder model appears on the bench. Identify the two sugar-phosphate backbones on the outside and the paired nitrogenous bases projecting inward. Use this flat representation to recognize the repeating pattern before viewing the full helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_ladder",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "detect",
            "id": "dna_seen",
            "duration": 2,
