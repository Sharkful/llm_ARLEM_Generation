      {
        "id": "action_04_rbc_trace",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_rbc_trace_animation",
        "instruction": {
          "title": "Trace one red blood cell through the full circuit",
          "description": "Advance the red blood cell step by step from the superior vena cava through the heart, lungs, and systemic outflow. At each step, name the chamber, valve, or vessel the cell has entered and observe the color change in the lung capillaries as oxygen is picked up."
