  "activity": {
    "id": "activity_heart_anatomy_training",
    "name": "Structural Anatomy of the Heart and Blood Flow",
    "description": "An AR-guided undergraduate anatomy lab in which learners identify the chambers, valves, and major vessels of the human heart, trace dual circulation, compare ventricular wall thickness, and explain valve function in preventing backflow.",
    "language": "en",
    "workplace": "workplace_heart_anatomy_lab",
    "start": "action_01_intro",
    "actions": [
      {
        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_intro_exterior_label",
        "instruction": {
          "title": "Orient to the heart in anatomical position",
          "description": "Observe the two full-size heart models. The left model shows the intact exterior and major vessels; the right model shows a cutaway interior. Note that right and left are named from the patient's perspective, so they appear reversed to the viewer."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_intro",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          },
          {
            "mode": "voice",
            "id": "continue_intro_voice",
            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
