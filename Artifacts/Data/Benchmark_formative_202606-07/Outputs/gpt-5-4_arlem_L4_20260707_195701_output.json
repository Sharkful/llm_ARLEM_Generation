      {
        "id": "action_03_dual_circuit",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_1",
        "location": "place_main_table",
        "predicate": "pred_dual_circuit_animation",
        "instruction": {
          "title": "Compare pulmonary and systemic circulation",
          "description": "View the color-coded dual circulation. Blue indicates deoxygenated blood moving through the right heart and toward the lungs; red indicates oxygenated blood moving through the left heart and toward the body. Notice how pulmonary arteries and veins differ from the usual systemic pattern."
        },
        "enter": {
