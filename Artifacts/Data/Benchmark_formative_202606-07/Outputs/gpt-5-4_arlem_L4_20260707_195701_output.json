        "location": "place_main_table",
        "predicate": "pred_chamber_labels",
        "instruction": {
          "title": "Identify chambers, valves, and vessels",
          "description": "Follow the guided structural tour. The cutaway heart highlights the four chambers, then the four valves, then the major vessels, while the intact heart highlights corresponding exterior landmarks."
        },
        "enter": {
