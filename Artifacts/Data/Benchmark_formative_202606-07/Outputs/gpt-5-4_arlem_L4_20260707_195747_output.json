  "activity": {
    "id": "act_vectors_projectiles_mechanics",
    "name": "Vectors and Projectile Motion AR Training",
    "description": "An augmented reality mechanics lab introducing vectors as quantities with magnitude and direction, then applying vector operations to two-dimensional projectile motion. Students progress from interactive vector representation to addition, decomposition, projectile analysis, range optimization, targeting, sandbox exploration, and conceptual recap.",
    "language": "en",
    "workplace": "wp_physics_vectors_projectiles",
    "start": "step_1_vector_intro",
    "actions": [
      {
        "id": "step_1_vector_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_headset_01",
        "location": "place_vector_station",
        "predicate": "pred_intro_vector_anim",
        "instruction": {
          "title": "Explore a single vector",
          "description": "Observe the floating vector arrow at the vector station. Notice its magnitude label and direction indicators relative to the colored reference axes. Move around the arrow and, if enabled, drag its head to see how magnitude and direction change together. Learning objective: represent a two-dimensional vector by magnitude and direction, and connect that representation to components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "triggers": [
          {
            "mode": "click",
