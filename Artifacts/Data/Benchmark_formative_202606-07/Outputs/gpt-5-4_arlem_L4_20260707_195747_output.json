      {
        "id": "step_3_vector_decomposition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_headset_01",
        "location": "place_vector_station",
        "predicate": "pred_decomposition_anim",
        "instruction": {
          "title": "Decompose a vector into components",
          "description": "A single vector is now broken into orthogonal components along the visible axes. Watch how the component arrows add tip-to-tail to reconstruct the original vector. Resize the components and see the original vector update as their sum. Learning objective: decompose a vector into x- and y-components using right-triangle trigonometry and reconstruct the original vector from its components."
        },
