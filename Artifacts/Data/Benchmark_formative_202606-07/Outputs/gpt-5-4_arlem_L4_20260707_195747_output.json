            "type": "action",
            "viewport": "actions",
            "operator": "equal"
          }
        ]
      },
      {
        "id": "step_2_vector_addition",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_headset_01",
        "location": "place_vector_station",
        "predicate": "pred_tip_to_tail_anim",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Two colored vectors appear. The blue vector starts at the origin, the green vector starts at the blue tip, and the red resultant connects the initial tail to the final head. Reorient the vectors and confirm that the resultant updates continuously. Learning objective: add two vectors graphically using the tip-to-tail method and identify the resultant vector."
        },
        "enter": {
