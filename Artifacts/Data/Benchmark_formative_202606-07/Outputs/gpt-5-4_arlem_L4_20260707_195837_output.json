  "activity": {
    "id": "act_vsepr_training",
    "name": "VSEPR Theory Guided AR Lab",
    "description": "An augmented reality lab for General Chemistry I students that builds from Lewis structures to VSEPR-based prediction of electron-domain and molecular geometries, including lone-pair effects and real-molecule examples.",
    "language": "en",
    "workplace": "wp_vsepr_chem_lab",
