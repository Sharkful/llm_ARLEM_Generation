        "id": "action_01_intro",
        "viewport": "actions",
        "type": "actions",
        "device": "device_headset_01",
        "location": "place_intro_table",
        "predicate": "pred_label_vsepr_intro",
        "instruction": {
          "title": "Welcome to VSEPR Theory",
          "description": "Look at the central atom model and the water Lewis structure reference. Learn that each bond or lone pair counts as one electron domain, and that electron domains arrange themselves to minimize repulsion."
        },
