  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR activity for introductory molecular biology students that introduces DNA double-helix structure, complementary base pairing, antiparallel strand orientation, and the major steps of semiconservative DNA replication at the replication fork.",
    "workplace": "wp_dna_replication_lab",
    "start": "step_1_detect_structure_zone",
    "actions": [
      {
        "id": "step_1_detect_structure_zone",
        "instruction": {
          "title": "Begin at the structure study zone",
          "description": "Move to the structure study zone and detect the station marker to start exploring DNA structure. Learning objective: identify the major structural components of DNA and recognize the double-helix form."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_left_station"
          }
        ]
      },
      {
        "id": "step_2_double_helix",
        "instruction": {
          "title": "Examine the double helix",
          "description": "Look at the DNA double helix model. Observe the two sugar-phosphate backbones twisting around a common axis, with nitrogenous bases projecting inward. Learning objective: describe how the backbone and bases assemble into the double helix."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_base_pairing"
          }
        ]
      },
      {
        "id": "step_3_base_pairing",
        "instruction": {
          "title": "Apply base-pairing rules",
          "description": "Inspect the base-pair sequence cards. Match adenine with thymine and guanine with cytosine, noting that A-T forms two hydrogen bonds and G-C forms three. Learning objective: apply complementary base-pairing rules and explain why these pairings occur."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_antiparallel"
          }
        ]
      },
      {
        "id": "step_4_antiparallel",
        "instruction": {
          "title": "Trace antiparallel strand direction",
          "description": "Return to the DNA model and follow the directional labels. One strand runs 5' to 3', while the complementary strand runs 3' to 5'. Learning objective: explain antiparallel orientation from sugar-phosphate backbone directionality."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "place_right_station"
          }
        ]
      },
      {
        "id": "step_5_replication_fork",
        "instruction": {
          "title": "Observe helicase at the replication fork",
          "description": "At the replication study zone, inspect the replication fork model. Watch helicase unwind the helix and see single-strand binding proteins stabilize the separated templates. Learning objective: identify the roles of helicase and single-strand binding proteins during fork formation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_synthesis"
          }
        ]
      },
      {
        "id": "step_6_leading_lagging",
        "instruction": {
          "title": "Compare leading and lagging strand synthesis",
          "description": "Follow DNA polymerase as it extends new DNA only in the 5' to 3' direction. Notice continuous synthesis on the leading strand and discontinuous Okazaki fragment formation on the lagging strand, later joined by DNA ligase. Learning objective: explain why antiparallel templates create asymmetric synthesis."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_semiconservative"
          }
        ]
      },
      {
        "id": "step_7_semiconservative",
        "instruction": {
          "title": "Conclude with semiconservative replication",
          "description": "View the completed daughter DNA molecules. Each daughter helix contains one parental strand and one newly synthesized strand. Use this model to predict outcomes after one and two rounds of replication. Learning objective: articulate why replication is semiconservative and predict daughter-molecule composition."
        },
        "enter": {
