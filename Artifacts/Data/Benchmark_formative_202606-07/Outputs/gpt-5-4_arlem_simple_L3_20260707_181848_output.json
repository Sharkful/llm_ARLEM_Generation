  "activity": {
    "id": "act_heart_anatomy_flow",
    "name": "Heart Structure and Blood Flow",
    "description": "A linear AR laboratory activity for undergraduate anatomy students to identify the chambers, valves, and vessels of the heart, then trace pulmonary and systemic circulation and relate ventricular wall thickness and valve function to cardiac performance.",
    "workplace": "wp_heart_anatomy_lab",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Orient to the Heart",
          "description": "Locate the heart model and begin with an overview of the heart as a dual pump. You will identify major structures and then trace the path of blood through pulmonary and systemic circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_heart_model"
          }
        ]
      },
      {
        "id": "action_2_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Examine the heart model and identify the right atrium, right ventricle, left atrium, and left ventricle. Note that the atria receive blood and the ventricles pump blood away from the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_valves"
          }
        ]
      },
      {
        "id": "action_3_valves",
        "instruction": {
          "title": "Locate the Four Valves",
          "description": "Find the tricuspid, pulmonary, mitral (bicuspid), and aortic valves. Distinguish atrioventricular valves from semilunar valves and note which structures they separate."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_blood_flow_card"
          }
        ]
      },
      {
        "id": "action_4_vessels_and_flow",
        "instruction": {
          "title": "Trace the Major Vessels and Blood Path",
          "description": "Use the flow sequence card to follow blood from the superior and inferior vena cava into the right atrium, through the tricuspid valve into the right ventricle, through the pulmonary valve and pulmonary arteries to the lungs, back by pulmonary veins to the left atrium, through the mitral valve into the left ventricle, and through the aortic valve and aorta to the body."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_5_circuits_and_wall_thickness"
          }
        ]
      },
      {
        "id": "action_5_circuits_and_wall_thickness",
        "instruction": {
          "title": "Compare Pulmonary and Systemic Circuits",
          "description": "Compare the right side of the heart, which pumps blood to the lungs, with the left side, which pumps blood to the entire body. Observe that the left ventricle has a thicker myocardium because systemic circulation requires greater pressure than pulmonary circulation."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_6_valve_function_summary"
          }
        ]
      },
      {
        "id": "action_6_valve_function_summary",
        "instruction": {
          "title": "Explain Valve Function and Review",
          "description": "Review how the tricuspid and mitral valves prevent backflow from ventricles into atria, and how the pulmonary and aortic semilunar valves prevent backflow from arteries into ventricles. Finish with a summary of the complete blood pathway through the heart."
        },
        "enter": {
