      {
        "id": "action_4_projectile_components",
        "instruction": {
          "title": "Step 4: Apply Components to Launch Velocity",
          "description": "The projectile's initial velocity can be decomposed into a constant horizontal component and a vertical component that changes under gravity."
        },
        "enter": {
