      {
        "id": "action_3_components",
        "instruction": {
          "title": "Step 3: Decompose a Vector into x and y Components",
          "description": "See a single vector split into horizontal and vertical components. Relate the components to the original vector using right-triangle trigonometry."
        },
        "enter": {
