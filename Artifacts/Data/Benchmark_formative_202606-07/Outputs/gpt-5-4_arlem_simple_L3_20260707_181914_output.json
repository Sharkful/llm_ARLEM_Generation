      {
        "id": "action_5_trajectory",
        "instruction": {
          "title": "Step 5: Track the Projectile Through Flight",
          "description": "Observe the parabolic trajectory formed by independent horizontal and vertical motion. At maximum height, the vertical velocity is zero while horizontal velocity remains unchanged."
        },
