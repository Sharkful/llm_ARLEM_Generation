  "activity": {
    "id": "act_vectors_projectile_linear",
    "name": "Vectors and 2D Projectile Motion",
    "description": "A linear AR learning sequence for introductory mechanics. Students review vector representation, vector addition, and vector components, then apply these ideas to projectile motion by decomposing launch velocity, examining independent horizontal and vertical motion, and comparing how angle and speed affect trajectory, range, and maximum height.",
    "workplace": "wp_physics_vectors_projectile",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Step 1: Identify a Vector",
          "description": "Observe a vector as a quantity with both magnitude and direction. This step introduces the idea that the same vector can later be expressed with components."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
