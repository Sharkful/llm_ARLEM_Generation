          }
        ]
      },
      {
        "id": "action_2_addition",
        "instruction": {
          "title": "Step 2: Add Vectors Tip-to-Tail",
          "description": "Watch two vectors placed tip-to-tail. The resultant extends from the starting point of the first vector to the ending point of the second vector."
        },
        "enter": {
