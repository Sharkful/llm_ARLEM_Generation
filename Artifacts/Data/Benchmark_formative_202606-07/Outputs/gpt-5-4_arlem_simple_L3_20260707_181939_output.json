  "activity": {
    "id": "act_vsepr_linear_lab",
    "name": "VSEPR Theory: From Lewis Structure to Molecular Shape",
    "description": "A linear AR lab for General Chemistry I in which students use Lewis structures, electron-domain counting, interactive geometry models, and example molecules to predict molecular shape with VSEPR theory.",
    "workplace": "wp_vsepr_lab",
    "start": "step_1_intro",
    "actions": [
      {
        "id": "step_1_intro",
        "instruction": {
          "title": "Count Electron Domains",
          "description": "Start at the Lewis Structure Reference Board. Count bonding pairs and lone pairs around the central atom to determine steric number. This step supports determining steric number from a Lewis structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
