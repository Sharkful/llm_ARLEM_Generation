          }
        ]
      },
      {
        "id": "step_4_bond_angles",
        "instruction": {
          "title": "See Why Lone Pairs Compress Bond Angles",
          "description": "Return attention to the Geometry Display Zone. Watch how lone pairs occupy more angular space than bonding pairs. Compare the ideal tetrahedral angle of 109.5 degrees with the smaller 104.5 degree H-O-H angle in water. This step supports explaining bond-angle deviations caused by lone pairs."
        },
        "enter": {
