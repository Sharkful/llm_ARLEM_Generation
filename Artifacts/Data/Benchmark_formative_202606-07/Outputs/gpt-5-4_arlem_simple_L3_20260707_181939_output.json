        ]
      },
      {
        "id": "step_3_molecular_shapes",
        "instruction": {
          "title": "Compare Electron Geometry and Molecular Shape",
          "description": "Detect the Electron Domain Model Kit. Observe that electron-domain geometry counts all domains, while molecular geometry describes only atom positions. Lone pairs change the visible molecular shape, producing bent, trigonal pyramidal, seesaw, T-shaped, square pyramidal, and square planar structures. This step supports distinguishing electron-domain geometry from molecular geometry."
        },
        "enter": {
          "remove_self": false,
