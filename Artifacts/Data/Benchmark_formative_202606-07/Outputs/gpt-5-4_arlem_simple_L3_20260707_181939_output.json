          }
        ]
      },
      {
        "id": "step_2_domain_geometries",
        "instruction": {
          "title": "Map Steric Number to Electron-Domain Geometry",
          "description": "Move to the Geometry Display Zone. Match steric numbers 2 through 6 to the five electron-domain geometries: linear, trigonal planar, tetrahedral, trigonal bipyramidal, and octahedral. This step supports predicting electron-domain geometry from steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
