          {
            "mode": "click",
            "id": "next_3"
          }
        ]
      },
      {
        "id": "action_4_linked_views",
        "instruction": {
          "title": "Link Orbit Geometry to the Sky View",
          "description": "Compare the outside orbital view with the night sky and follow the Earth-to-Mars line of sight as it reverses during overtaking. Learning objective: connect the observed loop to changing viewing geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
