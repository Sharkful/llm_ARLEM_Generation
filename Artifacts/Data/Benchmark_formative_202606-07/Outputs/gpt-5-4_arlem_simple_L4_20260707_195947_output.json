  "activity": {
    "id": "act_astronomy_retrograde_linear",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A linear AR activity for introductory astronomy students that explores Mars's apparent retrograde motion from night-sky, geocentric, heliocentric, linked-view, embodied, comparison, prediction, and recap perspectives.",
    "workplace": "wp_astronomy_retrograde",
    "start": "action_1_observe",
    "actions": [
      {
        "id": "action_1_observe",
        "instruction": {
          "title": "Observe Mars in the Night Sky",
          "description": "Watch Mars drift eastward, reverse into a westward loop, and then resume eastward motion against the background constellations. Learning objective: describe the observed retrograde path of Mars."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_1"
          }
        ]
      },
      {
        "id": "action_2_geocentric",
        "instruction": {
          "title": "See the Geocentric Explanation",
          "description": "View Earth at the center while Mars moves on an epicycle carried by a deferent. Learning objective: contrast the geocentric explanation and recognize its added complexity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
