            "mode": "click",
            "id": "next_4"
          }
        ]
      },
      {
        "id": "action_5_embodied",
        "instruction": {
          "title": "Generate Retrograde by Walking Earth's Orbit",
          "description": "Move to the orbit-walk zone and use your own motion around the inner orbit to make Mars appear to shift backward against the stars. Learning objective: predict and experience when retrograde occurs during an overtaking event."
        },
        "enter": {
          "remove_self": false,
