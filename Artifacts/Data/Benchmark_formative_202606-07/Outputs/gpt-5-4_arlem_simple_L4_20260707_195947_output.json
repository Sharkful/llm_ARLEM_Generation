            "id": "next_2"
          }
        ]
      },
      {
        "id": "action_3_heliocentric",
        "instruction": {
          "title": "Switch to the Heliocentric View",
          "description": "Look above the solar system and watch faster-moving Earth overtake slower-moving Mars on the inside track. Learning objective: explain retrograde motion as a consequence of relative orbital motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
