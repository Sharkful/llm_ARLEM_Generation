          }
        ]
      },
      {
        "id": "action_6_ssb",
        "instruction": {
          "title": "Step 6: Single-strand binding proteins stabilize the fork",
          "description": "Observe single-strand binding proteins attaching to the exposed DNA strands behind helicase to keep them open and available as templates."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
