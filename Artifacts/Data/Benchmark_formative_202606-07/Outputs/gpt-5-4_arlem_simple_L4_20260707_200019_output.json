  "activity": {
    "id": "act_dna_structure_replication",
    "name": "DNA Structure and Semiconservative Replication",
    "description": "A linear AR learning sequence for introductory molecular biology students that introduces DNA structure, complementary base pairing, antiparallel strand orientation, replication fork enzymes, leading and lagging strand synthesis, and semiconservative replication.",
    "workplace": "wp_dna_replication_lab",
    "start": "action_1_detect_ladder",
    "actions": [
      {
        "id": "action_1_detect_ladder",
        "instruction": {
          "title": "Step 1: Detect the DNA ladder card",
          "description": "Locate the DNA ladder model card to begin exploring the basic structure of DNA as a ladder with sugar-phosphate backbones and paired bases."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "thing_dna_ladder"
          },
          {
            "mode": "click",
            "id": "action_2_helix"
          }
        ]
      },
      {
        "id": "action_2_helix",
        "instruction": {
          "title": "Step 2: From ladder to double helix",
          "description": "Observe how the flat ladder representation maps onto a three-dimensional double helix with two backbones spiraling around a common axis and base pairs stacked inside."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_3_antiparallel"
          }
        ]
      },
      {
        "id": "action_3_antiparallel",
        "instruction": {
          "title": "Step 3: Antiparallel 5' and 3' orientation",
          "description": "Examine the arrows and labels on the two DNA strands to see that one backbone runs 5' to 3' while the complementary strand runs 3' to 5'. This opposite orientation is the antiparallel arrangement."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_4_basepair"
          }
        ]
      },
      {
        "id": "action_4_basepair",
        "instruction": {
          "title": "Step 4: Complementary base pairing",
          "description": "Inspect the partial DNA ladder and identify which bases pair across the strands. Adenine pairs with thymine through two hydrogen bonds, and guanine pairs with cytosine through three hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_5_helicase"
          }
        ]
      },
      {
        "id": "action_5_helicase",
        "instruction": {
          "title": "Step 5: Helicase opens the double helix",
          "description": "Watch helicase move along the DNA and unwind the double helix by separating the paired strands at the replication fork."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
