          }
        ]
      },
      {
        "id": "action_7_leading",
        "instruction": {
          "title": "Step 7: Continuous synthesis on the leading strand",
          "description": "Follow DNA polymerase as it adds nucleotides to the new strand in the 5' to 3' direction while moving continuously with the replication fork on the leading-strand template."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
