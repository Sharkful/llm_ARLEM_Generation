  "activity": {
    "id": "act_heart_anatomy_linear",
    "name": "Heart Structure and Blood Flow",
    "description": "A linear AR learning activity for undergraduate anatomy students that introduces the external and internal anatomy of the human heart, traces blood flow through pulmonary and systemic circulation, compares ventricular wall thickness, and explains valve function in preventing backflow.",
    "workplace": "wp_heart_anatomy_lab",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Orient to the Heart",
          "description": "Observe the intact and cutaway heart models. Identify the apex, major external vessels, and the patient-based right-left orientation. Learning objective: identify overall heart orientation and map external to internal views."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_structure_tour"
          }
        ]
      },
      {
        "id": "action_2_structure_tour",
        "instruction": {
          "title": "Tour Chambers, Valves, and Vessels",
          "description": "Follow the guided structural tour of the four chambers, four valves, and major vessels. Learning objective: identify and correctly name the chambers, valves, and major vessels of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_dual_circuit"
          }
        ]
      },
      {
        "id": "action_3_dual_circuit",
        "instruction": {
          "title": "View the Dual Circulation",
          "description": "Watch color-coded blood flow through the pulmonary and systemic circuits. Blue indicates deoxygenated blood and red indicates oxygenated blood. Learning objective: distinguish pulmonary from systemic circulation and identify the role of the right and left sides of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_rbc_trace"
          }
        ]
      },
      {
        "id": "action_4_rbc_trace",
        "instruction": {
          "title": "Trace a Red Blood Cell Through the Heart",
          "description": "Advance through the full path of a red blood cell from the vena cava to the lungs, back to the left heart, and out to the body. Learning objective: trace blood through chambers, valves, and vessels in the correct order."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_wall_thickness"
          }
        ]
      },
      {
        "id": "action_5_wall_thickness",
        "instruction": {
          "title": "Compare Ventricular Wall Thickness",
          "description": "Compare right and left ventricular wall thickness in cross section. Learning objective: explain why the left ventricle has thicker myocardium and relate wall thickness to systemic versus pulmonary pressure demands."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_valve_function"
          }
        ]
      },
      {
        "id": "action_6_valve_function",
        "instruction": {
          "title": "See How Valves Prevent Backflow",
          "description": "Examine atrioventricular and semilunar valves as they open and close. Learning objective: describe how each valve prevents backflow and identify which chambers or vessels each valve separates."
        },
        "enter": {
