  "activity": {
    "id": "act_vectors_projectile_linear",
    "name": "Vectors and Two-Dimensional Projectile Motion",
    "description": "A linear introductory AR activity for General Physics I in which students review vector magnitude and direction, tip-to-tail addition, component decomposition, and the application of x-y components to projectile motion and maximum range.",
    "workplace": "wp_physics_vectors_projectile",
    "start": "step_detect_workspace",
    "actions": [
      {
        "id": "step_detect_workspace",
        "instruction": {
          "title": "Locate the AR workspace",
          "description": "Scan the learning setup until the vector board and physics workspace are detected. This establishes the reference frame for the activity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_vector_board"
          }
        ]
      },
      {
        "id": "step_single_vector",
        "instruction": {
          "title": "Observe a vector as magnitude and direction",
          "description": "A single vector is displayed from the origin with reference axes. Use the labels to identify its magnitude and direction, and relate the arrow to a quantity that has both size and direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_addition"
          }
        ]
      },
      {
        "id": "step_vector_addition",
        "instruction": {
          "title": "Add vectors tip-to-tail",
          "description": "Two vectors are arranged tip-to-tail, and a resultant vector connects the start of the first to the end of the second. Identify how the resultant represents vector addition."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_decomposition"
          }
        ]
      },
      {
        "id": "step_vector_decomposition",
        "instruction": {
          "title": "Decompose a vector into x and y components",
          "description": "The original vector is resolved into horizontal and vertical components. Connect the components to right-triangle trigonometry and see that the components reconstruct the original vector."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_projectile_setup"
          }
        ]
      },
      {
        "id": "step_projectile_setup",
        "instruction": {
          "title": "Transition to projectile motion",
          "description": "The vector ideas are now applied in a two-dimensional vertical plane. Observe the launch point, the initial velocity vector, and the labeled horizontal and vertical axes."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "det_launcher"
          }
        ]
      },
      {
        "id": "step_projectile_flight",
        "instruction": {
          "title": "Compare horizontal and vertical motion during flight",
          "description": "Watch the projectile move along a parabolic path while its velocity is shown as horizontal and vertical components. Notice that the horizontal component stays constant while the vertical component changes because of gravity."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_range"
          }
        ]
      },
      {
        "id": "step_maximum_range",
        "instruction": {
          "title": "Relate launch angle to range",
          "description": "Compare example projectile paths at the same launch speed. Use the displayed comparison to identify that 45 degrees gives the maximum range on level ground, while complementary angles produce the same range."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_target"
          }
        ]
      },
      {
        "id": "step_target_challenge",
        "instruction": {
          "title": "Apply projectile ideas to hit a target",
          "description": "A ground target appears at a fixed distance. Use what you learned about launch speed, angle, and components to predict a trajectory that reaches the target."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_to_summary"
          }
        ]
      },
      {
        "id": "step_summary",
        "instruction": {
          "title": "Review the key ideas",
          "description": "Summarize the lesson: vectors have magnitude and direction, vectors add tip-to-tail, components reconstruct a vector, projectile motion separates into independent horizontal and vertical parts, and 45 degrees maximizes range for a fixed speed on level ground."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish"
          }
        ]
      }
    ]
  }
