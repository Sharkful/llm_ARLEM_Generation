  "activity": {
    "id": "act_vsepr_linear",
    "name": "VSEPR Theory and Molecular Geometry",
    "description": "A simplified linear AR lab for General Chemistry I that introduces VSEPR theory, the five electron-domain geometries, the distinction between electron-domain and molecular geometry, lone pair effects on bond angles, and real-molecule examples.",
    "workplace": "wp_vsepr_chem1",
    "start": "action_1_intro",
    "actions": [
      {
        "id": "action_1_intro",
        "instruction": {
          "title": "Welcome to VSEPR",
          "description": "Observe the central atom and the flat Lewis structure of water. Count each bond or lone pair around the central atom as one electron domain, and note that VSEPR uses this count to predict the 3D shape."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_2_domain_progression"
          }
        ]
      },
      {
        "id": "action_2_domain_progression",
        "instruction": {
          "title": "Minimum-Repulsion Principle",
          "description": "Watch electron domains spread apart around the central atom. Two domains settle linearly, three become trigonal planar, and four become tetrahedral as repulsions are minimized."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
