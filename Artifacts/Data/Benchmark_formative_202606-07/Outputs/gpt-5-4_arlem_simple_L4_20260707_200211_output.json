          }
        ]
      },
      {
        "id": "action_3_geometry_catalog",
        "instruction": {
          "title": "Five Electron-Domain Geometries",
          "description": "Extend the pattern to five and six electron domains. Identify the characteristic electron-domain geometries: trigonal bipyramidal and octahedral, and compare their ideal bond angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "triggers": [
          {
            "mode": "click",
            "id": "action_4_shape_distinction"
          }
        ]
      },
      {
        "id": "action_4_shape_distinction",
        "instruction": {
          "title": "Electron-Domain Geometry vs Molecular Geometry",
          "description": "Compare methane, ammonia, and water. The electron-domain geometry remains tetrahedral for all three, but the molecular geometry changes when one or two domains are lone pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
