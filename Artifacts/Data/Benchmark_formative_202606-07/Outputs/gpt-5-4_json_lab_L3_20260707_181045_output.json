            {
              "target": "polymeraseLagging",
              "enabled": true
            },
            {
              "target": "strandModeLabel",
              "enabled": true
            }
          ],
          "changeMeaning": "DNA polymerases appear on both templates together with a synthesis-mode label so students can compare the two sides of the fork in one view.",
          "narration": "DNA polymerase extends a new strand only by adding nucleotides to a 3-prime hydroxyl, so synthesis always proceeds in the 5-prime to 3-prime direction. Because the templates are antiparallel, the two new strands must be made differently."
        },
        {
          "clipName": "clip4",
          "audioClip": "dna_replication_leading_and_lagging",
          "autoAdvance": true,
          "changes": [
