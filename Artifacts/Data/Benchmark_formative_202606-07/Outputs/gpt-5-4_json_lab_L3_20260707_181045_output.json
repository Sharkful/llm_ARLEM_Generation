            }
          ],
          "changeMeaning": "A replication-fork label is added to orient students to the Y-shaped opening where replication machinery will assemble and act.",
          "narration": "Replication begins when the double helix opens into a replication fork. Each original strand will serve as a template for the synthesis of a new complementary strand."
        },
        {
          "clipName": "clip1",
          "audioClip": "dna_replication_helicase_unwinds",
          "autoAdvance": true,
