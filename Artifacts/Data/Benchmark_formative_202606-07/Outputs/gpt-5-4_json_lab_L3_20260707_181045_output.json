            },
            {
              "target": "backboneRight",
              "enabled": true
            }
          ],
          "changeMeaning": "Both outer rails are highlighted to focus attention on the two sugar-phosphate backbones that define the exterior of the molecule.",
          "narration": "The outer edges of the helix are the sugar-phosphate backbones. These repeating sugar and phosphate groups form two spiraling rails that support the structure of the molecule."
        },
        {
          "clipName": "clip2",
          "audioClip": "dna_structure_base_pairs_and_interior",
