                -0.72
              ],
              "enabled": true
            }
          ],
          "changeMeaning": "Helicase appears at the fork junction and shifts slightly into position to show it as the enzyme responsible for unwinding parental DNA.",
          "narration": "Helicase moves along the DNA and separates the two parental strands by disrupting the interactions between complementary bases. This creates exposed template strands at the fork."
        },
        {
          "clipName": "clip2",
          "audioClip": "dna_replication_ssb_stabilize",
          "autoAdvance": true,
          "changes": [
