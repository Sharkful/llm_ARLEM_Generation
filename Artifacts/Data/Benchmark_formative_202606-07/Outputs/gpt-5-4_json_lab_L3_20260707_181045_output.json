            {
              "target": "ssbBottom",
              "enabled": true
            }
          ],
          "changeMeaning": "Single-strand binding proteins are added onto the exposed templates to show stabilization of unwound DNA and prevention of re-annealing.",
          "narration": "Once the strands are separated, single-strand binding proteins attach to the exposed DNA. They help stabilize the unwound strands and keep them accessible for replication."
        },
        {
          "clipName": "clip3",
          "audioClip": "dna_replication_polymerase_directionality",
          "autoAdvance": true,
          "changes": [
