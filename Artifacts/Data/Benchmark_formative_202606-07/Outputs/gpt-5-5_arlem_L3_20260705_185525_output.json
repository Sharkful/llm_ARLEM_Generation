  "activity": {
    "id": "act_vectors_projectile_motion",
    "name": "Vectors and Two-Dimensional Projectile Motion",
    "description": "A guided AR laboratory for algebra-based General Physics I. Learners first represent vectors by magnitude, direction, and components; then they add vectors graphically, decompose and reconstruct vectors using right-triangle trigonometry, and apply these ideas to projectile motion. AR overlays show the independence of horizontal and vertical motion, changing velocity components during flight, and the effects of launch angle and speed on range and maximum height.",
    "language": "en",
    "workplace": "wp_vectors_projectile_lab",
    "start": "step_01_orientation",
    "actions": [
