        "id": "step_01_orientation",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset",
        "location": "place_vector_workbench",
        "predicate": "pred_lab_intro_label",
        "instruction": {
          "title": "Orient to the Vector Lab",
          "description": "Stand at the Vector Operations Workbench. The AR headset will place the lab title and play a short orientation. Learning objective: recognize that vectors represent quantities with both magnitude and direction."
        },
