        "viewport": "actions",
        "type": "actions",
        "device": "dev_ar_headset_01",
        "location": "place_model_table",
        "predicate": "pred_intro_label",
        "instruction": {
          "title": "Orient to the VSEPR idea",
          "description": "Look at the molecular modeling table. VSEPR theory predicts shapes because electron domains around a central atom spread out to minimize mutual repulsion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
