  "activity": {
    "id": "act_vsepr_theory_geometry_training",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Geometry",
    "description": "A hands-on AR training activity for General Chemistry I students. Learners use a central atom kit, electron-domain tokens, bond-angle gauge, and molecule reference cards to predict electron-domain geometry and molecular shape from Lewis structures, examine lone-pair effects, and compare VSEPR predictions with observed molecular structures.",
    "language": "en",
    "workplace": "wp_vsepr_ar_lab",
    "start": "step_01_orient_vsepr",
    "actions": [
