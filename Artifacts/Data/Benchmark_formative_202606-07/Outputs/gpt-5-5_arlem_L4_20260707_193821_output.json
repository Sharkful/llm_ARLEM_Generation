        "device": "dev_hololens_learner",
        "location": "place_main_table",
        "predicate": "anim_two_three_four_domain_settle",
        "instruction": {
          "title": "Watch electron domains move apart",
          "description": "Learning objective: predict electron-domain geometry from steric numbers 2, 3, and 4. Observe two domains settle linear at 180\u00b0, three settle trigonal planar at 120\u00b0, and four settle tetrahedral at 109.5\u00b0."
        },
