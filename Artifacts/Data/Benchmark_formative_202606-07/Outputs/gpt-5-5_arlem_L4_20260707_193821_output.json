  "activity": {
    "id": "act_vsepr_theory_ar_training",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Geometry",
    "description": "A hands-on AR training session for General Chemistry I learners. Students begin with flat Lewis structures, count steric number, observe electron-domain repulsions settling into minimum-repulsion geometries, distinguish electron-domain geometry from molecular geometry, examine lone-pair bond-angle compression, compare predictions to real molecules, and complete guided prediction challenges.",
    "language": "en",
    "workplace": "wp_vsepr_university_ar_lab",
    "start": "step_01_intro_count_domains",
    "actions": [
      {
        "id": "step_01_intro_count_domains",
        "viewport": "actions",
        "type": "actions",
        "device": "dev_hololens_learner",
        "location": "place_reference_wall",
        "predicate": "label_intro_vsepr_core_idea",
        "instruction": {
          "title": "Start with a Lewis structure",
          "description": "Learning objective: determine steric number by counting electron domains. Look at the water Lewis structure. Count each bond, double bond, triple bond, or lone pair around the central atom as one electron domain."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": [],
          "messages": [],
          "if_logic": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_reference_wall",
              "augmentation": "label_intro_vsepr_core_idea",
              "poi": "panel_center"
            },
            {
              "target": "thing_lewis_structure_panel",
              "augmentation": "image_water_lewis_counting_domains",
              "poi": "lewis_image_slot"
