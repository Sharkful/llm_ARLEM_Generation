    "predicates": [
      {
        "id": "label_intro_retrograde",
        "type": "label",
        "scale": 1.0,
        "url": "text://Retrograde motion: Mars usually drifts eastward among the stars, then appears to reverse westward before resuming eastward motion."
      },
      {
        "id": "audio_intro_retrograde",
        "type": "audio",
        "scale": 1.0,
        "url": "https://assets.example.com/audio/retrograde_intro_mars_path.mp3"
      },
      {
        "id": "image_mars_nightly_positions",
        "type": "image",
        "scale": 1.0,
        "url": "https://assets.example.com/images/mars_nightly_positions_constellations.png"
      },
      {
        "id": "label_mars_loop_phases",
        "type": "label",
        "scale": 1.0,
        "url": "text://Observe three phases: eastward drift, westward retrograde loop, and return to eastward drift."
      },
      {
        "id": "animation_mars_sky_loop",
        "type": "animation",
        "scale": 0.8,
        "url": "https://assets.example.com/animations/mars_apparent_retrograde_loop.glb"
      },
      {
        "id": "video_geocentric_epicycle",
        "type": "video",
        "scale": 1.0,
        "url": "https://assets.example.com/video/geocentric_epicycle_explanation.mp4"
      },
      {
        "id": "label_geocentric_parsimony",
        "type": "label",
        "scale": 1.0,
        "url": "text://Geocentric models can reproduce loops with epicycles, but require extra circles added to circular motion around Earth."
      },
      {
        "id": "animation_heliocentric_overtake",
        "type": "animation",
        "scale": 0.9,
        "url": "https://assets.example.com/animations/earth_overtakes_mars_heliocentric.glb"
