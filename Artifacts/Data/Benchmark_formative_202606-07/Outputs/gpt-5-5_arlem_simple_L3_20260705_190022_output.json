      {
        "id": "audio_heliocentric_explanation",
        "type": "audio",
        "scale": 1.0,
        "url": "https://assets.example.com/audio/earth_overtakes_mars_explanation.mp3"
      },
      {
        "id": "label_predict_opposition",
        "type": "label",
        "scale": 1.0,
        "url": "text://Retrograde occurs near opposition, when Earth passes between the Sun and an outer planet and overtakes it in its inner, faster orbit."
      },
      {
        "id": "image_outer_planet_loop_comparison",
        "type": "image",
        "scale": 1.0,
        "url": "https://assets.example.com/images/mars_jupiter_saturn_loop_sizes.png"
      },
      {
        "id": "label_compare_planets",
        "type": "label",
        "scale": 1.0,
        "url": "text://Mars shows a larger loop; Jupiter and Saturn are farther away, so Earth's overtaking motion shifts their apparent positions less."
      },
      {
        "id": "audio_summary_retrograde",
        "type": "audio",
        "scale": 1.0,
        "url": "https://assets.example.com/audio/retrograde_motion_summary.mp3"
      }
