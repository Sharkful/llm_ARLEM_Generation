  "activity": {
    "id": "retrograde_motion_activity",
    "name": "Apparent Retrograde Motion of Mars",
    "description": "A simplified linear AR lab for 100-level astronomy students. Students first view Mars's apparent eastward drift, westward loop, and return to eastward motion against background stars, then compare geocentric epicycle and heliocentric overtaking explanations. The final steps support prediction of retrograde timing and comparison of Mars, Jupiter, and Saturn loop sizes.",
    "workplace": "retrograde_motion_workplace",
    "start": "step_01_detect_observing_station",
    "actions": [
      {
        "id": "step_01_detect_observing_station",
        "instruction": {
          "title": "Set the observing frame",
          "description": "Point your device at the Earth Surface Observing Station marker. This establishes the Earth-based viewpoint used to describe the apparent path of Mars in the night sky."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "observing_station",
              "augmentation": "label_intro_retrograde",
              "poi": "default"
            },
            {
              "target": "observing_station",
              "augmentation": "audio_intro_retrograde",
              "poi": "sky_view"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_observing_station"
          }
        ]
      },
      {
        "id": "step_02_mars_path",
        "instruction": {
          "title": "Trace Mars against the stars",
          "description": "View the constellation star field and Mars nightly-position diagram. Identify Mars's normal eastward drift, its temporary westward reversal, and its return to eastward motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "background_stars",
              "augmentation": "image_mars_nightly_positions",
              "poi": "default"
            },
            {
              "target": "mars_retrograde_track",
              "augmentation": "label_mars_loop_phases",
              "poi": "track_label_point"
            },
            {
              "target": "background_stars",
              "augmentation": "animation_mars_sky_loop",
              "poi": "mars_loop_overlay"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_geocentric"
          }
        ]
      },
      {
        "id": "step_03_geocentric_model",
        "instruction": {
          "title": "Examine the geocentric explanation",
          "description": "In the Earth-centered model, Mars's loop is represented with an epicycle: a smaller circular motion carried around Earth. Consider how this explains the observation but adds extra machinery."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "geocentric_epicycle_model",
              "augmentation": "video_geocentric_epicycle",
              "poi": "default"
            },
            {
              "target": "geocentric_epicycle_model",
              "augmentation": "label_geocentric_parsimony",
              "poi": "epicycle_label_point"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_heliocentric"
          }
        ]
      },
      {
        "id": "step_04_heliocentric_overtake",
        "instruction": {
          "title": "Watch Earth overtake Mars",
          "description": "Shift to the external solar-system view. Earth moves faster on its smaller inner orbit and passes slower Mars, making Mars appear to drift backward against distant stars from Earth's viewpoint."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_orbits",
              "augmentation": "animation_heliocentric_overtake",
              "poi": "default"
            },
            {
              "target": "solar_system_stage",
              "augmentation": "audio_heliocentric_explanation",
              "poi": "orbit_plane"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_solar_stage"
          }
        ]
      },
      {
        "id": "step_05_predict_retrograde",
        "instruction": {
          "title": "Predict when retrograde occurs",
          "description": "Use the Sun-Earth-Mars alignment to predict retrograde timing. Retrograde for an outer planet occurs near opposition, when Earth passes between the Sun and that planet."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heliocentric_orbits",
              "augmentation": "label_predict_opposition",
              "poi": "opposition_point"
            },
            {
              "target": "heliocentric_orbits",
              "augmentation": "animation_heliocentric_overtake",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_planet_comparison"
          }
        ]
      },
      {
        "id": "step_06_compare_planets",
        "instruction": {
          "title": "Compare Mars, Jupiter, and Saturn",
          "description": "Compare apparent retrograde loops for three outer planets. Mars's loop is largest because it is closer to Earth; Jupiter and Saturn produce smaller loops because they are farther away."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "planet_loop_comparison",
              "augmentation": "image_outer_planet_loop_comparison",
              "poi": "default"
            },
            {
              "target": "planet_loop_comparison",
              "augmentation": "label_compare_planets",
              "poi": "loop_scale_point"
            },
            {
              "target": "planet_loop_comparison",
              "augmentation": "audio_summary_retrograde",
              "poi": "loop_scale_point"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_wrap_up"
          }
        ]
      },
      {
        "id": "step_07_wrap_up",
        "instruction": {
          "title": "Complete the explanation",
          "description": "Summarize the lab: Mars's apparent loop is not caused by Mars physically reversing direction. It is an apparent effect caused by Earth overtaking Mars, and the heliocentric explanation accounts for the pattern more simply than epicycles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "observing_station",
              "augmentation": "label_intro_retrograde",
              "poi": "default"
            },
            {
              "target": "heliocentric_orbits",
              "augmentation": "label_predict_opposition",
              "poi": "opposition_point"
            },
            {
              "target": "planet_loop_comparison",
              "augmentation": "label_compare_planets",
              "poi": "loop_scale_point"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
  }
}