  "activity": {
    "id": "act_dna_structure_semiconservative_replication",
    "name": "DNA Double Helix and Semiconservative Replication Walkthrough",
    "description": "A simplified linear AR lab for a 200-level introductory molecular biology course. Students inspect the three-dimensional double helix, identify sugar-phosphate backbones, inward-facing nitrogenous bases, hydrogen bonds, and antiparallel 5\u2032/3\u2032 directionality. They then follow helicase, single-strand binding proteins, DNA polymerase, and ligase at a replication fork to connect antiparallel structure with leading- and lagging-strand synthesis and the semiconservative outcome of DNA replication.",
    "workplace": "wp_dna_replication_lab",
    "start": "step_01_orient_lab",
    "actions": [
      {
        "id": "step_01_orient_lab",
        "instruction": {
          "title": "Orient to the DNA Replication AR Lab",
          "description": "Place the AR bench origin and review the learning path: DNA structure first, then replication fork enzymes, strand synthesis asymmetry, ligation, and semiconservative daughter molecules."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "helix_study_zone",
              "augmentation": "lbl_lab_title_dna_replication",
              "poi": "overview_panel"
            },
            {
              "target": "helix_study_zone",
              "augmentation": "img_dna_overview_map",
              "poi": "overview_panel"
            },
            {
              "target": "helix_study_zone",
              "augmentation": "aud_intro_learning_goals",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_helix"
          }
        ]
      },
      {
        "id": "step_02_identify_double_helix_components",
        "instruction": {
          "title": "Identify the Components of the Double Helix",
          "description": "Examine the 3D DNA model. Locate the two sugar-phosphate backbones on the outside, the bases projecting inward, and the hydrogen-bonded base-pair region between the strands."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "anim_double_helix_backbone_bases",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "lbl_sugar_phosphate_backbone",
              "poi": "left_backbone"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "lbl_sugar_phosphate_backbone",
              "poi": "right_backbone"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "lbl_bases_project_inward",
              "poi": "base_pair_center"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "aud_structure_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_dna_helix_model"
          },
          {
            "mode": "click",
            "id": "continue_after_components"
          }
        ]
      },
      {
        "id": "step_03_base_pairing_rules",
        "instruction": {
          "title": "Apply Complementary Base-Pairing Rules",
          "description": "Use the base-pair tiles to connect adenine with thymine and guanine with cytosine. Note that A\u2013T pairs form two hydrogen bonds, while G\u2013C pairs form three hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "base_pair_tiles",
              "augmentation": "img_base_pair_rules",
              "poi": "sequence_practice_panel"
            },
            {
              "target": "base_pair_tiles",
              "augmentation": "lbl_at_two_hbonds",
              "poi": "a_t_pair"
            },
            {
              "target": "base_pair_tiles",
              "augmentation": "lbl_gc_three_hbonds",
              "poi": "g_c_pair"
            },
            {
              "target": "base_pair_tiles",
              "augmentation": "aud_complementary_pairing",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_antiparallel"
          }
        ]
      },
      {
        "id": "step_04_antiparallel_directionality",
        "instruction": {
          "title": "Trace Antiparallel 5\u2032 and 3\u2032 Directionality",
          "description": "Follow the arrows on each sugar-phosphate backbone. One strand runs 5\u2032 to 3\u2032 while the complementary strand runs 3\u2032 to 5\u2032, creating the antiparallel geometry that constrains replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "anim_antiparallel_5_to_3",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "lbl_strand_A_5_to_3",
              "poi": "five_prime_top_left"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "lbl_strand_B_3_to_5",
              "poi": "three_prime_top_right"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "aud_antiparallel_directionality",
              "poi": "default"
