  "activity": {
    "id": "heart_blood_flow_activity",
    "name": "Structural Anatomy of the Heart and Blood Flow Pathway",
    "description": "A simplified linear AR lab for 200-level Human Anatomy and Physiology students. Learners identify heart chambers, valves, and great vessels; trace deoxygenated and oxygenated blood flow through pulmonary and systemic circuits; and relate ventricular myocardium thickness to circuit pressure demands.",
    "workplace": "heart_anatomy_workplace",
    "start": "step_01_orient_heart",
    "actions": [
      {
        "id": "step_01_orient_heart",
        "instruction": {
          "title": "Orient to the Heart Model",
          "description": "Detect the 3D heart model marker. Use the anterior surface as your reference and note that anatomical right appears on the viewer's left in an anterior view. Learning objective: establish orientation before naming chambers and vessels."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "label_four_chambers",
              "poi": "default"
            },
            {
              "target": "heart_model",
              "augmentation": "audio_intro_heart_orientation",
              "poi": "anterior_surface"
            },
            {
              "target": "heart_model",
              "augmentation": "image_chamber_map",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_heart_model"
          }
        ]
      },
      {
        "id": "step_02_identify_chambers",
        "instruction": {
          "title": "Identify the Four Chambers",
          "description": "Compare the right and left chamber focus panels. Name the right atrium, right ventricle, left atrium, and left ventricle. Learning objective: identify and name all four chambers and distinguish the right and left sides of the heart."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "right_chambers_panel",
              "augmentation": "label_right_heart",
              "poi": "default"
            },
            {
              "target": "right_chambers_panel",
              "augmentation": "image_chamber_map",
              "poi": "right_atrium_poi"
            },
            {
              "target": "left_chambers_panel",
              "augmentation": "label_left_heart",
              "poi": "default"
            },
            {
              "target": "left_chambers_panel",
              "augmentation": "image_chamber_map",
              "poi": "left_atrium_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_valves"
          }
        ]
      },
      {
        "id": "step_03_identify_valves",
        "instruction": {
          "title": "Locate the Four Heart Valves",
          "description": "Find the tricuspid valve between right atrium and right ventricle, pulmonary valve between right ventricle and pulmonary trunk, mitral valve between left atrium and left ventricle, and aortic valve between left ventricle and aorta. Learning objective: identify atrioventricular and semilunar valves and describe how they prevent backflow."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "valves_panel",
              "augmentation": "label_valves",
              "poi": "default"
            },
            {
              "target": "valves_panel",
              "augmentation": "image_valve_positions",
              "poi": "av_valves_poi"
            },
            {
              "target": "valves_panel",
              "augmentation": "video_valve_backflow_prevention",
              "poi": "semilunar_valves_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_vessels"
          }
        ]
      },
      {
        "id": "step_04_identify_great_vessels",
        "instruction": {
          "title": "Identify the Great Vessels",
          "description": "Locate vessels entering and leaving the heart: superior and inferior vena cava enter the right atrium; pulmonary arteries leave the right ventricle; pulmonary veins enter the left atrium; the aorta leaves the left ventricle. Learning objective: identify the major vessels and connect each vessel to its chamber or circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "great_vessels_panel",
              "augmentation": "label_great_vessels",
              "poi": "default"
            },
            {
              "target": "great_vessels_panel",
              "augmentation": "image_vessel_overview",
              "poi": "vena_cava_poi"
            },
            {
              "target": "great_vessels_panel",
              "augmentation": "image_vessel_overview",
              "poi": "aorta_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_great_vessels_panel"
          }
        ]
      },
      {
        "id": "step_05_trace_pulmonary_loop",
        "instruction": {
          "title": "Trace Deoxygenated Blood to the Lungs",
          "description": "Follow the blue flow animation: body tissues \u2192 superior/inferior vena cava \u2192 right atrium \u2192 tricuspid valve \u2192 right ventricle \u2192 pulmonary valve \u2192 pulmonary arteries \u2192 lungs. Learning objective: trace the pulmonary circuit and explain that the right heart pumps blood only to the lungs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "pulmonary_circuit_zone",
              "augmentation": "label_dual_circulation",
              "poi": "default"
            },
            {
              "target": "pulmonary_circuit_zone",
              "augmentation": "anim_deoxygenated_flow",
              "poi": "lungs_path_poi"
            },
            {
              "target": "pulmonary_circuit_zone",
              "augmentation": "audio_blood_path_sequence",
              "poi": "lungs_path_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_systemic_loop"
          }
        ]
      },
      {
        "id": "step_06_trace_systemic_loop",
        "instruction": {
          "title": "Trace Oxygenated Blood to the Body",
          "description": "Follow the red flow animation: lungs \u2192 pulmonary veins \u2192 left atrium \u2192 mitral valve \u2192 left ventricle \u2192 aortic valve \u2192 aorta \u2192 systemic circulation. Learning objective: trace the systemic circuit and distinguish it from the pulmonary circuit."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "systemic_circuit_zone",
              "augmentation": "label_dual_circulation",
              "poi": "default"
            },
            {
              "target": "systemic_circuit_zone",
              "augmentation": "anim_oxygenated_flow",
              "poi": "body_path_poi"
            },
            {
              "target": "systemic_circuit_zone",
              "augmentation": "audio_blood_path_sequence",
              "poi": "body_path_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_ventricle_comparison"
          }
        ]
      },
      {
        "id": "step_07_compare_ventricles",
        "instruction": {
          "title": "Compare Ventricular Wall Thickness",
          "description": "Inspect the left ventricle wall label and compare it with the right ventricle. The left ventricle has a substantially thicker myocardium because it generates higher pressure to perfuse the systemic circuit, while the right ventricle pumps to the nearby lungs at lower pressure. Learning objective: relate myocardial wall thickness to functional pressure demands."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "left_chambers_panel",
              "augmentation": "label_left_ventricle_wall",
              "poi": "left_ventricle_poi"
            },
            {
              "target": "left_chambers_panel",
              "augmentation": "audio_ventricle_wall_thickness",
              "poi": "left_ventricle_poi"
            },
            {
              "target": "right_chambers_panel",
              "augmentation": "label_right_heart",
              "poi": "right_ventricle_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_review"
          }
        ]
      },
      {
        "id": "step_08_review_sequence",
        "instruction": {
          "title": "Review the Complete Blood Path",
          "description": "Recite the full pathway in order and include each valve: venae cavae, right atrium, tricuspid valve, right ventricle, pulmonary valve, pulmonary arteries, lungs, pulmonary veins, left atrium, mitral valve, left ventricle, aortic valve, aorta. Learning objective: consolidate chamber, valve, vessel, pulmonary circuit, and systemic circuit knowledge."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "heart_model",
              "augmentation": "label_four_chambers",
              "poi": "default"
            },
            {
              "target": "valves_panel",
              "augmentation": "label_valves",
              "poi": "default"
            },
            {
              "target": "great_vessels_panel",
              "augmentation": "label_great_vessels",
              "poi": "default"
            },
            {
              "target": "pulmonary_circuit_zone",
              "augmentation": "anim_deoxygenated_flow",
              "poi": "lungs_path_poi"
            },
            {
              "target": "systemic_circuit_zone",
              "augmentation": "anim_oxygenated_flow",
              "poi": "body_path_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
  }
