  "activity": {
    "id": "vectors_projectile_linear_activity",
    "name": "Vectors to Projectile Motion: Linear AR Exploration",
    "description": "A simplified AR lab for General Physics I students. Learners first interpret vectors by magnitude, direction, and components, then connect vector decomposition to two-dimensional projectile motion. The experience emphasizes tip-to-tail addition, right-triangle component analysis, independence of horizontal and vertical motion, projectile velocity changes during flight, and qualitative predictions about launch angle and speed.",
    "workplace": "vectors_projectile_workplace",
    "start": "step_01_vector_intro",
    "actions": [
      {
        "id": "step_01_vector_intro",
        "instruction": {
          "title": "1. Identify a Vector as Magnitude Plus Direction",
          "description": "Aim your device at the vector table. A sample arrow appears. Notice that the arrow length represents magnitude and the arrow orientation represents direction. This supports the objective: represent a two-dimensional vector by magnitude and direction."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_table",
              "augmentation": "lbl_vector_definition",
              "poi": "default"
            },
            {
              "target": "vector_table",
              "augmentation": "aud_vector_intro",
              "poi": "resultant_slot"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_addition"
          }
        ]
      },
      {
        "id": "step_02_tip_to_tail",
        "instruction": {
          "title": "2. Add Vectors Tip-to-Tail",
          "description": "Observe two vectors being translated without changing length or direction. The second vector\u2019s tail moves to the first vector\u2019s tip. The resultant runs from the first tail to the final tip. This supports the objective: add vectors graphically and identify the resultant."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "vector_workspace",
              "augmentation": "anim_tip_to_tail_addition",
              "poi": "tip_to_tail_zone"
            },
            {
              "target": "vector_table",
              "augmentation": "lbl_resultant_vector",
              "poi": "resultant_slot"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_components"
          }
        ]
      },
      {
        "id": "step_03_components",
        "instruction": {
          "title": "3. Decompose a Vector into x and y Components",
          "description": "Look at the component axes board. The diagonal vector forms a right triangle with horizontal and vertical legs. Use cosine for the adjacent x-component and sine for the opposite y-component. This supports the objective: decompose and reconstruct a vector using right-triangle trigonometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "axes_board",
              "augmentation": "img_component_triangle",
              "poi": "component_triangle_poi"
            },
            {
              "target": "axes_board",
              "augmentation": "lbl_component_equations",
              "poi": "default"
            },
            {
              "target": "axes_board",
              "augmentation": "aud_components_trig",
              "poi": "component_triangle_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_axes_board_complete"
          }
        ]
      },
      {
        "id": "step_04_launch_components",
        "instruction": {
          "title": "4. Apply Components to Initial Projectile Velocity",
          "description": "Aim at the projectile launcher. The launch velocity vector splits into horizontal vx and vertical vy components. The same component rules used for abstract vectors now describe the projectile\u2019s initial motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_launcher",
              "augmentation": "anim_projectile_decomposition",
              "poi": "launch_vector_poi"
            },
            {
              "target": "projectile_launcher",
              "augmentation": "lbl_velocity_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_independence"
          }
        ]
      },
      {
        "id": "step_05_independent_motion",
        "instruction": {
          "title": "5. Explain Independent Horizontal and Vertical Motion",
          "description": "Watch the comparison of horizontal and vertical motion. With no horizontal force in the ideal model, vx remains constant. Gravity acts vertically, so vy changes steadily. This supports the objective: explain independence of horizontal and vertical projectile motion."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_range_lane",
              "augmentation": "vid_independent_motion",
              "poi": "default"
            },
            {
              "target": "projectile_launcher",
              "augmentation": "lbl_velocity_components",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_range_lane_complete"
          }
        ]
      },
      {
        "id": "step_06_trajectory_apex",
        "instruction": {
          "title": "6. Track the Parabolic Path and the Apex",
          "description": "Follow the parabolic trajectory. The path emerges from constant horizontal velocity combined with uniformly accelerated vertical motion. At the highest point, vertical velocity is zero but horizontal velocity is not."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_range_lane",
              "augmentation": "anim_parabolic_trajectory",
              "poi": "default"
            },
            {
              "target": "projectile_range_lane",
              "augmentation": "lbl_apex_vy_zero",
              "poi": "apex_zone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_prediction"
          }
        ]
      },
      {
        "id": "step_07_angle_speed_prediction",
        "instruction": {
          "title": "7. Predict Effects of Launch Angle and Speed",
          "description": "Compare trajectories for different launch angles and speeds. Increasing speed raises both maximum height and range. For equal launch and landing heights, a 45\u00b0 launch angle gives maximum range for a fixed speed."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "projectile_launcher",
              "augmentation": "anim_angle_speed_comparison",
              "poi": "launch_vector_poi"
            },
            {
              "target": "range_pad",
              "augmentation": "lbl_range_prediction",
              "poi": "range_label_poi"
            },
            {
              "target": "range_pad",
              "augmentation": "aud_summary_prediction",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_wrap_up"
          }
        ]
      },
      {
        "id": "step_08_wrap_up",
        "instruction": {
          "title": "8. Connect Vector Tools to Projectile Motion",
          "description": "Review the core connection: projectile motion is a vector problem. The initial velocity vector is decomposed into components, horizontal and vertical motions evolve independently, and the visible path is their combined result."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "axes_board",
              "augmentation": "lbl_component_equations",
              "poi": "default"
            },
            {
              "target": "projectile_range_lane",
              "augmentation": "lbl_apex_vy_zero",
              "poi": "apex_zone"
            },
            {
              "target": "range_pad",
              "augmentation": "lbl_range_prediction",
              "poi": "range_label_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
  }
