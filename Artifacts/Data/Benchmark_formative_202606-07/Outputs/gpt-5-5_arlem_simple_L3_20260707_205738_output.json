  "activity": {
    "id": "act_vsepr_linear_lab",
    "name": "VSEPR Geometry Explorer: From Lewis Structures to Molecular Shape",
    "description": "A simplified linear AR activity for General Chemistry I students. Learners use Lewis structures to count electron domains, connect steric number to electron-domain geometry, distinguish molecular geometry from electron-domain geometry, examine lone-pair bond-angle effects, and compare predictions with common real molecules.",
    "workplace": "wp_vsepr_general_chem",
    "start": "step_01_count_domains",
    "actions": [
      {
        "id": "step_01_count_domains",
        "instruction": {
          "title": "Count electron domains from a Lewis structure",
          "description": "Place the Lewis structure card in view. Count regions of electron density around the central atom: each single, double, or triple bond counts as one bonding domain, and each lone pair counts as one domain. This gives the steric number."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_lewis_card",
              "augmentation": "lbl_steric_number_formula",
              "poi": "top_edge"
            },
            {
              "target": "thing_lewis_card",
              "augmentation": "img_lewis_to_domains",
              "poi": "default"
            },
            {
              "target": "thing_lewis_card",
              "augmentation": "aud_intro_vsepr_repulsion",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_lewis_card"
          }
        ]
      },
      {
        "id": "step_02_sn2_sn4_geometries",
        "instruction": {
          "title": "Predict electron-domain geometry for steric numbers 2\u20134",
          "description": "At the molecule construction zone, observe how two, three, and four electron domains move as far apart as possible. Identify linear, trigonal planar, and tetrahedral electron-domain geometries and their ideal bond angles."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_model_zone",
              "augmentation": "anim_linear_trigonal_tetra",
              "poi": "default"
            },
            {
              "target": "place_model_zone",
              "augmentation": "lbl_sn2_sn3_sn4",
              "poi": "above_model"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_sn5_sn6"
          }
        ]
      },
      {
        "id": "step_03_sn5_sn6_geometries",
        "instruction": {
          "title": "Extend VSEPR to steric numbers 5 and 6",
          "description": "Use the domain manipulator puck to inspect trigonal bipyramidal and octahedral arrangements. Notice that these are electron-domain geometries: they describe where all bonding and lone-pair domains are arranged in space."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_domain_manipulator",
              "augmentation": "anim_tbp_octahedral",
              "poi": "center_atom_socket"
            },
            {
              "target": "thing_domain_manipulator",
              "augmentation": "lbl_sn5_sn6",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_domain_manipulator"
          }
        ]
      },
      {
        "id": "step_04_lone_pair_shapes",
        "instruction": {
          "title": "Distinguish electron-domain geometry from molecular geometry",
          "description": "Watch lone-pair domains become invisible in the molecular model while still occupying space. Identify common molecular shapes produced by lone pairs: bent, trigonal pyramidal, seesaw, T-shaped, square planar, and square pyramidal."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_model_zone",
              "augmentation": "anim_lone_pair_shapes",
              "poi": "default"
            },
            {
              "target": "place_model_zone",
              "augmentation": "lbl_molecular_vs_electron_geometry",
              "poi": "above_model"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "next_lone_pair_angles"
          }
        ]
      },
      {
        "id": "step_05_lone_pair_angles",
        "instruction": {
          "title": "Explain bond-angle deviations caused by lone pairs",
          "description": "Aim the angle gauge at the model. Lone pairs occupy more angular space than bonding pairs, so they compress nearby bond angles. Compare methane's ideal tetrahedral angle of 109.5\u00b0 with water's smaller H\u2013O\u2013H angle of about 104.5\u00b0."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_angle_gauge",
              "augmentation": "vid_lone_pair_angle_compression",
              "poi": "readout"
            },
            {
              "target": "thing_angle_gauge",
              "augmentation": "lbl_water_methane_angles",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_angle_gauge"
          }
        ]
      },
      {
        "id": "step_06_real_molecules",
        "instruction": {
          "title": "Apply VSEPR to real molecules",
          "description": "Compare predicted and observed structures for H\u2082O, NH\u2083, CH\u2084, PF\u2085, SF\u2086, and XeF\u2084. For each molecule, start with its Lewis structure, count domains, identify electron-domain geometry, then name the molecular geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_molecule_set",
              "augmentation": "img_real_molecule_comparison",
              "poi": "display_row"
            },
            {
              "target": "thing_molecule_set",
              "augmentation": "aud_real_molecule_wrapup",
              "poi": "default"
            },
            {
              "target": "place_comparison_zone",
              "augmentation": "lbl_apply_vsepr_summary",
              "poi": "side_panel"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "finish_activity"
          }
        ]
      }
    ]
