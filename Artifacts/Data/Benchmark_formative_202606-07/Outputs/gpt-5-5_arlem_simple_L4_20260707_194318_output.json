  "activity": {
    "id": "dna_replication_linear_activity",
    "name": "DNA Double Helix and Semiconservative Replication",
    "description": "A simplified linear AR lab for 200-level molecular biology students. Learners progress from a ladder schematic of DNA to the double helix, antiparallel 5'-to-3' orientation, complementary base-pairing, replication fork enzymes, leading and lagging strand synthesis, and semiconservative inheritance of parental strands.",
    "workplace": "dna_replication_workplace",
    "start": "step_01_ladder_structure",
    "actions": [
      {
        "id": "step_01_ladder_structure",
        "instruction": {
          "title": "1. DNA as a Ladder Schematic",
          "description": "Identify DNA as a polymer with two sugar-phosphate backbones and inward-facing nitrogenous bases. The colored rungs show A, T, G, and C bases paired across the molecule."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "label_dna_ladder_components",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "audio_dna_structure_intro",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "image_base_pair_rules",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_helix"
          }
        ]
      },
      {
        "id": "step_02_double_helix",
        "instruction": {
          "title": "2. From Ladder to Double Helix",
          "description": "Watch the flat ladder twist into a double helix. Notice that the two backbones spiral around a common axis while base pairs stack in the interior; one turn is about ten base pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "anim_dna_ladder_to_double_helix",
              "poi": "default"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "label_dna_ladder_components",
              "poi": "backbone_left"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "label_dna_ladder_components",
              "poi": "backbone_right"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_helix_marker"
          }
        ]
      },
      {
        "id": "step_03_antiparallel",
        "instruction": {
          "title": "3. Antiparallel 5\u2032-to-3\u2032 Directionality",
          "description": "Follow the arrows along each backbone. One strand runs 5\u2032 to 3\u2032 upward, while the complementary strand runs 3\u2032 to 5\u2032 upward; this opposite orientation is forced by backbone chemistry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "dna_helix_model",
              "augmentation": "label_antiparallel_5_to_3",
              "poi": "helix_top"
            },
            {
              "target": "dna_helix_model",
              "augmentation": "audio_antiparallel_directionality",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_pairing"
          }
        ]
      },
      {
        "id": "step_04_base_pairing",
        "instruction": {
          "title": "4. Complementary Base-Pairing Rules",
          "description": "Use the displayed template sequence 5\u2032-ATGCCAGT-3\u2032 to determine the complementary strand. A pairs with T using two hydrogen bonds; G pairs with C using three hydrogen bonds."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "base_pairing_board",
              "augmentation": "anim_complementary_pairing_practice",
              "poi": "template_sequence"
            },
            {
              "target": "base_pairing_board",
              "augmentation": "image_base_pair_rules",
              "poi": "base_palette"
            },
            {
              "target": "base_pairing_board",
              "augmentation": "audio_pairing_hydrogen_bonds",
              "poi": "complement_sequence"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_base_pairing_board"
          }
        ]
      },
      {
        "id": "step_05_helicase",
        "instruction": {
          "title": "5. Helicase Opens the Replication Fork",
          "description": "Observe helicase at the fork front. It unwinds the double helix by disrupting hydrogen bonds between paired bases, exposing each parental strand as a template."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "anim_helicase_unwinds_dna",
              "poi": "fork_front"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "label_helicase_function",
              "poi": "fork_front"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_ssb"
          }
        ]
      },
      {
        "id": "step_06_ssb",
        "instruction": {
          "title": "6. Single-Strand Binding Proteins Stabilize Templates",
          "description": "Small SSB proteins bind the exposed parental strands. They prevent the separated strands from re-pairing or folding, keeping templates accessible for replication."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "anim_ssb_stabilizes_strands",
              "poi": "leading_arm"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "anim_ssb_stabilizes_strands",
              "poi": "lagging_arm"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "label_ssb_function",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_replication_fork"
          }
        ]
      },
      {
        "id": "step_07_leading_strand",
        "instruction": {
          "title": "7. Leading Strand Synthesis",
          "description": "DNA polymerase extends a new strand only in the 5\u2032-to-3\u2032 direction by adding nucleotides to a 3\u2032 end. On the leading-strand template, synthesis follows the fork continuously."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "anim_leading_strand_synthesis",
              "poi": "leading_arm"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "label_polymerase_5_to_3",
              "poi": "leading_arm"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_lagging"
          }
        ]
      },
      {
        "id": "step_08_lagging_strand",
        "instruction": {
          "title": "8. Lagging Strand, Okazaki Fragments, and Ligase",
          "description": "On the opposite template, polymerase must synthesize short 5\u2032-to-3\u2032 fragments away from the fork. DNA ligase then seals these Okazaki fragments into a continuous strand."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "replication_fork_model",
              "augmentation": "anim_lagging_okazaki_ligase",
              "poi": "lagging_arm"
            },
            {
              "target": "replication_fork_model",
              "augmentation": "label_lagging_ligase_function",
              "poi": "fragment_zone"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_full_fork"
          }
        ]
      },
      {
        "id": "step_09_full_fork",
        "instruction": {
          "title": "9. Integrated Replication Fork Overview",
          "description": "Review the full fork: helicase unwinds, SSBs stabilize, polymerase builds the leading strand continuously, polymerase builds the lagging strand in fragments, and ligase joins fragments."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
