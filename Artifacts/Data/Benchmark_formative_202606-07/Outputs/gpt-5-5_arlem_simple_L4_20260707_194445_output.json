  "activity": {
    "id": "act_vectors_projectile_motion_linear",
    "name": "Vectors and Projectile Motion: Linear AR Exploration",
    "description": "A simplified university-level AR lab for General Physics I. Students progress linearly from vectors as arrows with magnitude and direction, to tip-to-tail addition, component decomposition, projectile velocity components, independence of horizontal and vertical motion, range versus launch angle, and a brief targeting synthesis. This reduced ARLEM version uses static anchors and markers with click or detect triggers only.",
    "workplace": "wp_vectors_projectiles_mechanics",
    "start": "step_01_vector_intro",
    "actions": [
      {
        "id": "step_01_vector_intro",
        "instruction": {
          "title": "1. Vectors Have Magnitude and Direction",
          "description": "Observe the blue arrow anchored at the origin of the x-y-z axes. Its length represents magnitude and its orientation represents direction, unlike a scalar quantity that has size only."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_vector_workspace",
              "augmentation": "lbl_vector_intro",
              "poi": "default"
            },
            {
              "target": "thing_axes_frame",
              "augmentation": "lbl_axes_xyz",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "anim_single_vector_arrow",
              "poi": "default"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "aud_vector_intro",
              "poi": "magnitude_label_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_addition"
          }
        ]
      },
      {
        "id": "step_02_tip_to_tail",
        "instruction": {
          "title": "2. Add Vectors Tip-to-Tail",
          "description": "Two arrows are placed so the tail of the second begins at the tip of the first. The red resultant runs from the starting tail to the final tip, showing the graphical sum."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_arrows",
              "augmentation": "anim_tip_to_tail_vectors",
              "poi": "default"
            },
            {
              "target": "place_vector_workspace",
              "augmentation": "lbl_tip_to_tail",
              "poi": "label_panel_poi"
            },
            {
              "target": "thing_component_arrows",
              "augmentation": "aud_tip_to_tail",
              "poi": "resultant_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_components"
          }
        ]
      },
      {
        "id": "step_03_components",
        "instruction": {
          "title": "3. Decompose a Vector into Components",
          "description": "The original vector can be reconstructed from perpendicular x and y component arrows. In two dimensions, these form a right triangle with the original vector as the hypotenuse."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_component_arrows",
              "augmentation": "anim_vector_decomposition",
              "poi": "x_component_poi"
            },
            {
              "target": "thing_component_arrows",
              "augmentation": "lbl_components",
              "poi": "y_component_poi"
            },
            {
              "target": "thing_vector_arrow",
              "augmentation": "aud_components_trig",
              "poi": "vector_head_poi"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_projectile_plane"
          }
        ]
      },
      {
        "id": "step_04_projectile_setup",
        "instruction": {
          "title": "4. Apply Vectors to Projectile Motion",
          "description": "A ball is launched in a vertical plane. Its initial velocity vector points up and to the right and can be treated with the same component methods used for abstract vectors."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "place_projectile_plane",
              "augmentation": "img_projectile_plane_axes",
              "poi": "default"
            },
            {
              "target": "place_projectile_plane",
              "augmentation": "lbl_projectile_setup",
              "poi": "trajectory_display_poi"
            },
            {
              "target": "thing_projectile_launcher",
              "augmentation": "aud_projectile_setup",
              "poi": "velocity_vector_poi"
            },
            {
              "target": "thing_projectile_launcher",
              "augmentation": "anim_single_vector_arrow",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_to_launch_demo"
          }
        ]
      },
      {
        "id": "step_05_independent_motion",
        "instruction": {
          "title": "5. Watch Independent Horizontal and Vertical Motion",
          "description": "During flight, the horizontal velocity component remains constant while the vertical component decreases, becomes zero at maximum height, and then points downward as the ball falls."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
