            "id": "detect_gallery"
          }
        ]
      },
      {
        "id": "step_07_recap",
        "instruction": {
          "title": "Recap: VSEPR Prediction Workflow",
          "description": "Review the complete workflow: draw/count domains from the Lewis structure, identify electron-domain geometry, remove lone pairs mentally to name molecular geometry, adjust expected angles, and compare with known structures."
        },
        "enter": {
