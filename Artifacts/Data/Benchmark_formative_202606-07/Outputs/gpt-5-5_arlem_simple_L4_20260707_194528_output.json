  "activity": {
    "id": "act_vsepr_linear_intro",
    "name": "VSEPR Theory: From Lewis Structures to 3D Molecular Shapes",
    "description": "A simplified linear AR lab for General Chemistry I students. Learners begin with a Lewis structure, count electron domains to find steric number, observe how electron domains minimize repulsion, identify the five fundamental electron-domain geometries, distinguish electron-domain geometry from molecular geometry, explain lone-pair bond-angle compression, and apply VSEPR predictions to representative molecules.",
    "workplace": "wp_vsepr_intro_lab",
    "start": "step_01_intro",
    "actions": [
      {
        "id": "step_01_intro",
        "instruction": {
          "title": "Start with VSEPR and a Lewis Structure",
          "description": "Look at the central atom station and the water Lewis structure. Count each bond or lone pair as one electron domain. Learning objective: determine steric number from a Lewis structure."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom_station",
              "augmentation": "lbl_vsepr_core_idea",
              "poi": "above_atom"
            },
            {
              "target": "thing_lewis_panel",
              "augmentation": "img_water_lewis_domain_count",
              "poi": "panel_center"
            },
            {
              "target": "thing_lewis_panel",
              "augmentation": "aud_intro_vsepr_from_lewis_to_3d",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_intro"
          }
        ]
      },
      {
        "id": "step_02_repulsion",
        "instruction": {
          "title": "Watch Domains Minimize Repulsion",
          "description": "Two, three, and four electron domains spread out to maximize separation: linear, trigonal planar, then tetrahedral. Learning objective: connect steric number 2\u20134 with electron-domain geometry."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_domain_model",
              "augmentation": "anim_domains_minimize_repulsion_2_to_4",
              "poi": "model_airspace"
            },
            {
              "target": "thing_domain_model",
              "augmentation": "lbl_domain_counts_2_3_4",
              "poi": "default"
            },
            {
              "target": "thing_domain_model",
              "augmentation": "aud_minimum_repulsion_principle",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_domain_model"
          }
        ]
      },
      {
        "id": "step_03_geometry_catalog",
        "instruction": {
          "title": "Complete the Five Electron-Domain Geometries",
          "description": "Add fifth and sixth domains to form trigonal bipyramidal and octahedral arrangements. Review the complete catalog and ideal angles. Learning objective: predict electron-domain geometry from steric number 2\u20136."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_domain_model",
              "augmentation": "anim_five_six_domain_geometries",
              "poi": "model_airspace"
            },
            {
              "target": "place_geometry_gallery",
              "augmentation": "img_geometry_catalog_angles",
              "poi": "gallery_center"
            },
            {
              "target": "thing_domain_model",
              "augmentation": "aud_geometry_catalog_5_and_6",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_catalog"
          }
        ]
      },
      {
        "id": "step_04_molecular_geometry",
        "instruction": {
          "title": "Electron-Domain vs Molecular Geometry",
          "description": "Compare CH4, NH3, and H2O. The electron-domain geometry remains tetrahedral, but lone pairs change the molecular geometry to trigonal pyramidal or bent. Learning objective: distinguish electron-domain geometry from molecular shape."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_central_atom_station",
              "augmentation": "anim_tetrahedral_ch4_nh3_h2o",
              "poi": "default"
            },
            {
              "target": "thing_central_atom_station",
              "augmentation": "lbl_electron_vs_molecular_geometry",
              "poi": "above_atom"
            },
            {
              "target": "thing_central_atom_station",
              "augmentation": "aud_electron_vs_molecular_geometry",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "detect",
            "id": "detect_central_atom_station"
          }
        ]
      },
      {
        "id": "step_05_lone_pair_angles",
        "instruction": {
          "title": "Why Lone Pairs Compress Bond Angles",
          "description": "Compare methane, ammonia, and water angles. Lone pairs occupy more angular space than bonding pairs, compressing H\u2013X\u2013H angles from 109.5\u00b0 to about 107\u00b0 and 104.5\u00b0. Learning objective: predict bond-angle deviations caused by lone pairs."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
            {
              "target": "thing_angle_compare",
              "augmentation": "anim_bond_angle_comparison",
              "poi": "comparison_row"
            },
            {
              "target": "thing_angle_compare",
              "augmentation": "lbl_lone_pairs_compress_angles",
              "poi": "default"
            },
            {
              "target": "thing_angle_compare",
              "augmentation": "aud_lone_pair_angle_deviation",
              "poi": "default"
            }
          ]
        },
        "triggers": [
          {
            "mode": "click",
            "id": "continue_angles"
          }
        ]
      },
      {
        "id": "step_06_real_molecules",
        "instruction": {
          "title": "Apply VSEPR to Real Molecules",
          "description": "Inspect CO2, BF3, CH4, PF5, SF6, NH3, H2O, and XeF4. Match Lewis structures to predicted and observed 3D shapes. Learning objective: apply VSEPR predictions to real examples."
        },
        "enter": {
          "remove_self": false,
          "activates": [],
          "deactivate": []
        },
        "exit": {
          "remove_self": false,
          "activates": [],
          "deactivate": [
