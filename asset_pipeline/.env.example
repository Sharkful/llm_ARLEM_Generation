# Copy to .env and fill in whichever provider(s) you actually use.
# All three are optional individually -- only the provider selected via
# ASSET_PIPELINE_LLM_PROVIDER (or passed explicitly per call) needs a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults shown)
ASSET_PIPELINE_LLM_PROVIDER=anthropic
ASSET_PIPELINE_LLM_MODEL=claude-sonnet-4-6
ASSET_PIPELINE_LIBRARY_DIR=
ASSET_PIPELINE_INTAKE_DIR=
ASSET_PIPELINE_OPENSCAD_BIN=
ASSET_PIPELINE_BLENDER_BIN=
ASSET_PIPELINE_MAX_TRIANGLES=20000
ASSET_PIPELINE_CATALOG_MATCH_THRESHOLD=0.85
